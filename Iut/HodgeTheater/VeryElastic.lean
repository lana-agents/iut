import Mathlib.Topology.Algebra.Group.ClosedSubgroup
import Mathlib.Topology.Algebra.OpenSubgroup
import Mathlib.GroupTheory.Schreier

/-!
# Very elastic groups and strict semi-absoluteness

[AbsTopI] Def. 1.1 (ii) (`Topics in Absolute Anabelian Geometry I.txt` l.453–456): a profinite
group `G` is *elastic* if every topologically finitely generated closed normal subgroup `N ⊆ H` of
an open subgroup `H ⊆ G` is either trivial or of finite index in `G`; it is *very elastic* if it is
elastic but not topologically finitely generated. By [AbsTopI] Thm. 1.7 (iii) (l.705–712) the
absolute Galois group of a number field is very elastic.

This file is generic (topological groups, no anabelian input):

* `IsTopFG N` (closed subgroups generated topologically by a finite set), `IsElastic`,
  `IsVeryElastic`;
* closure properties of `IsTopFG`: images (`IsTopFG.map`), preimages along closed embeddings
  (`IsTopFG.of_map`), intersections with open subgroups (`IsTopFG.inf_open`, topological
  Schreier, from Mathlib's `Subgroup.fg_of_index_ne_zero`), and passage from `M ⊓ U` to `M` for `U`
  open (`IsTopFG.of_inf_open`); dense images of finitely generated groups (`isTopFG_top_of_dense`);
* `IsVeryElastic.eq_bot`: the necessity half of [AbsTopI] Prop. 1.3 (ii) (l.539–549): in a very
  elastic group every topologically finitely generated closed normal subgroup of an open subgroup
  is trivial;
* **`map_eq_one_of_isVeryElastic`** ([AbsTopI] Prop. 2.5 (ii), l.1046–1060, for automorphisms):
  let `f : Q ↪ P` be an open embedding of compact groups and `pr : P ↠ G` a continuous surjection
  onto a very elastic Hausdorff group with topologically finitely generated kernel. Then every
  continuous automorphism of `Q` maps `ker(pr ∘ f)` into itself.
-/

namespace Iut

namespace HodgeTheater

namespace Elastic

open Topology

section Defs

variable (G : Type*) [Group G] [TopologicalSpace G]

/-- A subgroup is **topologically finitely generated** if it is the closure of the subgroup
generated by a finite set (in particular it is closed). -/
def IsTopFG {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (N : Subgroup G) : Prop :=
  ∃ s : Set G, s.Finite ∧ (Subgroup.closure s).topologicalClosure = N

variable [IsTopologicalGroup G]

/-- **Elastic** ([AbsTopI] Def. 1.1 (ii), l.453–455): every topologically finitely generated
closed normal subgroup `N ⊆ H` of an open subgroup `H ⊆ G` is trivial or of finite index in `G`. -/
def IsElastic : Prop :=
  ∀ H N : Subgroup G, IsOpen (H : Set G) → N ≤ H → (N.subgroupOf H).Normal →
    IsClosed (N : Set G) → IsTopFG N → N = ⊥ ∨ N.FiniteIndex

/-- **Very elastic** ([AbsTopI] Def. 1.1 (ii), l.455–456): elastic, but not topologically finitely
generated. -/
def IsVeryElastic : Prop := IsElastic G ∧ ¬ IsTopFG (⊤ : Subgroup G)

end Defs

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

lemma IsTopFG.isClosed {N : Subgroup G} (h : IsTopFG N) : IsClosed (N : Set G) := by
  obtain ⟨s, -, hs⟩ := h
  rw [← hs]
  exact Subgroup.isClosed_topologicalClosure _

/-- **Images**: the image of a topologically finitely generated subgroup under a continuous
homomorphism is topologically finitely generated if it is closed. -/
lemma IsTopFG.map {G' : Type*} [Group G'] [TopologicalSpace G'] [IsTopologicalGroup G']
    {N : Subgroup G} (h : IsTopFG N) (f : G →* G') (hf : Continuous f)
    (hc : IsClosed ((N.map f : Subgroup G') : Set G')) : IsTopFG (N.map f) := by
  obtain ⟨s, hs, hsN⟩ := h
  refine ⟨f '' s, hs.image f, le_antisymm ?_ ?_⟩
  · refine Subgroup.topologicalClosure_minimal _ ?_ hc
    rw [← MonoidHom.map_closure]
    exact Subgroup.map_mono (hsN ▸ Subgroup.le_topologicalClosure _)
  · rintro _ ⟨x, hx, rfl⟩
    rw [← hsN] at hx
    have h1 : f x ∈ closure (f '' (Subgroup.closure s : Set G)) :=
      image_closure_subset_closure_image hf ⟨x, hx, rfl⟩
    have h2 : f '' (Subgroup.closure s : Set G) = ((Subgroup.closure (f '' s)) : Set G') := by
      rw [← MonoidHom.map_closure, Subgroup.coe_map]
    rw [h2] at h1
    exact h1

/-- **Preimages along closed embeddings.** -/
lemma IsTopFG.of_map {G' : Type*} [Group G'] [TopologicalSpace G'] [IsTopologicalGroup G']
    {N : Subgroup G} (f : G →* G') (hf : IsClosedEmbedding f) (h : IsTopFG (N.map f)) :
    IsTopFG N := by
  obtain ⟨t, ht, htN⟩ := h
  have htr : t ⊆ Set.range f := fun y hy => by
    have : y ∈ N.map f := htN ▸ Subgroup.le_topologicalClosure _ (Subgroup.subset_closure hy)
    obtain ⟨x, -, rfl⟩ := this
    exact ⟨x, rfl⟩
  have hft : f '' (f ⁻¹' t) = t := Set.image_preimage_eq_of_subset htr
  refine ⟨f ⁻¹' t, ht.preimage hf.injective.injOn, Subgroup.map_injective hf.injective ?_⟩
  rw [← htN]
  apply SetLike.coe_injective
  rw [Subgroup.coe_map, Subgroup.topologicalClosure_coe, Subgroup.topologicalClosure_coe,
    ← hf.closure_image_eq, ← Subgroup.coe_map, MonoidHom.map_closure, hft]

/-- A dense image of a finitely generated group is topologically finitely generated. -/
lemma isTopFG_top_of_dense {Γ : Type*} [Group Γ] [hΓ : Group.FG Γ] (φ : Γ →* G)
    (hφ : DenseRange φ) : IsTopFG (⊤ : Subgroup G) := by
  obtain ⟨S, hS⟩ := hΓ.out
  refine ⟨φ '' (S : Set Γ), S.finite_toSet.image φ, eq_top_iff.2 fun x _ => ?_⟩
  rw [← MonoidHom.map_closure, hS, ← MonoidHom.range_eq_map]
  change x ∈ closure (Set.range φ)
  rw [hφ.closure_range]
  trivial

/-- Transport along a continuous isomorphism of the top subgroup. -/
lemma isTopFG_top_of_equiv {G' : Type*} [Group G'] [TopologicalSpace G'] [IsTopologicalGroup G']
    (e : G' ≃ₜ* G) (h : IsTopFG (⊤ : Subgroup G')) : IsTopFG (⊤ : Subgroup G) := by
  have hm : (⊤ : Subgroup G').map (e : G' →* G) = ⊤ :=
    Subgroup.map_top_of_surjective _ e.surjective
  have := h.map (e : G' →* G) e.continuous (by rw [hm]; exact isClosed_univ)
  rwa [hm] at this

/-- A closed subgroup that is topologically finitely generated as a group is so as a subgroup. -/
lemma IsTopFG.of_top_subtype {K : Subgroup G} (hK : IsClosed (K : Set G))
    (h : IsTopFG (⊤ : Subgroup K)) : IsTopFG K := by
  have hm : (⊤ : Subgroup K).map K.subtype = K := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have := h.map K.subtype continuous_subtype_val (by rw [hm]; exact hK)
  rwa [hm] at this

/-- **Topological Schreier**: in a compact group, the intersection of a topologically finitely
generated subgroup with an open subgroup is topologically finitely generated. -/
lemma IsTopFG.inf_open [CompactSpace G] {N U : Subgroup G} (h : IsTopFG N)
    (hU : IsOpen (U : Set G)) : IsTopFG (N ⊓ U) := by
  obtain ⟨s, hs, hsN⟩ := h
  haveI : Finite s := hs.to_subtype
  set Γ := Subgroup.closure s
  haveI : Finite (G ⧸ U) := Subgroup.quotient_finite_of_isOpen U hU
  haveI : U.FiniteIndex := Subgroup.finiteIndex_of_finite_quotient
  set K : Subgroup Γ := U.subgroupOf Γ
  haveI : Group.FG K := Subgroup.fg_of_index_ne_zero K
  obtain ⟨t, ht⟩ := (Group.fg_def.1 ‹Group.FG K›)
  let ι : K →* G := Γ.subtype.comp K.subtype
  have hcl : Subgroup.closure (ι '' (t : Set K)) = (⊤ : Subgroup K).map ι := by
    rw [← MonoidHom.map_closure, ht]
  have hΓU : ((Γ ⊓ U : Subgroup G) : Set G) ⊆ Subgroup.closure (ι '' (t : Set K)) := by
    rintro x ⟨hxΓ, hxU⟩
    rw [hcl]
    exact ⟨⟨⟨x, hxΓ⟩, hxU⟩, trivial, rfl⟩
  have hle : Subgroup.closure (ι '' (t : Set K)) ≤ N ⊓ U := by
    rw [hcl]
    rintro _ ⟨k, -, rfl⟩
    exact ⟨hsN ▸ Subgroup.le_topologicalClosure _ k.1.2, k.2⟩
  have hNc : IsClosed ((N ⊓ U : Subgroup G) : Set G) :=
    (hsN ▸ Subgroup.isClosed_topologicalClosure _).inter (Subgroup.isClosed_of_isOpen U hU)
  refine ⟨ι '' (t : Set K), t.finite_toSet.image ι,
    le_antisymm (Subgroup.topologicalClosure_minimal _ hle hNc) ?_⟩
  rintro x ⟨hxN, hxU⟩
  have hx : x ∈ (U : Set G) ∩ closure (Γ : Set G) := by
    refine ⟨hxU, ?_⟩
    rw [← Subgroup.topologicalClosure_coe, hsN]
    exact hxN
  have := hU.inter_closure hx
  rw [Set.inter_comm] at this
  exact closure_mono hΓU this

/-- **Finite index**: if `N` is topologically finitely generated of finite index, so is `G`. -/
lemma IsTopFG.top_of_finiteIndex {N : Subgroup G} (h : IsTopFG N) [N.FiniteIndex] :
    IsTopFG (⊤ : Subgroup G) := by
  obtain ⟨s, hs, hsN⟩ := h
  let T : Set G := Set.range fun q : G ⧸ N => q.out
  refine ⟨s ∪ T, hs.union (Set.finite_range _), eq_top_iff.2 fun x _ => ?_⟩
  set C := (Subgroup.closure (s ∪ T)).topologicalClosure
  have hN : N ≤ C := hsN ▸ Subgroup.topologicalClosure_mono
    (Subgroup.closure_mono Set.subset_union_left)
  have hT : ∀ t ∈ T, t ∈ C := fun t ht =>
    Subgroup.le_topologicalClosure _ (Subgroup.subset_closure (Set.subset_union_right ht))
  set q : G ⧸ N := (x : G ⧸ N)
  have hq : (q.out)⁻¹ * x ∈ N := QuotientGroup.eq.1 (QuotientGroup.out_eq' q)
  have e : x = q.out * ((q.out)⁻¹ * x) := by group
  rw [e]
  exact C.mul_mem (hT _ ⟨q, rfl⟩) (hN hq)

/-- **Open intersections**: in a compact group, if `M` is closed, `U` open and `M ⊓ U`
topologically finitely generated, then so is `M`. -/
lemma IsTopFG.of_inf_open [CompactSpace G] {M U : Subgroup G} (hM : IsClosed (M : Set G))
    (hU : IsOpen (U : Set G)) (h : IsTopFG (M ⊓ U)) : IsTopFG M := by
  classical
  obtain ⟨s, hs, hsN⟩ := h
  haveI : Finite (G ⧸ U) := Subgroup.quotient_finite_of_isOpen U hU
  let r : G ⧸ U → G := fun q => if hq : ∃ m ∈ M, (m : G ⧸ U) = q then hq.choose else 1
  have hrM : ∀ q, r q ∈ M := fun q => by
    by_cases hq : ∃ m ∈ M, (m : G ⧸ U) = q
    · simp only [r, dif_pos hq]
      exact hq.choose_spec.1
    · simp only [r, dif_neg hq]
      exact M.one_mem
  have hr : ∀ m ∈ M, ((r (m : G ⧸ U) : G) : G ⧸ U) = (m : G ⧸ U) := fun m hm => by
    have hq : ∃ m' ∈ M, (m' : G ⧸ U) = (m : G ⧸ U) := ⟨m, hm, rfl⟩
    simp only [r, dif_pos hq]
    exact hq.choose_spec.2
  let T : Set G := Set.range r
  refine ⟨s ∪ T, hs.union (Set.finite_range _), le_antisymm ?_ fun x hx => ?_⟩
  · refine Subgroup.topologicalClosure_minimal _ ((Subgroup.closure_le _).2 ?_) hM
    rintro y (hy | ⟨q, rfl⟩)
    · exact (hsN ▸ Subgroup.le_topologicalClosure _ (Subgroup.subset_closure hy) :
        y ∈ M ⊓ U).1
    · exact hrM q
  set C := (Subgroup.closure (s ∪ T)).topologicalClosure
  have hN : M ⊓ U ≤ C := hsN ▸ Subgroup.topologicalClosure_mono
    (Subgroup.closure_mono Set.subset_union_left)
  set t := r (x : G ⧸ U)
  have hq : t⁻¹ * x ∈ U := QuotientGroup.eq.1 (hr x hx)
  have hqM : t⁻¹ * x ∈ M := M.mul_mem (M.inv_mem (hrM _)) hx
  have ht : t ∈ C := Subgroup.le_topologicalClosure _
    (Subgroup.subset_closure (Set.subset_union_right ⟨_, rfl⟩))
  have e : x = t * (t⁻¹ * x) := by group
  rw [e]
  exact C.mul_mem ht (hN ⟨hqM, hq⟩)

/-- **[AbsTopI] Prop. 1.3 (ii), necessity** (l.539–549): in a very elastic group, every
topologically finitely generated closed normal subgroup of an open subgroup is trivial. -/
lemma IsVeryElastic.eq_bot (hG : IsVeryElastic G) {H N : Subgroup G} (hH : IsOpen (H : Set G))
    (hNH : N ≤ H) (hn : (N.subgroupOf H).Normal) (hN : IsTopFG N) : N = ⊥ := by
  rcases hG.1 H N hH hNH hn hN.isClosed hN with h | h
  · exact h
  · exact (hG.2 hN.top_of_finiteIndex).elim

/-- **Strict semi-absoluteness from very elasticity** ([AbsTopI] Prop. 2.5 (ii), l.1046–1060, and
Cor. 2.8 (ii), l.1348–1379, for automorphisms): let `f : Q ↪ P` be an open embedding of compact
groups and `pr : P ↠ G` a continuous surjection onto a very elastic Hausdorff group whose kernel
is topologically finitely generated. Then every continuous automorphism `α` of `Q` maps
`ker(pr ∘ f)` into itself: the image of `α(ker(pr ∘ f))` in `G` is a topologically finitely
generated closed normal subgroup of the open subgroup `pr(f(Q))`, hence trivial. -/
theorem map_eq_one_of_isVeryElastic {Q P : Type*} [Group Q] [TopologicalSpace Q]
    [IsTopologicalGroup Q] [CompactSpace Q] [Group P] [TopologicalSpace P] [IsTopologicalGroup P]
    [CompactSpace P] [T2Space G] (f : Q →* P) (hf : IsOpenEmbedding f) (pr : P →* G)
    (hpr : Continuous pr) (hsurj : Function.Surjective pr) (hΔ : IsTopFG pr.ker)
    (hG : IsVeryElastic G) (α : Q →* Q) (hα : Continuous α) (hαs : Function.Surjective α)
    (x : Q) (hx : pr (f x) = 1) : pr (f (α x)) = 1 := by
  set φ : Q →* G := pr.comp f
  have hφ : Continuous φ := hpr.comp hf.continuous
  have hfr : IsOpen ((f.range : Subgroup P) : Set P) := by
    rw [MonoidHom.coe_range]
    exact hf.isOpen_range
  have hfrc : IsClosed ((f.range : Subgroup P) : Set P) := Subgroup.isClosed_of_isOpen _ hfr
  -- `ker φ` is topologically finitely generated
  have hmap : φ.ker.map f = pr.ker ⊓ f.range := by
    ext y
    constructor
    · rintro ⟨q, hq, rfl⟩
      exact ⟨hq, q, rfl⟩
    · rintro ⟨hy, q, rfl⟩
      exact ⟨q, hy, rfl⟩
  have hΔQ : IsTopFG φ.ker := by
    refine IsTopFG.of_map f ⟨hf.isEmbedding, ?_⟩ ?_
    · rw [← MonoidHom.coe_range]
      exact hfrc
    · rw [hmap]
      exact hΔ.inf_open hfr
  have hkc : IsClosed (φ.ker : Set Q) := hΔQ.isClosed
  -- its image under `φ ∘ α`
  set ψ : Q →* G := φ.comp α
  have hψ : Continuous ψ := hφ.comp hα
  set N := φ.ker.map ψ
  have hNc : IsClosed (N : Set G) := by
    rw [Subgroup.coe_map]
    exact (hkc.isCompact.image hψ).isClosed
  have hN : IsTopFG N := hΔQ.map ψ hψ hNc
  -- the open subgroup `φ(Q)`
  set H := φ.range
  have hNH : N ≤ H := by
    rintro _ ⟨q, -, rfl⟩
    exact ⟨α q, rfl⟩
  have hn : (N.subgroupOf H).Normal := by
    refine ⟨fun n hn h => ?_⟩
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    obtain ⟨d, hd, hdn⟩ := hn
    obtain ⟨g, hg⟩ := h
    obtain ⟨q, rfl⟩ := hg
    obtain ⟨q', rfl⟩ := hαs q
    have hc : q' * d * q'⁻¹ ∈ φ.ker := φ.normal_ker.conj_mem d hd q'
    refine ⟨q' * d * q'⁻¹, hc, ?_⟩
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, map_mul, map_inv, ← hdn]
    rfl
  have hHc : IsClosed (H : Set G) := by
    rw [MonoidHom.coe_range]
    exact (isCompact_range hφ).isClosed
  haveI : Finite (P ⧸ f.range) := Subgroup.quotient_finite_of_isOpen _ hfr
  haveI : f.range.FiniteIndex := Subgroup.finiteIndex_of_finite_quotient
  have hHi : H.index ≠ 0 := by
    have e : H = f.range.map pr := MonoidHom.range_comp pr f
    rw [e]
    intro h0
    have := Subgroup.index_map_dvd f.range hsurj
    rw [h0, zero_dvd_iff] at this
    exact Subgroup.FiniteIndex.index_ne_zero this
  haveI : H.FiniteIndex := ⟨hHi⟩
  have hHo : IsOpen (H : Set G) := Subgroup.isOpen_of_isClosed_of_finiteIndex H hHc
  have hbot := hG.eq_bot hHo hNH hn hN
  have hmem : ψ x ∈ N := ⟨x, hx, rfl⟩
  rw [hbot] at hmem
  exact (Subgroup.mem_bot.1 hmem)

end Elastic

end HodgeTheater

end Iut
