import Iut.Wall.Ind3
import Iut.MainTheorem

/-!
# The η-algorithm as an interface, and the wall hypothesis (9-1) (the wall, Milestone 1c)

The LANA interim report (July 2026, [LANA]) isolates the step of IUT III from Theorem 3.11 to
Corollary 3.12 that LANA could not reconstruct as the equation **(9-1)** ([LANA], §9.2,
pp. 45–46):

> there exists some suitable `S` such that `η_q = η^anab_S`,

where `η_q, η^anab_S : R_val → R_ss` are two isomorphisms of pointed real lines, for the
`q`-pilot BPS of a Hodge theater (§4.2(c)): `η_q` sends the pilot to the class of
`{q_v O_v}` (computed in the native ring structure of the `q`-side), and `η^anab_S` sends it to
the class of `M = 1·S`, "`LGP·S`", the output of the anabelian **η-algorithm** ([LANA], §9.1,
Steps 1–9; the Θ-value-action part of IUT III, Theorem 3.11, [LANA], §6.2) run on the input
BPS after a choice of an isomorphism `ι` of it with the Θ-pilot BPS of a Hodge theater
(Step 1, which introduces (Ind1), (Ind2)), and a choice of `S ⊆ VC(I)` ((Ind3)). [LANA], p. 44:
"if the problem described in the 'main goal' … is solved, then Corollary 3.12 (and thus …
abc) will follow".

## The interface `EtaAlg D`

Hodge theaters are opaque (`EtaAlg.Side`); each carries an étale-unit BPS (`EtaAlg.etUnit`,
[LANA], §4.2(c)), hence a `q`-pilot BPS (`EtaAlg.qBPS`, value-group portion `qVal`) and a
Θ-pilot BPS (`EtaAlg.thetaBPS`, value-group portion `thetaVal`, [LANA], §7.1(a)). The
algorithm is a function `out ι S` (the region `LGP·S` read in the container; [LANA], §9.1(h),
(i)), for a choice `ι : B ≅ thetaBPS h` and an (Ind3)-choice `S`, subject to:

* **(T1) (Ind1), (Ind2) act on the choice of `S`** (`ind12_acts_on_S`; IUT III,
  Theorem 3.11(i); [LANA], §6.2(b), §10.4: "the indeterminacies create ambiguities in the
  choice of the set `S`"): precomposing `ι` with an automorphism of the étale-unit portion of
  the input changes the output by a permutation of the (Ind3)-choices. So the *set* of
  possible outputs depends only on the (Ind1)/(Ind2)-orbit of `ι`.
* **(T2) dependence only on the étale-unit portion** (`etUnitOnly`; [LANA], Remark 6.2.2: the
  input of the "raw" algorithm "appears to consist solely of the étale-unit BPS, and the
  value-group part does not seem to affect the algorithm's result"). Kept as a separate field
  since [LANA] records that (SHE) suggests otherwise; nothing below uses it except the checks.
* **(T3) realisation** (`realisation`; IUT III, Theorem 3.11(ii) with the log-Kummer
  correspondence, Corollary 3.12; roadmap package P21): every output is an adelic region of the
  concrete container (`IsAdelic`) lying in the holomorphic hull of a **single** (Ind1)-image of
  the concrete theta-pilot region (`InHullOfImage`). [LANA], §6.2(i), puts the possible images
  `LGP·U` in the theta-pilot region itself (`InImage`); asking only for the hull is weaker
  (`InImage.inHullOfImage`), so `EtaAlg` admits more algorithms and `variant_of_wall` is
  stronger. The single image (rather than the union over (Ind1)) is what makes (9-1) yield
  the variant (IUT IV's reading) and not only the literal reading of Corollary 3.12
  (roadmap v2, §2(b)).
* the existence of a Hodge theater (`side_nonempty`; IUT I, Theorem A). Without it the wall
  would be vacuous.

`η^anab_{ι,S}` is then *defined* as in [LANA], §9.2: the pointed map `R_val → R_ss ≅ ℝ`
sending the pilot to the class (log-volume) of `out ι S` (`EtaAlg.etaAnab`).

## The wall hypothesis

`Wall A`: for every Θ-link from the Θ-pilot BPS of `h₁` to the `q`-pilot BPS of `h₂` ([LANA],
§7.1(b)), there are a choice `ι` (for the input `q`-pilot BPS of `h₂` and the Hodge theater
`h₁` of the Θ-link's domain) and an (Ind3)-choice `S` with `η^anab_{ι,S} = η_q` — (9-1), with
the "orbit generated by the indeterminacies" of [LANA], §9.3, realized by the existential over
`ι` and `S`. It is a `Prop`, a hypothesis; it is never assumed.

By [LANA], Remark 8.2.1 (`BPS.connected`), the Θ-link data carry no information: `Wall A` is
equivalent to the same statement for all pairs of Hodge theaters (`wall_iff_forall`).

## Results

* `variant_of_wall : Wall A → Corollary312Variant (concreteVariantData D)` and
  `literal_of_wall`; for families, `cor312VariantHolds_of_wall` and `classicalABC_of_wall`.
* `etaAnab_eq_etaQ_iff`: (9-1) for `(ι, S)` holds iff `log-vol(out ι S) = −|log(q)|`: an
  equation between two maps of pointed lines *is* an equation of real numbers.

The faithfulness checks (shadow lemma, trivial instance, identified copies) are in
`Iut/Wall/Checks.lean` and `Iut/Wall/IdentifiedCopies.lean`.
-/

namespace Iut

namespace Wall

open NumberField

/-- The index set of the places of the BPSs of `D` (the places of `F`). -/
abbrev Pl (D : InitialThetaData.{0}) : Type := FinitePlace D.F ⊕ InfinitePlace D.F

variable (D : InitialThetaData.{0})

/-- **The η-algorithm of [LANA], §9.1, as an interface** (see the module docstring for the
fields (T1)–(T3) and their sources). -/
structure EtaAlg where
  /-- The model étale-unit prime-strip `{G_v ↷ O^{×µ}_v}_v` (opaque). -/
  model : Pl D → GMData
  /-- The Hodge theaters (opaque; IUT I, `Θ^{±ell}NF`-Hodge theaters). -/
  Side : Type
  /-- There is a Hodge theater (IUT I). -/
  side_nonempty : Nonempty Side
  /-- The étale-unit BPS `B(H)` of a Hodge theater ([LANA], §4.2(c)). -/
  etUnit : Side → EtUnitBPS model
  /-- **The output** `LGP·S` of the η-algorithm, read in the concrete container ([LANA], §9.1,
  Steps 8–9; §6.2(i)), for a choice `ι` of an isomorphism of the input BPS `B` with the
  Θ-pilot BPS of a Hodge theater `h` (Step 1) and an (Ind3)-choice `S`. -/
  out : ∀ {B : BPS model D.bpsDegrees.bad} {h : Side},
    BPS.Iso B ⟨etUnit h, D.thetaValD⟩ → Ind3 D → Region D
  /-- **(T1)** (Ind1), (Ind2) — automorphisms of the étale-unit portion of the input — act on
  the (Ind3)-choices (IUT III, Theorem 3.11(i); [LANA], §10.4). -/
  ind12_acts_on_S : ∀ {B : BPS model D.bpsDegrees.bad} {h : Side} (α : EtUnitIso B.et B.et)
    (ι : BPS.Iso B ⟨etUnit h, D.thetaValD⟩), ∃ τ : Ind3 D ≃ Ind3 D, ∀ S,
      out ((BPS.Iso.mk α (ValBPS.Iso.refl _)).trans ι) S = out ι (τ S)
  /-- **(T2)** the output depends on the input only through its étale-unit portion and the
  étale-unit part of the choice ([LANA], Remark 6.2.2). -/
  etUnitOnly : ∃ f : ∀ {E : EtUnitBPS model} {h : Side}, EtUnitIso E (etUnit h) → Ind3 D →
      Region D, ∀ {B : BPS model D.bpsDegrees.bad} {h : Side}
      (ι : BPS.Iso B ⟨etUnit h, D.thetaValD⟩) (S : Ind3 D), out ι S = f ι.et S
  /-- **(T3) realisation**: every output is an adelic region in the holomorphic hull of a
  single (Ind1)-image of the concrete theta-pilot region (IUT III, Theorem 3.11(ii),
  Corollary 3.12; roadmap package P21). -/
  realisation : ∀ {B : BPS model D.bpsDegrees.bad} {h : Side}
    (ι : BPS.Iso B ⟨etUnit h, D.thetaValD⟩) (S : Ind3 D),
      IsAdelic D (out ι S) ∧ InHullOfImage D (out ι S)

namespace EtaAlg

variable {D} (A : EtaAlg D)

/-- The BPSs of `A`. -/
abbrev BPSA := BPS A.model D.bpsDegrees.bad

/-- **The `q`-pilot BPS** of a Hodge theater ([LANA], §4.2(c)). -/
noncomputable def qBPS (h : A.Side) : A.BPSA := ⟨A.etUnit h, qVal D.bpsDegrees⟩

/-- **The Θ-pilot BPS** of a Hodge theater ([LANA], §7.1(a)). -/
noncomputable def thetaBPS (h : A.Side) : A.BPSA := ⟨A.etUnit h, D.thetaValD⟩

/-- The choices of Step 1 of the η-algorithm: isomorphisms of the input with a Θ-pilot BPS. -/
abbrev Choice (B : A.BPSA) (h : A.Side) := BPS.Iso B (A.thetaBPS h)

/-- **`η^anab_{ι,S} : R_val → R_ss ≅ ℝ`** ([LANA], §9.2): the pointed map sending the pilot of
the input to the class (log-volume) of `M = 1·S`, the output `out ι S`. -/
noncomputable def etaAnab {B : A.BPSA} {h : A.Side} (ι : A.Choice B h) (S : Ind3 D) :
    B.val.C →ₗ[ℝ] ℝ :=
  B.val.eta (logVol D (A.out ι S))

/-- **(9-1) for `(ι, S)` is an equation of real numbers**: `η^anab_{ι,S} = η_q` iff the output
has log-volume `−|log(q)|`. -/
theorem etaAnab_eq_etaQ_iff {h₁ h₂ : A.Side} (ι : A.Choice (A.qBPS h₂) h₁) (S : Ind3 D) :
    A.etaAnab ι S = etaQ D ↔ logVol D (A.out ι S) = (concreteVariantData D).qPilot.lhs :=
  ValBPS.eta_eq_eta_iff _ _ _

/-- The Θ-pilot and `q`-pilot BPSs of any two Hodge theaters are isomorphic ([LANA],
Lemma 4.1.7): Θ-links exist. -/
theorem nonempty_thetaLink (h₁ h₂ : A.Side) : Nonempty (BPS.Iso (A.thetaBPS h₁) (A.qBPS h₂)) :=
  (BPS.nonempty_iso_iff _ _).mpr (PF_thetaVal _ D.wallS_ne_zero)

/-- Step 1 of the η-algorithm is always possible for a `q`-pilot input. -/
theorem nonempty_choice (h₁ h₂ : A.Side) : Nonempty (A.Choice (A.qBPS h₂) h₁) :=
  (BPS.nonempty_iso_iff _ _).mpr (PF_thetaVal _ D.wallS_ne_zero).symm

end EtaAlg

end Wall

open Wall in
/-- **The wall hypothesis (9-1)** ([LANA], §9.2, p. 46; IUT III, proof of Corollary 3.12,
Step (xi)): for every Θ-link `gl` from the Θ-pilot BPS of `h₁` to the `q`-pilot BPS of `h₂`,
the η-algorithm, applied to the `q`-pilot BPS of `h₂` through the Θ-pilot BPS of `h₁`, admits a
choice `ι` and an (Ind3)-choice `S` with `η^anab_{ι,S} = η_q`. A hypothesis, never assumed. -/
def Wall (D : InitialThetaData.{0}) (A : Wall.EtaAlg D) : Prop :=
  ∀ (h₁ h₂ : A.Side) (_gl : BPS.Iso (A.thetaBPS h₁) (A.qBPS h₂)),
    ∃ (ι : A.Choice (A.qBPS h₂) h₁) (S : Ind3 D), A.etaAnab ι S = etaQ D

namespace Wall

variable {D}

/-- **The Θ-link data in `Wall` are vacuous** ([LANA], Remark 8.2.1): Θ-links always exist
(`EtaAlg.nonempty_thetaLink`). -/
theorem wall_iff_forall (A : EtaAlg D) :
    Wall D A ↔ ∀ h₁ h₂ : A.Side, ∃ (ι : A.Choice (A.qBPS h₂) h₁) (S : Ind3 D),
      A.etaAnab ι S = etaQ D :=
  ⟨fun h h₁ h₂ => h h₁ h₂ (A.nonempty_thetaLink h₁ h₂).some, fun h h₁ h₂ _ => h h₁ h₂⟩

/-- **The wall gives an output of log-volume `−|log(q)|`.** -/
theorem exists_out_of_wall (A : EtaAlg D) (hW : Wall D A) :
    ∃ U : Region D, IsAdelic D U ∧ InHullOfImage D U ∧
      logVol D U = (concreteVariantData D).qPilot.lhs := by
  obtain ⟨h⟩ := A.side_nonempty
  obtain ⟨ι, S, hη⟩ := (wall_iff_forall A).mp hW h h
  exact ⟨A.out ι S, (A.realisation ι S).1, (A.realisation ι S).2,
    (A.etaAnab_eq_etaQ_iff ι S).mp hη⟩

/-- **The wall implies the Corollary 3.12 variant** (IUT IV's reading of (Ind1)): equal η's give
an output of log-volume `−|log(q)|`; the realisation (T3) puts it in the hull of a single
(Ind1)-image of the theta-pilot region, whose log-volume is `−|log(Θ)|` by the
(Ind1)-invariance (`Iut/Concrete/Ind1Invariance.lean`). -/
theorem variant_of_wall (A : EtaAlg D) (hW : Wall D A) :
    Corollary312Variant (concreteVariantData D) := by
  obtain ⟨U, hU, hI, hvol⟩ := exists_out_of_wall A hW
  exact (corollary312Variant_iff _).mpr (hvol ▸ logVol_le_rhs D hU hI)

/-- **The wall implies the literal reading of Corollary 3.12.** -/
theorem literal_of_wall (A : EtaAlg D) (hW : Wall D A) :
    Corollary312Variant (concreteVariantDataLit D) :=
  (variant_of_wall A hW).trans D.rhs_le_rhsLit

/-- **The wall for all initial Θ-data implies `Cor312VariantHolds`.** -/
theorem cor312VariantHolds_of_wall (A : ∀ D : InitialThetaData.{0}, EtaAlg D)
    (hW : ∀ D, Wall D (A D)) : Cor312VariantHolds :=
  fun D => variant_of_wall (A D) (hW D)

/-- **The wall for all initial Θ-data implies `Cor312LiteralHolds`.** -/
theorem cor312LiteralHolds_of_wall (A : ∀ D : InitialThetaData.{0}, EtaAlg D)
    (hW : ∀ D, Wall D (A D)) : Cor312LiteralHolds :=
  fun D => literal_of_wall (A D) (hW D)

/-- **The wall for all initial Θ-data implies the ABC conjecture**, through the main theorem
`classicalABC_of_variant`. -/
theorem classicalABC_of_wall (A : ∀ D : InitialThetaData.{0}, EtaAlg D)
    (hW : ∀ D, Wall D (A D)) : ClassicalABC :=
  classicalABC_of_variant (cor312VariantHolds_of_wall A hW)

end Wall

end Iut
