import Iut.Frobenioid.Tempered.ThetaEnv
import Iut.EtaleTheta.Env.CycRigidity

/-!
# Frobenioid-theoretic mono-theta environments ([EtTh], Lemma 5.8, Lemma 5.9, Proposition 5.5)

Continuation of `Iut/Frobenioid/Tempered/ThetaEnv.lean` (same abstract inputs: a model Frobenioid
`C = Model Φ B divB`, base-equivalent pre-steps `s⊓ = s, s⊔ = t : X → Y` forming an `N`-th root of
a right fraction-pair, a section `σ` from a base-Frobenius pair, `π : PX → Aut_C(X)/O^×(X)` standing
for the outer homomorphism `Π^tp_X → Aut_D(A^bs_N)`, and `PYdd ≤ PY ≤ PX` standing for
`Π^tp_Ÿ ⊆ Π^tp_Y ⊆ Π^tp_X`).

[EtTh], Lemma 5.9(iv) equips `E^Π_N` with "the evident topology" and with the mono-theta
environment structure determined by "the subgroup of `Out(E^Π_N)` generated by the natural outer
actions of `l·ℤ` [Lemma 5.9(iii)], `K^×` [Lemma 5.8] on `E_N`, together with the `μ_N`-conjugacy
classes of subgroups given by the images of `s⊔-Π_N`". Here:

* **topology**: `Aut_C(Y)` carries a discrete topology (an instance hypothesis
  `[DiscreteTopology (Aut Y)]`), `E^Π_N ⊆ Aut_C(Y) × PX` the subspace topology;
* **the outer action of `K^×`** ([EtTh], Lemma 5.8): the image of `K^×` in `O^×(B^birat_N)` is an
  abstract subgroup `Kcst ⊆ B(Y_D)` of rational functions fixed by the base automorphisms
  (`hKfix`); `constRoots` is `(K^×)^{1/N} = {c | N·c ∈ Kcst}`, and `twistE c` is conjugation by
  the birational unit `c` (`(1, g, 0, u) ↦ (1, g, 0, u + g^*c − c)`), an automorphism of `E^Π_N`
  (needing `Φ^gp(Y_D)` torsion-free, `htf`); for `c ∈ O^×(Y)` it **is** conjugation by the unit `c`
  (`Model.conj_unitAut_mem_thetaE`: **Lemma 5.8**, "`(O_K^×)^{1/N}` normalises `E_N`");
* **the outer action of `PX/PY`** ([EtTh], Lemma 5.9(iii)): conjugation by the extension
  `E^Π_X = thetaEPi ⊤` of all of `PX` (`conjE`);
* `Model.thetaD`: the subgroup generated by these and `Model.frobEnv : MonoThetaEnv`.

The comparison with MR15's model environment `Env.modelEnv` (for any augmentation `aug : PX → G`,
action `ψ` and Kummer cocycles `Kum` such that conjugation by `s⊓-gp` on `μ_N(Y)` is `ψ ∘ aug`
and the Kummer cocycles of `Kum` are those of `(K^×)^{1/N}`), Lemma 5.9(v) and Proposition 5.5
follow below.
-/

namespace Iut

namespace Frobenioid

open CategoryTheory
open Iut.EtaleTheta Iut.EtaleTheta.Env SemidirectProduct

universe w v u

noncomputable section

namespace Model

variable {D : Type u} [Category.{v} D]
variable {Φ : DivMonoid.{w} D} {B : GrpOn.{w} D} {divB : DivHom B Φ.toGrpOn}

/-! ### Units of `Y` as automorphisms -/

section Units

variable {Y : Model Φ B divB}

lemma unitAut_hom (d : B.obj Y.base) (hd : divB.app _ d = 0) :
    (unitAut Y d hd).hom = unitHom Y d hd := rfl

lemma unitAut_mem_unitsAut (d : B.obj Y.base) (hd : divB.app _ d = 0) :
    unitAut Y d hd ∈ unitsAut Y := rfl

lemma unitAut_congr {d e : B.obj Y.base} (h : d = e) (hd : divB.app _ d = 0)
    (he : divB.app _ e = 0) : unitAut Y d hd = unitAut Y e he := by
  subst h
  rfl

lemma unitAut_mul (d e : B.obj Y.base) (hd : divB.app _ d = 0) (he : divB.app _ e = 0) :
    unitAut Y d hd * unitAut Y e he =
      unitAut Y (d + e) (by rw [map_add, hd, he, add_zero]) := by
  ext1
  change unitHom Y e he ≫ unitHom Y d hd = _
  rw [unitHom_comp, unitAut_hom]
  ext <;> simp [unitHom, add_comm]

lemma unitAut_zero (h : divB.app _ (0 : B.obj Y.base) = 0) : unitAut Y 0 h = 1 := by
  ext1
  change unitHom Y 0 h = 𝟙 Y
  ext <;> simp [unitHom]

lemma unitAut_pow (d : B.obj Y.base) (hd : divB.app _ d = 0) (n : ℕ) :
    unitAut Y d hd ^ n = unitAut Y (n • d) (by rw [map_nsmul, hd, smul_zero]) := by
  ext1
  exact unitIso_pow Y d hd n

lemma unitAut_mem_muN {d : B.obj Y.base} (hd : divB.app _ d = 0) {N : ℕ} (hN : N • d = 0) :
    unitAut Y d hd ∈ muN Y N :=
  ⟨rfl, by rw [unitAut_pow]; simp only [hN]; exact unitAut_zero _⟩

lemma mul_unitAut_base (a : Aut Y) (d : B.obj Y.base) (hd : divB.app _ d = 0) :
    (a * unitAut Y d hd).hom.base = a.hom.base := by
  change ((unitAut Y d hd).hom ≫ a.hom).base = _
  rw [comp_base]
  exact Category.id_comp _

/-- **Conjugating a unit**: `a · (1, id, 0, d) · a⁻¹ = (1, id, 0, (Base a⁻¹)^* d)`. -/
lemma conj_unitAut (a : Aut Y) (d : B.obj Y.base) (hd : divB.app _ d = 0) :
    a * unitAut Y d hd * a⁻¹ = unitAut Y (B.pb a.inv.base d)
      (by rw [divB.natural, hd, map_zero]) := by
  have hdeg : a.inv.deg = 1 := deg_of_iso a.symm
  have hdiv : a.inv.div = 0 := div_of_iso a.symm
  have h0 := congrArg Hom.u a.inv_hom_id
  simp only [comp_u, id_u, deg_of_iso a, PNat.one_coe, one_smul] at h0
  ext1
  change a.inv ≫ unitHom Y d hd ≫ a.hom = _
  rw [unitAut_hom]
  ext
  · simp [unitHom, deg_of_iso a, hdeg]
  · simp [unitHom, inv_base_of_iso]
  · simp [unitHom, div_of_iso a, hdiv]
  · simp only [comp_u, comp_deg, unitHom, mk1_u, mk1_deg, mk1_base, GrpOn.pb_id',
      deg_of_iso a, mul_one, PNat.one_coe, one_smul, map_add]
    rw [← sub_eq_zero, ← h0]
    abel

/-- The unit `g^*c − c` of the conjugation by a birational unit `c` (a rational function whose
divisor is fixed by `g = Base(a)`). -/
def twUnit (a : Aut Y) (c : B.obj Y.base) (h : Φ.pb a.hom.base (divB.app _ c) = divB.app _ c) :
    Aut Y :=
  unitAut Y (B.pb a.hom.base c - c) (by rw [map_sub, divB.natural, h, sub_self])

lemma twUnit_congr {a b : Aut Y} (hab : a.hom.base = b.hom.base) (c : B.obj Y.base)
    (ha : Φ.pb a.hom.base (divB.app _ c) = divB.app _ c)
    (hb : Φ.pb b.hom.base (divB.app _ c) = divB.app _ c) : twUnit a c ha = twUnit b c hb :=
  unitAut_congr (by rw [hab]) _ _

lemma twUnit_eq_one {a : Aut Y} (ha : a.hom.base = 𝟙 _) (c : B.obj Y.base)
    (h : Φ.pb a.hom.base (divB.app _ c) = divB.app _ c) : twUnit a c h = 1 := by
  unfold twUnit
  rw [← unitAut_zero (Y := Y) (by rw [map_zero])]
  exact unitAut_congr (by rw [ha, GrpOn.pb_id', sub_self]) _ _

/-- **The cocycle relation of the twist**: `tw(ab) = b⁻¹ · tw(a) · b · tw(b)`. -/
lemma twUnit_mul (a b : Aut Y) (c : B.obj Y.base)
    (ha : Φ.pb a.hom.base (divB.app _ c) = divB.app _ c)
    (hb : Φ.pb b.hom.base (divB.app _ c) = divB.app _ c)
    (hab : Φ.pb (a * b).hom.base (divB.app _ c) = divB.app _ c) :
    twUnit (a * b) c hab = b⁻¹ * twUnit a c ha * b * twUnit b c hb := by
  have e := conj_unitAut b⁻¹ (B.pb a.hom.base c - c)
    (by rw [map_sub, divB.natural, ha, sub_self])
  rw [inv_inv] at e
  rw [twUnit, twUnit, twUnit, e, unitAut_mul]
  refine unitAut_congr ?_ _ _
  change B.pb (b.hom ≫ a.hom).base c - c = B.pb b.hom.base (B.pb a.hom.base c - c) + _
  rw [comp_base, GrpOn.pb_comp', map_sub]
  abel

/-- `μ_N(Y)` is commutative (units of a model Frobenioid commute). -/
instance instCommGroupMuN (Y : Model Φ B divB) (N : ℕ) : CommGroup (muN Y N) :=
  { (inferInstance : Group (muN Y N)) with
    mul_comm := fun a b => Subtype.ext (units_comm a.2.1 b.2.1) }

end Units

/-! ### `K^×`-twists and conjugation by `E^Π_X` -/

section Theta

variable {X Y : Model Φ B divB} {s t : X ⟶ Y} [IsIso s.base] [IsIso t.base]
  (hs : IsPreStep (toElem Φ B divB) s)
  (ht : IsPreStep (toElem Φ B divB) t) (hb : s.base = t.base)
  {σ : Aut X ⧸ unitsAut X →* Aut X}
  (hsec : ∀ q, (QuotientGroup.mk (σ q) : Aut X ⧸ unitsAut X) = q)
  {PX : Type (max v w)} [Group PX] (π : PX →* Aut X ⧸ unitsAut X)
  (hsfix : ∀ q, Φ.pb (σ q).hom.base s.div = s.div) (PY : Subgroup PX) (N : ℕ)

lemma thetaE_mono {PY PY' : Subgroup PX} (h : PY ≤ PY') :
    thetaE hs π hsfix PY N ≤ thetaE hs π hsfix PY' N := by
  rintro _ ⟨m, hm, p, hp, rfl⟩
  exact ⟨m, hm, p, h hp, rfl⟩

lemma thetaEPi_le_top : thetaEPi hs π hsfix PY N ≤ thetaEPi hs π hsfix ⊤ N :=
  fun _ hx => ⟨trivial, thetaE_mono hs π hsfix N le_top hx.2.1, hx.2.2⟩

lemma base_eq_of_mem_thetaEPi {PY : Subgroup PX} {x : Aut Y × PX}
    (hx : x ∈ thetaEPi hs π hsfix PY N) : x.1.hom.base = (sgp hs π hsfix x.2).hom.base :=
  hx.2.2

/-! #### `(K^×)^{1/N}` and the twists -/

variable (Kcst : AddSubgroup (B.obj Y.base))

/-- **`(K^×)^{1/N}`** ([EtTh], Lemma 5.8): the rational functions `c ∈ B(Y_D)` (birational units
of `Y`) with `N·c` in the image `Kcst` of `K^×`. -/
def constRoots : AddSubgroup (B.obj Y.base) where
  carrier := {c | N • c ∈ Kcst}
  add_mem' {a b} ha hb := by
    change N • (a + b) ∈ Kcst
    rw [smul_add]
    exact Kcst.add_mem ha hb
  zero_mem' := by
    change N • (0 : B.obj Y.base) ∈ Kcst
    rw [smul_zero]
    exact Kcst.zero_mem
  neg_mem' {a} ha := by
    change N • (-a) ∈ Kcst
    rw [smul_neg]
    exact Kcst.neg_mem ha

lemma mem_constRoots {c : B.obj Y.base} : c ∈ constRoots N Kcst ↔ N • c ∈ Kcst := Iff.rfl

variable (hKfix : ∀ k ∈ Kcst, ∀ p : PX, B.pb (sgp hs π hsfix p).hom.base k = k)
  (htf : ∀ a : Φ.obj Y.base, N • a = 0 → a = 0)

include hKfix htf in
/-- The divisor of `c ∈ (K^×)^{1/N}` is fixed by the bases of `s⊓-gp(PX)` (`Φ^gp` torsion-free). -/
lemma divB_fix_of_mem_constRoots {c : B.obj Y.base} (hc : c ∈ constRoots N Kcst) (p : PX) :
    Φ.pb (sgp hs π hsfix p).hom.base (divB.app _ c) = divB.app _ c := by
  refine sub_eq_zero.1 (htf _ ?_)
  rw [smul_sub, ← map_nsmul, ← map_nsmul, ← divB.natural, hKfix _ hc p, sub_self]

include hKfix in
lemma nsmul_twist_eq_zero {c : B.obj Y.base} (hc : c ∈ constRoots N Kcst) (p : PX) :
    N • (B.pb (sgp hs π hsfix p).hom.base c - c) = 0 := by
  rw [smul_sub, ← map_nsmul, hKfix _ hc p, sub_self]

include hKfix htf in
lemma divB_fix_of_mem {PY : Subgroup PX} {c : B.obj Y.base} (hc : c ∈ constRoots N Kcst)
    {x : Aut Y × PX} (hx : x ∈ thetaEPi hs π hsfix PY N) :
    Φ.pb x.1.hom.base (divB.app _ c) = divB.app _ c := by
  rw [base_eq_of_mem_thetaEPi hs π hsfix N hx]
  exact divB_fix_of_mem_constRoots hs π hsfix N Kcst hKfix htf hc x.2

include hKfix htf in
lemma twUnit_mem_muN {PY : Subgroup PX} {c : B.obj Y.base} (hc : c ∈ constRoots N Kcst)
    {x : Aut Y × PX} (hx : x ∈ thetaEPi hs π hsfix PY N) :
    twUnit x.1 c (divB_fix_of_mem hs π hsfix N Kcst hKfix htf hc hx) ∈ muN Y N := by
  refine unitAut_mem_muN _ ?_
  rw [base_eq_of_mem_thetaEPi hs π hsfix N hx]
  exact nsmul_twist_eq_zero hs π hsfix N Kcst hKfix hc x.2

/-- The twist of `x ∈ E^Π_N` by `c ∈ (K^×)^{1/N}` (conjugation by the birational unit `c`). -/
def twistEFun {c : B.obj Y.base} (hc : c ∈ constRoots N Kcst) (x : thetaEPi hs π hsfix PY N) :
    thetaEPi hs π hsfix PY N :=
  ⟨((x : Aut Y × PX).1 * twUnit (x : Aut Y × PX).1 c
      (divB_fix_of_mem hs π hsfix N Kcst hKfix htf hc x.2), (x : Aut Y × PX).2),
    x.2.1, (thetaE hs π hsfix PY N).mul_mem x.2.2.1
      (muN_le_thetaE hs π hsfix PY N (twUnit_mem_muN hs π hsfix N Kcst hKfix htf hc x.2)), by
      change ((twUnit _ c _).hom ≫ (x : Aut Y × PX).1.hom).base = _
      rw [comp_base, show (twUnit (x : Aut Y × PX).1 c _).hom.base = 𝟙 _ from rfl,
        Category.id_comp]
      exact x.2.2.2⟩

lemma coe_twistEFun {c : B.obj Y.base} (hc : c ∈ constRoots N Kcst)
    (x : thetaEPi hs π hsfix PY N) :
    (twistEFun hs π hsfix PY N Kcst hKfix htf hc x : Aut Y × PX) =
      ((x : Aut Y × PX).1 * twUnit (x : Aut Y × PX).1 c
        (divB_fix_of_mem hs π hsfix N Kcst hKfix htf hc x.2), (x : Aut Y × PX).2) := rfl

lemma twistFun_mul {c : B.obj Y.base} (hc : c ∈ constRoots N Kcst)
    (x y : thetaEPi hs π hsfix PY N) :
    twistEFun hs π hsfix PY N Kcst hKfix htf hc (x * y) =
      twistEFun hs π hsfix PY N Kcst hKfix htf hc x *
        twistEFun hs π hsfix PY N Kcst hKfix htf hc y := by
  apply Subtype.ext
  apply Prod.ext
  · have e : twUnit ((x * y : thetaEPi hs π hsfix PY N) : Aut Y × PX).1 c
        (divB_fix_of_mem hs π hsfix N Kcst hKfix htf hc (x * y).2) =
        ((y : Aut Y × PX).1)⁻¹ * twUnit (x : Aut Y × PX).1 c
          (divB_fix_of_mem hs π hsfix N Kcst hKfix htf hc x.2) * (y : Aut Y × PX).1 *
          twUnit (y : Aut Y × PX).1 c (divB_fix_of_mem hs π hsfix N Kcst hKfix htf hc y.2) :=
      twUnit_mul _ _ c _ _ _
    change (x : Aut Y × PX).1 * (y : Aut Y × PX).1 * twUnit _ c _ = _
    rw [e]
    change _ = (x : Aut Y × PX).1 * twUnit _ c _ * ((y : Aut Y × PX).1 * twUnit _ c _)
    group
  · rfl

lemma twistFun_twistFun {c : B.obj Y.base} (hc : c ∈ constRoots N Kcst)
    (hc' : -c ∈ constRoots N Kcst) (x : thetaEPi hs π hsfix PY N) :
    twistEFun hs π hsfix PY N Kcst hKfix htf hc' (twistEFun hs π hsfix PY N Kcst hKfix htf hc x) =
      x := by
  apply Subtype.ext
  apply Prod.ext
  · simp only [coe_twistEFun]
    unfold twUnit
    rw [mul_assoc, unitAut_mul]
    conv_rhs => rw [← mul_one (x : Aut Y × PX).1]
    congr 1
    rw [← unitAut_zero (Y := Y) (by rw [map_zero])]
    refine unitAut_congr ?_ _ _
    rw [mul_unitAut_base, map_neg]
    abel
  · rfl

/-- **The outer action of `K^×`** ([EtTh], Lemma 5.8, Lemma 5.9(iv)): the twist by
`c ∈ (K^×)^{1/N}` (conjugation by the birational unit `c`) as an automorphism of `E^Π_N`. -/
def twistE (c : constRoots N Kcst) : MulAut (thetaEPi hs π hsfix PY N) :=
  MonoidHom.toMulEquiv
    { toFun := twistEFun hs π hsfix PY N Kcst hKfix htf c.2
      map_one' := by
        apply Subtype.ext
        apply Prod.ext
        · change (1 : Aut Y) * twUnit (1 : Aut Y) (c : B.obj Y.base)
            (divB_fix_of_mem hs π hsfix N Kcst hKfix htf c.2 (1 : thetaEPi hs π hsfix PY N).2) = 1
          rw [twUnit_eq_one rfl, one_mul]
        · rfl
      map_mul' := twistFun_mul hs π hsfix PY N Kcst hKfix htf c.2 }
    { toFun := twistEFun hs π hsfix PY N Kcst hKfix htf ((constRoots N Kcst).neg_mem c.2)
      map_one' := by
        apply Subtype.ext
        apply Prod.ext
        · change (1 : Aut Y) * twUnit (1 : Aut Y) (-(c : B.obj Y.base))
            (divB_fix_of_mem hs π hsfix N Kcst hKfix htf ((constRoots N Kcst).neg_mem c.2)
              (1 : thetaEPi hs π hsfix PY N).2) = 1
          rw [twUnit_eq_one rfl, one_mul]
        · rfl
      map_mul' := twistFun_mul hs π hsfix PY N Kcst hKfix htf _ }
    (by
      ext x : 1
      exact twistFun_twistFun hs π hsfix PY N Kcst hKfix htf c.2
        ((constRoots N Kcst).neg_mem c.2) x)
    (by
      ext x : 1
      have := twistFun_twistFun hs π hsfix PY N Kcst hKfix htf
        ((constRoots N Kcst).neg_mem c.2) (by rw [neg_neg]; exact c.2) x
      simp only [neg_neg] at this
      exact this)

lemma coe_twistE (c : constRoots N Kcst) (x : thetaEPi hs π hsfix PY N) :
    (twistE hs π hsfix PY N Kcst hKfix htf c x : Aut Y × PX) =
      ((x : Aut Y × PX).1 * twUnit (x : Aut Y × PX).1 c
        (divB_fix_of_mem hs π hsfix N Kcst hKfix htf c.2 x.2), (x : Aut Y × PX).2) := rfl

/-! #### Conjugation by `E^Π_X` (the outer action of `PX/PY`, [EtTh], Lemma 5.9(iii)) -/

/-- `μ_N(Y) ⊆ E^Π_N`, `m ↦ (m, 1)`. -/
def inlE : muN Y N →* thetaEPi hs π hsfix PY N where
  toFun m := ⟨((m : Aut Y), 1), PY.one_mem, muN_le_thetaE hs π hsfix PY N m.2, by
    rw [map_one]
    exact m.2.1⟩
  map_one' := rfl
  map_mul' _ _ := by
    apply Subtype.ext
    apply Prod.ext
    · rfl
    · exact (mul_one 1).symm

@[simp] lemma coe_inlE (m : muN Y N) :
    (inlE hs π hsfix PY N m : Aut Y × PX) = ((m : Aut Y), 1) := rfl

/-- The inclusion `E^Π_N ⊆ E^Π_X`. -/
def inclTop : thetaEPi hs π hsfix PY N →* thetaEPi hs π hsfix ⊤ N :=
  Subgroup.inclusion (thetaEPi_le_top hs π hsfix PY N)

@[simp] lemma coe_inclTop (y : thetaEPi hs π hsfix PY N) :
    (inclTop hs π hsfix PY N y : Aut Y × PX) = y := rfl

section Normal

variable [PY.Normal]

lemma conj_mem_thetaEPi (z : thetaEPi hs π hsfix ⊤ N) {y : Aut Y × PX}
    (hy : y ∈ thetaEPi hs π hsfix PY N) :
    (z : Aut Y × PX) * y * (z : Aut Y × PX)⁻¹ ∈ thetaEPi hs π hsfix PY N := by
  have htop : (z : Aut Y × PX) * y * (z : Aut Y × PX)⁻¹ ∈ thetaEPi hs π hsfix ⊤ N :=
    (thetaEPi hs π hsfix ⊤ N).mul_mem ((thetaEPi hs π hsfix ⊤ N).mul_mem z.2
      (thetaEPi_le_top hs π hsfix PY N hy)) ((thetaEPi hs π hsfix ⊤ N).inv_mem z.2)
  obtain ⟨-, ⟨m, hm, x, -, hz1⟩, -⟩ := z.2
  obtain ⟨hp, ⟨m', hm', p, hpY, hy1⟩, -⟩ := hy
  refine ⟨?_, ?_, htop.2.2⟩
  · change (z : Aut Y × PX).2 * y.2 * (z : Aut Y × PX).2⁻¹ ∈ PY
    exact (inferInstance : PY.Normal).conj_mem _ hp _
  · change (z : Aut Y × PX).1 * y.1 * (z : Aut Y × PX).1⁻¹ ∈ thetaE hs π hsfix PY N
    have hnorm : (muN Y N).Normal := inferInstance
    rw [hz1, hy1]
    have e : m * sgp hs π hsfix x * (m' * sgp hs π hsfix p) * (m * sgp hs π hsfix x)⁻¹ =
        m * (sgp hs π hsfix x * m' * (sgp hs π hsfix x)⁻¹) * sgp hs π hsfix (x * p * x⁻¹) *
          m⁻¹ := by
      rw [map_mul, map_mul, map_inv]
      group
    rw [e]
    refine (thetaE hs π hsfix PY N).mul_mem ((thetaE hs π hsfix PY N).mul_mem
      ((thetaE hs π hsfix PY N).mul_mem (muN_le_thetaE hs π hsfix PY N hm)
        (muN_le_thetaE hs π hsfix PY N (hnorm.conj_mem _ hm' _)))
      (sgp_mem_thetaE hs π hsfix PY N ((inferInstance : PY.Normal).conj_mem _ hpY _)))
      (muN_le_thetaE hs π hsfix PY N ((muN Y N).inv_mem hm))

/-- **Conjugation by `z ∈ E^Π_X`** as an automorphism of `E^Π_N` ([EtTh], Lemma 5.9(iii): the
outer action of `PX/PY ≅ l·ℤ`; for `z ∈ E^Π_N` the inner automorphisms). -/
def conjE (z : thetaEPi hs π hsfix ⊤ N) : MulAut (thetaEPi hs π hsfix PY N) where
  toFun y := ⟨(z : Aut Y × PX) * y * (z : Aut Y × PX)⁻¹, conj_mem_thetaEPi hs π hsfix PY N z y.2⟩
  invFun y := ⟨(z : Aut Y × PX)⁻¹ * y * (z : Aut Y × PX), by
    simpa using conj_mem_thetaEPi hs π hsfix PY N z⁻¹ y.2⟩
  left_inv y := Subtype.ext (by simp [mul_assoc])
  right_inv y := Subtype.ext (by simp [mul_assoc])
  map_mul' y y' := Subtype.ext (by simp [mul_assoc])

lemma coe_conjE (z : thetaEPi hs π hsfix ⊤ N) (y : thetaEPi hs π hsfix PY N) :
    (conjE hs π hsfix PY N z y : Aut Y × PX) =
      (z : Aut Y × PX) * y * (z : Aut Y × PX)⁻¹ := rfl

lemma conjE_inclTop (y : thetaEPi hs π hsfix PY N) :
    conjE hs π hsfix PY N (inclTop hs π hsfix PY N y) = MulAut.conj y := by
  ext x : 1
  apply Subtype.ext
  rfl

/-! #### The subgroup `D` and the environment -/

/-- **The subgroup `D ⊆ Aut(E^Π_N)`** ([EtTh], Lemma 5.9(iv)): generated by the conjugations by
`E^Π_X` (the inner automorphisms and the outer action of `PX/PY ≅ l·ℤ`, Lemma 5.9(iii)) and the
twists by `(K^×)^{1/N}` (the outer action of `K^×`, Lemma 5.8). -/
def thetaD : Subgroup (MulAut (thetaEPi hs π hsfix PY N)) :=
  Subgroup.closure (Set.range (conjE hs π hsfix PY N) ∪
    Set.range (twistE hs π hsfix PY N Kcst hKfix htf))

lemma inner_le_thetaD :
    (MulAut.conj : thetaEPi hs π hsfix PY N →* MulAut (thetaEPi hs π hsfix PY N)).range ≤
      thetaD hs π hsfix PY N Kcst hKfix htf := by
  rintro _ ⟨y, rfl⟩
  refine Subgroup.subset_closure (Or.inl ⟨inclTop hs π hsfix PY N y, ?_⟩)
  exact conjE_inclTop hs π hsfix PY N y

variable {PY} {PYdd : Subgroup PX} (hle : PYdd ≤ PY)
  (htfix : ∀ p : PYdd, Φ.pb (σ (π p)).hom.base t.div = t.div)
  (hFN : ∀ p : PYdd, B.pb (σ (π p)).hom.base (N • (s.u - t.u)) = N • (s.u - t.u))

/-- **The theta subgroups** ([EtTh], Lemma 5.9(iv)): the `μ_N`-conjugates of the image of
`s⊔-Π_N : PYdd → E^Π_N`. -/
def thetaSubgroupsE : Set (Subgroup (thetaEPi hs π hsfix PY N)) :=
  Set.range fun m : muN Y N => (tPi hs ht hb π hsfix N hle htfix hFN).range.map
    (MulAut.conj (inlE hs π hsfix PY N m)).toMonoidHom

section Env

variable [TopologicalSpace (Aut Y)] [DiscreteTopology (Aut Y)] [TopologicalSpace PX]
  [IsTopologicalGroup PX]

/-- **The Frobenioid-theoretic mono-theta environment** ([EtTh], Lemma 5.9(iv); IUT II,
Prop. 1.2(ii): `M^Θ(C)`): the topological group `E^Π_N` (subspace topology of
`Aut_C(Y) × PX`, `Aut_C(Y)` discrete), the subgroup `D` generated by the outer actions of `l·ℤ`
and `K^×`, and the `μ_N`-conjugates of the image of `s⊔-Π_N`. -/
def frobEnv : MonoThetaEnv.{max v w} where
  G := thetaEPi hs π hsfix PY N
  D := thetaD hs π hsfix PY N Kcst hKfix htf
  inner_le := inner_le_thetaD hs π hsfix PY N Kcst hKfix htf
  thetaSubgroups := thetaSubgroupsE hs ht hb π hsfix N hle htfix hFN

end Env

end Normal

/-! ### Lemma 5.8: conjugation by `(O_K^×)^{1/N}` -/

section Lemma58

variable {PY}

/-- **Conjugation by a unit `c ∈ O^×(Y)`** is the twist by `c`: `c · a · c⁻¹ = a · (g^*c − c)`. -/
lemma unitAut_conj (a : Aut Y) (c : B.obj Y.base) (hc : divB.app _ c = 0)
    (h : Φ.pb a.hom.base (divB.app _ c) = divB.app _ c) :
    unitAut Y c hc * a * (unitAut Y c hc)⁻¹ = a * twUnit a c h := by
  have e := conj_unitAut a⁻¹ c hc
  rw [inv_inv] at e
  have hinv : (unitAut Y c hc)⁻¹ = unitAut Y (-c) (by rw [map_neg, hc, neg_zero]) := by
    rw [inv_eq_iff_mul_eq_one, unitAut_mul, ← unitAut_zero (Y := Y) (by rw [map_zero])]
    exact unitAut_congr (by abel) _ _
  calc unitAut Y c hc * a * (unitAut Y c hc)⁻¹
      = a * (a⁻¹ * unitAut Y c hc * a) * (unitAut Y c hc)⁻¹ := by group
    _ = a * twUnit a c h := by
      rw [e, hinv, mul_assoc, unitAut_mul, twUnit]
      exact congrArg _ (unitAut_congr (by
        change B.pb a.hom.base c + -c = _
        abel) _ _)

lemma unitAut_eq_one_iff (d : B.obj Y.base) (hd : divB.app _ d = 0) :
    unitAut Y d hd = 1 ↔ d = 0 := by
  refine ⟨fun h => ?_, fun h => by subst h; exact unitAut_zero _⟩
  exact congrArg (fun a : Aut Y => a.hom.u) h

include hKfix htf in
/-- **[EtTh], Lemma 5.8** (`⊇`): every `c ∈ (O_K^×)^{1/N} = (K^×)^{1/N} ∩ O^×(Y)` normalises
`E_N`: conjugation by `c` maps `e ∈ E_N` to `e · (Base(e)^*c − c) ∈ E_N`. -/
theorem conj_unitAut_mem_thetaE {c : B.obj Y.base} (hc0 : divB.app _ c = 0)
    (hc : c ∈ constRoots N Kcst) {e : Aut Y} (he : e ∈ thetaE hs π hsfix PY N) :
    unitAut Y c hc0 * e * (unitAut Y c hc0)⁻¹ ∈ thetaE hs π hsfix PY N := by
  obtain ⟨m, hm, p, hp, rfl⟩ := he
  have hbase : (m * sgp hs π hsfix p).hom.base = (sgp hs π hsfix p).hom.base := by
    change ((sgp hs π hsfix p).hom ≫ m.hom).base = _
    rw [comp_base, show m.hom.base = 𝟙 _ from hm.1, Category.comp_id]
  have hfix : Φ.pb (m * sgp hs π hsfix p).hom.base (divB.app _ c) = divB.app _ c := by
    rw [hbase]
    exact divB_fix_of_mem_constRoots hs π hsfix N Kcst hKfix htf hc p
  rw [unitAut_conj _ c hc0 hfix]
  refine (thetaE hs π hsfix PY N).mul_mem ⟨m, hm, p, hp, rfl⟩
    (muN_le_thetaE hs π hsfix PY N (unitAut_mem_muN _ ?_))
  rw [hbase]
  exact nsmul_twist_eq_zero hs π hsfix N Kcst hKfix hc p

include hsec in
/-- **[EtTh], Lemma 5.8** (`⊆`): a unit `c ∈ O^×(Y)` normalising `E_N` lies in `(K^×)^{1/N}`,
given the geometric input of the proof in [EtTh] (`hGeom`: "since `Y` is geometrically connected
over `K`", a unit on which `PY` acts through `μ_N` is an `N`-th root of an element of `K^×`). -/
theorem mem_constRoots_of_normalizes
    (hGeom : ∀ c : B.obj Y.base, divB.app _ c = 0 →
      (∀ p ∈ PY, N • (B.pb (sgp hs π hsfix p).hom.base c - c) = 0) → c ∈ constRoots N Kcst)
    {c : B.obj Y.base} (hc0 : divB.app _ c = 0)
    (hnorm : ∀ e ∈ thetaE hs π hsfix PY N,
      unitAut Y c hc0 * e * (unitAut Y c hc0)⁻¹ ∈ thetaE hs π hsfix PY N) :
    c ∈ constRoots N Kcst := by
  refine hGeom c hc0 fun p hp => ?_
  have hfix : Φ.pb (sgp hs π hsfix p).hom.base (divB.app _ c) = divB.app _ c := by
    rw [hc0, map_zero]
  have h1 := hnorm _ (sgp_mem_thetaE hs π hsfix PY N hp)
  rw [unitAut_conj _ c hc0 hfix] at h1
  have h2 : twUnit (sgp hs π hsfix p) c hfix ∈ thetaE hs π hsfix PY N := by
    have := (thetaE hs π hsfix PY N).mul_mem
      ((thetaE hs π hsfix PY N).inv_mem (sgp_mem_thetaE hs π hsfix PY N hp)) h1
    rwa [inv_mul_cancel_left] at this
  have h3 := ((mem_unitsAut_iff_mem_muN hs hsec π hsfix PY N h2).1
    (unitAut_mem_unitsAut _ _)).2
  rw [twUnit, unitAut_pow, unitAut_eq_one_iff] at h3
  exact h3

end Lemma58

/-! ### Comparison with the model environment `Env.modelEnv` -/

section Compare

open scoped Envelope

variable {PY} {G : Type (max v w)} [Group G] (aug : PX →* G) (ψ : G →* MulAut (muN Y N))
  (hact : ∀ (x : PX) (m : muN Y N),
    ((ψ (aug x) m : muN Y N) : Aut Y) = sgp hs π hsfix x * m * (sgp hs π hsfix x)⁻¹)

include hsec in
lemma left_mem_muN {x : Aut Y × PX} (hx : x ∈ thetaEPi hs π hsfix PY N) :
    x.1 * (sgp hs π hsfix x.2)⁻¹ ∈ muN Y N := by
  refine (mem_unitsAut_iff_mem_muN hs hsec π hsfix PY N
    ((thetaE hs π hsfix PY N).mul_mem hx.2.1
      ((thetaE hs π hsfix PY N).inv_mem (sgp_mem_thetaE hs π hsfix PY N hx.1)))).1 ?_
  change ((sgp hs π hsfix x.2).inv ≫ x.1.hom).base = 𝟙 _
  rw [comp_base, hx.2.2, inv_base_of_iso]

/-- The `μ_N`-component `e · s⊓-gp(p)^{-1}` of `(e, p) ∈ E^Π_N`. -/
def leftE (x : thetaEPi hs π hsfix PY N) : muN Y N :=
  ⟨(x : Aut Y × PX).1 * (sgp hs π hsfix (x : Aut Y × PX).2)⁻¹,
    left_mem_muN hs hsec π hsfix N x.2⟩

/-- **`E^Π_N → Π_X[μ_N]`**, `(e, p) ↦ (e · s⊓-gp(p)^{-1}, p)`. -/
def toEnvHom : thetaEPi hs π hsfix PY N →* EnvX aug ψ where
  toFun x := ⟨leftE hs hsec π hsfix N x, (x : Aut Y × PX).2⟩
  map_one' := by
    refine SemidirectProduct.ext (Subtype.ext ?_) rfl
    change (1 : Aut Y) * (sgp hs π hsfix 1)⁻¹ = 1
    simp
  map_mul' x y := by
    refine SemidirectProduct.ext (Subtype.ext ?_) rfl
    change (x : Aut Y × PX).1 * (y : Aut Y × PX).1 *
        (sgp hs π hsfix ((x : Aut Y × PX).2 * (y : Aut Y × PX).2))⁻¹ =
      (x : Aut Y × PX).1 * (sgp hs π hsfix (x : Aut Y × PX).2)⁻¹ *
        ((ψ (aug (x : Aut Y × PX).2) (leftE hs hsec π hsfix N y) : muN Y N) : Aut Y)
    rw [hact]
    change _ = _ * (_ * ((y : Aut Y × PX).1 * (sgp hs π hsfix (y : Aut Y × PX).2)⁻¹) * _)
    rw [map_mul]
    group

@[simp] lemma toEnvHom_left (x : thetaEPi hs π hsfix PY N) :
    ((toEnvHom hs hsec π hsfix N aug ψ hact x).left : Aut Y) =
      (x : Aut Y × PX).1 * (sgp hs π hsfix (x : Aut Y × PX).2)⁻¹ := rfl

@[simp] lemma toEnvHom_right (x : thetaEPi hs π hsfix PY N) :
    (toEnvHom hs hsec π hsfix N aug ψ hact x).right = (x : Aut Y × PX).2 := rfl

/-- The inverse map `Π_Y[μ_N] → E^Π_N`, `(m, p) ↦ (m · s⊓-gp(p), p)`. -/
def ofEnvFun (w : envY aug ψ PY) : thetaEPi hs π hsfix PY N :=
  ⟨(((w : EnvX aug ψ).left : Aut Y) * sgp hs π hsfix (w : EnvX aug ψ).right,
      (w : EnvX aug ψ).right),
    w.2, ⟨_, (w : EnvX aug ψ).left.2, _, w.2, rfl⟩, by
      change ((sgp hs π hsfix _).hom ≫ ((w : EnvX aug ψ).left : Aut Y).hom).base = _
      rw [comp_base, show ((w : EnvX aug ψ).left : Aut Y).hom.base = 𝟙 _ from
        (w : EnvX aug ψ).left.2.1, Category.comp_id]⟩

/-- **[EtTh], Lemma 5.9(iv)** (group part, model form): `E^Π_N ≅ Π_Y[μ_N]` (the preimage of `PY`
in `μ_N ⋊ PX`). -/
def toEnvY : thetaEPi hs π hsfix PY N ≃* envY aug ψ PY where
  toFun x := ⟨toEnvHom hs hsec π hsfix N aug ψ hact x, x.2.1⟩
  invFun := ofEnvFun hs π hsfix N aug ψ
  left_inv x := by
    apply Subtype.ext
    apply Prod.ext
    · change (x : Aut Y × PX).1 * (sgp hs π hsfix (x : Aut Y × PX).2)⁻¹ *
        sgp hs π hsfix (x : Aut Y × PX).2 = _
      group
    · rfl
  right_inv w := by
    apply Subtype.ext
    refine SemidirectProduct.ext (Subtype.ext ?_) rfl
    change ((w : EnvX aug ψ).left : Aut Y) * sgp hs π hsfix (w : EnvX aug ψ).right *
      (sgp hs π hsfix (w : EnvX aug ψ).right)⁻¹ = _
    group
  map_mul' x y := Subtype.ext ((toEnvHom hs hsec π hsfix N aug ψ hact).map_mul x y)

@[simp] lemma coe_toEnvY (x : thetaEPi hs π hsfix PY N) :
    (toEnvY hs hsec π hsfix N aug ψ hact x : EnvX aug ψ) =
      toEnvHom hs hsec π hsfix N aug ψ hact x := rfl

lemma toEnvY_inlE (m : muN Y N) :
    toEnvY hs hsec π hsfix N aug ψ hact (inlE hs π hsfix PY N m) = inlY aug ψ PY m := by
  apply Subtype.ext
  refine SemidirectProduct.ext (Subtype.ext ?_) rfl
  change (m : Aut Y) * (sgp hs π hsfix 1)⁻¹ = m
  simp

/-- `toEnvHom` on `E^Π_X = thetaEPi ⊤` is surjective. -/
lemma toEnvHom_top_surjective :
    Function.Surjective (toEnvHom hs hsec π hsfix (PY := ⊤) N aug ψ hact) := by
  intro w
  refine ⟨⟨((w.left : Aut Y) * sgp hs π hsfix w.right, w.right), trivial,
    ⟨_, w.left.2, _, trivial, rfl⟩, ?_⟩, ?_⟩
  · change ((sgp hs π hsfix _).hom ≫ (w.left : Aut Y).hom).base = _
    rw [comp_base, show (w.left : Aut Y).hom.base = 𝟙 _ from w.left.2.1, Category.comp_id]
  · refine SemidirectProduct.ext (Subtype.ext ?_) rfl
    change (w.left : Aut Y) * sgp hs π hsfix w.right * (sgp hs π hsfix w.right)⁻¹ = _
    group

/-- **Transport of the conjugations** `conjE z` to conjugation by `toEnvHom z` in `Π_X[μ_N]`. -/
lemma toEnvY_conjE [PY.Normal] (z : thetaEPi hs π hsfix ⊤ N) (y : thetaEPi hs π hsfix PY N) :
    (toEnvY hs hsec π hsfix N aug ψ hact (conjE hs π hsfix PY N z y) : EnvX aug ψ) =
      toEnvHom hs hsec π hsfix N aug ψ hact z * toEnvY hs hsec π hsfix N aug ψ hact y *
        (toEnvHom hs hsec π hsfix N aug ψ hact z)⁻¹ := by
  have h1 := (toEnvHom hs hsec π hsfix (PY := ⊤) N aug ψ hact).map_mul
    (z * inclTop hs π hsfix PY N y) z⁻¹
  have h2 := (toEnvHom hs hsec π hsfix (PY := ⊤) N aug ψ hact).map_mul z
    (inclTop hs π hsfix PY N y)
  rw [h2, map_inv] at h1
  exact h1

/-- The Kummer cocycle of `c ∈ (K^×)^{1/N}`: `x ↦ s⊓-gp(x) · (g_x^*c − c) · s⊓-gp(x)^{-1}`. -/
def kapC (c : constRoots N Kcst) (x : PX) : muN Y N :=
  ⟨sgp hs π hsfix x *
      twUnit (sgp hs π hsfix x) c (divB_fix_of_mem_constRoots hs π hsfix N Kcst hKfix htf c.2 x) *
      (sgp hs π hsfix x)⁻¹,
    (inferInstance : (muN Y N).Normal).conj_mem _
      (unitAut_mem_muN _ (nsmul_twist_eq_zero hs π hsfix N Kcst hKfix c.2 x)) _⟩

/-- **Transport of the `K^×`-twists** to the Kummer twists of the model. -/
lemma toEnvY_twistE (c : constRoots N Kcst) {κ : G → muN Y N} (hκ : IsCocycle ψ κ)
    (hκc : ∀ x, κ (aug x) = kapC hs π hsfix N Kcst hKfix htf c x)
    (y : thetaEPi hs π hsfix PY N) :
    (toEnvY hs hsec π hsfix N aug ψ hact (twistE hs π hsfix PY N Kcst hKfix htf c y) :
        EnvX aug ψ) = twist κ hκ (toEnvY hs hsec π hsfix N aug ψ hact y) := by
  refine SemidirectProduct.ext (Subtype.ext ?_) rfl
  change (y : Aut Y × PX).1 * twUnit _ (c : B.obj Y.base) _ *
      (sgp hs π hsfix (y : Aut Y × PX).2)⁻¹ =
    ((κ (aug (y : Aut Y × PX).2) : muN Y N) : Aut Y) *
      ((y : Aut Y × PX).1 * (sgp hs π hsfix (y : Aut Y × PX).2)⁻¹)
  rw [hκc]
  change _ = sgp hs π hsfix (y : Aut Y × PX).2 * twUnit _ (c : B.obj Y.base) _ *
      (sgp hs π hsfix (y : Aut Y × PX).2)⁻¹ * _
  rw [twUnit_congr (base_eq_of_mem_thetaEPi hs π hsfix N y.2) (c : B.obj Y.base) _
    (divB_fix_of_mem_constRoots hs π hsfix N Kcst hKfix htf c.2 _)]
  set g := sgp hs π hsfix (y : Aut Y × PX).2
  set u := twUnit g (c : B.obj Y.base)
    (divB_fix_of_mem_constRoots hs π hsfix N Kcst hKfix htf c.2 _)
  set m := (y : Aut Y × PX).1 * g⁻¹ with hm
  have hmu : m ∈ unitsAut Y := (left_mem_muN hs hsec π hsfix N y.2).1
  have hgu : g * u * g⁻¹ ∈ unitsAut Y :=
    (inferInstance : (unitsAut Y).Normal).conj_mem _ (unitAut_mem_unitsAut _ _) _
  have hy : (y : Aut Y × PX).1 = m * g := by rw [hm, inv_mul_cancel_right]
  rw [hy]
  calc m * g * u * g⁻¹ = m * (g * u * g⁻¹) := by group
    _ = g * u * g⁻¹ * m := units_comm hmu hgu

variable (Kum : Subgroup (G → muN Y N)) (hKum : ∀ κ ∈ Kum, IsCocycle ψ κ)
  (hKumF : ∀ c : constRoots N Kcst, ∃ κ ∈ Kum,
    ∀ x, κ (aug x) = kapC hs π hsfix N Kcst hKfix htf c x)
  (hKumF' : ∀ κ ∈ Kum, ∃ c : constRoots N Kcst,
    ∀ x, κ (aug x) = kapC hs π hsfix N Kcst hKfix htf c x)

include hKumF hKumF' in
/-- **The subgroups `D` correspond** ([EtTh], Lemma 5.9(iv)): under `E^Π_N ≅ Π_Y[μ_N]`, the
subgroup generated by the outer actions of `l·ℤ` and `K^×` is the model's `DY` (the twists by
`Kum` and the conjugations by `Π_X[μ_N]`), provided the Kummer cocycles `Kum` are those of
`(K^×)^{1/N}` (`hKumF`, `hKumF'`). -/
theorem map_thetaD [PY.Normal] :
    (thetaD hs π hsfix PY N Kcst hKfix htf).map
        (MonoThetaEnv.conjAut (toEnvY hs hsec π hsfix N aug ψ hact)) =
      DY aug ψ Kum PY hKum := by
  rw [thetaD, MonoidHom.map_closure]
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro _ ⟨α, hα | hα, rfl⟩
    · obtain ⟨z, rfl⟩ := hα
      refine ⟨MulAut.conj (toEnvHom hs hsec π hsfix N aug ψ hact z),
        conj_mem_DX aug ψ Kum hKum _, fun w => ?_⟩
      change ((toEnvY hs hsec π hsfix N aug ψ hact) (conjE hs π hsfix PY N z
        ((toEnvY hs hsec π hsfix N aug ψ hact).symm w)) : EnvX aug ψ) = _
      rw [toEnvY_conjE, MulEquiv.apply_symm_apply]
      rfl
    · obtain ⟨c, rfl⟩ := hα
      obtain ⟨κ, hκ, hκc⟩ := hKumF c
      refine ⟨twist κ (hKum κ hκ), twist_mem_DX aug ψ Kum hKum hκ, fun w => ?_⟩
      change ((toEnvY hs hsec π hsfix N aug ψ hact) (twistE hs π hsfix PY N Kcst hKfix htf c
        ((toEnvY hs hsec π hsfix N aug ψ hact).symm w)) : EnvX aug ψ) = _
      rw [toEnvY_twistE hs hsec π hsfix N Kcst hKfix htf aug ψ hact c (hKum κ hκ) hκc,
        MulEquiv.apply_symm_apply]
  · intro α hα
    obtain ⟨β, hβ, hαβ⟩ := hα
    obtain ⟨κ, hκ, x, rfl⟩ := hβ
    obtain ⟨c, hc⟩ := hKumF' κ hκ
    obtain ⟨z, rfl⟩ := toEnvHom_top_surjective hs hsec π hsfix N aug ψ hact x
    have key : α = MonoThetaEnv.conjAut (toEnvY hs hsec π hsfix N aug ψ hact)
        (twistE hs π hsfix PY N Kcst hKfix htf c) *
        MonoThetaEnv.conjAut (toEnvY hs hsec π hsfix N aug ψ hact) (conjE hs π hsfix PY N z) := by
      ext w : 1
      apply Subtype.ext
      rw [hαβ w, MulAut.mul_apply]
      change _ = ((toEnvY hs hsec π hsfix N aug ψ hact) (twistE hs π hsfix PY N Kcst hKfix htf c
        ((toEnvY hs hsec π hsfix N aug ψ hact).symm ((toEnvY hs hsec π hsfix N aug ψ hact)
          (conjE hs π hsfix PY N z ((toEnvY hs hsec π hsfix N aug ψ hact).symm w))))) :
            EnvX aug ψ)
      rw [MulEquiv.symm_apply_apply,
        toEnvY_twistE hs hsec π hsfix N Kcst hKfix htf aug ψ hact c (hKum κ hκ) hc]
      congr 1
      rw [toEnvY_conjE, MulEquiv.apply_symm_apply]
      rfl
    rw [key]
    exact Subgroup.mul_mem _ (Subgroup.subset_closure ⟨_, Or.inr ⟨c, rfl⟩, rfl⟩)
      (Subgroup.subset_closure ⟨_, Or.inl ⟨z, rfl⟩, rfl⟩)

/-! #### The theta cocycle and the isomorphism of environments -/

variable {PYdd : Subgroup PX} (hle : PYdd ≤ PY)
  (htfix : ∀ p : PYdd, Φ.pb (σ (π p)).hom.base t.div = t.div)
  (hFN : ∀ p : PYdd, B.pb (σ (π p)).hom.base (N • (s.u - t.u)) = N • (s.u - t.u))

/-- **The Frobenioid theta cocycle** `δ(q) = s⊔-gp(q) · s⊓-gp(q)^{-1} ∈ μ_N(Y)` (`Model.eta`), the
`μ_N`-component of `s⊔-Π_N(q)`. -/
def deltaE (q : PYdd) : muN Y N :=
  ⟨eta hs ht π hsfix htfix q, eta_mem_muN hs ht hb π hsfix N htfix hFN q⟩

lemma toEnvHom_tPi (q : PYdd) :
    toEnvHom hs hsec π hsfix N aug ψ hact (tPi hs ht hb π hsfix N hle htfix hFN q) =
      ⟨deltaE hs ht hb π hsfix N htfix hFN q, q⟩ := rfl

include hsec hact hle in
lemma isCocycle_deltaE : IsCocycle (actDD aug ψ PYdd) (deltaE hs ht hb π hsfix N htfix hFN) := by
  intro g h
  have e := (toEnvHom hs hsec π hsfix N aug ψ hact).map_mul
    (tPi hs ht hb π hsfix N hle htfix hFN g) (tPi hs ht hb π hsfix N hle htfix hFN h)
  rw [← (tPi hs ht hb π hsfix N hle htfix hFN).map_mul] at e
  exact congrArg SemidirectProduct.left e

/-- The cocycle of the model environment (`thetaSection = s^alg − η`, so `η = δ⁻¹`). -/
abbrev etaModel : PYdd → muN Y N := thetaCocycle (deltaE hs ht hb π hsfix N htfix hFN)

include hsec hact hle in
lemma isCocycle_etaModel :
    IsCocycle (actDD aug ψ PYdd) (etaModel hs ht hb π hsfix N htfix hFN) :=
  isCocycle_thetaCocycle (isCocycle_deltaE hs ht hb hsec π hsfix N aug ψ hact hle htfix hFN)

lemma map_range_tPi :
    (tPi hs ht hb π hsfix N hle htfix hFN).range.map
        (toEnvY hs hsec π hsfix N aug ψ hact).toMonoidHom =
      (thetaSection aug ψ hle (isCocycle_etaModel hs ht hb hsec π hsfix N aug ψ hact hle htfix
        hFN)).range := by
  rw [← MonoidHom.range_comp]
  congr 1

/-- The algebraic section `s⊓-Π_N : PYdd → E^Π_N`, `p ↦ (s⊓-gp(p), p)`. -/
def sPi : PYdd →* thetaEPi hs π hsfix PY N where
  toFun p := ⟨(sgp hs π hsfix p, p), hle p.2, sgp_mem_thetaE hs π hsfix PY N (hle p.2), rfl⟩
  map_one' := by ext <;> simp
  map_mul' p p' := by ext <;> simp

lemma toEnvY_sPi (q : PYdd) :
    toEnvY hs hsec π hsfix N aug ψ hact (sPi hs π hsfix N hle q) = algSection aug ψ hle q := by
  apply Subtype.ext
  refine SemidirectProduct.ext (Subtype.ext ?_) rfl
  change sgp hs π hsfix q * (sgp hs π hsfix q)⁻¹ = 1
  group

include hact in
/-- **The Frobenioid cyclotomic map is the Kummer class** ([EtTh], Proposition 4.3(iii),
Proposition 5.5): for geometric `q` (`aug q = 1`), `δ(q)` is the inverse of the Kummer unit
`κ(q) = (1, id, 0, kummerUnit s t (σ π q))`. -/
theorem deltaE_eq_kummer (q : PYdd) (hq : aug q = 1) :
    (deltaE hs ht hb π hsfix N htfix hFN q : Aut Y) =
      (unitAut Y (kummerUnit s t (σ (π q)))
        (divB_kummerUnit hs ht hb _ (hsfix _) (htfix q)))⁻¹ := by
  change eta hs ht π hsfix htfix q = _
  rw [eta_eq hs ht hb π hsfix htfix q]
  have hκ := (muN Y N).inv_mem (unitAut_mem_muN (divB_kummerUnit hs ht hb _ (hsfix _) (htfix q))
    (nsmul_kummerUnit _ N (hFN q)))
  have := hact q ⟨_, hκ⟩
  rw [hq, map_one] at this
  exact this.symm

/-- **[EtTh], Proposition 5.5** (with the named input `hKummer` = [EtTh], Proposition 5.2(iii)):
if the Frobenioid theta cocycle is cohomologous to the étale theta cocycle `ηθ` (transported to
`μ_N(Y)` by the scheme-theoretic identification of [EtTh], Remark 5.2.1), then on the geometric
part the Frobenioid cyclotomic map `δ` (the Kummer class, `deltaE_eq_kummer`) is the isomorphism
`q ↦ ηθ(q)⁻¹` of the étale theta class. -/
theorem deltaE_eq_of_kummer {ηθ : PYdd → muN Y N}
    (hKummer : Cohomologous (actDD aug ψ PYdd) (etaModel hs ht hb π hsfix N htfix hFN) ηθ)
    (q : PYdd) (hq : aug q = 1) : deltaE hs ht hb π hsfix N htfix hFN q = (ηθ q)⁻¹ := by
  obtain ⟨ζ, hζ⟩ := hKummer
  have h := hζ q
  have h1 : actDD aug ψ PYdd q = 1 := by
    change ψ (aug q) = 1
    rw [hq, map_one]
  rw [h1, MulAut.one_apply] at h
  rw [h]
  change _ = (ζ * (deltaE hs ht hb π hsfix N htfix hFN q)⁻¹ * ζ⁻¹)⁻¹
  rw [mul_comm ζ, mul_inv_cancel_right, inv_inv]

/-! #### Topology -/

section Top

variable [TopologicalSpace (Aut Y)] [DiscreteTopology (Aut Y)] [TopologicalSpace PX]
  [IsTopologicalGroup PX] (hπ : IsOpen (π.ker : Set PX))

include hπ in
/-- `s⊓-gp : PX → Aut_C(Y)` is continuous (with open fibres) if `π` has open kernel. -/
lemma continuous_sgp : Continuous (sgp hs π hsfix) := by
  have hker : IsOpen ((sgp hs π hsfix).ker : Set PX) :=
    Subgroup.isOpen_mono (fun p hp => MonoidHom.mem_ker.2
      (sgp_eq_one_of_ker hs π hsfix (MonoidHom.mem_ker.1 hp))) hπ
  rw [continuous_discrete_rng]
  intro a
  rw [isOpen_iff_forall_mem_open]
  intro x hx
  refine ⟨(fun y => x⁻¹ * y) ⁻¹' ((sgp hs π hsfix).ker : Set PX), fun y hy => ?_,
    hker.preimage (continuous_const.mul continuous_id), by simp⟩
  simp only [Set.mem_preimage, SetLike.mem_coe, MonoidHom.mem_ker, map_mul, map_inv,
    Set.mem_singleton_iff] at hx hy ⊢
  rw [← hx]
  calc sgp hs π hsfix y = sgp hs π hsfix x * ((sgp hs π hsfix x)⁻¹ * sgp hs π hsfix y) := by
        group
    _ = sgp hs π hsfix x := by rw [hy, mul_one]

omit [TopologicalSpace (Aut Y)] [DiscreteTopology (Aut Y)] in
include hπ hact in
/-- The action of `PX` on `μ_N(Y)` has open kernel. -/
lemma isOpen_ker_act : IsOpen ((act aug ψ).ker : Set PX) := by
  refine Subgroup.isOpen_mono (fun p hp => ?_) hπ
  have h1 := sgp_eq_one_of_ker hs π hsfix (MonoidHom.mem_ker.1 hp)
  rw [MonoidHom.mem_ker]
  refine MulEquiv.ext fun m => Subtype.ext ?_
  change ((ψ (aug p) m : muN Y N) : Aut Y) = (m : Aut Y)
  rw [hact, h1]
  group

include hπ in
/-- **[EtTh], Lemma 5.9(iv)** (topological part): `E^Π_N ≅ Π_Y[μ_N]` as topological groups. -/
def toEnvYₜ : thetaEPi hs π hsfix PY N ≃ₜ* envY aug ψ PY where
  toMulEquiv := toEnvY hs hsec π hsfix N aug ψ hact
  continuous_toFun := by
    have hs' := continuous_sgp hs π hsfix hπ
    refine Continuous.subtype_mk ?_ _
    change Continuous fun x : thetaEPi hs π hsfix PY N =>
      (⟨leftE hs hsec π hsfix N x, (x : Aut Y × PX).2⟩ : EnvX aug ψ)
    refine Envelope.continuous_mk (Continuous.subtype_mk ?_ _) ?_
    · exact (continuous_fst.comp continuous_subtype_val).mul
        ((hs'.comp (continuous_snd.comp continuous_subtype_val)).inv)
    · exact continuous_snd.comp continuous_subtype_val
  continuous_invFun := by
    have hs' := continuous_sgp hs π hsfix hπ
    refine Continuous.subtype_mk (Continuous.prodMk ?_ ?_) _
    · exact (continuous_subtype_val.comp (Envelope.continuous_left.comp continuous_subtype_val)).mul
        (hs'.comp (Envelope.continuous_right.comp continuous_subtype_val))
    · exact Envelope.continuous_right.comp continuous_subtype_val

@[simp] lemma toEnvYₜ_apply (x : thetaEPi hs π hsfix PY N) :
    toEnvYₜ hs hsec π hsfix N aug ψ hact hπ x = toEnvY hs hsec π hsfix N aug ψ hact x := rfl

/-- **[EtTh], Lemma 5.9(iv)**: the Frobenioid-theoretic mono-theta environment is isomorphic to
the model mono-theta environment of the theta setting `(PX, aug, ψ, Kum, PYdd ≤ PY)` with the
Frobenioid theta cocycle, provided conjugation by `s⊓-gp` on `μ_N(Y)` is `ψ ∘ aug` (`hact`) and the
Kummer cocycles `Kum` are those of `(K^×)^{1/N}` (`hKumF`, `hKumF'`). (For `G = PX`,
`aug = id` and `Kum` the cocycles `kapC c` these hypotheses hold by definition.) -/
def frobEnvIso [PY.Normal] :
    MonoThetaEnv.Iso (frobEnv hs ht hb π hsfix N Kcst hKfix htf hle htfix hFN)
      (modelEnv aug ψ Kum hle (isOpen_ker_act hs π hsfix N aug ψ hact hπ) hKum
        (isCocycle_etaModel hs ht hb hsec π hsfix N aug ψ hact hle htfix hFN)) where
  e := toEnvYₜ hs hsec π hsfix N aug ψ hact hπ
  map_D := map_thetaD hs hsec π hsfix N Kcst hKfix htf aug ψ hact Kum hKum hKumF hKumF'
  map_theta := by
    have key : ∀ m : muN Y N, ((tPi hs ht hb π hsfix N hle htfix hFN).range.map
        (MulAut.conj (inlE hs π hsfix PY N m)).toMonoidHom).map
          (toEnvY hs hsec π hsfix N aug ψ hact).toMonoidHom =
        (thetaSection aug ψ hle (isCocycle_etaModel hs ht hb hsec π hsfix N aug ψ hact hle htfix
          hFN)).range.map (MulAut.conj (inlY aug ψ PY m)).toMonoidHom := by
      intro m
      rw [← map_range_tPi hs ht hb hsec π hsfix N aug ψ hact hle htfix hFN, Subgroup.map_map,
        Subgroup.map_map]
      congr 1
      refine MonoidHom.ext fun y => ?_
      simp [MulAut.conj_apply, toEnvY_inlE]
    ext H
    change H ∈ Subgroup.map (toEnvY hs hsec π hsfix N aug ψ hact).toMonoidHom ''
      thetaSubgroupsE hs ht hb π hsfix N hle htfix hFN ↔ _
    dsimp only [modelEnv]
    refine Iff.trans ?_ (mem_thetaSubgroups_iff aug ψ hle _ H).symm
    constructor
    · rintro ⟨_, ⟨m, rfl⟩, rfl⟩
      exact ⟨m, key m⟩
    · rintro ⟨m, rfl⟩
      exact ⟨_, ⟨m, rfl⟩, key m⟩

/-! #### Lemma 5.9(v) and Proposition 5.5 -/

/-- Isomorphism of environments from an equality. -/
def _root_.Iut.EtaleTheta.MonoThetaEnv.Iso.ofEq.{t} {M M' : MonoThetaEnv.{t}} (h : M = M') :
    MonoThetaEnv.Iso M M' :=
  h ▸ MonoThetaEnv.Iso.refl M

include hKumF hKumF' in
/-- **[EtTh], Lemma 5.9(iv)** with `hKummer`: the Frobenioid-theoretic mono-theta environment is
isomorphic to the model environment of the étale theta class `ηθ`. -/
def frobEnvIsoTheta [PY.Normal] {ηθ : PYdd → muN Y N} (hηθ : IsCocycle (actDD aug ψ PYdd) ηθ)
    (hKummer : Cohomologous (actDD aug ψ PYdd) (etaModel hs ht hb π hsfix N htfix hFN) ηθ) :
    MonoThetaEnv.Iso (frobEnv hs ht hb π hsfix N Kcst hKfix htf hle htfix hFN)
      (modelEnv aug ψ Kum hle (isOpen_ker_act hs π hsfix N aug ψ hact hπ) hKum hηθ) :=
  (frobEnvIso hs ht hb hsec π hsfix N Kcst hKfix htf aug ψ hact Kum hKum hKumF hKumF' hle htfix
    hFN hπ).trans (MonoThetaEnv.Iso.ofEq (modelEnv_eq_of_cohomologous aug ψ Kum hle _ hKum _ hηθ
      hKummer))

include hπ hKum hKumF hKumF' in
open scoped commutatorElement in
/-- **[EtTh], Lemma 5.9(v)**: the cyclotomic rigidity isomorphism of [EtTh], Corollary 2.19(i)
(MR15's algorithm `MonoThetaEnv.IsCyc`), computed on the Frobenioid-theoretic environment with
the input subgroups transported from the model, is the Frobenioid-theoretic isomorphism of
Proposition 5.5: `s⊓-Π_N(l) ↦ δ(l)` (`δ(l)` = the inverse Kummer unit, `deltaE_eq_kummer`). The
hypotheses are those of `Env.cyclotomicRigidity_env` (MR15's Layer-B obligations). -/
theorem frobEnv_isCyc [PY.Normal] [Finite (muN Y N)] (hPY : Envelope.FISlim PY)
    (hG : ∀ τ : G, (∀ σ, τ * σ = σ * τ) → τ = 1) (hsurj : ∀ σ : G, ∃ h ∈ PY, aug h = σ)
    (L Kθ : Subgroup PX) (hKL : Kθ ≤ L) (hLdd : L ≤ PYdd) (hLg : ∀ l ∈ L, aug l = 1)
    (hη13 : ∀ k (hk : k ∈ PYdd), k ∈ Kθ → deltaE hs ht hb π hsfix N htfix hFN ⟨k, hk⟩ = 1)
    (hL : Subgroup.closure {c | c ∈ L ∧ ∃ a b, aug a = 1 ∧ b ∈ PY ∧ aug b = 1 ∧ c = ⁅a, b⁆} ⊔
      Kθ = L)
    (t m : thetaEPi hs π hsfix PY N) :
    (frobEnv hs ht hb π hsfix N Kcst hKfix htf hle htfix hFN).IsCyc
        ((rightSub aug ψ PY L).comap (toEnvY hs hsec π hsfix N aug ψ hact).toMonoidHom)
        ((rightSub aug ψ PY Kθ).comap (toEnvY hs hsec π hsfix N aug ψ hact).toMonoidHom)
        ((geomSub aug ψ PY).comap (toEnvY hs hsec π hsfix N aug ψ hact).toMonoidHom) t m ↔
      ∃ l : PYdd, (l : PX) ∈ L ∧ t = sPi hs π hsfix N hle l ∧
        m = inlE hs π hsfix PY N (deltaE hs ht hb π hsfix N htfix hFN l) := by
  have hsj : Function.Surjective (toEnvY hs hsec π hsfix (PY := PY) N aug ψ hact).toMonoidHom :=
    fun w => ⟨_, (toEnvY hs hsec π hsfix (PY := PY) N aug ψ hact).apply_symm_apply w⟩
  refine (cyclotomicRigidity_env aug ψ Kum hle (isOpen_ker_act hs π hsfix N aug ψ hact hπ) hKum
    (isCocycle_etaModel hs ht hb hsec π hsfix N aug ψ hact hle htfix hFN) hPY hG hsurj L Kθ hKL
    hLdd hLg (fun k hk hkK => by
      change (deltaE hs ht hb π hsfix N htfix hFN ⟨k, hk⟩)⁻¹ = 1
      rw [hη13 k hk hkK, inv_one]) hL
    (frobEnvIso hs ht hb hsec π hsfix N Kcst hKfix htf aug ψ hact Kum hKum hKumF hKumF' hle htfix
      hFN hπ)
    (Subgroup.map_comap_eq_self_of_surjective hsj _)
    (Subgroup.map_comap_eq_self_of_surjective hsj _)
    (Subgroup.map_comap_eq_self_of_surjective hsj _) t m).trans ?_
  refine exists_congr fun l => and_congr_right fun _ => and_congr ?_ ?_
  · change toEnvY hs hsec π hsfix N aug ψ hact t = algSection aug ψ hle l ↔ _
    rw [← toEnvY_sPi hs hsec π hsfix N aug ψ hact hle l]
    exact (toEnvY hs hsec π hsfix N aug ψ hact).injective.eq_iff
  · change toEnvY hs hsec π hsfix N aug ψ hact m =
      inlY aug ψ PY ((deltaE hs ht hb π hsfix N htfix hFN l)⁻¹)⁻¹ ↔ _
    rw [inv_inv, ← toEnvY_inlE hs hsec π hsfix N aug ψ hact]
    exact (toEnvY hs hsec π hsfix N aug ψ hact).injective.eq_iff

