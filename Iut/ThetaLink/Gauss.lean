import Iut.EtaleTheta.Wall
import Iut.Wall.Pilots
import Iut.Wall.Rss
import Iut.HodgeTheater.PrimeStrip

/-!
# Gaussian monoids and `q`-pilot monoids (IUT II, Corollaries 3.5, 3.6, 4.6; IUT III, Def. 3.8)

At a bad place `v`, IUT II, Corollary 3.5(ii), defines the **Gaussian monoids**
`Ψ_ξ = Ψ^×_cns⟨F_ℓ^*⟩ · ξ^ℕ ⊆ ∏_{|t| ∈ F_ℓ^*} Ψ_cns,|t|`: the submonoid of the product over the
labels `j = 1, …, ℓ*` generated by the *diagonal* units and one **value profile** `ξ`, a
family of theta values `ξ_j` at the labels `j` (each well defined up to roots of unity). The
`q`-pilot monoid is the analogous submonoid generated by the diagonal units and the diagonal
`q`-parameter `q_v` (the splitting monoid of the monoid `Ψ_cns`, IUT III, Definition 3.8(i);
IUT II, Remark 4.10.2(ii)). The value-group portion of the Θ-link sends one to the other
(IUT II, Remark 4.10.3(iii): `q_v ↦ {q_v^{j²}}_j`, read from the `q`-side).

The model here is concrete: `K_v` the completion of `K = D.Kt` at a bad place `v`, the units
`O^×` the elements of norm `1`, and the products indexed by `Fin ℓ*` (the label `j` is
`j.1 + 1`).

## Results

* **Splitting monoids** (`splitMonoid g = O^×·g^ℕ ⊆ L^n` for a generator `g`), and **splitting
  up to torsion** (IUT II, Corollary 3.5(iii)): if some entry has `0 < ‖g_j‖ < 1`, then
  `(u, N) ↦ u·g^N` is an isomorphism `O^× × ℕ ≃* splitMonoid g` (`splitEquiv`); the units of
  the splitting monoid are exactly the diagonal units (`norm_eq_one_iff`).
* **The value-group map of a link** `linkEquiv g g' : splitMonoid g ≃* splitMonoid g'`,
  `u·g^N ↦ u·g'^N`: the identity on the unit portion (`linkEquiv_diag`), the generator to the
  generator (`linkEquiv_gen`). It is the **only** isomorphism with these two properties
  (`linkEquiv_unique`).
* **The Gaussian and `q`-pilot monoids of `D`** at a bad place: `gaussGen D v` (the theta values
  `q_v^{j²}`, P16's `lgpValue`), `qGen D v` (the diagonal `q_v`), `gauss D v`, `qMonoid D v`;
  `0 < ‖q_v‖ < 1` (`norm_qroot_pos`, `norm_qroot_lt_one`); the **Θ-link on monoids**
  `gaussLink D v : gauss D v ≃* qMonoid D v`, which is the identity on the label `1`
  (`gaussLink_label_one`, IUT II, Remark 4.10.3(iii)) and not the identity on any other label
  (`gaussLink_ne_label`).
* **Value profiles** (Corollary 3.5(ii), Hodge–Arakelov-theoretic evaluation): families `ξ`
  whose entries are `ℓ`-th roots of the values `Θ_v(√-1·s^j)` of IUT's normalized theta function
  (P16, `thetaRatio`); `isValueProfile_iff`: these are exactly `ξ_j = ζ_j·q_v^{j²}` with
  `ζ_j^ℓ = 1`; `IsValueProfile.pow_eq`: `ξ^ℓ` does not depend on the value profile, so the
  Gaussian monoid `Ψ_{ℓ·ξ}` is independent of `ξ` (`gauss_pow_eq`, the analogue of "the
  submonoid `Ψ_{2l·ξ}` … is independent of the value-profile `ξ`"); every value profile has the
  norms of `gaussGen` (`IsValueProfile.norm_eq`) and its Gaussian monoid is split.
* **Degrees** (the realified value groups): the capsule-average `avgDeg g = (1/n)∑_j −log‖g_j‖`
  of the Gaussian generator is `s` times that of the `q`-pilot generator, `s = sFactor ℓ*`
  (`avgDeg_gaussGen`): the scale factor of the wall (`Iut.Wall.sFactor`) is the ratio of the
  realified degrees of the Gaussian and `q`-pilot monoids.
-/

noncomputable section

namespace Iut

namespace ThetaLink

open NumberField

/-! ### Splitting monoids -/

section Splitting

variable {L : Type*} [NormedField L] {n : ℕ}

/-- **The splitting monoid** `O^×·g^ℕ ⊆ L^n` generated by the diagonal units of norm one and
the generator `g` (IUT II, Corollary 3.5(ii): `Ψ_ξ = Ψ^×_cns⟨F_ℓ^*⟩·ξ^ℕ`). -/
def splitMonoid (g : Fin n → L) : Submonoid (Fin n → L) where
  carrier := {x | ∃ u : L, ‖u‖ = 1 ∧ ∃ N : ℕ, x = fun j => u * g j ^ N}
  mul_mem' := by
    rintro _ _ ⟨u, hu, N, rfl⟩ ⟨u', hu', N', rfl⟩
    refine ⟨u * u', by rw [norm_mul, hu, hu', one_mul], N + N', funext fun j => ?_⟩
    simp only [Pi.mul_apply, pow_add]
    ring
  one_mem' := ⟨1, norm_one, 0, funext fun _ => by simp⟩

lemma mem_splitMonoid {g : Fin n → L} {x : Fin n → L} :
    x ∈ splitMonoid g ↔ ∃ u : L, ‖u‖ = 1 ∧ ∃ N : ℕ, x = fun j => u * g j ^ N := Iff.rfl

/-- The element `u·g^N` of the splitting monoid. -/
def splitElt (g : Fin n → L) (u : L) (hu : ‖u‖ = 1) (N : ℕ) : splitMonoid g :=
  ⟨fun j => u * g j ^ N, u, hu, N, rfl⟩

@[simp] lemma coe_splitElt (g : Fin n → L) (u : L) (hu : ‖u‖ = 1) (N : ℕ) :
    (splitElt g u hu N : Fin n → L) = fun j => u * g j ^ N := rfl

/-- A generator with an entry of norm in `(0, 1)`. -/
def IsSplitGen (g : Fin n → L) : Prop := ∃ j, 0 < ‖g j‖ ∧ ‖g j‖ < 1

/-- **The splitting is unique** (IUT II, Corollary 3.5(iii), "splitting up to torsion"): for a
generator with an entry of norm in `(0, 1)`, `u·g^N` determines `u` and `N`. -/
theorem splitElt_injective {g : Fin n → L} (hg : IsSplitGen g) {u u' : L} {N N' : ℕ}
    (hu : ‖u‖ = 1) (hu' : ‖u'‖ = 1)
    (h : (fun j => u * g j ^ N) = fun j => u' * g j ^ N') : u = u' ∧ N = N' := by
  obtain ⟨j, h0, h1⟩ := hg
  have hj := congrFun h j
  have hN : N = N' := by
    have := congrArg norm hj
    simp only [norm_mul, norm_pow, hu, hu', one_mul] at this
    exact pow_right_injective₀ h0 h1.ne this
  subst hN
  refine ⟨?_, rfl⟩
  have hg0 : g j ^ N ≠ 0 := pow_ne_zero _ (norm_pos_iff.mp h0)
  exact mul_right_cancel₀ hg0 hj

/-- The splitting homomorphism `O^× × ℕ → splitMonoid g`, `(u, N) ↦ u·g^N`. -/
def splitHom (g : Fin n → L) :
    HodgeTheater.unitsOne L × Multiplicative ℕ →* splitMonoid g where
  toFun p := splitElt g ((p.1 : Lˣ) : L) p.1.2 (Multiplicative.toAdd p.2)
  map_one' := by
    apply Subtype.ext
    funext j
    simp
  map_mul' p p' := by
    apply Subtype.ext
    funext j
    simp only [coe_splitElt, Prod.fst_mul, Prod.snd_mul, Subgroup.coe_mul, Units.val_mul,
      toAdd_mul, pow_add, Submonoid.coe_mul, Pi.mul_apply]
    ring

lemma coe_splitHom (g : Fin n → L) (p : HodgeTheater.unitsOne L × Multiplicative ℕ) :
    (splitHom g p : Fin n → L) = fun j => ((p.1 : Lˣ) : L) * g j ^ (Multiplicative.toAdd p.2) :=
  rfl

theorem splitHom_bijective {g : Fin n → L} (hg : IsSplitGen g) :
    Function.Bijective (splitHom g) := by
  constructor
  · rintro ⟨u, N⟩ ⟨u', N'⟩ h
    have h' := congrArg Subtype.val h
    rw [coe_splitHom, coe_splitHom] at h'
    obtain ⟨hu, hN⟩ := splitElt_injective hg u.2 u'.2 h'
    refine Prod.ext (Subtype.ext (Units.ext hu)) ?_
    exact Multiplicative.toAdd.injective hN
  · rintro ⟨x, u, hu, N, rfl⟩
    have hu0 : u ≠ 0 := by
      rintro rfl
      simp at hu
    refine ⟨(⟨Units.mk0 u hu0, hu⟩, Multiplicative.ofAdd N), ?_⟩
    rfl

/-- **Splitting up to torsion** (IUT II, Corollary 3.5(iii)): `O^× × ℕ ≃* splitMonoid g`. -/
def splitEquiv {g : Fin n → L} (hg : IsSplitGen g) :
    HodgeTheater.unitsOne L × Multiplicative ℕ ≃* splitMonoid g :=
  MulEquiv.ofBijective (splitHom g) (splitHom_bijective hg)

lemma splitEquiv_apply {g : Fin n → L} (hg : IsSplitGen g)
    (p : HodgeTheater.unitsOne L × Multiplicative ℕ) : splitEquiv hg p = splitHom g p := rfl

/-- **The units of a splitting monoid are the diagonal units**: an element `u·g^N` has an entry
of norm one at an entry of norm in `(0, 1)` iff `N = 0`. -/
theorem norm_eq_one_iff {g : Fin n → L} {j : Fin n} (h0 : 0 < ‖g j‖) (h1 : ‖g j‖ < 1)
    {u : L} (hu : ‖u‖ = 1) (N : ℕ) : ‖u * g j ^ N‖ = 1 ↔ N = 0 := by
  rw [norm_mul, hu, one_mul, norm_pow]
  constructor
  · intro h
    exact pow_right_injective₀ h0 h1.ne (h.trans (pow_zero _).symm)
  · rintro rfl
    exact pow_zero _

/-! ### The value-group map of a link -/

/-- **The value-group map of a link on splitting monoids**: `u·g^N ↦ u·g'^N`. -/
def linkEquiv {g g' : Fin n → L} (hg : IsSplitGen g) (hg' : IsSplitGen g') :
    splitMonoid g ≃* splitMonoid g' :=
  (splitEquiv hg).symm.trans (splitEquiv hg')

theorem linkEquiv_splitElt {g g' : Fin n → L} (hg : IsSplitGen g) (hg' : IsSplitGen g')
    (u : L) (hu : ‖u‖ = 1) (N : ℕ) :
    linkEquiv hg hg' (splitElt g u hu N) = splitElt g' u hu N := by
  have hu0 : u ≠ 0 := by
    rintro rfl
    simp at hu
  have h : splitElt g u hu N = splitEquiv hg (⟨Units.mk0 u hu0, hu⟩, Multiplicative.ofAdd N) :=
    rfl
  rw [linkEquiv, MulEquiv.trans_apply, h, MulEquiv.symm_apply_apply]
  rfl

/-- **The unit portions are identified**: the link is the identity on the diagonal units. -/
theorem linkEquiv_diag {g g' : Fin n → L} (hg : IsSplitGen g) (hg' : IsSplitGen g')
    (u : L) (hu : ‖u‖ = 1) :
    (linkEquiv hg hg' (splitElt g u hu 0) : Fin n → L) = fun _ => u := by
  rw [linkEquiv_splitElt]
  funext j
  simp

/-- **The generator goes to the generator.** -/
theorem linkEquiv_gen {g g' : Fin n → L} (hg : IsSplitGen g) (hg' : IsSplitGen g') :
    (linkEquiv hg hg' (splitElt g 1 norm_one 1) : Fin n → L) = g' := by
  rw [linkEquiv_splitElt]
  funext j
  simp

/-- **Uniqueness**: a monoid homomorphism `splitMonoid g → splitMonoid g'` that is the identity
on the diagonal units and sends the generator to the generator is `linkEquiv`. -/
theorem linkEquiv_unique {g g' : Fin n → L} (hg : IsSplitGen g) (hg' : IsSplitGen g')
    (f : splitMonoid g →* splitMonoid g')
    (hunit : ∀ u (hu : ‖u‖ = 1), f (splitElt g u hu 0) = splitElt g' u hu 0)
    (hgen : f (splitElt g 1 norm_one 1) = splitElt g' 1 norm_one 1) :
    ∀ x, f x = linkEquiv hg hg' x := by
  rintro ⟨x, u, hu, N, rfl⟩
  have hx : (⟨fun j => u * g j ^ N, u, hu, N, rfl⟩ : splitMonoid g) =
      splitElt g u hu 0 * splitElt g 1 norm_one 1 ^ N := by
    apply Subtype.ext
    funext j
    simp [SubmonoidClass.coe_pow]
  rw [hx, map_mul, map_pow, hunit, hgen, map_mul, map_pow, linkEquiv_splitElt,
    linkEquiv_splitElt]

/-! ### Degrees -/

/-- **The capsule-average degree** `(1/n)·∑_j −log‖g_j‖` of a generator: the realified degree
of the splitting monoid (normalized by the number of labels, as the procession-normalized
log-volume, IUT III, Proposition 3.9). -/
def avgDeg (g : Fin n → L) : ℝ := (∑ j, -Real.log ‖g j‖) / n

lemma avgDeg_const (n : ℕ) (hn : 0 < n) (q : L) :
    avgDeg (fun _ : Fin n => q) = -Real.log ‖q‖ := by
  have : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  rw [avgDeg, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  field_simp

/-- **The Gaussian generator `(q^{j²})_{j = 1..n}` has `s` times the degree of `q`**, with
`s = (1² + ⋯ + n²)/n` the scale factor of the wall. -/
theorem avgDeg_gaussian (q : L) :
    avgDeg (fun j : Fin n => q ^ ((j.1 + 1) ^ 2)) = Wall.sFactor n * -Real.log ‖q‖ := by
  rw [avgDeg, Wall.sFactor]
  simp only [norm_pow, Real.log_pow]
  rw [Fin.sum_univ_eq_sum_range (fun j => -(((j + 1) ^ 2 : ℕ) * Real.log ‖q‖)) n]
  rw [div_mul_eq_mul_div, Finset.sum_mul]
  congr 1
  refine Finset.sum_congr rfl fun j _ => ?_
  push_cast
  ring

end Splitting

/-! ### The Gaussian and `q`-pilot monoids of initial Θ-data -/

variable (D : InitialThetaData.{0})

/-- `0 < ‖q_v‖` at a bad place. -/
lemma norm_qroot_pos (v : FinitePlace D.Kt) : 0 < ‖D.qroot v‖ :=
  norm_pos_iff.mpr (D.qroot_ne_zero v)

/-- `‖q_v‖ < 1` at a bad place (`q_v^{2ℓ}` is the Tate parameter). -/
lemma norm_qroot_lt_one {v : FinitePlace D.Kt} (hv : IsBadK D v) : ‖D.qroot v‖ < 1 := by
  have h := qrootOf_spec D hv
  have hq := (D.tate.S v hv).t.norm_lt_one
  rw [← h, norm_pow] at hq
  have hℓ : 2 * D.ℓ ≠ 0 := by
    have := D.prime.five_le
    unfold InitialThetaData.ℓ
    omega
  exact (pow_lt_one_iff_of_nonneg (norm_nonneg _) hℓ).mp hq

/-- **The Gaussian generator** at a bad place: the theta values `q_v^{j²}` at the labels
`j = 1, …, ℓ*` (P16, `EtaleTheta.lgpValue`). -/
def gaussGen (v : FinitePlace D.Kt) : Fin (Wall.nC D) → completionAt D.Kt v :=
  fun j => EtaleTheta.lgpValue D v (j.1 + 1)

/-- **The `q`-pilot generator**: the diagonal `q_v`. -/
def qGen (v : FinitePlace D.Kt) : Fin (Wall.nC D) → completionAt D.Kt v := fun _ => D.qroot v

/-- **The Gaussian monoid** `Ψ_gau = O^×·{q_v^{j²}}_j^ℕ` (IUT II, Corollaries 3.5(ii), 3.6(ii)). -/
abbrev gauss (v : FinitePlace D.Kt) : Submonoid (Fin (Wall.nC D) → completionAt D.Kt v) :=
  splitMonoid (gaussGen D v)

/-- **The `q`-pilot monoid** `O^×·q_v^ℕ` (diagonal; IUT III, Definition 3.8(i)). -/
abbrev qMonoid (v : FinitePlace D.Kt) : Submonoid (Fin (Wall.nC D) → completionAt D.Kt v) :=
  splitMonoid (qGen D v)

/-- The label `1` (index `0`). -/
def labelOne : Fin (Wall.nC D) := ⟨0, Wall.nC_pos D⟩

lemma isSplitGen_qGen {v : FinitePlace D.Kt} (hv : IsBadK D v) : IsSplitGen (qGen D v) :=
  ⟨labelOne D, norm_qroot_pos D v, norm_qroot_lt_one D hv⟩

lemma gaussGen_labelOne (v : FinitePlace D.Kt) : gaussGen D v (labelOne D) = D.qroot v := by
  simp [gaussGen, labelOne, EtaleTheta.lgpValue]

lemma isSplitGen_gaussGen {v : FinitePlace D.Kt} (hv : IsBadK D v) :
    IsSplitGen (gaussGen D v) :=
  ⟨labelOne D, by rw [gaussGen_labelOne]; exact norm_qroot_pos D v,
    by rw [gaussGen_labelOne]; exact norm_qroot_lt_one D hv⟩

/-- **The value-group portion of the Θ-link on monoids** at a bad place: the Gaussian monoid of
the Θ-side to the `q`-pilot monoid of the `q`-side, `u·{q_v^{j²}}^N ↦ u·q_v^N`. -/
def gaussLink {v : FinitePlace D.Kt} (hv : IsBadK D v) : gauss D v ≃* qMonoid D v :=
  linkEquiv (isSplitGen_gaussGen D hv) (isSplitGen_qGen D hv)

/-- **At the label `1` the Θ-link on monoids is the identity** (IUT II, Remark 4.10.3(iii)):
the entry at the label `1` is unchanged. -/
theorem gaussLink_label_one {v : FinitePlace D.Kt} (hv : IsBadK D v) (x : gauss D v) :
    (gaussLink D hv x : Fin (Wall.nC D) → completionAt D.Kt v) (labelOne D) =
      (x : Fin (Wall.nC D) → completionAt D.Kt v) (labelOne D) := by
  obtain ⟨_, u, hu, N, rfl⟩ := x
  have h := congrArg
    (fun y : qMonoid D v => (y : Fin (Wall.nC D) → completionAt D.Kt v) (labelOne D))
    (linkEquiv_splitElt (isSplitGen_gaussGen D hv) (isSplitGen_qGen D hv) u hu N)
  refine h.trans ?_
  simp [qGen, gaussGen_labelOne]

/-- **At every other label the Θ-link on monoids is not the identity**: the Gaussian generator's
entry `q_v^{j²}` (`j ≥ 2`) goes to `q_v ≠ q_v^{j²}`. -/
theorem gaussLink_ne_label {v : FinitePlace D.Kt} (hv : IsBadK D v) (j : Fin (Wall.nC D))
    (hj : j ≠ labelOne D) :
    (gaussLink D hv (splitElt _ 1 norm_one 1) : Fin (Wall.nC D) → completionAt D.Kt v) j ≠
      gaussGen D v j := by
  rw [gaussLink, linkEquiv_gen]
  intro h
  have h0 := norm_qroot_pos D v
  have h1 := norm_qroot_lt_one D hv
  have h' := congrArg norm h
  simp only [qGen, gaussGen, EtaleTheta.lgpValue, norm_pow] at h'
  have := pow_right_injective₀ h0 h1.ne (h'.symm.trans (pow_one _).symm)
  apply hj
  apply Fin.ext
  change j.1 = 0
  have h2 : (j.1 + 1) ^ 2 = 1 := this
  nlinarith [Nat.zero_le j.1]

/-! ### Value profiles (Hodge–Arakelov-theoretic evaluation) -/

/-- **A value profile** (IUT II, Corollary 3.5(ii)): at every label `j`, an `ℓ`-th root of the
value `Θ_v(√-1·s^j) = (s^j θ(q^j)/θ(1))⁻¹` of IUT's normalized theta function (P16,
`EtaleTheta.thetaRatio`; the evaluation of the theta function at the evaluation points labelled
`j`). -/
def IsValueProfile {v : FinitePlace D.Kt} (hv : IsBadK D v)
    (ξ : Fin (Wall.nC D) → completionAt D.Kt v) : Prop :=
  ∀ j, ξ j ^ D.ℓ =
    (EtaleTheta.thetaRatio (D.tate.S v hv).t (EtaleTheta.sqrtQ D v) (j.1 + 1))⁻¹

/-- **The value profiles are exactly the `μ_ℓ`-multiples of the Gaussian generator** (P16,
`pow_eq_thetaRatio_inv_iff`). -/
theorem isValueProfile_iff {v : FinitePlace D.Kt} (hv : IsBadK D v)
    (ξ : Fin (Wall.nC D) → completionAt D.Kt v) :
    IsValueProfile D hv ξ ↔ ∀ j, ∃ ζ : completionAt D.Kt v, ζ ^ D.ℓ = 1 ∧
      ξ j = ζ * gaussGen D v j :=
  forall_congr' fun j => EtaleTheta.pow_eq_thetaRatio_inv_iff D hv (j.1 + 1) (ξ j)

theorem isValueProfile_gaussGen {v : FinitePlace D.Kt} (hv : IsBadK D v) :
    IsValueProfile D hv (gaussGen D v) :=
  (isValueProfile_iff D hv _).mpr fun _ => ⟨1, one_pow _, (one_mul _).symm⟩

/-- **`ξ^ℓ` does not depend on the value profile**: it is the family of theta values. -/
theorem IsValueProfile.pow_eq {v : FinitePlace D.Kt} {hv : IsBadK D v}
    {ξ ξ' : Fin (Wall.nC D) → completionAt D.Kt v} (h : IsValueProfile D hv ξ)
    (h' : IsValueProfile D hv ξ') : (fun j => ξ j ^ D.ℓ) = fun j => ξ' j ^ D.ℓ :=
  funext fun j => (h j).trans (h' j).symm

/-- **The Gaussian monoid `Ψ_{ℓ·ξ}` does not depend on the value profile `ξ`** (the analogue of
IUT II, Corollary 3.5(ii): "`Ψ_{2l·ξ}` … is independent of the value-profile `ξ`"; here the
roots are `ℓ`-th roots, so the exponent `ℓ` suffices). -/
theorem gauss_pow_eq {v : FinitePlace D.Kt} {hv : IsBadK D v}
    {ξ ξ' : Fin (Wall.nC D) → completionAt D.Kt v} (h : IsValueProfile D hv ξ)
    (h' : IsValueProfile D hv ξ') :
    splitMonoid (fun j => ξ j ^ D.ℓ) = splitMonoid (fun j => ξ' j ^ D.ℓ) := by
  rw [IsValueProfile.pow_eq D h h']

/-- Roots of unity have norm one. -/
lemma norm_eq_one_of_pow {L : Type*} [NormedField L] {ζ : L} {m : ℕ} (hm : m ≠ 0)
    (h : ζ ^ m = 1) : ‖ζ‖ = 1 := by
  have h' := congrArg norm h
  rw [norm_pow, norm_one] at h'
  exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) hm).mp h'

/-- **Every value profile has the norms of the Gaussian generator** (the roots of unity are
units of norm one). -/
theorem IsValueProfile.norm_eq {v : FinitePlace D.Kt} {hv : IsBadK D v}
    {ξ : Fin (Wall.nC D) → completionAt D.Kt v} (h : IsValueProfile D hv ξ) (j) :
    ‖ξ j‖ = ‖gaussGen D v j‖ := by
  obtain ⟨ζ, hζ, hξ⟩ := (isValueProfile_iff D hv ξ).mp h j
  have hℓ : D.ℓ ≠ 0 := by
    have := D.prime.five_le
    unfold InitialThetaData.ℓ
    omega
  rw [hξ, norm_mul, norm_eq_one_of_pow hℓ hζ, one_mul]

/-- The Gaussian monoid of every value profile is split. -/
theorem IsValueProfile.isSplitGen {v : FinitePlace D.Kt} {hv : IsBadK D v}
    {ξ : Fin (Wall.nC D) → completionAt D.Kt v} (h : IsValueProfile D hv ξ) : IsSplitGen ξ := by
  obtain ⟨j, h0, h1⟩ := isSplitGen_gaussGen D hv
  exact ⟨j, by rw [h.norm_eq]; exact h0, by rw [h.norm_eq]; exact h1⟩

/-! ### Degrees of the Gaussian and `q`-pilot monoids -/

/-- **The degree of the Gaussian generator is `s` times the degree of the `q`-pilot generator**,
`s = sFactor ℓ*` (`Iut.Wall.sFactor`, `D.wallS`). -/
theorem avgDeg_gaussGen (v : FinitePlace D.Kt) :
    avgDeg (gaussGen D v) = D.wallS * avgDeg (qGen D v) := by
  rw [show qGen D v = fun _ => D.qroot v from rfl, avgDeg_const _ (Wall.nC_pos D)]
  exact avgDeg_gaussian (D.qroot v)

/-- The degree of every value profile is that of the Gaussian generator. -/
theorem IsValueProfile.avgDeg_eq {v : FinitePlace D.Kt} {hv : IsBadK D v}
    {ξ : Fin (Wall.nC D) → completionAt D.Kt v} (h : IsValueProfile D hv ξ) :
    avgDeg ξ = avgDeg (gaussGen D v) := by
  simp only [avgDeg, IsValueProfile.norm_eq D h]

/-- `avgDeg(q-pilot) = −log‖q_v‖ > 0` at a bad place. -/
theorem avgDeg_qGen_pos {v : FinitePlace D.Kt} (hv : IsBadK D v) : 0 < avgDeg (qGen D v) := by
  rw [show qGen D v = fun _ => D.qroot v from rfl, avgDeg_const _ (Wall.nC_pos D)]
  have := Real.log_neg (norm_qroot_pos D v) (norm_qroot_lt_one D hv)
  linarith

/-- **The Gaussian and `q`-pilot monoids have different degrees** (`s > 1`): the Θ-link on
monoids is not degree preserving; it divides degrees by `s`. -/
theorem avgDeg_gaussGen_ne {v : FinitePlace D.Kt} (hv : IsBadK D v) :
    avgDeg (gaussGen D v) ≠ avgDeg (qGen D v) := by
  rw [avgDeg_gaussGen]
  intro h
  have h1 := D.one_lt_wallS
  have h2 := avgDeg_qGen_pos D hv
  nlinarith

end ThetaLink

end Iut
