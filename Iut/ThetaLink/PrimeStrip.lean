import Iut.HodgeTheater.Wall
import Iut.Frobenioid.Wall

/-!
# `F^{⊩▶×μ}`-prime-strips (IUT II, Definition 4.9(vi)–(viii); Corollary 4.10(i)–(iv))

IUT II, Definition 4.9(viii): an `F^{⊩▶×μ}`-prime-strip is a collection
`(C^⊩, Prime(C^⊩) ≅ V, F^{⊢▶×μ}, {ρ_v})`: a global realified Frobenioid, an `F^{⊢▶×μ}`-prime-strip
(at each `v` a split-Kummer Frobenioid whose units form `O^{×μ}` and whose splitting monoid
`O^▶ ≅ ℕ` is generated by a single element at `v ∈ V^bad`), and the isomorphisms `ρ_v`
identifying the realified local value groups with the local data of `C^⊩`; the generators of
the monoids `O^▶` at `V^bad` together with the `ρ_v` determine the **pilot object**. Its
morphisms are isomorphisms of all these data.

## The model

`RlfMuStrip D` has two portions:

* **the unit portion** `unit : FMuStrip D` — the `F^{⊢×μ}`-prime-strip
  (`Multiradial.PrimeStrip.FMuStrip`, MR20: `G_v ↷ O^{×μ}_{\bar{ℚ}_p}` with the natural Galois
  action at `v ∈ V^non`, `{1} ↷ S¹/μ_∞` at `v ∈ V^arc`);
* **the value-group portion** `val : ValBPS (Pl D) bad` — the realified global value-group line
  `C` (the realification of `C^⊩` is a real line, [FrdI], Theorem 6.4) with the local pilots
  `φ_v ∈ C`, the images under `ρ_v` of the generators of the splitting monoids `O^▶` at `V^bad`
  (and of the analogous elements elsewhere). This is the value-group BPS of the wall
  (`Iut/Wall/BPS.lean`, [LANA], Definitions 4.1.3, 4.1.4); its pilot `∑_{v ∈ V^bad} φ_v` is the
  pilot object of Definition 4.9(viii).

Isomorphisms (`RlfMuStrip.Iso`) are pairs of an isomorphism of `F^{⊢×μ}`-prime-strips and an
isomorphism of value-group lines carrying local pilots to local pilots. **Simplifications**
(documented): the splitting monoids `O^▶` and the Frobenioid `C^⊩` itself are recorded only
through their realified value groups and the local pilots (the realified Frobenioid degree of
the pilot objects is related to `C^⊩` of P15 in `Link.lean`); the value-group lines are
indexed by the places of `F` (the wall's indexing `Pl D`), the unit portion by `V ≅ V_mod`.

## The strips of a `Θ^{±ell}NF`-Hodge theater (IUT II, Corollary 4.10(i)–(iv))

* `qStrip H` = `‡F^{⊩▶×μ}_Δ`: the unit portion of `H` with the `q`-pilot value-group line
  (`Wall.qVal`: local pilots `deg(q_v)`, the splitting monoids of the monoids `Ψ_cns` generated
  by `q_v`, IUT III, Definition 3.8(i));
* `gauStrip H` = `†F^{⊩▶×μ}_gau` (and `†F^{⊩▶×μ}_LGP`): the unit portion of `H` with the
  Θ-pilot (Gaussian) value-group line (`Wall.thetaVal`: local pilots `Θ_v` of degree `s·deg(q_v)`,
  the generators of the Gaussian monoids, `Gauss.lean`).

Both have the **same** unit portion `H.Fmu` (`unit_qStrip`, `unit_gauStrip`): the natural
isomorphisms `F^{⊢×μ}_Δ ≅ F^{⊢×μ}_env ≅ F^{⊢×μ}_gau` of IUT II, Corollary 4.10(iv) ("the
definition of the unit portion of the theta and Gaussian monoids") are identities in the model.
Isomorphisms of Hodge theaters induce isomorphisms of both strips (`qStripIso`, `gauStripIso`).
The strips, as BPSs, are exactly the `q`-pilot and Θ-pilot BPSs of the wall's η-algorithm over
the theaters (`toBPS_qStrip`, `toBPS_gauStrip`, `rfl`).
-/

noncomputable section

namespace Iut

namespace ThetaLink

open HodgeTheater Wall NumberField

/-! ### Groupoid laws for isomorphisms of `F^{⊢×μ}`-prime-strips -/

namespace FMuIso

open Multiradial.PrimeStrip (FMuStrip GMObj)

variable {D : InitialThetaData.{0}} {P Q R : FMuStrip D}

theorem ext {f g : P.Iso Q}
    (h : ∀ x, (∀ a, (FMuStripAt.iso f x).G a = (FMuStripAt.iso g x).G a) ∧
      ∀ m, (FMuStripAt.iso f x).M m = (FMuStripAt.iso g x).M m) : f = g :=
  Prod.ext (funext fun v => GMObj.Iso.ext (h (Sum.inl v)).1 (h (Sum.inl v)).2)
    (funext fun v => GMObj.Iso.ext (h (Sum.inr v)).1 (h (Sum.inr v)).2)

/-- `f⁻¹ ∘ (f ∘ g) = g`. -/
theorem symm_trans_trans (f : P.Iso Q) (g : Q.Iso R) :
    FMuStrip.Iso.trans f.symm (FMuStrip.Iso.trans f g) = g :=
  ext fun _ => ⟨fun _ => by simp, fun _ => by simp⟩

/-- `f ∘ (f⁻¹ ∘ g) = g`. -/
theorem trans_symm_trans (f : Q.Iso P) (g : Q.Iso R) :
    FMuStrip.Iso.trans f (FMuStrip.Iso.trans f.symm g) = g :=
  ext fun _ => ⟨fun _ => by simp, fun _ => by simp⟩

/-- `(f ∘ g⁻¹) ∘ g = f`. -/
theorem trans_symm_trans' (f : P.Iso Q) (g : R.Iso Q) :
    FMuStrip.Iso.trans (FMuStrip.Iso.trans f g.symm) g = f :=
  ext fun _ => ⟨fun _ => by simp, fun _ => by simp⟩

/-- `(f ∘ g) ∘ g⁻¹ = f`. -/
theorem trans_trans_symm (f : P.Iso Q) (g : Q.Iso R) :
    FMuStrip.Iso.trans (FMuStrip.Iso.trans f g) g.symm = f :=
  ext fun _ => ⟨fun _ => by simp, fun _ => by simp⟩

/-- Conjugation cancels: `f ∘ ((f⁻¹ ∘ (u ∘ g)) ∘ g⁻¹) = u`. -/
theorem conj_cancel {P' Q' : FMuStrip D} (f : P.Iso P') (g : Q.Iso Q') (u : P.Iso Q) :
    FMuStrip.Iso.trans f (FMuStrip.Iso.trans (FMuStrip.Iso.trans f.symm
      (FMuStrip.Iso.trans u g)) g.symm) = u :=
  ext fun _ => ⟨fun _ => by simp, fun _ => by simp⟩

/-- Conjugation cancels: `f⁻¹ ∘ ((f ∘ (u ∘ g⁻¹)) ∘ g) = u`. -/
theorem conj_cancel' {P' Q' : FMuStrip D} (f : P.Iso P') (g : Q.Iso Q') (u : P'.Iso Q') :
    FMuStrip.Iso.trans f.symm (FMuStrip.Iso.trans (FMuStrip.Iso.trans f
      (FMuStrip.Iso.trans u g.symm)) g) = u :=
  ext fun _ => ⟨fun _ => by simp, fun _ => by simp⟩

end FMuIso

variable (D : InitialThetaData.{0})

open Multiradial.PrimeStrip (FMuStrip)

/-! ### `F^{⊩▶×μ}`-prime-strips -/

/-- **An `F^{⊩▶×μ}`-prime-strip** (IUT II, Definition 4.9(viii); see the module docstring for the
encoding): a unit portion (an `F^{⊢×μ}`-prime-strip) and a value-group portion (the realified
global value-group line with its local pilots). -/
structure RlfMuStrip where
  /-- The unit portion `F^{⊢×μ}`. -/
  unit : FMuStrip D
  /-- The value-group portion: the realified value-group line with the local pilots. -/
  val : ValBPS (Pl D) D.bpsDegrees.bad

namespace RlfMuStrip

variable {D}

/-- **A morphism of `F^{⊩▶×μ}`-prime-strips** (IUT II, Definition 4.9(viii)): an isomorphism of
the unit portions and an isomorphism of the value-group portions. -/
structure Iso (P Q : RlfMuStrip D) where
  /-- The isomorphism of the unit portions. -/
  unit : P.unit.Iso Q.unit
  /-- The isomorphism of the value-group portions (local pilots to local pilots). -/
  val : ValBPS.Iso P.val Q.val

/-- The identity. -/
def Iso.refl (P : RlfMuStrip D) : P.Iso P := ⟨FMuStrip.Iso.refl _, ValBPS.Iso.refl _⟩

/-- The inverse. -/
def Iso.symm {P Q : RlfMuStrip D} (f : P.Iso Q) : Q.Iso P := ⟨f.unit.symm, f.val.symm⟩

/-- The composite. -/
def Iso.trans {P Q R : RlfMuStrip D} (f : P.Iso Q) (g : Q.Iso R) : P.Iso R :=
  ⟨f.unit.trans g.unit, f.val.trans g.val⟩

/-- **The pilot** (the pilot object of IUT II, Definition 4.9(viii), in the realified value
group). -/
noncomputable abbrev pilot (P : RlfMuStrip D) : P.val.C := P.val.pilot

/-- **Morphisms preserve pilots** (the pilot object is determined by the data). -/
theorem Iso.map_pilot {P Q : RlfMuStrip D} (f : P.Iso Q) :
    f.val.toLinearEquiv P.pilot = Q.pilot :=
  ValBPS.Iso.map_pilot f.val

/-- **Two `F^{⊩▶×μ}`-prime-strips are isomorphic iff their value-group portions have the same
product formula** (any two unit portions are isomorphic, `FMuStrip.nonempty_iso`; [LANA],
Lemma 4.1.7 for the value-group portions). -/
theorem nonempty_iso_iff (P Q : RlfMuStrip D) : Nonempty (P.Iso Q) ↔ P.val.PF = Q.val.PF := by
  rw [← ValBPS.nonempty_iso_iff]
  constructor
  · rintro ⟨f⟩
    exact ⟨f.val⟩
  · rintro ⟨g⟩
    exact ⟨⟨(FMuStrip.nonempty_iso _ _).some, g⟩⟩

/-- **The value-group portion of a morphism is unique.** -/
theorem Iso.val_eq {P Q : RlfMuStrip D} (f g : P.Iso Q) : f.val = g.val :=
  (ValBPS.valIso_subsingleton P.val Q.val).elim _ _

/-- **The morphisms are determined by their unit portions**, and every isomorphism of unit
portions occurs: if the strips are isomorphic, the full poly-isomorphism is the full
poly-isomorphism of the `F^{⊢×μ}`-prime-strips. -/
noncomputable def isoEquivUnit {P Q : RlfMuStrip D} (h : Nonempty (P.Iso Q)) :
    P.Iso Q ≃ P.unit.Iso Q.unit where
  toFun f := f.unit
  invFun u := ⟨u, h.some.val⟩
  left_inv f := by
    obtain ⟨u, v⟩ := f
    simp only [Iso.mk.injEq, true_and]
    exact (ValBPS.valIso_subsingleton P.val Q.val).elim _ _
  right_inv _ := rfl

/-- **The BPS of an `F^{⊩▶×μ}`-prime-strip** (the unit portion pulled back to the places of `F`,
`HodgeTheater.etUnitOf`). -/
noncomputable def toBPS (P : RlfMuStrip D) : BPS (etModel D) D.bpsDegrees.bad :=
  ⟨etUnitOf D P.unit, P.val⟩

/-- **The BPS isomorphism of a morphism.** -/
noncomputable def Iso.toBPS {P Q : RlfMuStrip D} (f : P.Iso Q) : BPS.Iso P.toBPS Q.toBPS :=
  ⟨etUnitIsoOfStrip D f.unit, f.val⟩

end RlfMuStrip

/-! ### The strips of a Hodge theater -/

/-- **`‡F^{⊩▶×μ}_Δ`** (IUT II, Corollary 4.10(i), (iii)): the unit portion of the theater with
the `q`-pilot value-group line. -/
noncomputable def qStrip (H : ThetaPmEllNFHT D) : RlfMuStrip D := ⟨H.Fmu, qVal D.bpsDegrees⟩

/-- **`†F^{⊩▶×μ}_gau`** (IUT II, Corollary 4.10(ii), (iii); also `†F^{⊩▶×μ}_LGP`, IUT III,
Definition 3.8(ii)): the unit portion of the theater with the Θ-pilot (Gaussian) value-group
line. -/
noncomputable def gauStrip (H : ThetaPmEllNFHT D) : RlfMuStrip D := ⟨H.Fmu, D.thetaValD⟩

/-- **The unit portions agree** (IUT II, Corollary 4.10(iv): `F^{⊢×μ}_Δ ≅ F^{⊢×μ}_gau`). -/
theorem unit_qStrip (H : ThetaPmEllNFHT D) : (qStrip D H).unit = H.Fmu := rfl

theorem unit_gauStrip (H : ThetaPmEllNFHT D) : (gauStrip D H).unit = H.Fmu := rfl

/-- **The natural isomorphism of unit portions** `F^{⊢×μ}_Δ ≅ F^{⊢×μ}_gau` (IUT II, Corollary
4.10(iv)): the identity. -/
def unitIdent (H : ThetaPmEllNFHT D) : (qStrip D H).unit.Iso (gauStrip D H).unit :=
  FMuStrip.Iso.refl _

/-- The pilot of `‡F^{⊩▶×μ}_Δ` is `|log q|`. -/
theorem pilot_qStrip (H : ThetaPmEllNFHT D) : (qStrip D H).pilot = D.qPilot.absLogQ :=
  D.pilot_qVal

/-- The degree of the pilot of `†F^{⊩▶×μ}_gau` is `s·|log q|`. -/
theorem degTheta_pilot_gauStrip (H : ThetaPmEllNFHT D) :
    degTheta D.bpsDegrees D.wallS_ne_zero (gauStrip D H).pilot = D.wallS * D.qPilot.absLogQ := by
  change degTheta D.bpsDegrees D.wallS_ne_zero (thetaVal D.bpsDegrees D.wallS_ne_zero).pilot = _
  rw [degTheta_pilot, ← qVal_pilot, D.pilot_qVal]

/-- **Isomorphisms of Hodge theaters induce isomorphisms of the `q`-pilot strips.** -/
noncomputable def qStripIso {H H' : ThetaPmEllNFHT D} (f : H.Iso H') :
    (qStrip D H).Iso (qStrip D H') :=
  ⟨f.Fmu, ValBPS.Iso.refl _⟩

/-- **Isomorphisms of Hodge theaters induce isomorphisms of the Gaussian strips.** -/
noncomputable def gauStripIso {H H' : ThetaPmEllNFHT D} (f : H.Iso H') :
    (gauStrip D H).Iso (gauStrip D H') :=
  ⟨f.Fmu, ValBPS.Iso.refl _⟩

variable {σ : Type} [Nonempty σ]

/-- **The `q`-pilot strip is the `q`-pilot BPS of the wall's η-algorithm over the theaters.** -/
theorem toBPS_qStrip (H : σ → ThetaPmEllNFHT D) (h : σ) :
    (qStrip D (H h)).toBPS = (theaterAlg D H).qBPS h := rfl

/-- **The Gaussian strip is the Θ-pilot BPS of the wall's η-algorithm over the theaters.** -/
theorem toBPS_gauStrip (H : σ → ThetaPmEllNFHT D) (h : σ) :
    (gauStrip D (H h)).toBPS = (theaterAlg D H).thetaBPS h := rfl

end ThetaLink

end Iut
