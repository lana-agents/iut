import Iut.ThetaLink.Gauss
import ContinuousKummerTheory.Kummer.Equiv

/-!
# Kummer compatibility of the Θ-link (IUT II, Corollaries 3.5, 4.10(iv); Remarks 4.10.2, 4.10.3)

The Θ-link identifies the **unit portions** of the two sides and is, on the **value-group
portions**, the map `u·{q_v^{j²}}^N ↦ u·q_v^N` of splitting monoids (`Gauss.lean`). IUT II,
Remark 4.10.3(i), (ii): the units are *coric* (this "will allow us to compare volumes on either
side"), while the value-group portion "is by no means preserved" — "a sort of Frobenius
morphism". Here this dichotomy is made precise for the **Kummer maps**
`κ : Kˣ → H¹_cont(Gal(Ω/K), μ_n)` (`continuous-kummer-theory`), which relate the Frobenius-like
monoids to their étale-like (Galois-cohomological) counterparts.

Everything is stated for an arbitrary field `K` with a Galois extension `Ω` containing the
`n`-th roots (the setting of `KummerTheory.kummer`, e.g. a separable closure of `K_v`).

* `kummer_splitElt`: the Kummer class of the Gaussian monoid element `u·(ζ·q^e)^N` is
  `κ(u)·κ(ζ)^N·κ(q)^{eN}` — the étale-like Gaussian monoid is generated by the Kummer classes of
  the units and of the theta values (IUT II, Corollary 3.5(ii), (iii): the Kummer-theoretic
  construction of the Gaussian monoids, "splitting up to torsion");
* `kummer_pow_eq_of_root`: for `ζ^ℓ = 1`, `κ(ζ·q^e)^ℓ = κ(q)^{eℓ}`, i.e. the `ℓ`-th powers of the
  Kummer classes of a value profile do not depend on the profile (Corollary 3.5(ii), at the
  level of Kummer classes);
* **unit portion — compatible**: a map of splitting monoids that is the identity on the unit
  portion commutes with `κ` there (`kummer_link_unit`, from `linkEquiv_diag`);
* **value-group portion — compatible exactly when an `n`-th power condition holds**:
  `kummer_eq_iff`: `κ(a) = κ(b) ↔ a/b ∈ (Kˣ)ⁿ` (`KummerTheory.ker_kummer`);
  `kummer_compat_iff`: the value-group map `u·g^N ↦ u·g'^N` commutes with `κ` on all elements
  iff `κ(g') = κ(g)`; `kummer_gauss_compat_iff`: for the Gaussian value `ζ·q^{e+1}` at a label
  and the `q`-pilot `q`, compatibility holds iff `ζ·q^e ∈ (Kˣ)ⁿ`. At the label `1` (`e = 0`,
  `ζ = 1`) this always holds (`kummer_gauss_compat_label_one`, IUT II, Remark 4.10.3(iii)); at
  the label `j ≥ 2` it requires `q^{j²−1}` (times a root of unity) to be an `n`-th power.

These are statements about Kummer classes of elements; the étale-like monoids as monoids
reconstructed from `G_v` (IUT II, Proposition 3.1, Corollary 3.5 in full, with cyclotomic
rigidity) are not formalized (P16 scope decision S2, P17).
-/

noncomputable section

namespace Iut

namespace ThetaLink

open KummerTheory

variable (n : ℕ) {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω] [IsGalois K Ω]
  [HasKummerRoots n K Ω] [Algebra.IsIntegral K Ω]

omit [IsGalois K Ω] in
/-- **The Kummer class of a Gaussian monoid element** `u·(ζ·q^e)^N`. -/
theorem kummer_splitElt (u ζ q : Kˣ) (e N : ℕ) :
    kummer n K Ω (u * (ζ * q ^ e) ^ N) =
      kummer n K Ω u * kummer n K Ω ζ ^ N * kummer n K Ω q ^ (e * N) := by
  rw [map_mul, map_pow, map_mul, map_pow, mul_pow, ← pow_mul, mul_assoc]

omit [IsGalois K Ω] in
/-- **The `ℓ`-th powers of the Kummer classes of a value profile are independent of the
profile**: `κ(ζ·q^e)^ℓ = κ(q)^{eℓ}` for `ζ^ℓ = 1`. -/
theorem kummer_pow_eq_of_root {ζ : Kˣ} {ℓ : ℕ} (hζ : ζ ^ ℓ = 1) (q : Kˣ) (e : ℕ) :
    kummer n K Ω (ζ * q ^ e) ^ ℓ = kummer n K Ω q ^ (e * ℓ) := by
  rw [← map_pow, mul_pow, hζ, one_mul, ← pow_mul, map_pow]

/-- **`κ(a) = κ(b)` iff `a/b` is an `n`-th power** (`KummerTheory.ker_kummer`). -/
theorem kummer_eq_iff (a b : Kˣ) :
    kummer n K Ω a = kummer n K Ω b ↔ ∃ y : Kˣ, y ^ n = a / b := by
  rw [← div_eq_one, ← map_div, ← MonoidHom.mem_ker, ker_kummer, MonoidHom.mem_range]
  simp only [powMonoidHom_apply]

omit [IsGalois K Ω] in
/-- **The value-group map `u·g^N ↦ u·g'^N` is Kummer compatible on all elements iff it is on the
generator.** -/
theorem kummer_compat_iff (g g' : Kˣ) :
    (∀ (u : Kˣ) (N : ℕ), kummer n K Ω (u * g' ^ N) = kummer n K Ω (u * g ^ N)) ↔
      kummer n K Ω g' = kummer n K Ω g := by
  constructor
  · intro h
    simpa using h 1 1
  · intro h u N
    rw [map_mul, map_mul, map_pow, map_pow, h]

/-- **Kummer compatibility of the Θ-link at a label**: the Gaussian value `ζ·q^{e+1}` (the theta
value `q^{j²}` up to the root of unity `ζ`, `e + 1 = j²`) and the `q`-pilot `q` have the same
Kummer class iff `ζ·q^e` is an `n`-th power. -/
theorem kummer_gauss_compat_iff (ζ q : Kˣ) (e : ℕ) :
    kummer n K Ω q = kummer n K Ω (ζ * q ^ (e + 1)) ↔ ∃ y : Kˣ, y ^ n = (ζ * q ^ e)⁻¹ := by
  rw [kummer_eq_iff]
  have : q / (ζ * q ^ (e + 1)) = (ζ * q ^ e)⁻¹ := by
    rw [div_eq_iff_eq_mul, pow_succ, ← mul_assoc ζ, inv_mul_cancel_left]
  rw [this]

omit [IsGalois K Ω] in
/-- **At the label `1` the Θ-link is Kummer compatible** (IUT II, Remark 4.10.3(iii): the
restriction to the label `1` "may be naturally identified with the identity"). -/
theorem kummer_gauss_compat_label_one (q : Kˣ) :
    kummer n K Ω q = kummer n K Ω (1 * q ^ (0 + 1)) := by
  simp

omit [IsGalois K Ω] [HasKummerRoots n K Ω] [Algebra.IsIntegral K Ω] in
/-- **The unit portion is Kummer compatible**: on the diagonal units, a link of splitting
monoids is the identity (`linkEquiv_diag`), so it commutes with the Kummer map. -/
theorem kummer_link_unit {L : Type*} [NormedField L] {m : ℕ} {g g' : Fin m → L}
    (hg : IsSplitGen g) (hg' : IsSplitGen g') (u : L) (hu : ‖u‖ = 1) (j : Fin m)
    (κ' : L → ContH1 Gal(Ω/K) (Mu n Ω)) :
    κ' ((linkEquiv hg hg' (splitElt g u hu 0) : Fin m → L) j) =
      κ' ((splitElt g u hu 0 : Fin m → L) j) := by
  rw [linkEquiv_diag]
  simp

end ThetaLink

end Iut
