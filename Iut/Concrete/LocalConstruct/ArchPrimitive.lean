import Iut.Concrete.LocalConstruct.ArchLogShell

/-!
# The primitive automorphisms of the archimedean packet (IUT IV, Proposition 1.5(iii))

The indeterminacy at the archimedean place in IUT IV, Proposition 1.5(iii) is given by the
**primitive automorphisms** of the factors: on a factor `ℂ` the group of order `8` of
`ℝ`-linear isometries generated by complex conjugation and multiplication by `±1`, `±√−1`
(on a factor `ℝ`, multiplication by `±1`). On the packet these act as
`x ↦ (⊗_j u_j) · (⊗_j σ_j)(x)`, where `σ_j` is an `ℝ`-algebra automorphism of the `j`-th
factor (identity or conjugation) and `u_j` is a fourth root of unity of the factor (`±1`,
`±i` in `ℂ`; `±1` in `ℝ`). Their class is `primAut`; it contains the Galois automorphisms
`galAut .infinite c` (`galAut_subset_primAut`), is finite (`primAut_finite`), and its members
are continuous (`continuous_of_mem_primAut`).

Multiplication by an element of norm `1` of a factor is an isometry of that factor, and the
projective norm is contractive under tensor products of contractions
(`PiTensorProduct.opNorm_mapL`), so the primitive automorphisms preserve every real multiple
of `B_I` (`primAut_image_smul_archIntegral_subset`). This gives Proposition 1.5(iii),(iv) for
the primitive automorphisms (`primAut_prop15`) and the admissibility of the corresponding
theta regions (`primAut_theta_admissible`, `primAut_thetaShell_admissible`).
-/

namespace Iut

namespace LocalConstruct

open NumberField MeasureTheory
open scoped TensorProduct Pointwise

universe u

variable {K : Type u} [Field K] [NumberField K]

/-! ### Multiplication by an element of a factor -/

section Factor

variable (v : Place K)

lemma norm_toNormedFactor_mul (a : ArchFactor K v) (x : ArchNormedFactor v) :
    ‖toNormedFactor v (a * (show ArchFactor K v from x))‖ =
      ‖toNormedFactor v a‖ * ‖x‖ := by
  change ‖((ULift.down a : archField K (archPlace K v)) : ℂ) *
      ((ULift.down (show ArchFactor K v from x) : archField K (archPlace K v)) : ℂ)‖ =
    ‖((ULift.down a : archField K (archPlace K v)) : ℂ)‖ *
      ‖((ULift.down (show ArchFactor K v from x) : archField K (archPlace K v)) : ℂ)‖
  exact norm_mul _ _

/-- A fourth root of unity of a factor has norm `1`. -/
lemma norm_toNormedFactor_of_pow_four {a : ArchFactor K v} (ha : a ^ 4 = 1) :
    ‖toNormedFactor v a‖ = 1 := by
  have h : ‖((ULift.down a : archField K (archPlace K v)) : ℂ)‖ ^ 4 = 1 := by
    have h4 : ((ULift.down a : archField K (archPlace K v)) : ℂ) ^ 4 = 1 :=
      congrArg (fun b : ArchFactor K v => ((ULift.down b : archField K (archPlace K v)) : ℂ)) ha
    rw [← norm_pow, h4, norm_one]
  exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) (by norm_num)).mp h

/-- Multiplication by an element of a factor, as a continuous linear map of the normed
factor. -/
noncomputable def archMulCLM (a : ArchFactor K v) :
    ArchNormedFactor v →L[ℝ] ArchNormedFactor v :=
  LinearMap.mkContinuous
    { toFun := fun x => toNormedFactor v (a * (show ArchFactor K v from x))
      map_add' := fun x y => mul_add a (show ArchFactor K v from x) (show ArchFactor K v from y)
      map_smul' := fun r x => mul_smul_comm r a (show ArchFactor K v from x) }
    ‖toNormedFactor v a‖ fun x => (norm_toNormedFactor_mul v a x).le

lemma norm_archMulCLM_le (a : ArchFactor K v) : ‖archMulCLM v a‖ ≤ ‖toNormedFactor v a‖ :=
  LinearMap.mkContinuous_norm_le _ (norm_nonneg _) _

/-- The set of fourth roots of unity of a factor is finite. -/
lemma finite_pow_four_eq_one : {a : ArchFactor K v | a ^ 4 = 1}.Finite := by
  let f : ArchFactor K v → ℂ := fun a => ((ULift.down a : archField K (archPlace K v)) : ℂ)
  have hf : Function.Injective f := fun a b h =>
    ULift.ext _ _ (Subtype.ext h)
  have hroots : {z : ℂ | z ^ 4 = 1}.Finite := by
    refine ((Polynomial.nthRoots 4 (1 : ℂ)).toFinset.finite_toSet).subset fun z hz => ?_
    simp only [Finset.mem_coe, Multiset.mem_toFinset]
    exact (Polynomial.mem_nthRoots (by norm_num)).mpr hz
  refine (hroots.preimage hf.injOn).subset fun a ha => ?_
  change f a ^ 4 = 1
  have : f a ^ 4 = f (a ^ 4) := rfl
  rw [this, Set.mem_setOf_eq.mp ha]
  rfl

end Factor

/-! ### The primitive automorphisms of the packet -/

variable {ι : Type} [Fintype ι] (c : ι → Place K)

/-- **The primitive automorphisms of the archimedean packet** (IUT IV, Proposition 1.5(iii)):
the maps `x ↦ (⊗_j u_j) · (⊗_j σ_j)(x)` with `σ_j` an `ℝ`-algebra automorphism of the `j`-th
factor (identity or complex conjugation) and `u_j` a fourth root of unity of the factor
(`±1`, `±√−1` in `ℂ`; `±1` in `ℝ`), i.e. the maps induced by the factorwise isometries
generated by complex conjugation and multiplication by `±1`, `±√−1`. -/
def primAut : Set (Tensor K .infinite c → Tensor K .infinite c) :=
  {φ | ∃ σ : ∀ j, ArchFactor K (c j) ≃ₐ[ℝ] ArchFactor K (c j),
    ∃ w : ∀ j, ArchFactor K (c j), (∀ j, w j ^ 4 = 1) ∧
      φ = fun x => PiTensorProduct.tprod ℝ w * mapAlgHom .infinite c σ x}

/-- The Galois automorphisms are primitive automorphisms (`w = 1`). -/
theorem galAut_subset_primAut : galAut .infinite c ⊆ primAut c := by
  rintro _ ⟨σ, rfl⟩
  refine ⟨σ, fun _ => 1, fun _ => one_pow 4, ?_⟩
  funext x
  have h1 : (PiTensorProduct.tprod ℝ fun j => (1 : ArchFactor K (c j))) =
      (1 : Tensor K .infinite c) := rfl
  rw [h1, one_mul]

/-- The identity is a primitive automorphism. -/
lemma id_mem_primAut : id ∈ primAut c :=
  galAut_subset_primAut c (id_mem_galAut .infinite c)

/-- **The class of primitive automorphisms is finite.** -/
theorem primAut_finite : (primAut c).Finite := by
  have hW : (Set.univ.pi fun j => {a : ArchFactor K (c j) | a ^ 4 = 1}).Finite :=
    Set.Finite.pi fun j => finite_pow_four_eq_one (c j)
  refine ((Set.finite_univ.prod hW).image fun p : (∀ j, ArchFactor K (c j) ≃ₐ[ℝ]
      ArchFactor K (c j)) × (∀ j, ArchFactor K (c j)) =>
        fun x => PiTensorProduct.tprod ℝ p.2 * mapAlgHom .infinite c p.1 x).subset ?_
  rintro _ ⟨σ, w, hw, rfl⟩
  exact ⟨(σ, w), ⟨Set.mem_univ _, fun j _ => hw j⟩, rfl⟩

/-- Primitive automorphisms are continuous. -/
lemma continuous_of_mem_primAut {φ : Tensor K .infinite c → Tensor K .infinite c}
    (hφ : φ ∈ primAut c) : Continuous φ := by
  obtain ⟨σ, w, -, rfl⟩ := hφ
  exact continuous_const.mul (continuous_mapAlgHom .infinite c σ)

/-! ### The primitive automorphisms preserve `B_I` -/

/-- Multiplication by `⊗_j w_j` on the normed model is the tensor product of the
multiplications by `w_j`. -/
lemma toArchModel_tprod_mul (w : ∀ j, ArchFactor K (c j)) (x : Tensor K .infinite c) :
    toArchModel c (PiTensorProduct.tprod ℝ w * x) =
      PiTensorProduct.mapL (fun j => archMulCLM (c j) (w j)) (toArchModel c x) := by
  induction x using PiTensorProduct.induction_on with
  | smul_tprod r m =>
    rw [mul_smul_comm, PiTensorProduct.tprod_mul_tprod]
    change (r • PiTensorProduct.tprod ℝ (fun j => toNormedFactor (c j) (w j * m j)) :
        ArchModel c) =
      PiTensorProduct.mapL (fun j => archMulCLM (c j) (w j))
        (r • PiTensorProduct.tprod ℝ (fun j => toNormedFactor (c j) (m j)) : ArchModel c)
    rw [map_smul, PiTensorProduct.mapL_apply, PiTensorProduct.map_tprod]
    rfl
  | add x y hx hy =>
    rw [mul_add]
    change (toArchModel c (PiTensorProduct.tprod ℝ w * x) +
        toArchModel c (PiTensorProduct.tprod ℝ w * y) : ArchModel c) =
      PiTensorProduct.mapL (fun j => archMulCLM (c j) (w j))
        (toArchModel c x + toArchModel c y : ArchModel c)
    rw [map_add, hx, hy]

/-- Multiplication by `⊗_j w_j` with all `w_j` fourth roots of unity is contractive for the
projective norm. -/
theorem archNorm_tprod_mul_le {w : ∀ j, ArchFactor K (c j)} (hw : ∀ j, w j ^ 4 = 1)
    (x : Tensor K .infinite c) :
    archNorm c (PiTensorProduct.tprod ℝ w * x) ≤ archNorm c x := by
  unfold archNorm
  rw [toArchModel_tprod_mul]
  refine (ContinuousLinearMap.le_opNorm _ _).trans ?_
  refine mul_le_of_le_one_left (norm_nonneg _) ?_
  refine (PiTensorProduct.opNorm_mapL _).trans ?_
  refine Finset.prod_le_one (fun j _ => norm_nonneg _) fun j _ => ?_
  exact (norm_archMulCLM_le (c j) (w j)).trans
    (norm_toNormedFactor_of_pow_four (c j) (hw j)).le

/-- **IUT IV, Proposition 1.5(iii)**: the primitive automorphisms preserve every real multiple
of `B_I`. -/
theorem primAut_image_smul_archIntegral_subset (t : ℝ) :
    ∀ φ ∈ primAut c, φ '' (algebraMap ℝ (Tensor K .infinite c) t • archIntegral c) ⊆
      algebraMap ℝ (Tensor K .infinite c) t • archIntegral c := by
  rintro _ ⟨σ, w, hw, rfl⟩ _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
  refine ⟨PiTensorProduct.tprod ℝ w * mapAlgHom .infinite c σ x,
    (archNorm_tprod_mul_le c hw _).trans (archNorm_mapAlgHom_le c σ x |>.trans hx), ?_⟩
  change algebraMap ℝ _ t * (PiTensorProduct.tprod ℝ w * mapAlgHom .infinite c σ x) =
    PiTensorProduct.tprod ℝ w * mapAlgHom .infinite c σ (algebraMap ℝ _ t * x)
  rw [map_mul, AlgHom.commutes, mul_left_comm]

/-! ### Consequences for the archimedean log-shell -/

/-- **IUT IV, Proposition 1.5(iii),(iv)** for the primitive automorphisms: the images of the
archimedean log-shell under the primitive automorphisms lie in `π^{|I|}·B_I`. -/
theorem primAut_prop15 : ∀ φ ∈ primAut c, φ '' archLogShell c ⊆
    algebraMap ℝ (Tensor K .infinite c) (Real.pi ^ Fintype.card ι) • integralAt .infinite c :=
  primAut_image_smul_archIntegral_subset c _

/-- The primitive automorphisms preserve the archimedean log-shell. -/
theorem primAut_archLogShell : ∀ φ ∈ primAut c, φ '' archLogShell c ⊆ archLogShell c :=
  primAut_image_smul_archIntegral_subset c _

/-- **The union of the images of a compact set of positive Haar measure under the primitive
automorphisms is admissible.** -/
theorem iUnion_primAut_admissible {S : Set (Tensor K .infinite c)} (hS : IsCompact S)
    (hpos : 0 < haar .infinite c S) : (⋃ φ ∈ primAut c, φ '' S) ∈ admissible .infinite c := by
  have hsub : S ⊆ ⋃ φ ∈ primAut c, φ '' S := fun x hx =>
    Set.mem_iUnion₂.mpr ⟨id, id_mem_primAut c, ⟨x, hx, rfl⟩⟩
  have hcpt : IsCompact (⋃ φ ∈ primAut c, φ '' S) :=
    (primAut_finite c).isCompact_biUnion fun φ hφ => hS.image (continuous_of_mem_primAut c hφ)
  refine ⟨?_, ?_, hcpt.isClosed.measurableSet, lt_of_lt_of_le hpos (measure_mono hsub),
    hcpt.measure_lt_top⟩
  · obtain ⟨x, hx⟩ := nonempty_of_measure_ne_zero hpos.ne'
    exact ⟨x, hsub hx⟩
  · rw [hcpt.isClosed.closure_eq]
    exact hcpt

/-- The union of the images of a scaled integral structure under the primitive automorphisms
is admissible (IUT IV, Proposition 1.5(iii)). -/
theorem primAut_theta_admissible (s : Tensor K .infinite c) (hs : IsUnit s) :
    (⋃ φ ∈ primAut c, φ '' (s • integralAt .infinite c)) ∈ admissible .infinite c :=
  iUnion_primAut_admissible c (isCompact_smul_integralAt s) (haar_smul_integralAt_pos hs)

/-- The union of the images of the archimedean log-shell under the primitive automorphisms is
admissible (IUT IV, Proposition 1.5(iii)). -/
theorem primAut_thetaShell_admissible :
    (⋃ φ ∈ primAut c, φ '' archLogShell c) ∈ admissible .infinite c :=
  iUnion_primAut_admissible c (isCompact_archLogShell c)
    (haar_smul_integralAt_pos (isUnit_archScalar c))

end LocalConstruct

end Iut
