import Iut.Concrete.LocalConstruct.ThetaAdmissible

/-!
# The archimedean log-shell and IUT IV, Proposition 1.5 (taxis #4, #278)

At the archimedean place the log-shell of a factor `ℝ` or `ℂ` is the closed disc of radius
`π` (the image of the units under the logarithm; IUT III, Proposition 1.2(vii)). The theta
region of IUT IV, Theorem 1.10, Step (vii) is built from the **tensor products of elements
of the log-shells** `⊗_j y_j`, `|y_j| ≤ π` (IUT III, Proposition 3.2(ii); IUT IV,
Proposition 1.5(iv)): `archLogShellSet`.

A set of elementary tensors is in general a null set (already `ℂ ⊗_ℝ ℂ ≅ ℂ ⊕ ℂ` has
`{z ⊗ w} = {(a, b) | |a| = |b|}`), so it is not an admissible region of the holomorphic hull
(IUT III, Remark 3.9.5(i): the region must contain a relatively compact subset of finite
log-volume). We therefore take, as at a prime (where `⊗_j 𝓘_{c j}` is the `ℤ_p`-module
generated by the elementary tensors, `tensorLogShell`), the module generated over the
archimedean "integers" `[-1, 1]`: the **closed absolutely convex hull** of the elementary
tensors of log-shell elements (`archLogShell`, `Iut.LocalTheory.logShell` at `∞`). Since the
hull regions `a·B_I` are absolutely convex and closed, this does not change the holomorphic
hull of the elementary tensors.

**IUT IV, Proposition 1.5(iv)** (`archLogShellSet_subset`, `archLogShell_subset`): every
component of `⊗_j y_j` in the direct sum decomposition of the packet has absolute value
`∏_j |y_j| ≤ π^{|I|}` (`norm_archChar_tprod`), so `archLogShell ⊆ π^{|I|}·B_I`. The log-shell
is compact and of positive Haar measure (`isCompact_archLogShell`, `haar_archLogShell_pos`):
the elementary tensors span the packet, so their absolutely convex hull has nonempty interior.

The Galois automorphisms `⊗_j σ_j` of the packet preserve `B_I` and its real multiples
(`mapAlgHom_image_archIntegral_subset`, `galAut_image_smul_archIntegral_subset`): they permute
the components up to absolute value (`norm_archChar_algHom`).
-/

namespace Iut

namespace LocalConstruct

open NumberField MeasureTheory
open scoped TensorProduct Pointwise

universe u

variable {K : Type u} [Field K] [NumberField K] {ι : Type} [Fintype ι] (c : ι → Place K)

/-! ### The Galois automorphisms of the packet preserve `B_I` -/

/-- **IUT IV, Proposition 1.5(iii)**: the Galois automorphisms of the packet preserve `B_I`. -/
theorem mapAlgHom_image_archIntegral_subset
    (σ : ∀ j, ArchFactor K (c j) ≃ₐ[ℝ] ArchFactor K (c j)) :
    mapAlgHom .infinite c σ '' archIntegral c ⊆ archIntegral c := by
  rintro _ ⟨x, hx, rfl⟩ m
  rw [norm_archChar_algHom]
  exact hx _

/-- The Galois automorphisms of the packet preserve every real multiple of `B_I`. -/
theorem galAut_image_smul_archIntegral_subset (t : ℝ) :
    ∀ φ ∈ galAut .infinite c, φ '' (algebraMap ℝ (Tensor K .infinite c) t • archIntegral c) ⊆
      algebraMap ℝ (Tensor K .infinite c) t • archIntegral c := by
  rintro _ ⟨σ, rfl⟩ _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
  refine ⟨mapAlgHom .infinite c σ x, mapAlgHom_image_archIntegral_subset c σ ⟨x, hx, rfl⟩, ?_⟩
  change algebraMap ℝ _ t * mapAlgHom .infinite c σ x =
    mapAlgHom .infinite c σ (algebraMap ℝ _ t * x)
  rw [map_mul, AlgHom.commutes]

/-! ### The real multiples of `B_I` are absolutely convex -/

/-- For `t > 0`, the polydisc `t·B_I` is absolutely convex. -/
theorem absConvex_algebraMap_smul_archIntegral {t : ℝ} (ht : 0 < t) :
    AbsConvex ℝ (algebraMap ℝ (Tensor K .infinite c) t • archIntegral c) := by
  refine ⟨fun a ha => ?_, fun x hx y hy a b ha hb hab => ?_⟩
  · rintro _ ⟨x, hx, rfl⟩
    rw [mem_algebraMap_smul_archIntegral ht] at hx ⊢
    intro m
    rw [map_smul, norm_smul]
    exact (mul_le_of_le_one_left (norm_nonneg _) ha).trans (hx m)
  · rw [mem_algebraMap_smul_archIntegral ht] at hx hy ⊢
    intro m
    rw [map_add, map_smul, map_smul]
    calc ‖a • archChar c m x + b • archChar c m y‖
        ≤ ‖a • archChar c m x‖ + ‖b • archChar c m y‖ := norm_add_le _ _
      _ = a * ‖archChar c m x‖ + b * ‖archChar c m y‖ := by
          rw [norm_smul, norm_smul, Real.norm_of_nonneg ha, Real.norm_of_nonneg hb]
      _ ≤ a * t + b * t := add_le_add (mul_le_mul_of_nonneg_left (hx m) ha)
          (mul_le_mul_of_nonneg_left (hy m) hb)
      _ = t := by rw [← add_mul, hab, one_mul]

/-! ### The archimedean log-shell -/

/-- **The tensor products of elements of the log-shells** `⊗_j y_j` with `|y_j| ≤ π`
(IUT III, Proposition 3.2(ii); IUT IV, Proposition 1.5(iv)). -/
def archLogShellSet : Set (Tensor K .infinite c) :=
  {x | ∃ y : ∀ j, ArchFactor K (c j), (∀ j, archAbs (c j) (y j) ≤ Real.pi) ∧
    PiTensorProduct.tprod ℝ y = x}

/-- **The archimedean log-shell** of the packet (`LocalTheory.logShell` at `∞`): the closed
absolutely convex hull of the tensor products of elements of the log-shells, i.e. the closed
`[-1, 1]`-module they generate (the archimedean counterpart of the `ℤ_p`-module
`tensorLogShell` generated by the elementary tensors at a prime). -/
def archLogShell : Set (Tensor K .infinite c) :=
  closure (absConvexHull ℝ (archLogShellSet c))

lemma one_mem_archLogShellSet : (1 : Tensor K .infinite c) ∈ archLogShellSet c :=
  ⟨1, fun j => by rw [Pi.one_apply, archAbs_one]; linarith [Real.pi_gt_three], rfl⟩

lemma archLogShellSet_subset_archLogShell : archLogShellSet c ⊆ archLogShell c :=
  subset_absConvexHull.trans subset_closure

lemma isUnit_archScalar : IsUnit (algebraMap ℝ (Tensor K .infinite c) (Real.pi ^ Fintype.card ι)) :=
  (isUnit_iff_ne_zero.mpr (pow_ne_zero _ Real.pi_ne_zero)).map (algebraMap ℝ _)

/-- **IUT IV, Proposition 1.5(iv)**: the tensor products of elements of the log-shells lie in
`π^{|I|}·B_I`. -/
theorem archLogShellSet_subset :
    archLogShellSet c ⊆
      algebraMap ℝ (Tensor K .infinite c) (Real.pi ^ Fintype.card ι) • archIntegral c := by
  rintro _ ⟨y, hy, rfl⟩
  rw [mem_algebraMap_smul_archIntegral (pow_pos Real.pi_pos _)]
  intro m
  rw [norm_archChar_tprod, ← Finset.card_univ, ← Finset.prod_const]
  exact Finset.prod_le_prod (fun j _ => archAbs_nonneg _ _) fun j _ => hy j

/-- **IUT IV, Proposition 1.5(iv)**: the archimedean log-shell lies in `π^{|I|}·B_I`. -/
theorem archLogShell_subset :
    archLogShell c ⊆
      algebraMap ℝ (Tensor K .infinite c) (Real.pi ^ Fintype.card ι) • archIntegral c :=
  closure_minimal (absConvexHull_min (archLogShellSet_subset c)
      (absConvex_algebraMap_smul_archIntegral c (pow_pos Real.pi_pos _)))
    (isCompact_smul _ (isCompact_archIntegral c)).isClosed

/-- The archimedean log-shell is compact. -/
lemma isCompact_archLogShell : IsCompact (archLogShell c) :=
  (isCompact_smul _ (isCompact_archIntegral c)).of_isClosed_subset isClosed_closure
    (archLogShell_subset c)

/-- The archimedean log-shell is relatively compact (`LocalTheory.logShell_relCompact` at `∞`). -/
lemma isCompact_closure_archLogShell : IsCompact (closure (archLogShell c)) := by
  rw [(isCompact_archLogShell c).isClosed.closure_eq]
  exact isCompact_archLogShell c

/-- The tensor products of elements of the log-shells span the packet. -/
lemma span_archLogShellSet : Submodule.span ℝ (archLogShellSet c) = ⊤ := by
  refine eq_top_iff.mpr ((PiTensorProduct.span_tprod_eq_top (R := ℝ)
    (s := fun j => ArchFactor K (c j))).symm.le.trans (Submodule.span_le.mpr ?_))
  rintro _ ⟨y, rfl⟩
  set l : ι → ℝ := fun j => Real.pi / (archAbs (c j) (y j) + 1) with hl
  have hl0 : ∀ j, 0 < l j := fun j => div_pos Real.pi_pos (by linarith [archAbs_nonneg _ (y j)])
  have hmem : PiTensorProduct.tprod ℝ (fun j => l j • y j) ∈ archLogShellSet c := by
    refine ⟨_, fun j => ?_, rfl⟩
    have h1 : 0 < archAbs (c j) (y j) + 1 := by linarith [archAbs_nonneg _ (y j)]
    rw [archAbs_smul, abs_of_pos (hl0 j), hl, div_mul_eq_mul_div, div_le_iff₀ h1]
    nlinarith [Real.pi_pos, archAbs_nonneg _ (y j)]
  have heq : PiTensorProduct.tprod ℝ y =
      (∏ j, l j)⁻¹ • PiTensorProduct.tprod ℝ (fun j => l j • y j) := by
    rw [MultilinearMap.map_smul_univ, smul_smul,
      inv_mul_cancel₀ (Finset.prod_ne_zero_iff.mpr fun j _ => (hl0 j).ne'), one_smul]
  change PiTensorProduct.tprod ℝ y ∈ Submodule.span ℝ (archLogShellSet c)
  rw [heq]
  exact Submodule.smul_mem _ _ (Submodule.subset_span hmem)

/-- **The archimedean log-shell has positive Haar measure**: the absolutely convex hull of the
elementary tensors spans the packet, hence has nonempty interior. -/
theorem haar_archLogShell_pos : 0 < haar .infinite c (archLogShell c) := by
  set S := absConvexHull ℝ (archLogShellSet c) with hS
  have h0 : (0 : Tensor K .infinite c) ∈ S :=
    balanced_absConvexHull.zero_mem ⟨1, subset_absConvexHull (one_mem_archLogShellSet c)⟩
  have hspan : affineSpan ℝ S = ⊤ := by
    rw [AffineSubspace.affineSpan_eq_top_iff_vectorSpan_eq_top_of_nonempty ℝ _ _ ⟨0, h0⟩,
      vectorSpan_eq_span_vsub_set_right ℝ h0]
    refine eq_top_iff.mpr ((span_archLogShellSet c).symm.le.trans (Submodule.span_mono ?_))
    intro x hx
    exact ⟨x, subset_absConvexHull hx, by simp⟩
  obtain ⟨x, hx⟩ := (convex_absConvexHull.interior_nonempty_iff_affineSpan_eq_top).mpr hspan
  exact lt_of_lt_of_le (isOpen_interior.measure_pos (haar .infinite c) ⟨x, hx⟩)
    (measure_mono (interior_subset.trans subset_closure))

end LocalConstruct

end Iut
