import Iut.EtaleTheta.ThetaLevelRational
import Iut.EtaleTheta.TateFunctionField

/-!
# The level `Ÿ'_N` inside the function field of `E_q` (MR14, task G1, ψ-route)

Let `s² = q`, `N` even, `Q = s^N`. The level `Ÿ'_N = E_Q ∖ C_N` of [EtTh], §1 (MR14 plan, route
R-alg) sits between the multiplication-by-`2N` cover and `X = E_q ∖ {O}`:

`E_q ∖ E_q[2N] --ψ--> Ÿ'_N = E_Q ∖ C_N --φ--> E_q ∖ {O}`, `ψ(u) = u^N`, `φ(Ü) = Ü²`,
`φ ∘ ψ = [2N]`.

So the function field of `Ÿ'_N` is the subfield `ψ^* K(E_Q)` of `K(E_q)` (the source of `[2N]`),
generated by `x_Q ∘ ψ` and `y_Q ∘ ψ`, and the theta level function `f_N` of `Ÿ'_N` becomes the
element `F_N = f_N ∘ ψ`, `F_N(u) = Θ̈_q(u^N)/Θ̈_{q^N}(u^N)^N`, of `K(E_q)`. In this file:

* `substCoef`, `shiftCoef`: Laurent families of `u ↦ G(u^N)` and `u ↦ u^{-a}·G(u)`;
* `isWeightFamily_pull`: if `c` is a weight-`k` theta family for the lattice `Q^ℤ`, then
  `u ↦ u^{-a}·G(u^N)` is a weight-`2kN` theta family for the lattice `q^ℤ` (as
  `u ↦ q u` moves `u^N` by `Q²`);
* `pullX`, `pullY`, `pullTheta`: the elements `x_Q ∘ ψ`, `y_Q ∘ ψ`, `F_N` of `K(E_q)`, with their
  values (`isTateFun_pullX`, `isTateFun_pullY`, `isTateFun_pullTheta`).
-/

open Polynomial

noncomputable section

namespace Iut.EtaleTheta

open TateCurvesTheta TateParameter WeierstrassCurve.Affine

variable {K : Type*} [NormedField K] [CompleteSpace K] [IsUltrametricDist K]

/-! ### Substitution and shift of Laurent families -/

/-- The Laurent family of `u ↦ G(u^N)`. -/
def substCoef (c : ℤ → K) (N : ℕ) (m : ℤ) : K :=
  if (N : ℤ) ∣ m then c (m / N) else 0

omit [CompleteSpace K] [IsUltrametricDist K] in
theorem hasSum_substCoef {c : ℤ → K} {G : K} {N : ℕ} (hN : 0 < N) (u : Kˣ)
    (h : HasSum (fun n : ℤ => c n * ((u : K) ^ N) ^ n) G) :
    HasSum (fun m : ℤ => substCoef c N m * (u : K) ^ m) G := by
  have hN' : (N : ℤ) ≠ 0 := by exact_mod_cast hN.ne'
  have hinj : Function.Injective fun n : ℤ => (N : ℤ) * n := mul_right_injective₀ hN'
  rw [← hinj.hasSum_iff]
  · convert h using 1
    funext n
    simp only [Function.comp_apply, substCoef, dvd_mul_right, if_true,
      Int.mul_ediv_cancel_left _ hN', ← zpow_natCast, ← zpow_mul]
  · intro m hm
    have : ¬ (N : ℤ) ∣ m := fun ⟨n, hn⟩ => hm ⟨n, hn.symm⟩
    simp [substCoef, this]

/-- The Laurent family of `u ↦ u^{-a}·G(u)`. -/
def shiftCoef (c : ℤ → K) (a : ℤ) (m : ℤ) : K := c (m + a)

omit [CompleteSpace K] [IsUltrametricDist K] in
theorem hasSum_shiftCoef {c : ℤ → K} {G : K} (a : ℤ) (u : Kˣ)
    (h : HasSum (fun m : ℤ => c m * (u : K) ^ m) G) :
    HasSum (fun m : ℤ => shiftCoef c a m * (u : K) ^ m) ((u : K) ^ (-a) * G) := by
  have h' := h.mul_left ((u : K) ^ (-a))
  rw [← (Equiv.addRight a).hasSum_iff] at h'
  have e : (fun m : ℤ => shiftCoef c a m * (u : K) ^ m) =
      (fun i => (u : K) ^ (-a) * (c i * (u : K) ^ i)) ∘ Equiv.addRight a := by
    funext m
    simp only [Function.comp_apply, Equiv.coe_addRight, shiftCoef]
    rw [zpow_add₀ u.ne_zero, zpow_neg]
    field_simp
  rw [e]
  exact h'

/-- The Laurent family of `u ↦ u^{-a}·G(u^N)`. -/
def pullCoef (c : ℤ → K) (N : ℕ) (a : ℤ) : ℤ → K := shiftCoef (substCoef c N) a

variable (t : TateParameter K)

omit [CompleteSpace K] [IsUltrametricDist K] in
theorem hasSum_pullCoef {T : TateParameter K} {k : ℕ} {A : Kˣ} {c : ℤ → K}
    (hc : T.IsWeightFamily k A c) {N : ℕ} (hN : 0 < N) (a : ℤ) (u : Kˣ) :
    HasSum (fun m : ℤ => pullCoef c N a m * (u : K) ^ m)
      ((u : K) ^ (-a) * ∑' n : ℤ, c n * ((u ^ N : Kˣ) : K) ^ n) := by
  refine hasSum_shiftCoef a u (hasSum_substCoef hN u ?_)
  have := (hc.summable (u ^ N)).hasSum
  simpa [Units.val_pow_eq_pow_val] using this

/-- **Pulling back theta families along `u ↦ u^N`**: for `s² = q` and `Q = s^N`, a weight-`k`
family `c` for the lattice `Q^ℤ` with multiplier `A` gives the weight-`2kN` family
`u ↦ u^{-a}·G(u^N)` for the lattice `q^ℤ` with multiplier `q^{-a}·A²·Q^{-k}`. -/
theorem isWeightFamily_pull {s : Kˣ} (hs : s ^ 2 = t.q) {N : ℕ} (hN : 0 < N)
    (T : TateParameter K) (hT : T.q = s ^ N) {k : ℕ} {A : Kˣ} {c : ℤ → K}
    (hc : T.IsWeightFamily k A c) (a : ℤ) :
    t.IsWeightFamily (2 * k * N) ((t.q ^ a)⁻¹ * A ^ 2 * (T.q ^ k)⁻¹) (pullCoef c N a) := by
  refine IsWeightFamily.of_tsum_q_smul (fun u => (hasSum_pullCoef hc hN a u).summable)
    fun u => ?_
  have hu : (u : K) ≠ 0 := u.ne_zero
  have hq : (t.q : K) ≠ 0 := t.q.ne_zero
  have hQ : (T.q : K) ≠ 0 := T.q.ne_zero
  -- `(q u)^N = Q · (Q · u^N)`
  have hpow : (((t.q * u) ^ N : Kˣ) : K) = (T.q : K) * ((T.q * u ^ N : Kˣ) : K) := by
    simp only [Units.val_pow_eq_pow_val, Units.val_mul]
    rw [mul_pow, ← mul_assoc, ← sq, hT, ← hs, Units.val_pow_eq_pow_val,
      Units.val_pow_eq_pow_val, ← pow_mul, ← pow_mul, mul_comm N 2]
  have hqu : (t.q : K) * (u : K) = ((t.q * u : Kˣ) : K) := by rw [Units.val_mul]
  rw [hqu, (hasSum_pullCoef hc hN a _).tsum_eq, (hasSum_pullCoef hc hN a u).tsum_eq, hpow,
    hc.tsum_q_smul, Units.val_mul T.q (u ^ N), hc.tsum_q_smul]
  simp only [Units.val_mul, Units.val_pow_eq_pow_val, Units.val_inv_eq_inv_val,
    Units.val_zpow_eq_zpow_val, zpow_neg, zpow_natCast, mul_zpow, mul_pow, mul_inv]
  rw [show (u : K) ^ (2 * k * N) = ((u : K) ^ N) ^ k * ((u : K) ^ N) ^ k by
    rw [← pow_add, ← pow_mul]; ring_nf]
  field_simp

/-! ### Good points -/

omit [CompleteSpace K] in
/-- There is a unit `u` of norm one with `u^{2N} ≠ 1`. -/
theorem exists_good_unit (t : TateParameter K) {N : ℕ} (hN : 0 < N) :
    ∃ u : Kˣ, ‖(u : K)‖ = 1 ∧ (u : K) ^ (2 * N) ≠ 1 := by
  by_contra h
  push Not at h
  have hp : (Polynomial.X ^ (2 * N) - Polynomial.C (1 : K)) ≠ 0 := by
    apply Polynomial.X_pow_sub_C_ne_zero; omega
  apply hp
  apply Polynomial.eq_zero_of_infinite_isRoot
  refine Set.infinite_of_injective_forall_mem (f := fun n : ℕ => (unitSeq t n : K))
    (fun a b hab => unitSeq_injective t (Units.ext hab)) fun n => ?_
  simp only [Set.mem_setOf_eq, Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow,
    Polynomial.eval_X, Polynomial.eval_C]
  rw [h _ (norm_one_add_q_pow t n), sub_self]

omit [CompleteSpace K] [IsUltrametricDist K] in
theorem eq_one_of_q_zpow_mul {T : TateParameter K} {w : K} (hw : ‖w‖ = 1) {k : ℤ}
    (h : (T.q : K) ^ k * w = 1) : w = 1 :=
  (eq_of_eq_q_zpow_mul T norm_one hw h.symm).symm

omit [CompleteSpace K] [IsUltrametricDist K] in
theorem offOrbit_of_norm {T : TateParameter K} {w : Kˣ} (hw : ‖(w : K)‖ = 1) (h1 : (w : K) ≠ 1) :
    OffOrbit T w := fun _ hk => h1 (eq_one_of_q_zpow_mul hw hk)

/-! ### The elements `x_Q ∘ ψ`, `y_Q ∘ ψ` and `F_N = f_N ∘ ψ` of `K(E_q)` -/

theorem offOrbit_of_theta_ne_zero {T : TateParameter K} {v : Kˣ} (h : T.theta (-v) ≠ 0) :
    OffOrbit T v := by
  intro k hk
  apply h
  rw [T.theta_eq_zero_iff]
  refine ⟨-k, ?_⟩
  rw [Units.val_neg, neg_inj, zpow_neg]
  exact eq_inv_of_mul_eq_one_right hk

variable (h12 : (12 : K) ≠ 0) {s : Kˣ} (hs : s ^ 2 = t.q) {N : ℕ} (hN : 0 < N)
  (T : TateParameter K) (hT : T.q = s ^ N)

omit [CompleteSpace K] [IsUltrametricDist K] in
include hs hT in
theorem pullMult_X :
    (t.q ^ (N : ℤ))⁻¹ * ((T.q * (-1))⁻¹ ^ 2) ^ 2 * (T.q ^ 2)⁻¹ = multθ t ^ (2 * 2 * N) := by
  rw [hT, ← hs]
  ext
  simp only [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val,
    Units.val_neg, Units.val_one, zpow_natCast]
  have hs0 : (s : K) ≠ 0 := s.ne_zero
  have hq : (t.q : K) = (s : K) ^ 2 := by rw [← hs, Units.val_pow_eq_pow_val]
  rw [hq]
  field_simp
  ring_nf
  rw [inv_pow, mul_inv_cancel₀ (pow_ne_zero _ hs0), one_mul, pow_mul',
    show ((-1 : K)) ^ 4 = 1 by norm_num, one_pow]

omit [CompleteSpace K] [IsUltrametricDist K] in
include hs hT in
theorem pullMult_Y {M : ℕ} (hM : N = 2 * M) :
    (t.q ^ ((3 * M : ℕ) : ℤ))⁻¹ * ((T.q * (-1))⁻¹ ^ 3) ^ 2 * (T.q ^ 3)⁻¹ =
      multθ t ^ (2 * 3 * N) := by
  rw [hT, ← hs]
  ext
  simp only [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val,
    Units.val_neg, Units.val_one, zpow_natCast]
  have hs0 : (s : K) ≠ 0 := s.ne_zero
  have hq : (t.q : K) = (s : K) ^ 2 := by rw [← hs, Units.val_pow_eq_pow_val]
  subst hM
  rw [hq]
  field_simp
  ring_nf
  rw [inv_pow, mul_inv_cancel₀ (pow_ne_zero _ hs0), one_mul, pow_mul',
    show ((-1 : K)) ^ 12 = 1 by norm_num, one_pow]

theorem tsum_pull_theta {T : TateParameter K} (hN : 0 < N) (j : ℕ) (u : Kˣ) (a : ℤ) :
    (∑' m : ℤ, pullCoef (cpow (T.thetaBlock (-1)) j) N a m * (u : K) ^ m) =
      (u : K) ^ (-a) * T.theta (-(u ^ N)) ^ j := by
  have hc := isWeightFamily_cpow T (isWeightFamily_thetaBlock (t := T) (-1)) j
  rw [(hasSum_pullCoef hc hN a u).tsum_eq, tsum_cpow T (isWeightFamily_thetaBlock (t := T) (-1)),
    tsum_thetaBlock, neg_one_mul]

include hs hN hT in
/-- **`x_Q ∘ ψ ∈ K(E_q)`**: there are `g ∈ K(E_q)` and `0 ≠ D ∈ K[E_q]` with
`D(u) ≠ 0 ⟺ θ_Q(-u^N) ≠ 0`, and `g(u) = X_Q(u^N)` there. -/
theorem exists_pullX :
    ∃ (g : TateField t) (D : TateRing t), ∀ (u : Kˣ) (hu : OffOrbit t u),
      (evalTate t h12 hu D ≠ 0 ↔ T.theta (-(u ^ N)) ≠ 0) ∧
      (T.theta (-(u ^ N)) ≠ 0 → HasTateValue t h12 g hu (T.X (u ^ N))) := by
  have hX := isWeightFamily_pull t hs hN T hT (isWeightFamily_XThetaSq T) (N : ℤ)
  rw [pullMult_X t hs T hT] at hX
  have hθ := isWeightFamily_pull t hs hN T hT
    (isWeightFamily_cpow T (isWeightFamily_thetaBlock (t := T) (-1)) 2) (N : ℤ)
  rw [one_mul, pullMult_X t hs T hT] at hθ
  obtain ⟨n, d, h⟩ := exists_hasTateValue_of_weight (h12 := h12) (by omega) hX hθ
  refine ⟨algebraMap _ (TateField t) n / algebraMap _ (TateField t) d, d, fun u hu => ?_⟩
  obtain ⟨e₁, e₂, hv⟩ := h u hu
  rw [tsum_pull_theta hN 2 u] at e₂ hv
  have hu0 : (u : K) ^ (-(N : ℤ)) ≠ 0 := zpow_ne_zero _ u.ne_zero
  have hθt : t.theta (-u) ^ (2 * 2 * N) ≠ 0 := pow_ne_zero _ (theta_neg_ne_zero t hu)
  refine ⟨⟨fun hD h0 => ?_, fun h0 hD => ?_⟩, fun h0 => ?_⟩
  · rw [h0, zero_pow two_ne_zero, mul_zero, eq_comm, mul_eq_zero, or_iff_left hθt] at e₂
    exact hD e₂
  · rw [hD, zero_mul, mul_eq_zero, or_iff_right hu0] at e₂
    exact h0 (pow_eq_zero_iff two_ne_zero |>.mp e₂)
  · have hne : (u : K) ^ (-(N : ℤ)) * T.theta (-(u ^ N)) ^ 2 ≠ 0 :=
      mul_ne_zero hu0 (pow_ne_zero _ h0)
    refine (hv hne).congr ?_
    have hoff := offOrbit_of_theta_ne_zero h0
    rw [(hasSum_pullCoef (isWeightFamily_XThetaSq T) hN _ u).tsum_eq,
      (T.hasSum_XThetaSqCoeff hoff).tsum_eq]
    field_simp

include hs hN hT in
/-- **`y_Q ∘ ψ ∈ K(E_q)`** (`N` even). -/
theorem exists_pullY (hev : Even N) :
    ∃ (g : TateField t) (D : TateRing t), ∀ (u : Kˣ) (hu : OffOrbit t u),
      (evalTate t h12 hu D ≠ 0 ↔ T.theta (-(u ^ N)) ≠ 0) ∧
      (T.theta (-(u ^ N)) ≠ 0 → HasTateValue t h12 g hu (T.Y (u ^ N))) := by
  obtain ⟨M, hM⟩ := hev
  rw [← two_mul] at hM
  have hY := isWeightFamily_pull t hs hN T hT (isWeightFamily_YThetaCube T) ((3 * M : ℕ) : ℤ)
  rw [pullMult_Y t hs T hT hM] at hY
  have hθ := isWeightFamily_pull t hs hN T hT
    (isWeightFamily_cpow T (isWeightFamily_thetaBlock (t := T) (-1)) 3) ((3 * M : ℕ) : ℤ)
  rw [one_mul, pullMult_Y t hs T hT hM] at hθ
  obtain ⟨n, d, h⟩ := exists_hasTateValue_of_weight (h12 := h12) (by omega) hY hθ
  refine ⟨algebraMap _ (TateField t) n / algebraMap _ (TateField t) d, d, fun u hu => ?_⟩
  obtain ⟨e₁, e₂, hv⟩ := h u hu
  rw [tsum_pull_theta hN 3 u] at e₂ hv
  have hu0 : (u : K) ^ (-((3 * M : ℕ) : ℤ)) ≠ 0 := zpow_ne_zero _ u.ne_zero
  have hθt : t.theta (-u) ^ (2 * 3 * N) ≠ 0 := pow_ne_zero _ (theta_neg_ne_zero t hu)
  refine ⟨⟨fun hD h0 => ?_, fun h0 hD => ?_⟩, fun h0 => ?_⟩
  · rw [h0, zero_pow three_ne_zero, mul_zero, eq_comm, mul_eq_zero, or_iff_left hθt] at e₂
    exact hD e₂
  · rw [hD, zero_mul, mul_eq_zero, or_iff_right hu0] at e₂
    exact h0 (pow_eq_zero_iff three_ne_zero |>.mp e₂)
  · have hne : (u : K) ^ (-((3 * M : ℕ) : ℤ)) * T.theta (-(u ^ N)) ^ 3 ≠ 0 :=
      mul_ne_zero hu0 (pow_ne_zero _ h0)
    refine (hv hne).congr ?_
    have hoff := offOrbit_of_theta_ne_zero h0
    rw [(hasSum_pullCoef (isWeightFamily_YThetaCube T) hN _ u).tsum_eq,
      (T.hasSum_YThetaCubeCoeff hoff).tsum_eq]
    field_simp

omit [CompleteSpace K] [IsUltrametricDist K] in
theorem aeval_mem_adjoin {L : Type*} [Field L] [Algebra K L] {S : Set L} {g : L}
    (hg : g ∈ IntermediateField.adjoin K S) (P : K[X]) :
    Polynomial.aeval g P ∈ IntermediateField.adjoin K S := by
  induction P using Polynomial.induction_on with
  | C a => simp only [aeval_C]; exact IntermediateField.algebraMap_mem _ a
  | add p q hp hq => simp only [map_add]; exact add_mem hp hq
  | monomial n a _ =>
    simpa [map_mul] using mul_mem (IntermediateField.algebraMap_mem _ a)
      (pow_mem hg (n + 1))

include hs hT in
/-- **G1 (ψ-route), the theta level function on `Ÿ'_N`**: for `N` even there are
`x_Q ∘ ψ, y_Q ∘ ψ ∈ K(E_q)` (values `X_Q(u^N)`, `Y_Q(u^N)` where `θ_Q(-u^N) ≠ 0`) and an
element `F_N ∈ K(x_Q ∘ ψ, y_Q ∘ ψ) = ψ^* K(E_Q)` with values
`F_N(u) = f_N(u^N) = Θ̈_q(u^N)/Θ̈_{q^N}(u^N)^N` wherever `θ_Q(-u^N) ≠ 0 ≠ Θ̈_{q^N}(u^N)`. -/
theorem exists_pullTheta (hev : Even N) :
    ∃ (gX gY F : TateField t) (D : TateRing t), D ≠ 0 ∧
      F ∈ IntermediateField.adjoin K ({gX, gY} : Set (TateField t)) ∧
      ∀ (u : Kˣ) (hu : OffOrbit t u),
        (evalTate t h12 hu D ≠ 0 ↔ T.theta (-(u ^ N)) ≠ 0) ∧
        (T.theta (-(u ^ N)) ≠ 0 →
          HasTateValue t h12 gX hu (T.X (u ^ N)) ∧ HasTateValue t h12 gY hu (T.Y (u ^ N)) ∧
          (etaleTheta (tatePow t N hN) (u ^ N) ≠ 0 →
            HasTateValue t h12 F hu (thetaLevel t N hN (u ^ N)))) := by
  obtain ⟨gX, DX, hX⟩ := exists_pullX t h12 hs hN T hT
  obtain ⟨gY, DY, hY⟩ := exists_pullY t h12 hs hN T hT hev
  obtain ⟨P₁, Q₁, P₂, Q₂, hP⟩ := thetaLevel_eq_div t h12 hs N hN hev T hT
  set num := Polynomial.aeval gX P₁ + gY * Polynomial.aeval gX Q₁
  set den := Polynomial.aeval gX P₂ + gY * Polynomial.aeval gX Q₂
  have hvals : ∀ (u : Kˣ) (hu : OffOrbit t u), T.theta (-(u ^ N)) ≠ 0 →
      HasTateValue t h12 num hu ((P₁.eval (T.X (u ^ N)) + T.Y (u ^ N) * Q₁.eval (T.X (u ^ N)))) ∧
      HasTateValue t h12 den hu ((P₂.eval (T.X (u ^ N)) + T.Y (u ^ N) * Q₂.eval (T.X (u ^ N)))) :=
    fun u hu h0 =>
      ⟨((hX u hu).2 h0).aeval P₁ |>.add (((hY u hu).2 h0).mul (((hX u hu).2 h0).aeval Q₁)),
        ((hX u hu).2 h0).aeval P₂ |>.add (((hY u hu).2 h0).mul (((hX u hu).2 h0).aeval Q₂))⟩
  -- a good point
  obtain ⟨u₀, hn₀, h1₀⟩ := exists_good_unit t hN
  have hu₀ : OffOrbit t u₀ := offOrbit_of_norm hn₀ fun h => h1₀ (by rw [h, one_pow])
  have hv₀n : ‖((u₀ ^ N : Kˣ) : K)‖ = 1 := by
    rw [Units.val_pow_eq_pow_val, norm_pow, hn₀, one_pow]
  have hv₀1 : ((u₀ ^ N : Kˣ) : K) ≠ 1 := by
    intro h; apply h1₀; rw [pow_mul', ← Units.val_pow_eq_pow_val, h, one_pow]
  have hθ₀ : T.theta (-(u₀ ^ N)) ≠ 0 := theta_neg_ne_zero T (offOrbit_of_norm hv₀n hv₀1)
  have hΘ₀ : etaleTheta (tatePow t N hN) (u₀ ^ N) ≠ 0 := by
    rw [Ne, etaleTheta_eq_zero_iff]
    rintro ⟨k, hk⟩
    apply h1₀
    have hsq : ‖(((u₀ ^ N : Kˣ) : K)) ^ 2‖ = 1 := by rw [norm_pow, hv₀n, one_pow]
    have := eq_one_of_q_zpow_mul (T := tatePow t N hN) hsq
      (k := -k) (by rw [hk, ← zpow_add₀ (tatePow t N hN).q.ne_zero, neg_add_cancel, zpow_zero])
    rw [mul_comm 2 N, pow_mul, ← Units.val_pow_eq_pow_val]
    exact this
  have hden0 : den ≠ 0 := by
    obtain ⟨-, hd⟩ := hvals u₀ hu₀ hθ₀
    refine hd.ne_zero ?_
    have := (hP (u₀ ^ N) (offOrbit_of_theta_ne_zero hθ₀)).2
    rwa [Ne, this]
  refine ⟨gX, gY, num / den, DX * DY, ?_, ?_, fun u hu => ?_⟩
  · intro h0
    have : evalTate t h12 hu₀ (DX * DY) ≠ 0 := by
      rw [map_mul]
      exact mul_ne_zero ((hX u₀ hu₀).1.mpr hθ₀) ((hY u₀ hu₀).1.mpr hθ₀)
    rw [h0, map_zero] at this
    exact this rfl
  · have hgX : gX ∈ IntermediateField.adjoin K ({gX, gY} : Set (TateField t)) :=
      IntermediateField.subset_adjoin _ _ (by simp)
    have hgY : gY ∈ IntermediateField.adjoin K ({gX, gY} : Set (TateField t)) :=
      IntermediateField.subset_adjoin _ _ (by simp)
    exact div_mem (add_mem (aeval_mem_adjoin hgX P₁) (mul_mem hgY (aeval_mem_adjoin hgX Q₁)))
      (add_mem (aeval_mem_adjoin hgX P₂) (mul_mem hgY (aeval_mem_adjoin hgX Q₂)))
  · refine ⟨?_, fun h0 => ⟨(hX u hu).2 h0, (hY u hu).2 h0, fun hΘ => ?_⟩⟩
    · rw [map_mul]
      exact ⟨fun h => (hX u hu).1.mp (left_ne_zero_of_mul h),
        fun h => mul_ne_zero ((hX u hu).1.mpr h) ((hY u hu).1.mpr h)⟩
    · obtain ⟨hn, hd⟩ := hvals u hu h0
      obtain ⟨he, hz⟩ := hP (u ^ N) (offOrbit_of_theta_ne_zero h0)
      have hd0 : P₂.eval (T.X (u ^ N)) + T.Y (u ^ N) * Q₂.eval (T.X (u ^ N)) ≠ 0 := by
        rwa [Ne, hz]
      exact (hn.div hd hd0).congr he.symm

end Iut.EtaleTheta
