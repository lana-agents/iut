import Iut.EtaleTheta.CyclotomicRigidity
import Mathlib.GroupTheory.SemidirectProduct

/-!
# The arithmetic model of `(Π^tp_Y)^Θ[μ_N]` and [EtTh], Prop. 2.14(i) (step 2, milestone (12))

The abelian environments of `CyclotomicRigidity.lean` model the *geometric* theta quotient
`(Δ^tp_Y)^Θ[μ_N] = μ × Δ_Θ × (Δ_Y)^ell`. Here the arithmetic group

`Π = (μ × Δ_Θ × (Δ_Y)^ell) ⋊ G`

is built (`Arith`), `G` (in [EtTh]: `G_K`) acting on all three factors through a cyclotomic
character `χ : G → ℤˣ` (`cycAct`; `μ_N`, `Δ_Θ` and `(Δ_Y)^ell` are Tate twists of `ℤ^`, so `G_K`
acts on them by the cyclotomic character, reduced to `ℤˣ` in the model). The subgroup
`D ⊆ Out(Π)` is generated by

* the conjugations `γ_k` by the powers of the generator of `Gal(Y/X) ≅ l·ℤ`
  (`(m, c, a) ↦ (m, c + k·l·a, a)`, as in the geometric model; they commute with `χ`), and
* the **Kummer twists** by `K^×`: multiplying the theta function by a scalar `u ∈ K^×`
  modifies the theta section by the Kummer class `κ_u` of `u`, a `1`-cocycle `G → μ`
  (`(x, σ) ↦ (x + κ_u(σ), σ)`).

`arithAut k κ` is the automorphism `γ_k` composed with the Kummer twist by the cocycle `κ`.

## Results

* `arithAut`: these are automorphisms of `Π` inducing the identity on `G`
  (`arithAut_right`) and `γ_k` on the geometric subgroup (`arithAut_inl`).
* **[EtTh], Prop. 2.14(i)** (`prop214`): if `G` is center-free (`G_K` is, [Mzk2], Thm 1.1.1(ii);
  this is the input of Mochizuki's proof), the set of `γ(β)·β⁻¹`, for `β` in the geometric
  subgroup `(Δ_Y)^Θ[μ]` and `γ ∈ Aut(Π)` whose class in `Out(Π)` lies in `D` (i.e.
  `γ = arithAut k κ ∘ inn(h)`) and which induces the identity on `Π ↠ G`, is exactly the image of
  `l·Δ_Θ` under the tautological section. As in [EtTh]: the Kummer twists (the automorphisms
  arising from `K^×`) restrict to the identity on the geometric subgroup, and the inner part is
  forced into the (abelian) geometric subgroup by the center-freeness.
* `prop214_inter`: the same set intersected with `(l·Δ_Θ)[μ]` (the form of the statement in
  [EtTh]).
-/

namespace Iut.EtaleTheta

open SemidirectProduct

universe u

variable (M : Type u) [AddCommGroup M] (l : ℤ) (μ : Type u) [AddCommGroup μ]
  (G : Type u) [Group G] (χ : G →* ℤˣ)

/-- The geometric part `(Δ_Y)^Θ[μ] = μ × Δ_Θ × (Δ_Y)^ell`, written multiplicatively. -/
abbrev Geo : Type u := Multiplicative (μ × M × M)

/-- Multiplication by a unit `u ∈ ℤˣ` on the geometric part. -/
def cycAut (u : ℤˣ) : MulAut (Geo M μ) where
  toFun x := Multiplicative.ofAdd (u • Multiplicative.toAdd x)
  invFun x := Multiplicative.ofAdd (u⁻¹ • Multiplicative.toAdd x)
  left_inv x := by
    change Multiplicative.ofAdd (u⁻¹ • Multiplicative.toAdd (Multiplicative.ofAdd _)) = x
    rw [toAdd_ofAdd, inv_smul_smul, ofAdd_toAdd]
  right_inv x := by
    change Multiplicative.ofAdd (u • Multiplicative.toAdd (Multiplicative.ofAdd _)) = x
    rw [toAdd_ofAdd, smul_inv_smul, ofAdd_toAdd]
  map_mul' x y := by simp [smul_add]

lemma cycAut_apply (u : ℤˣ) (x : Geo M μ) :
    cycAut M μ u x = Multiplicative.ofAdd (u • Multiplicative.toAdd x) := rfl

/-- **The cyclotomic action** of `G` on the geometric part, through `χ`. -/
def cycAct : G →* MulAut (Geo M μ) where
  toFun σ := cycAut M μ (χ σ)
  map_one' := MulEquiv.ext fun x => by simp [cycAut_apply]
  map_mul' σ τ := MulEquiv.ext fun x => by simp [cycAut_apply, mul_smul]

lemma cycAct_apply (σ : G) : cycAct M μ G χ σ = cycAut M μ (χ σ) := rfl

/-- **The arithmetic model** `(Π^tp_Y)^Θ[μ] = (μ × Δ_Θ × (Δ_Y)^ell) ⋊ G`. -/
abbrev Arith : Type u := Geo M μ ⋊[cycAct M μ G χ] G

variable {M μ G χ}

lemma gammaK_smul (k : ℤ) (u : ℤˣ) (x : μ × M × M) :
    gammaK M l μ k (u • x) = u • gammaK M l μ k x := by
  rcases x with ⟨m, c, a⟩
  ext <;> simp [gammaK, Units.smul_def, smul_add, smul_comm (u : ℤ) (k * l)]

lemma gammaK_symm_smul (k : ℤ) (u : ℤˣ) (x : μ × M × M) :
    (gammaK M l μ k).symm (u • x) = u • (gammaK M l μ k).symm x := by
  apply (gammaK M l μ k).injective
  rw [AddEquiv.apply_symm_apply, gammaK_smul, AddEquiv.apply_symm_apply]

/-- A **Kummer cocycle** `κ : G → μ` (the Kummer class of a scalar `u ∈ K^×`):
`κ(στ) = κ(σ) + χ(σ)·κ(τ)`. -/
def IsKummerCocycle (κ : G → μ) : Prop := ∀ σ τ, κ (σ * τ) = κ σ + χ σ • κ τ

lemma IsKummerCocycle.map_one {κ : G → μ} (hκ : IsKummerCocycle (χ := χ) κ) : κ 1 = 0 := by
  have := hκ 1 1
  rw [mul_one, χ.map_one, one_smul] at this
  exact left_eq_add.mp this

lemma isKummerCocycle_zero : IsKummerCocycle (χ := χ) (fun _ : G => (0 : μ)) := fun _ _ => by
  simp

/-- The left component of `arithAut`. -/
def arithFun (k : ℤ) (κ : G → μ) (x : Arith M μ G χ) : Arith M μ G χ :=
  ⟨Multiplicative.ofAdd (gammaK M l μ k (Multiplicative.toAdd x.left) + (κ x.right, 0, 0)),
    x.right⟩

/-- The inverse of `arithFun`. -/
def arithInv (k : ℤ) (κ : G → μ) (x : Arith M μ G χ) : Arith M μ G χ :=
  ⟨Multiplicative.ofAdd ((gammaK M l μ k).symm (Multiplicative.toAdd x.left - (κ x.right, 0, 0))),
    x.right⟩

/-- **The automorphism `γ_k` composed with the Kummer twist by `κ`**:
`(x, σ) ↦ (γ_k(x) + κ(σ), σ)`. -/
def arithAut (k : ℤ) (κ : G → μ) (hκ : IsKummerCocycle (χ := χ) κ) : MulAut (Arith M μ G χ) where
  toFun := arithFun l k κ
  invFun := arithInv l k κ
  left_inv x := by
    obtain ⟨a, σ⟩ := x
    simp only [arithFun, arithInv, toAdd_ofAdd, add_sub_cancel_right, AddEquiv.symm_apply_apply,
      ofAdd_toAdd]
  right_inv x := by
    obtain ⟨a, σ⟩ := x
    simp only [arithFun, arithInv, toAdd_ofAdd, sub_add_cancel, AddEquiv.apply_symm_apply,
      ofAdd_toAdd]
  map_mul' x y := by
    refine SemidirectProduct.ext ?_ rfl
    simp only [arithFun, mul_left, mul_right, cycAct_apply, cycAut_apply, toAdd_mul,
      toAdd_ofAdd, map_add, gammaK_smul, smul_add, ← ofAdd_add, hκ x.right y.right]
    congr 1
    ext
    · simp only [Prod.fst_add, Prod.smul_fst]
      abel
    · simp
    · simp

@[simp] lemma arithAut_right (k : ℤ) (κ : G → μ) (hκ : IsKummerCocycle (χ := χ) κ)
    (x : Arith M μ G χ) : (arithAut l k κ hκ x).right = x.right := rfl

/-- On the geometric subgroup `arithAut k κ` is `γ_k` (the Kummer twist is trivial there). -/
lemma arithAut_inl (k : ℤ) (κ : G → μ) (hκ : IsKummerCocycle (χ := χ) κ) (b : Geo M μ) :
    arithAut l k κ hκ (inl b) =
      inl (Multiplicative.ofAdd (gammaK M l μ k (Multiplicative.toAdd b))) := by
  refine SemidirectProduct.ext ?_ rfl
  change Multiplicative.ofAdd (_ + (κ 1, 0, 0)) = _
  rw [hκ.map_one]
  simp

/-- The automorphisms of `Π` whose class in `Out(Π)` lies in `D`. -/
def AutD (γ : MulAut (Arith M μ G χ)) : Prop :=
  ∃ (k : ℤ) (κ : G → μ) (hκ : IsKummerCocycle (χ := χ) κ) (h : Arith M μ G χ),
    γ = arithAut l k κ hκ * MulAut.conj h

/-- The set of [EtTh], Prop. 2.14(i): the `γ(β)·β⁻¹`, `β` geometric, `γ` with class in `D`
inducing the identity on `G`. -/
def prop214Set : Set (Arith M μ G χ) :=
  {z | ∃ γ : MulAut (Arith M μ G χ), AutD l γ ∧ (∀ x, (γ x).right = x.right) ∧
    ∃ β : Arith M μ G χ, β.right = 1 ∧ z = γ β * β⁻¹}

/-- The image of `l·Δ_Θ` under the tautological section: `y ↦ (0, l·y, 0)`. -/
def tautArith (y : M) : Arith M μ G χ := inl (Multiplicative.ofAdd (0, l • y, 0))

/-- **[EtTh], Prop. 2.14(i)** in the arithmetic model: for a center-free `G`, the set of
`γ(β)·β⁻¹` (`β` geometric, `γ` with class in `D` and identity on `G`) is the image of `l·Δ_Θ`
under the tautological section. -/
theorem prop214 (hG : ∀ τ : G, (∀ σ, τ * σ = σ * τ) → τ = 1) :
    prop214Set (M := M) (μ := μ) (G := G) (χ := χ) l = Set.range (tautArith l) := by
  ext z
  constructor
  · rintro ⟨γ, ⟨k, κ, hκ, h, rfl⟩, hid, β, hβ, rfl⟩
    -- the inner part is geometric
    have hτ : h.right = 1 := by
      refine hG _ fun σ => ?_
      have := hid (inr σ)
      simp only [MulAut.mul_apply, arithAut_right, MulAut.conj_apply, mul_right, inv_right,
        right_inr] at this
      calc h.right * σ = h.right * σ * h.right⁻¹ * h.right := by group
        _ = σ * h.right := by rw [this]
    have hh : h = inl h.left := SemidirectProduct.ext rfl hτ
    have hb : β = inl β.left := SemidirectProduct.ext rfl hβ
    refine ⟨k • (Multiplicative.toAdd β.left).2.2, ?_⟩
    rw [MulAut.mul_apply, MulAut.conj_apply, hh, hb, ← map_inv, ← map_mul, ← map_mul,
      mul_inv_cancel_comm, arithAut_inl, ← map_inv, ← map_mul]
    unfold tautArith
    congr 1
    rw [← ofAdd_toAdd (Multiplicative.ofAdd _ * _), toAdd_mul, toAdd_ofAdd, toAdd_inv,
      ← sub_eq_add_neg, gammaK_sub]
    simp [mul_comm k l, mul_smul]
  · rintro ⟨y, rfl⟩
    refine ⟨arithAut l 1 (fun _ => 0) isKummerCocycle_zero * MulAut.conj 1,
      ⟨1, _, isKummerCocycle_zero, 1, rfl⟩, fun x => by simp, inl (Multiplicative.ofAdd (0, 0, y)),
      rfl, ?_⟩
    rw [MulAut.mul_apply, MulAut.conj_apply, one_mul, inv_one, mul_one, arithAut_inl, ← map_inv,
      ← map_mul]
    unfold tautArith
    congr 1
    rw [← ofAdd_toAdd (Multiplicative.ofAdd _ * _), toAdd_mul, toAdd_ofAdd, toAdd_inv,
      toAdd_ofAdd, ← sub_eq_add_neg,
      gammaK_sub]
    simp

/-- The subquotient `(l·Δ_Θ)[μ]` in the arithmetic model. -/
def lArith : Set (Arith M μ G χ) :=
  Set.range fun x : μ × M => inl (Multiplicative.ofAdd (x.1, l • x.2, 0))

/-- **[EtTh], Prop. 2.14(i)**, in the form of the statement: the intersection with `(l·Δ_Θ)[μ]`. -/
theorem prop214_inter (hG : ∀ τ : G, (∀ σ, τ * σ = σ * τ) → τ = 1) :
    lArith (M := M) (μ := μ) (G := G) (χ := χ) l ∩ prop214Set l = Set.range (tautArith l) := by
  rw [prop214 l hG]
  refine Set.inter_eq_right.2 ?_
  rintro _ ⟨y, rfl⟩
  exact ⟨(0, y), rfl⟩

end Iut.EtaleTheta
