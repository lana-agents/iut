import Mathlib.GroupTheory.Abelianization.Defs
import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.GroupTheory.Subgroup.Center
import Mathlib.Tactic.Group
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-!
# The theta quotient of a group ([EtTh], §1)

[EtTh], §1 (l.455–475): for the geometric fundamental group `Δ` (profinite free on two
generators) one writes `Δ^ell = Δ^ab`, `Δ^Θ = Δ/[Δ, [Δ, Δ]]` and `Δ_Θ ⊆ Δ^Θ` for the image of
`∧² Δ^ell`, so that `1 → Δ_Θ → Δ^Θ → Δ^ell → 1`. This file proves the group-theoretic part for an
arbitrary group:

* `thetaQuot Δ := Δ ⧸ ⁅[Δ, Δ], ⊤⁆` is of nilpotency class `≤ 2` (`thetaQuot_isClassTwo`).
* In a class-`2` group (`IsClassTwo G`: commutators are central) the commutator is
  **biadditive** (`commutatorElement_mul_left`, `commutatorElement_mul_right`), **alternating**,
  depends only on the classes in `G^ab` (`commutatorElement_eq_of_ab_eq`), and the resulting
  pairing `thetaPairing : Abelianization G →* Abelianization G →* center G` (with values in
  `[G, G]`, `thetaPairing_mem_commutator`) is natural for
  homomorphisms (`map_thetaPairing`): the "`∧² Δ^ell → Δ_Θ`" of [EtTh].
* `commutator_eq_zpowers`: if `G` is generated by two elements `a, b`, then
  `[G, G] = ⟨⁅a, b⁆⟩` is cyclic (for `Δ` free on two generators, `Δ_Θ` is generated by the
  commutator of the generators).
-/

open scoped commutatorElement

namespace Iut.EtaleTheta

section ClassTwo

variable {G : Type*} [Group G]

/-- `G` has nilpotency class `≤ 2`: every commutator is central. -/
def IsClassTwo (G : Type*) [Group G] : Prop := ∀ x y z : G, ⁅x, y⁆ * z = z * ⁅x, y⁆

variable (h : IsClassTwo G)
include h

theorem IsClassTwo.mem_center (x y : G) : ⁅x, y⁆ ∈ Subgroup.center G :=
  Subgroup.mem_center_iff.mpr fun z => (h x y z).symm

theorem IsClassTwo.commute_of_mem_commutator {c : G} (hc : c ∈ commutator G) (z : G) :
    c * z = z * c := by
  have hle : commutator G ≤ Subgroup.center G := by
    rw [commutator_def, Subgroup.commutator_le]
    intro x _ y _
    exact h.mem_center x y
  exact ((Subgroup.mem_center_iff.mp (hle hc)) z).symm

/-- Biadditivity in the first variable. -/
theorem IsClassTwo.commutatorElement_mul_left (a b c : G) : ⁅a * b, c⁆ = ⁅a, c⁆ * ⁅b, c⁆ := by
  calc ⁅a * b, c⁆ = a * ⁅b, c⁆ * (c * a⁻¹ * c⁻¹) := by
        simp only [commutatorElement_def]; group
    _ = ⁅b, c⁆ * a * (c * a⁻¹ * c⁻¹) := by rw [h b c a]
    _ = ⁅b, c⁆ * ⁅a, c⁆ := by simp only [commutatorElement_def]; group
    _ = ⁅a, c⁆ * ⁅b, c⁆ := h b c ⁅a, c⁆

/-- Biadditivity in the second variable. -/
theorem IsClassTwo.commutatorElement_mul_right (a b c : G) : ⁅a, b * c⁆ = ⁅a, b⁆ * ⁅a, c⁆ := by
  rw [← commutatorElement_inv, h.commutatorElement_mul_left, mul_inv_rev, commutatorElement_inv,
    commutatorElement_inv]
  exact h a c ⁅a, b⁆

omit h in
theorem IsClassTwo.commutatorElement_one_left (a : G) : ⁅(1 : G), a⁆ = 1 := by
  simp [commutatorElement_def]

/-- The commutator only depends on the classes modulo `[G, G]` (since `[G, G]` is central). -/
theorem IsClassTwo.commutatorElement_mul_comm_left (a c : G) {d : G} (hd : d ∈ commutator G) :
    ⁅a * d, c⁆ = ⁅a, c⁆ := by
  rw [h.commutatorElement_mul_left]
  have : ⁅d, c⁆ = 1 := commutatorElement_eq_one_iff_mul_comm.mpr (h.commute_of_mem_commutator hd c)
  rw [this, mul_one]

theorem IsClassTwo.commutatorElement_eq_of_ab_eq {a a' c c' : G}
    (ha : (Abelianization.of a : Abelianization G) = Abelianization.of a')
    (hc : (Abelianization.of c : Abelianization G) = Abelianization.of c') :
    ⁅a, c⁆ = ⁅a', c'⁆ := by
  have ha' : a⁻¹ * a' ∈ commutator G := by
    rw [← QuotientGroup.eq]; exact ha
  have hc' : c⁻¹ * c' ∈ commutator G := by
    rw [← QuotientGroup.eq]; exact hc
  have e1 : ⁅a', c⁆ = ⁅a, c⁆ := by
    rw [show a' = a * (a⁻¹ * a') by group]
    exact h.commutatorElement_mul_comm_left a c ha'
  have e2 : ⁅a', c'⁆ = ⁅a', c⁆ := by
    rw [show c' = c * (c⁻¹ * c') by group, h.commutatorElement_mul_right]
    have : ⁅a', c⁻¹ * c'⁆ = 1 := by
      rw [← commutatorElement_inv, inv_eq_one]
      exact commutatorElement_eq_one_iff_mul_comm.mpr (h.commute_of_mem_commutator hc' a')
    rw [this, mul_one]
  rw [e2, e1]

omit h in
theorem commutatorElement_mem_commutator (a c : G) : ⁅a, c⁆ ∈ commutator G := by
  rw [commutator_def]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top a) (Subgroup.mem_top c)

omit h in
/-- Induction principle for `G^ab`. -/
theorem abel_induction {P : Abelianization G → Prop} (x : Abelianization G)
    (hP : ∀ a : G, P (Abelianization.of a)) : P x :=
  QuotientGroup.induction_on x fun a => hP a

omit h in
/-- The center is commutative. -/
abbrev centerCommGroup : CommGroup (Subgroup.center G) :=
  { (inferInstance : Group (Subgroup.center G)) with
    mul_comm := fun a b => Subtype.ext (Subgroup.mem_center_iff.mp b.2 a) }

attribute [local instance] centerCommGroup

/-- The commutator with a fixed right argument, as a homomorphism `G → Z(G)`. -/
def commLeftHom (c : G) : G →* Subgroup.center G where
  toFun a := ⟨⁅a, c⁆, h.mem_center a c⟩
  map_one' := Subtype.ext (by simp [commutatorElement_def])
  map_mul' a b := Subtype.ext (h.commutatorElement_mul_left a b c)

/-- `c ↦ ⁅x, c⁆` for `x ∈ G^ab`. -/
def commRightHom (x : Abelianization G) : G →* Subgroup.center G where
  toFun c := Abelianization.lift (commLeftHom h c) x
  map_one' := by
    induction x using abel_induction with
    | hP a =>
      exact Subtype.ext (by simp [commLeftHom, Abelianization.lift_apply_of, commutatorElement_def])
  map_mul' c d := by
    induction x using abel_induction with
    | hP a =>
      exact Subtype.ext
        (by simp [commLeftHom, Abelianization.lift_apply_of, h.commutatorElement_mul_right])

/-- **The pairing `∧² Δ^ell → Δ_Θ`**: `(ā, c̄) ↦ ⁅a, c⁆`, biadditive on `G^ab`, with values in the
center (and in `[G, G]`, `thetaPairing_mem_commutator`). -/
def thetaPairing : Abelianization G →* Abelianization G →* Subgroup.center G where
  toFun x := Abelianization.lift (commRightHom h x)
  map_one' := by
    ext c
    simp [commRightHom]
  map_mul' x y := by
    ext c
    simp [commRightHom]

@[simp]
theorem thetaPairing_of (a c : G) :
    (thetaPairing h (Abelianization.of a) (Abelianization.of c) : G) = ⁅a, c⁆ := by
  simp [thetaPairing, commRightHom, commLeftHom, Abelianization.lift_apply_of]

theorem thetaPairing_mem_commutator (x y : Abelianization G) :
    (thetaPairing h x y : G) ∈ commutator G := by
  induction x using abel_induction with
  | hP a =>
    induction y using abel_induction with
    | hP b =>
      rw [thetaPairing_of]
      exact commutatorElement_mem_commutator _ _

/-- The pairing is alternating. -/
theorem thetaPairing_self (x : Abelianization G) : thetaPairing h x x = 1 := by
  induction x using abel_induction with
  | hP a => exact Subtype.ext (by simp)

theorem thetaPairing_swap (x y : Abelianization G) :
    thetaPairing h y x = (thetaPairing h x y)⁻¹ := by
  induction x using abel_induction with
  | hP a =>
    induction y using abel_induction with
    | hP b => exact Subtype.ext (by simp [commutatorElement_inv])

/-- **Naturality** of the pairing: a homomorphism `f : G →* G'` of class-`2` groups maps
`⁅a, c⁆` to `⁅f a, f c⁆` (in particular automorphisms of `Δ` act compatibly on `Δ^ell` and
`Δ_Θ`). -/
theorem map_thetaPairing {G' : Type*} [Group G'] (h' : IsClassTwo G') (f : G →* G')
    (x y : Abelianization G) :
    (f (thetaPairing h x y : G)) =
      (thetaPairing h' (Abelianization.map f x) (Abelianization.map f y) : G') := by
  induction x using abel_induction with
  | hP a =>
    induction y using abel_induction with
    | hP b => simp [map_commutatorElement]

/-- **Two generators give a cyclic commutator subgroup**: if `G = ⟨a, b⟩` has class `≤ 2`, then
`[G, G]` is generated by `⁅a, b⁆` ([EtTh]: `Δ_Θ ≅ ∧² Δ^ell` is cyclic, generated by the
commutator of the two generators). -/
theorem commutator_eq_zpowers {a b : G} (hab : Subgroup.closure {a, b} = ⊤) :
    commutator G = Subgroup.zpowers ⁅a, b⁆ := by
  apply le_antisymm
  · -- every commutator lies in `⟨⁅a, b⁆⟩`, by induction on both arguments
    set Z := Subgroup.zpowers ⁅a, b⁆
    have key : ∀ x y : G, ⁅x, y⁆ ∈ Z := by
      -- first: commutators with a generator on the left
      have gen : ∀ g ∈ ({a, b} : Set G), ∀ y : G, ⁅g, y⁆ ∈ Z := by
        intro g hg y
        have hy : y ∈ Subgroup.closure {a, b} := hab ▸ Subgroup.mem_top y
        induction hy using Subgroup.closure_induction with
        | mem y hy' =>
          rcases hg with rfl | rfl <;> rcases hy' with rfl | rfl
          · simp [commutatorElement_def, Z]
          · exact Subgroup.mem_zpowers _
          · rw [← commutatorElement_inv]; exact Subgroup.inv_mem _ (Subgroup.mem_zpowers _)
          · simp [commutatorElement_def, Z]
        | one => simp [commutatorElement_def, Z]
        | mul y z _ _ hy hz =>
          rw [h.commutatorElement_mul_right]; exact Subgroup.mul_mem _ hy hz
        | inv y _ hy =>
          have : ⁅g, y⁻¹⁆ = ⁅g, y⁆⁻¹ := by
            have e := h.commutatorElement_mul_right g y y⁻¹
            rw [mul_inv_cancel, show ⁅g, (1 : G)⁆ = 1 by simp [commutatorElement_def]] at e
            exact eq_inv_of_mul_eq_one_right e.symm
          rw [this]; exact Subgroup.inv_mem _ hy
      intro x y
      have hx : x ∈ Subgroup.closure {a, b} := hab ▸ Subgroup.mem_top x
      induction hx using Subgroup.closure_induction with
      | mem x hx' => exact gen x hx' y
      | one => simp [commutatorElement_def, Z]
      | mul x z _ _ hx hz => rw [h.commutatorElement_mul_left]; exact Subgroup.mul_mem _ hx hz
      | inv x _ hx =>
        have : ⁅x⁻¹, y⁆ = ⁅x, y⁆⁻¹ := by
          have e := h.commutatorElement_mul_left x x⁻¹ y
          rw [mul_inv_cancel, IsClassTwo.commutatorElement_one_left] at e
          exact eq_inv_of_mul_eq_one_right e.symm
        rw [this]; exact Subgroup.inv_mem _ hx
    rw [commutator_def, Subgroup.commutator_le]
    intro x _ y _
    exact key x y
  · rw [Subgroup.zpowers_le]
    exact commutatorElement_mem_commutator _ _

end ClassTwo

section Quotient

variable (Δ : Type*) [Group Δ]

/-- `[[Δ, Δ], Δ]`, the kernel of `Δ ↠ Δ^Θ`. -/
def thetaKernel : Subgroup Δ := ⁅commutator Δ, ⊤⁆

instance : (thetaKernel Δ).Normal := by
  unfold thetaKernel; infer_instance

/-- **The theta quotient** `Δ^Θ = Δ / [[Δ, Δ], Δ]` ([EtTh], §1). -/
abbrev thetaQuot : Type _ := Δ ⧸ thetaKernel Δ

/-- `Δ^Θ` has nilpotency class `≤ 2`. -/
theorem thetaQuot_isClassTwo : IsClassTwo (thetaQuot Δ) := by
  intro x y z
  induction x using QuotientGroup.induction_on with
  | H x =>
  induction y using QuotientGroup.induction_on with
  | H y =>
  induction z using QuotientGroup.induction_on with
  | H z =>
  rw [← commutatorElement_eq_one_iff_mul_comm]
  have hmem : ⁅⁅x, y⁆, z⁆ ∈ thetaKernel Δ :=
    Subgroup.commutator_mem_commutator (commutatorElement_mem_commutator x y) (Subgroup.mem_top z)
  have := (QuotientGroup.eq_one_iff (N := thetaKernel Δ) _).mpr hmem
  have e : ((⁅⁅x, y⁆, z⁆ : Δ) : thetaQuot Δ) =
      ⁅⁅(x : thetaQuot Δ), (y : thetaQuot Δ)⁆, (z : thetaQuot Δ)⁆ := by
    simp [commutatorElement_def]
  rw [← e]
  exact this

end Quotient

end Iut.EtaleTheta
