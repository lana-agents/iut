import Iut.EtaleTheta.Heisenberg
import Mathlib.GroupTheory.Torsion

/-!
# Cyclotomic rigidity of mono-theta environments ([EtTh], Cor. 2.19(i), Prop. 2.14(i))

A mod `N` mono-theta environment ([EtTh], Definition 2.13(ii)) is a triple `(Π, D, s^Θ)`: a
topological group `Π ≅ Π^tp_Y[μ_N]`, a subgroup `D ⊆ Out(Π)` (generated by `K^×` and
`Gal(Y/X) ≅ l·ℤ`), and the `μ_N`-conjugacy class of the image of the theta section
`s^Θ : Π^tp_Ÿ → Π^tp_Y[μ_N]`. **Cyclotomic rigidity** ([EtTh], Cor. 2.19(i)) is a functorial
group-theoretic algorithm which reconstructs, from the environment alone, the subquotients
`μ_N`, `(l·Δ_Θ)[μ_N]` and the two splittings of `(l·Δ_Θ)[μ_N] ↠ l·Δ_Θ` given by the algebraic
(tautological) and theta sections, hence the isomorphism of cyclotomes
`(l·Δ_Θ) ⊗ ℤ/N ≅ μ_N` as their difference.

This file formalizes that algorithm for environments whose group is **abelian** — the geometric
theta quotient `(Δ^tp_Y)^Θ[μ_N]` (abelian by [EtTh], proof of Prop. 2.14(i)) — written
additively, and proves it in full there:

## The abstract algorithm (`Env`)

An environment `E : Env` is an abelian group `Π` with a set `D` of automorphisms (for abelian
`Π`, `Out(Π) = Aut(Π)`) and a subgroup `S` (the image of the theta section; `μ_N`-conjugacy is
trivial). Isomorphisms `Env.Iso` are group isomorphisms transporting `D` and `S`. The algorithm:

* `Env.mu` — the cyclotome `μ_N`: the torsion subgroup (`Π^tp_Y` is torsion-free; [EtTh] uses
  temp-slimness instead, `Envelope.mem_range_inl_iff`);
* `Env.taut` — the algebraic splitting of `l·Δ_Θ`: the subgroup generated by `γ(β) - β`,
  `γ ∈ D` ([EtTh], Prop. 2.14(i));
* `Env.L := mu ⊔ taut` — the subquotient `(l·Δ_Θ)[μ_N]`;
* `Env.thetaSplit := S ⊓ L` — the theta splitting;
* `Env.IsCyc t m` — the isomorphism of cyclotomes: `t ∈ taut` corresponds to `m ∈ μ` iff
  `t + m` lies in the theta splitting (the difference of the two splittings).

`Env.Iso.map_mu`, `map_taut`, `map_L`, `map_thetaSplit`, `isCyc_iff`: **the algorithm is
functorial** — every isomorphism of environments carries each output to the corresponding one.

## The model (`model`)

For a torsion-free cyclotome `M` (`Δ_Θ ≅ (Δ_Y)^ell ≅ M`), `l ≠ 0`, a torsion group `μ` (`μ_N`)
with the reduction `red : M →+ μ` (the natural isomorphism `Δ_Θ ⊗ ℤ/N ≅ μ_N`, i.e. the
restriction of the étale theta class to `Δ_Θ`, [EtTh], Prop. 1.3) and the Kummer class
`ρ : M →+ μ` of `Ü` on `(Δ_Ÿ)^ell = 2·(Δ_Y)^ell`, the model environment is
`Π = μ × Δ_Θ × (Δ_Y)^ell` with

* `D = {γ_k}`, `γ_k(m, c, a) = (m, c + k·l·a, a)`: conjugation by the `k`-th power of the
  generator of `Gal(Y/X)` in the theta group (`ThetaGroup.conj_tpow`);
* `S` the image of the theta section `s^Θ(c, 2a') = (-red c - ρ a', c, 2a')` on
  `(Δ_Ÿ)^Θ = Δ_Θ × 2·(Δ_Y)^ell` (the tautological section minus the theta class).

`model_mu`, `model_taut` (**[EtTh], Prop. 2.14(i)**: `{γ(β) - β}` is the image of `l·Δ_Θ` under
the tautological section), `model_L`, `model_thetaSplit`, `model_isCyc`: the algorithm returns
`μ`, `taut(l·Δ_Θ)`, `(l·Δ_Θ)[μ]`, the theta splitting, and the cyclotome isomorphism
`l·c ↦ -red(l·c)` (the restriction of the theta class).

**`cyclotomicRigidity`** ([EtTh], Cor. 2.19(i), for the theta quotient): for any environment
`E` and any isomorphism `f : E ≅ model`, `f` maps `E.mu`, `E.taut`, `E.L`, `E.thetaSplit` onto
`μ`, `taut(l·Δ_Θ)`, `(l·Δ_Θ)[μ]`, the theta splitting, and the algorithmic isomorphism of
cyclotomes of `E` onto the natural one. `cyclotomicRigidity_aut`: every automorphism of the model
environment commutes with `red` on `l·Δ_Θ` — no `(ℤ/N)^×`-indeterminacy.
`model_isCyc_pow`: replacing the theta class by its `n`-th power multiplies the reconstructed
isomorphism by `n` ([EtTh], Remark 2.19.2).

The full Cor. 2.19(i) for `Π^tp_Y[μ_N]` itself needs, besides this algorithm, the group-theoretic
reconstruction of the theta quotient `Π^tp_Y ↠ (Π^tp_Y)^Θ` and of `Π^tp_Ÿ` from `Π^tp_X`
([EtTh], Cor. 2.18(i)), which rests on tempered anabelian results not available here; see
`README.md`.
-/

namespace Iut.EtaleTheta

universe u

/-- **An (abelian, additive) mono-theta environment** ([EtTh], Def. 2.13(ii)): a group `Π`,
a set `D` of automorphisms, and the image `S` of the theta section. -/
structure Env where
  /-- The group `Π ≅ (Δ^tp_Y)^Θ[μ_N]`. -/
  carrier : Type u
  [grp : AddCommGroup carrier]
  /-- The automorphisms `D` (for abelian `Π`, `Out(Π) = Aut(Π)`). -/
  D : Set (carrier ≃+ carrier)
  /-- The image of the theta section. -/
  S : AddSubgroup carrier

attribute [instance] Env.grp

namespace Env

variable (E : Env.{u})

/-- The cyclotome `μ_N`: the torsion subgroup. -/
def mu : AddSubgroup E.carrier := AddCommGroup.torsion E.carrier

/-- The algebraic splitting `taut(l·Δ_Θ)`: generated by the `γ(β) - β`, `γ ∈ D`
([EtTh], Prop. 2.14(i)). -/
def taut : AddSubgroup E.carrier :=
  AddSubgroup.closure {x | ∃ γ ∈ E.D, ∃ β, x = γ β - β}

/-- The subquotient `(l·Δ_Θ)[μ_N]`. -/
def L : AddSubgroup E.carrier := E.mu ⊔ E.taut

/-- The theta splitting of `(l·Δ_Θ)[μ_N] ↠ l·Δ_Θ`. -/
def thetaSplit : AddSubgroup E.carrier := E.S ⊓ E.L

/-- **The isomorphism of cyclotomes** as a relation: `t` (in the algebraic splitting)
corresponds to `m ∈ μ` iff `t + m` lies in the theta splitting. -/
def IsCyc (t m : E.carrier) : Prop := t ∈ E.taut ∧ m ∈ E.mu ∧ t + m ∈ E.thetaSplit

/-- **An isomorphism of environments**: an isomorphism of groups transporting `D` (by
conjugation) and `S`. -/
structure Iso (E E' : Env.{u}) where
  /-- The isomorphism of groups. -/
  e : E.carrier ≃+ E'.carrier
  map_D : ∀ γ : E'.carrier ≃+ E'.carrier, γ ∈ E'.D ↔ (e.trans (γ.trans e.symm)) ∈ E.D
  map_S : E.S.map e.toAddMonoidHom = E'.S

variable {E} {E' : Env.{u}} (f : Iso E E')

namespace Iso

lemma map_mu : E.mu.map f.e.toAddMonoidHom = E'.mu := by
  ext y
  simp only [AddSubgroup.mem_map, mu, AddCommGroup.mem_torsion]
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact (f.e.injective.isOfFinAddOrder_iff (f := f.e.toAddMonoidHom)).2 hx
  · intro hy
    refine ⟨f.e.symm y, ?_, by simp⟩
    rw [← f.e.injective.isOfFinAddOrder_iff (f := f.e.toAddMonoidHom)]
    simpa using hy

lemma map_taut : E.taut.map f.e.toAddMonoidHom = E'.taut := by
  rw [taut, AddMonoidHom.map_closure, taut]
  congr 1
  ext y
  simp only [Set.mem_image, Set.mem_setOf_eq]
  constructor
  · rintro ⟨x, ⟨γ, hγ, β, rfl⟩, rfl⟩
    refine ⟨f.e.symm.trans (γ.trans f.e), ?_, f.e β, ?_⟩
    · rw [f.map_D]
      convert hγ using 1
      ext z
      simp
    · simp
  · rintro ⟨γ', hγ', β', rfl⟩
    refine ⟨_, ⟨_, (f.map_D γ').1 hγ', f.e.symm β', rfl⟩, ?_⟩
    simp

lemma map_L : E.L.map f.e.toAddMonoidHom = E'.L := by
  rw [L, AddSubgroup.map_sup, map_mu, map_taut, L]

lemma map_thetaSplit : E.thetaSplit.map f.e.toAddMonoidHom = E'.thetaSplit := by
  rw [thetaSplit, AddSubgroup.map_inf _ _ _ f.e.injective, f.map_S, map_L, thetaSplit]

lemma mem_iff {H : AddSubgroup E.carrier} {H' : AddSubgroup E'.carrier}
    (h : H.map f.e.toAddMonoidHom = H') (x : E.carrier) : f.e x ∈ H' ↔ x ∈ H := by
  rw [← h, AddSubgroup.mem_map_equiv]
  simp

/-- **Functoriality of the cyclotome isomorphism** ([EtTh], Cor. 2.19(i)). -/
theorem isCyc_iff (t m : E.carrier) : E'.IsCyc (f.e t) (f.e m) ↔ E.IsCyc t m := by
  unfold IsCyc
  rw [f.mem_iff f.map_taut, f.mem_iff f.map_mu, ← map_add, f.mem_iff f.map_thetaSplit]

end Iso

end Env

/-! ### The theta group: `Gal(Y/X)` acting on `(Δ_Y)^Θ` -/

namespace ThetaGroup

variable {M : Type*} [AddCommGroup M] {l : ℤ}

lemma tgen_zpow (k : ℤ) : (tgen : ThetaGroup M l) ^ k = ⟨0, 0, k⟩ := by
  induction k using Int.induction_on with
  | zero => rfl
  | succ k ih =>
    rw [zpow_add_one, ih]
    ext <;> simp [tgen]
  | pred k ih =>
    rw [zpow_sub_one, ih]
    ext <;> simp [tgen, sub_eq_add_neg]

/-- **The generator of `Gal(Y/X)` acts on `(Δ_Y)^Θ = Δ_Θ × (Δ_Y)^ell` by
`(c, a) ↦ (c + k·l·a, a)`**: conjugation by `t^k` in the theta group. -/
theorem conj_tpow (k : ℤ) (c a : M) :
    (tgen : ThetaGroup M l) ^ k * ⟨c, a, 0⟩ * ((tgen : ThetaGroup M l) ^ k)⁻¹ =
      ⟨c + (k * l) • a, a, 0⟩ := by
  rw [tgen_zpow]
  ext <;> simp [mul_comm k l]

end ThetaGroup

/-! ### The model environment -/

section Model

variable (M : Type u) [AddCommGroup M] (l : ℤ) (μ : Type u) [AddCommGroup μ]
  (red ρ : M →+ μ)

/-- The automorphism `γ_k : (m, c, a) ↦ (m, c + k·l·a, a)` of `μ × Δ_Θ × (Δ_Y)^ell`. -/
def gammaK (k : ℤ) : (μ × M × M) ≃+ (μ × M × M) where
  toFun x := (x.1, x.2.1 + (k * l) • x.2.2, x.2.2)
  invFun x := (x.1, x.2.1 - (k * l) • x.2.2, x.2.2)
  left_inv x := by simp
  right_inv x := by simp
  map_add' x y := by
    ext <;> simp only [Prod.fst_add, Prod.snd_add, smul_add]
    abel

/-- The theta section `s^Θ(c, 2a') = (-red c - ρ a', c, 2a')` on `(Δ_Ÿ)^Θ = Δ_Θ × 2(Δ_Y)^ell`. -/
def thetaSection : M × M →+ μ × M × M where
  toFun x := (-red x.1 - ρ x.2, x.1, 2 • x.2)
  map_zero' := by simp
  map_add' x y := by
    ext <;> simp only [Prod.fst_add, Prod.snd_add, map_add, smul_add]
    abel

/-- **The model mono-theta environment** of the geometric theta quotient
`(Δ^tp_Y)^Θ[μ_N] = μ × Δ_Θ × (Δ_Y)^ell` ([EtTh], Definition 2.13(ii)). -/
abbrev model : Env.{u} where
  carrier := μ × M × M
  D := Set.range (gammaK M l μ)
  S := (thetaSection M μ red ρ).range

/-- The tautological (algebraic) section on `l·Δ_Θ`: `c ↦ (0, c, 0)`. -/
def tautSection : M →+ μ × M × M where
  toFun c := (0, c, 0)
  map_zero' := rfl
  map_add' _ _ := by ext <;> simp

/-- `y ↦ (0, l·y, 0)`: the image of `l·Δ_Θ` under the tautological section. -/
def tautHom : M →+ μ × M × M where
  toFun y := (0, l • y, 0)
  map_zero' := by simp
  map_add' _ _ := by ext <;> simp

/-- `(m, y) ↦ (m, l·y, 0)`: the subquotient `(l·Δ_Θ)[μ]`. -/
def lHom : μ × M →+ μ × M × M where
  toFun x := (x.1, l • x.2, 0)
  map_zero' := by simp
  map_add' _ _ := by ext <;> simp

/-- `y ↦ (-red(l·y), l·y, 0)`: the theta splitting of `(l·Δ_Θ)[μ] ↠ l·Δ_Θ`. -/
def thetaHom : M →+ μ × M × M where
  toFun y := (-red (l • y), l • y, 0)
  map_zero' := by simp
  map_add' _ _ := by
    ext <;> simp only [map_add, smul_add, Prod.fst_add, Prod.snd_add, neg_add, add_zero]

variable {M l μ red ρ}

lemma gammaK_sub (k : ℤ) (β : μ × M × M) :
    gammaK M l μ k β - β = (0, (k * l) • β.2.2, 0) := by
  ext <;> simp [gammaK]

/-- `γ_k` is conjugation by the `k`-th power of the generator of `Gal(Y/X)` in the theta group
`Δ^Θ` (`ThetaGroup.conj_tpow`), extended trivially to `μ`. -/
lemma gammaK_apply (k : ℤ) (c a : M) (μ' : Type u) [AddCommGroup μ'] (m' : μ') :
    gammaK M l μ' k (m', c, a) =
      (m', ((ThetaGroup.tgen : ThetaGroup M l) ^ k * ⟨c, a, 0⟩ *
          ((ThetaGroup.tgen : ThetaGroup M l) ^ k)⁻¹).c, a) := by
  rw [ThetaGroup.conj_tpow]
  rfl

/-- **[EtTh], Prop. 2.14(i) in the model**: the subgroup generated by the `γ(β) - β`, `γ ∈ D`,
is the image of `l·Δ_Θ` under the tautological section. -/
theorem model_taut : (model M l μ red ρ).taut = (tautHom M l μ).range := by
  apply le_antisymm
  · rw [Env.taut, AddSubgroup.closure_le]
    rintro _ ⟨γ, ⟨k, rfl⟩, β, rfl⟩
    refine ⟨k • β.2.2, ?_⟩
    change (tautHom M l μ) (k • β.2.2) = gammaK M l μ k β - β
    rw [gammaK_sub]
    simp only [tautHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk, mul_comm k l, mul_smul]
  · rintro _ ⟨y, rfl⟩
    apply AddSubgroup.subset_closure
    refine ⟨gammaK M l μ 1, ⟨1, rfl⟩, (0, 0, y), ?_⟩
    rw [gammaK_sub]
    simp [tautHom]

variable [IsAddTorsionFree M]

/-- The model cyclotome: the torsion of `μ × Δ_Θ × (Δ_Y)^ell` is `μ`. -/
theorem model_mu (hμ : AddMonoid.IsTorsion μ) :
    (model M l μ red ρ).mu = (AddMonoidHom.inl μ (M × M)).range := by
  ext ⟨m, c, a⟩
  simp only [Env.mu, model, AddCommGroup.mem_torsion, AddMonoidHom.mem_range,
    AddMonoidHom.inl_apply, Prod.mk.injEq]
  constructor
  · intro h
    have hc := (isOfFinAddOrder_iff_eq_zero c).1 h.snd.fst
    have ha := (isOfFinAddOrder_iff_eq_zero a).1 h.snd.snd
    exact ⟨m, rfl, by rw [hc, ha]; rfl⟩
  · rintro ⟨m', rfl, h⟩
    rw [← h]
    exact (hμ m').prod_mk (IsOfFinAddOrder.zero)

/-- The model subquotient `(l·Δ_Θ)[μ]`. -/
theorem model_L (hμ : AddMonoid.IsTorsion μ) :
    (model M l μ red ρ).L = (lHom M l μ).range := by
  rw [Env.L, model_mu hμ, model_taut]
  apply le_antisymm
  · refine sup_le ?_ ?_
    · rintro _ ⟨m, rfl⟩
      exact ⟨(m, 0), by simp [lHom]⟩
    · rintro _ ⟨y, rfl⟩
      exact ⟨(0, y), by simp [lHom, tautHom]⟩
  · rintro _ ⟨⟨m, y⟩, rfl⟩
    have : lHom M l μ (m, y) = AddMonoidHom.inl μ (M × M) m + tautHom M l μ y := by
      ext <;> simp [lHom, tautHom]
    rw [this]
    exact AddSubgroup.add_mem_sup ⟨m, rfl⟩ ⟨y, rfl⟩

/-- The model theta splitting: `S ∩ (l·Δ_Θ)[μ] = {(-red(l·y), l·y, 0)}`. -/
theorem model_thetaSplit (hμ : AddMonoid.IsTorsion μ) :
    (model M l μ red ρ).thetaSplit = (thetaHom M l μ red).range := by
  rw [Env.thetaSplit, model_L hμ]
  ext x
  simp only [AddSubgroup.mem_inf, AddMonoidHom.mem_range, model]
  constructor
  · rintro ⟨⟨⟨c, a'⟩, hS⟩, ⟨⟨m, y⟩, hL⟩⟩
    rw [← hS] at hL
    simp only [thetaSection, lHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Prod.mk.injEq] at hL
    obtain ⟨h1, h2, h3⟩ := hL
    have ha' : a' = 0 := nsmul_right_injective two_ne_zero (h3.symm.trans (smul_zero 2).symm)
    refine ⟨y, ?_⟩
    rw [← hS]
    simp only [thetaHom, thetaSection, AddMonoidHom.coe_mk, ZeroHom.coe_mk, ha', map_zero,
      sub_zero, smul_zero, h2]
  · rintro ⟨y, rfl⟩
    refine ⟨⟨(l • y, 0), ?_⟩, ⟨(-red (l • y), y), ?_⟩⟩ <;>
      simp [thetaSection, thetaHom, lHom]

/-- **The model isomorphism of cyclotomes**: `(0, l·y, 0)` corresponds to `(-red(l·y), 0, 0)`;
i.e. the reconstructed isomorphism `l·Δ_Θ ⊗ ℤ/N ≅ μ_N` is `-red`, the (negative of the)
restriction of the étale theta class to `l·Δ_Θ` ([EtTh], Prop. 1.3). -/
theorem model_isCyc (hμ : AddMonoid.IsTorsion μ) (t m : μ × M × M) :
    (model M l μ red ρ).IsCyc t m ↔
      ∃ y : M, t = (0, l • y, 0) ∧ m = (-red (l • y), 0, 0) := by
  rw [Env.IsCyc, model_taut, model_mu hμ, model_thetaSplit hμ]
  constructor
  · rintro ⟨⟨y, rfl⟩, ⟨m', rfl⟩, ⟨y', hy'⟩⟩
    simp only [thetaHom, tautHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk, AddMonoidHom.inl_apply,
      Prod.mk_add_mk, zero_add, add_zero, Prod.mk.injEq] at hy'
    refine ⟨y, rfl, ?_⟩
    simp only [AddMonoidHom.inl_apply, Prod.mk.injEq]
    rw [← hy'.1, hy'.2.1]
    exact ⟨rfl, rfl⟩
  · rintro ⟨y, rfl, rfl⟩
    refine ⟨⟨y, rfl⟩, ⟨-red (l • y), rfl⟩, ⟨y, ?_⟩⟩
    simp [thetaHom]

/-- **Cyclotomic rigidity** ([EtTh], Cor. 2.19(i), for the geometric theta quotient): for any
mono-theta environment `E` and any isomorphism `f : E ≅ model`, the algorithmic outputs of `E`
are carried to the model subquotients, and the algorithmic isomorphism of cyclotomes of `E` to
the natural one `-red` on `l·Δ_Θ`. -/
theorem cyclotomicRigidity (hμ : AddMonoid.IsTorsion μ) {E : Env.{u}}
    (f : Env.Iso E (model M l μ red ρ)) :
    E.mu.map f.e.toAddMonoidHom = (AddMonoidHom.inl μ (M × M)).range ∧
      E.taut.map f.e.toAddMonoidHom = (tautHom M l μ).range ∧
      E.L.map f.e.toAddMonoidHom = (lHom M l μ).range ∧
      E.thetaSplit.map f.e.toAddMonoidHom = (thetaHom M l μ red).range ∧
      ∀ t m, E.IsCyc t m ↔ ∃ y : M, f.e t = (0, l • y, 0) ∧ f.e m = (-red (l • y), 0, 0) := by
  refine ⟨(f.map_mu).trans (model_mu hμ), (f.map_taut).trans model_taut,
    (f.map_L).trans (model_L hμ), (f.map_thetaSplit).trans (model_thetaSplit hμ), ?_⟩
  intro t m
  rw [← f.isCyc_iff, model_isCyc hμ]

/-- **Automorphisms of the model environment preserve the isomorphism of cyclotomes**: an
automorphism maps `(0, l·y, 0)` to some `(0, l·y', 0)` and then `(-red(l·y), 0, 0)` to
`(-red(l·y'), 0, 0)` — the identification `l·Δ_Θ ⊗ ℤ/N ≅ μ_N` has no `(ℤ/N)^×`-twist. -/
theorem cyclotomicRigidity_aut (hμ : AddMonoid.IsTorsion μ)
    (f : Env.Iso (model M l μ red ρ) (model M l μ red ρ)) (y : M) :
    ∃ y' : M, f.e (0, l • y, 0) = (0, l • y', 0) ∧
      f.e (-red (l • y), 0, 0) = (-red (l • y'), 0, 0) := by
  have h : (model M l μ red ρ).IsCyc (0, l • y, 0) (-red (l • y), 0, 0) :=
    (model_isCyc hμ _ _).2 ⟨y, rfl, rfl⟩
  rw [← f.isCyc_iff, model_isCyc hμ] at h
  exact h

/-- **[EtTh], Remark 2.19.2**: working with the `n`-th power of the theta function (the theta
class `n·η`) the reconstructed isomorphism of cyclotomes becomes `-n·red`, which is not an
isomorphism onto `μ_N` unless `n` is prime to `N`: only the first power of (the `l`-th root of)
the theta function yields cyclotomic rigidity for all of `μ_N`. -/
theorem model_isCyc_pow (hμ : AddMonoid.IsTorsion μ) (n : ℤ) (t m : μ × M × M) :
    (model M l μ (n • red) ρ).IsCyc t m ↔
      ∃ y : M, t = (0, l • y, 0) ∧ m = (-(n • red (l • y)), 0, 0) :=
  model_isCyc hμ t m

end Model

end Iut.EtaleTheta
