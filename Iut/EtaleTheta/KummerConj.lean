import ContinuousKummerTheory.Curve.Kummer
import CurvesJacobian.Cusp.CoverGaloisData

/-!
# Conjugation of curve Kummer classes by an automorphism of `Ω` (MR14, [EtTh] Prop. 1.5(iii))

Let `D` be Galois data of `pi1` (a curve `U` with `Π_U = H ⧸ ⟨⟨S⟩⟩`, `S` the inertia elements at
the places centred on `U`) and `σ ∈ Gal(Ω / k(t))` with `σ⁻¹ H σ ⊆ H` and `σ⁻¹ H_L σ ⊆ H_L`
(e.g. `σ(L') ⊆ L'` for `H = H_L = Gal(Ω/L')`). Then:

* `conj_mem_S`, `conj_mem_ambientKernel`: conjugation by `σ` preserves the inertia elements `S`
  (it moves a place `W` centred on `U` to the place `σ(W)`, again centred on `U` because `σ` fixes
  `k(t)`) and hence the kernel `⟨⟨S⟩⟩`;
* `conjPi σ : Π_U → Π_U`, `h ↦ σ⁻¹ h σ`, and **`conjH1 σ`** on `H¹(Π_U, μ_n)`,
  `c ↦ (g ↦ σ · c(σ⁻¹ g σ))` (coefficients transported by `σ`);
* **`conjH1_kummerMap`**: `conjH1 σ (κ_n(u)) = κ_n(σ u)` for units `u`, `σ u` of `U` (on cocycles:
  `g ↦ σ((σ⁻¹gσ)(α)/α) = g(σα)/σα` for `α^n = u`).

This is the cohomological form of "an automorphism lying over `[-1]` acts on Kummer classes through
its action on functions", used for the inversion part of [EtTh] Prop. 1.5(iii).
-/

open Pi1.Orbifold KummerTheory KummerTheory.Curve AffOrbicurve IntermediateField.algebraAdjoinAdjoin

noncomputable section

universe u

namespace Iut.EtaleTheta

/-- `v_W(x) < 1` iff `x = 0` or `x⁻¹ ∉ W`. -/
theorem valuation_lt_one_iff_inv {Ω : Type*} [Field Ω] (W : ValuationSubring Ω) (x : Ω) :
    W.valuation x < 1 ↔ x = 0 ∨ x⁻¹ ∉ W := by
  rcases eq_or_ne x 0 with rfl | hx
  · simp
  · have h0 : 0 < W.valuation x := zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hx)
    rw [← W.valuation_le_one_iff, map_inv₀, inv_le_one₀ h0]
    simp [hx]

section Conj

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} {D : GaloisData k t}
  (σ : Ω ≃ₐ[K₀ k t] Ω)

theorem conj_algebraMap (c : k) : σ (algebraMap k Ω c) = algebraMap k Ω c := by
  rw [IsScalarTower.algebraMap_apply k (K₀ k t) Ω]
  exact σ.commutes _

theorem conj_t : σ t = t :=
  σ.commutes ⟨t, IntermediateField.mem_adjoin_simple_self k t⟩

variable {σ}

/-- **Conjugation preserves the inertia elements** at the places centred on `U`. -/
theorem conj_mem_S (hHL : ∀ h ∈ D.HL, σ⁻¹ * h * σ ∈ D.HL) {s : Ω ≃ₐ[K₀ k t] Ω} (hs : s ∈ D.S) :
    σ⁻¹ * s * σ ∈ D.S := by
  obtain ⟨hsHL, W, hk, htW, hin⟩ := hs
  refine ⟨hHL s hsHL, W.comap (σ : Ω ≃+* Ω).toRingHom, fun c => ?_, ?_, fun a ha => ?_⟩
  · rw [ValuationSubring.mem_comap]
    change σ (algebraMap k Ω c) ∈ W
    rw [conj_algebraMap]; exact hk c
  · rw [ValuationSubring.mem_comap]
    change σ t ∈ W
    rw [conj_t]; exact htW
  · rw [ValuationSubring.mem_comap] at ha
    change σ a ∈ W at ha
    have h := hin (σ a) ha
    have e : (σ⁻¹ * s * σ) a - a = σ.symm (s (σ a) - σ a) := by
      rw [map_sub, AlgEquiv.mul_apply, AlgEquiv.mul_apply]
      simp [AlgEquiv.aut_inv]
    rw [e, valuation_lt_one_iff_inv] at *
    rcases h with h | h
    · left; rw [h, map_zero]
    · right
      rw [ValuationSubring.mem_comap]
      change σ (σ.symm _)⁻¹ ∉ W
      rwa [map_inv₀, AlgEquiv.apply_symm_apply]

variable (hH : ∀ h ∈ D.H, σ⁻¹ * h * σ ∈ D.H) (hHL : ∀ h ∈ D.HL, σ⁻¹ * h * σ ∈ D.HL)

include hH hHL in
/-- **Conjugation preserves the closed normal subgroup generated by the inertia elements.** -/
theorem conj_mem_ambientKernel {g : Ω ≃ₐ[K₀ k t] Ω}
    (hg : g ∈ GaloisPi1.ambientKernel D.H D.S) :
    σ⁻¹ * g * σ ∈ GaloisPi1.ambientKernel D.H D.S := by
  let c : (Ω ≃ₐ[K₀ k t] Ω) →* (Ω ≃ₐ[K₀ k t] Ω) := MulAut.conj σ⁻¹
  have hc : Continuous c := by
    change Continuous fun x => σ⁻¹ * x * σ⁻¹⁻¹
    fun_prop
  have hcl : Subgroup.closure (GaloisPi1.conjSet D.H D.S) ≤
      (GaloisPi1.ambientKernel D.H D.S).comap c := by
    rw [Subgroup.closure_le]
    rintro _ ⟨h, hh, s, hs, rfl⟩
    refine Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ?_)
    refine ⟨σ⁻¹ * h * σ, hH h hh, σ⁻¹ * s * σ, conj_mem_S hHL hs, ?_⟩
    simp [c, mul_assoc]
  have : GaloisPi1.ambientKernel D.H D.S ≤ (GaloisPi1.ambientKernel D.H D.S).comap c := by
    apply Subgroup.topologicalClosure_minimal _ hcl
    exact (Subgroup.isClosed_topologicalClosure _).preimage hc
  have h := this hg
  simpa [c] using h

/-- Conjugation `h ↦ σ⁻¹ h σ` on `H`. -/
def conjH : D.H →* D.H where
  toFun h := ⟨σ⁻¹ * h * σ, hH h h.2⟩
  map_one' := by ext1; simp
  map_mul' a b := by ext1; simp [mul_assoc]

@[simp] theorem coe_conjH (h : D.H) : ((conjH hH h : D.H) : Ω ≃ₐ[K₀ k t] Ω) = σ⁻¹ * h * σ := rfl

theorem continuous_conjH : Continuous (conjH (D := D) hH) := by
  refine Continuous.subtype_mk ?_ _
  change Continuous fun h : D.H => σ⁻¹ * (h : Ω ≃ₐ[K₀ k t] Ω) * σ
  fun_prop

include hHL in
theorem kernel_le_comap_conjH :
    GaloisPi1.kernel D.H D.S ≤ (GaloisPi1.kernel D.H D.S).comap (conjH hH) := by
  intro h hh
  simp only [Subgroup.mem_comap, GaloisPi1.kernel, Subgroup.mem_subgroupOf, coe_conjH] at hh ⊢
  exact conj_mem_ambientKernel hH hHL hh

/-- **Conjugation by `σ` on `Π_U`**, `h ↦ σ⁻¹ h σ`. -/
def conjPi : Pi D →* Pi D :=
  QuotientGroup.map _ _ (conjH hH) (kernel_le_comap_conjH hH hHL)

theorem continuous_conjPi : Continuous (conjPi hH hHL) := by
  change Continuous (QuotientGroup.map (GaloisPi1.kernel D.H D.S) (GaloisPi1.kernel D.H D.S)
    (conjH hH) (kernel_le_comap_conjH hH hHL))
  rw [(QuotientGroup.isQuotientMap_mk (GaloisPi1.kernel D.H D.S)).continuous_iff]
  exact QuotientGroup.continuous_mk.comp (continuous_conjH hH)

variable (σ) in
/-- `σ` acting on `μ_n(Ω)`. -/
def muConj (n : ℕ) : Mu n Ω →* Mu n Ω := MulDistribMulAction.toMonoidHom (Mu n Ω) σ

@[simp] theorem muConj_apply (n : ℕ) (ζ : Mu n Ω) : muConj σ n ζ = σ • ζ := rfl

theorem muConj_conjH (n : ℕ) (h : D.H) (ζ : Mu n Ω) :
    muConj σ n (conjH hH h • ζ) = h • muConj σ n ζ := by
  simp only [muConj_apply]
  change σ • ((σ⁻¹ * (h : Ω ≃ₐ[K₀ k t] Ω) * σ) • ζ) = (h : Ω ≃ₐ[K₀ k t] Ω) • σ • ζ
  rw [← mul_smul, ← mul_smul]
  congr 1
  group

variable [CharZero k] [IsGalois (K₀ k t) Ω] [IsSepClosed Ω]

/-- **Conjugation by `σ` on `H¹(Π_U, μ_n)`**: `c ↦ (g ↦ σ · c(σ⁻¹ g σ))`. -/
def conjH1 (n : ℕ) [NeZero n] : ContH1 (Pi D) (Mu n Ω) →* ContH1 (Pi D) (Mu n Ω) :=
  ContH1.map (conjPi hH hHL) (continuous_conjPi hH hHL) (muConj σ n) continuous_of_discreteTopology
    (fun g ζ => by
      induction g using QuotientGroup.induction_on with
      | H h => exact muConj_conjH hH n h ζ)

/-- **Conjugation of Kummer classes**: for units `u`, `u'` of `U` with `σ u = u'`,
`conjH1 σ (κ_n(u)) = κ_n(u')`. -/
theorem conjH1_kummerMap (n : ℕ) [NeZero n] (v v' : units D)
    (h : σ (((v : (F D)ˣ) : F D) : Ω) = (((v' : (F D)ˣ) : F D) : Ω)) :
    conjH1 hH hHL n (kummerMap D n v) = kummerMap D n v' := by
  apply ContH1.inflation_injective (N := GaloisPi1.kernel D.H D.S) (fun _ _ => rfl)
  change inflMu D n _ = inflMu D n _
  have step : ∀ x : ContH1 (Pi D) (Mu n Ω), inflMu D n (conjH1 hH hHL n x) =
      ContH1.map (conjH hH) (continuous_conjH hH) (muConj σ n) continuous_of_discreteTopology
        (muConj_conjH hH n) (inflMu D n x) := by
    intro x
    induction x using ContH1.induction_on with
    | h c => rfl
  rw [step, inflation_kummerMap, inflation_kummerMap]
  set α := kummerRoot n (F D) Ω (v : (F D)ˣ)
  have hα : α ^ n = Units.map (algebraMap (F D) Ω : F D →* Ω) (v : (F D)ˣ) :=
    kummerRoot_pow n (F D) Ω _
  set β : Ωˣ := Units.map (σ : Ω →* Ω) α
  have hβ : β ^ n = Units.map (algebraMap (F D) Ω : F D →* Ω) (v' : (F D)ˣ) := by
    ext
    have := congrArg (fun x : Ωˣ => σ (x : Ω)) hα
    simp only [Units.val_pow_eq_pow_val, map_pow, Units.coe_map, MonoidHom.coe_coe] at this ⊢
    change σ (α : Ω) ^ n = _
    rw [this]
    exact h
  rw [kummer_eq _ α hα, kummer_eq _ β hβ]
  refine congrArg ContH1.mk (Subtype.ext (funext fun g => ?_))
  apply Mu.ext
  apply Units.ext
  simp only [ContH1.cocyclesMap_apply, muConj_apply, MonoidHom.id_apply, kummerCocycle_apply,
    Mu.val_smul, val_kummerFun, Units.val_div_eq_div_val, AlgEquiv.smul_units_def,
    Units.coe_map, MonoidHom.coe_coe, toGalF_apply, coe_conjH, β]
  simp [AlgEquiv.mul_apply, map_div₀]

end Conj

/-! ### Levels given by intermediate fields: the unit `-1` and the inversion statement -/

section Field

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}

/-- The unit `-1` of a curve `U`. -/
def negOneUnit (D : GaloisData k t) : units D :=
  ⟨-1, by simpa using isIntegral_one.neg, by simpa using isIntegral_one.neg⟩

@[simp] theorem coe_negOneUnit (D : GaloisData k t) :
    ((((negOneUnit D : units D) : (F D)ˣ) : F D) : Ω) = -1 := by
  simp [negOneUnit]

variable [CharZero k] [IsGalois (K₀ k t) Ω] [IsSepClosed Ω] (ht : Transcendental k t)

/-- **The inversion statement at a level** `L` (a Prop `def` used only as a conclusion): `σ`
normalises `Gal(Ω/L)` (`h ↦ σ⁻¹ h σ`), and conjugation by `σ` on `H¹(Π_L, μ_n)` sends `κ_n(η)` to
`κ_n(-1) · κ_n(η)` for every `n` ([EtTh] Prop. 1.5(iii): `ι` fixes `η̈` up to the Kummer class of
a unit of the field of constants). -/
def InversionAt {L : IntermediateField (K₀ k t) Ω}
    (hL : IsOpen (L.fixingSubgroup : Set (Ω ≃ₐ[K₀ k t] Ω)))
    (η : units (CurvesJacobian.Cusp.fieldData ht L hL)) (σ : Ω ≃ₐ[K₀ k t] Ω) : Prop :=
  ∃ hH : ∀ h ∈ (CurvesJacobian.Cusp.fieldData ht L hL).H,
      σ⁻¹ * h * σ ∈ (CurvesJacobian.Cusp.fieldData ht L hL).H,
    ∀ (n : ℕ) [NeZero n],
      conjH1 (D := CurvesJacobian.Cusp.fieldData ht L hL) hH hH n
          (kummerMap (CurvesJacobian.Cusp.fieldData ht L hL) n η) =
        kummerMap (CurvesJacobian.Cusp.fieldData ht L hL) n (negOneUnit _) *
          kummerMap (CurvesJacobian.Cusp.fieldData ht L hL) n η

/-- **The inversion statement from the action on functions**: if `σ(L) ⊆ L` and `σ η = -η`, then
`InversionAt σ η`. -/
theorem inversionAt_of {L : IntermediateField (K₀ k t) Ω}
    (hL : IsOpen (L.fixingSubgroup : Set (Ω ≃ₐ[K₀ k t] Ω)))
    (η : units (CurvesJacobian.Cusp.fieldData ht L hL)) (σ : Ω ≃ₐ[K₀ k t] Ω)
    (hσL : ∀ x ∈ L, σ x ∈ L)
    (hη : σ ((((η : (F (CurvesJacobian.Cusp.fieldData ht L hL))ˣ) :
      F (CurvesJacobian.Cusp.fieldData ht L hL)) : Ω)) =
        -((((η : (F (CurvesJacobian.Cusp.fieldData ht L hL))ˣ) :
          F (CurvesJacobian.Cusp.fieldData ht L hL)) : Ω))) :
    InversionAt ht hL η σ := by
  have hH : ∀ h ∈ (CurvesJacobian.Cusp.fieldData ht L hL).H,
      σ⁻¹ * h * σ ∈ (CurvesJacobian.Cusp.fieldData ht L hL).H := by
    intro h hh
    change h ∈ L.fixingSubgroup at hh
    change _ ∈ L.fixingSubgroup
    rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
    intro x hx
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hh _ (hσL x hx), AlgEquiv.aut_inv]
    exact σ.symm_apply_apply x
  refine ⟨hH, fun n _ => ?_⟩
  rw [← map_mul]
  refine conjH1_kummerMap hH hH n η _ ?_
  rw [hη]
  simp

end Field

end Iut.EtaleTheta
