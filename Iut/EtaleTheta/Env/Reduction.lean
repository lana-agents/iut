import Iut.EtaleTheta.Env.CycRigidity
import Mathlib.CategoryTheory.Category.Basic
import Mathlib.Topology.Algebra.Group.Quotient

/-!
# Reduction of mono-theta environments ([EtTh], Def. 2.13(ii))

[EtTh], Def. 2.13(ii): for `N' | N`, a mod `N` mono-theta environment `M` induces a mod `N'`
mono-theta environment `M_{N'}`, and a *morphism* `M → M'` of mono-theta environments (`M'` of
level `N'`) is an isomorphism `M_{N'} ≅ M'`. For the model `Π_Y[μ_N]` the induced environment is
`Π_Y[μ_{N'}] = Π_Y[μ_N] / Ker(μ_N ↠ μ_{N'})`, and `Ker(μ_N ↠ μ_{N'}) = (μ_N)^{N'}`.

Here the reduction is constructed **intrinsically** from an abstract environment `M`, so that it
is functorial in isomorphisms of environments: the cyclotome `μ ⊆ M.G` is recovered by the
algorithm of [EtTh], Prop. 2.11(ii) (`MonoThetaEnv.mu`, the union of the centralizers of the
finite-index subgroups), and

* `fiPow G k`: the subgroup generated by the `k`-th powers of the elements of `fiCentralizers G`;
  it is preserved by every group isomorphism (`map_fiPow`), in particular normal;
* `MonoThetaEnv.reduce M k`: the environment `(M.G ⧸ fiPow M.G k, image of D, images of the
  theta subgroups)` (`M_{k}` in [EtTh]);
* `MonoThetaEnv.reduceIso`: isomorphisms of environments induce isomorphisms of the reductions;
* the **category of mono-theta environments** (morphisms = isomorphisms of environments,
  `MonoThetaEnv.instCategory`) and the **reduction functor** `MonoThetaEnv.reduceFunctor k`.

For the model environments, `fiPow` is computed in `Env/Tower.lean` (`fiPow_model`): it is
`inl(μ^k)`, so the reduction of the mod `N` model is the mod `N'` model.
-/

namespace Iut.EtaleTheta

universe u

/-! ### The `k`-th powers of the cyclotome -/

/-- The subgroup generated by the `k`-th powers of the elements of `fiCentralizers G` (for
`G = Π[μ_N]` with `Π` `FISlim`: the subgroup `(μ_N)^k = Ker(μ_N ↠ μ_k)` for `k ∣ N`). -/
def fiPow (G : Type*) [Group G] (k : ℕ) : Subgroup G :=
  Subgroup.closure ((fun x : G => x ^ k) '' fiCentralizers G)

/-- **`fiPow` is preserved by group isomorphisms.** -/
theorem map_fiPow {A B : Type*} [Group A] [Group B] (e : A ≃* B) (k : ℕ) :
    (fiPow A k).map (e : A →* B) = fiPow B k := by
  rw [fiPow, MonoidHom.map_closure, fiPow]
  congr 1
  ext y
  constructor
  · rintro ⟨_, ⟨x, hx, rfl⟩, rfl⟩
    exact ⟨e x, (apply_mem_fiCentralizers_iff e x).2 hx, by simp [map_pow]⟩
  · rintro ⟨x, hx, rfl⟩
    refine ⟨_, ⟨e.symm x, ?_, rfl⟩, by simp [map_pow]⟩
    rwa [← apply_mem_fiCentralizers_iff e, e.apply_symm_apply]

lemma apply_mem_fiPow_iff {A B : Type*} [Group A] [Group B] (e : A ≃* B) (k : ℕ) (x : A) :
    e x ∈ fiPow B k ↔ x ∈ fiPow A k := by
  rw [← map_fiPow e k]
  exact ⟨fun ⟨y, hy, h⟩ => e.injective h ▸ hy, fun hx => ⟨x, hx, rfl⟩⟩

instance fiPow_normal (G : Type*) [Group G] (k : ℕ) : (fiPow G k).Normal :=
  ⟨fun n hn g => (apply_mem_fiPow_iff (MulAut.conj g) k n).2 hn⟩

/-- The automorphism of `G ⧸ fiPow G k` induced by an automorphism of `G`. -/
def quotAut (G : Type*) [Group G] (k : ℕ) : MulAut G →* MulAut (G ⧸ fiPow G k) where
  toFun γ := QuotientGroup.congr _ _ γ (map_fiPow γ k)
  map_one' := MulEquiv.ext fun x => by
    induction x using QuotientGroup.induction_on with
    | H x => rfl
  map_mul' γ γ' := MulEquiv.ext fun x => by
    induction x using QuotientGroup.induction_on with
    | H x => rfl

@[simp] lemma quotAut_mk (G : Type*) [Group G] (k : ℕ) (γ : MulAut G) (x : G) :
    quotAut G k γ (x : G ⧸ fiPow G k) = ((γ x : G) : G ⧸ fiPow G k) := rfl

section ContinuousCongr

variable {A B : Type*} [Group A] [Group B] [TopologicalSpace A] [TopologicalSpace B]
  [IsTopologicalGroup A] [IsTopologicalGroup B]

/-- The isomorphism of quotients induced by an isomorphism of topological groups. -/
def continuousCongr (NA : Subgroup A) (NB : Subgroup B) [NA.Normal] [NB.Normal] (e : A ≃ₜ* B)
    (he : NA.map (e.toMulEquiv : A →* B) = NB) : A ⧸ NA ≃ₜ* B ⧸ NB where
  toMulEquiv := QuotientGroup.congr NA NB e.toMulEquiv he
  continuous_toFun := by
    refine (QuotientGroup.isQuotientMap_mk NA).continuous_iff.2 ?_
    exact QuotientGroup.continuous_mk.comp e.continuous
  continuous_invFun := by
    refine (QuotientGroup.isQuotientMap_mk NB).continuous_iff.2 ?_
    exact QuotientGroup.continuous_mk.comp e.symm.continuous

omit [IsTopologicalGroup A] [IsTopologicalGroup B] in
@[simp] lemma continuousCongr_mk (NA : Subgroup A) (NB : Subgroup B) [NA.Normal] [NB.Normal]
    (e : A ≃ₜ* B) (he) (x : A) :
    continuousCongr NA NB e he (x : A ⧸ NA) = ((e x : B) : B ⧸ NB) := rfl

end ContinuousCongr

namespace MonoThetaEnv

/-! ### Reduction of an environment -/

variable (M : MonoThetaEnv.{u}) (k : ℕ)

/-- **The reduction `M_k` of a mono-theta environment** ([EtTh], Def. 2.13(ii)): the quotient of
`M.G` by the `k`-th powers of its cyclotome, with the induced `D` and theta subgroups. -/
def reduce : MonoThetaEnv.{u} where
  G := M.G ⧸ fiPow M.G k
  D := M.D.map (quotAut M.G k)
  inner_le := by
    rintro _ ⟨x, rfl⟩
    induction x using QuotientGroup.induction_on with
    | H x =>
      refine ⟨MulAut.conj x, M.inner_le ⟨x, rfl⟩, MulEquiv.ext fun y => ?_⟩
      induction y using QuotientGroup.induction_on with
      | H y => rfl
  thetaSubgroups := Subgroup.map (QuotientGroup.mk' (fiPow M.G k)) '' M.thetaSubgroups

@[simp] lemma reduce_G : (M.reduce k).G = (M.G ⧸ fiPow M.G k) := rfl

lemma reduce_D : (M.reduce k).D = M.D.map (quotAut M.G k) := rfl

lemma reduce_thetaSubgroups :
    (M.reduce k).thetaSubgroups =
      Subgroup.map (QuotientGroup.mk' (fiPow M.G k)) '' M.thetaSubgroups := rfl

/-- Two isomorphisms of environments with the same underlying map are equal. -/
@[ext] theorem Iso.ext {M M' : MonoThetaEnv.{u}} {f g : Iso M M'} (h : ∀ x, f.e x = g.e x) :
    f = g := by
  obtain ⟨e, _, _⟩ := f
  obtain ⟨e', _, _⟩ := g
  have : e = e' := ContinuousMulEquiv.ext h
  subst this
  rfl

@[simp] lemma Iso.refl_e_apply (M : MonoThetaEnv.{u}) (x : M.G) : (Iso.refl M).e x = x := rfl

@[simp] lemma Iso.trans_e_apply {M M' M'' : MonoThetaEnv.{u}} (f : Iso M M') (g : Iso M' M'')
    (x : M.G) : (f.trans g).e x = g.e (f.e x) := rfl

@[simp] lemma Iso.symm_e_apply {M M' : MonoThetaEnv.{u}} (f : Iso M M') (x : M'.G) :
    f.symm.e x = f.e.symm x := rfl

variable {M} {M' : MonoThetaEnv.{u}}

lemma conjAut_quotAut (e : M.G ≃* M'.G) (γ : MulAut M.G) :
    conjAut (QuotientGroup.congr _ _ e (map_fiPow e k)) (quotAut M.G k γ) =
      quotAut M'.G k (conjAut e γ) := by
  refine MulEquiv.ext fun x => ?_
  induction x using QuotientGroup.induction_on with
  | H x =>
    change QuotientGroup.congr _ _ e (map_fiPow e k)
      (quotAut M.G k γ ((QuotientGroup.congr _ _ e (map_fiPow e k)).symm (x : M'.G ⧸ _))) = _
    rw [QuotientGroup.congr_symm, QuotientGroup.congr_mk, quotAut_mk, QuotientGroup.congr_mk,
      quotAut_mk]
    rfl

/-- **Isomorphisms of environments induce isomorphisms of their reductions.** -/
def reduceIso (f : Iso M M') : Iso (M.reduce k) (M'.reduce k) where
  e := continuousCongr _ _ f.e (map_fiPow f.e.toMulEquiv k)
  map_D := by
    change (M.D.map (quotAut M.G k)).map
      (conjAut (QuotientGroup.congr _ _ f.e.toMulEquiv (map_fiPow f.e.toMulEquiv k))) =
        M'.D.map (quotAut M'.G k)
    rw [← f.map_D, Subgroup.map_map, Subgroup.map_map]
    congr 1
    exact MonoidHom.ext fun γ => conjAut_quotAut k f.e.toMulEquiv γ
  map_theta := by
    change Subgroup.map (QuotientGroup.congr _ _ f.e.toMulEquiv
      (map_fiPow f.e.toMulEquiv k)).toMonoidHom ''
        (Subgroup.map (QuotientGroup.mk' (fiPow M.G k)) '' M.thetaSubgroups) =
      Subgroup.map (QuotientGroup.mk' (fiPow M'.G k)) '' M'.thetaSubgroups
    rw [← f.map_theta, Set.image_image, Set.image_image]
    refine Set.image_congr fun H _ => ?_
    rw [Subgroup.map_map, Subgroup.map_map]
    rfl

@[simp] lemma reduceIso_e_mk (f : Iso M M') (x : M.G) :
    (reduceIso k f).e (x : M.G ⧸ fiPow M.G k) = ((f.e x : M'.G) : M'.G ⧸ fiPow M'.G k) := rfl

/-! ### The category of mono-theta environments and the reduction functor -/

/-- **The groupoid of mono-theta environments**: morphisms are isomorphisms of environments
([EtTh], Def. 2.13(ii); morphisms between environments of different levels are isomorphisms
after reduction, see `reduceFunctor`). -/
instance instCategory : CategoryTheory.Category.{u} MonoThetaEnv.{u} where
  Hom := Iso
  id := Iso.refl
  comp f g := Iso.trans f g
  id_comp _ := Iso.ext fun _ => rfl
  comp_id _ := Iso.ext fun _ => rfl
  assoc _ _ _ := Iso.ext fun _ => rfl

/-- The isomorphism of environments underlying a morphism. -/
def homIso {M M' : MonoThetaEnv.{u}} (f : M ⟶ M') : Iso M M' := f

@[simp] lemma homIso_id (M : MonoThetaEnv.{u}) :
    homIso (CategoryTheory.CategoryStruct.id M) = Iso.refl M := rfl

@[simp] lemma homIso_comp {M M' M'' : MonoThetaEnv.{u}} (f : M ⟶ M') (g : M' ⟶ M'') :
    homIso (CategoryTheory.CategoryStruct.comp f g) = (homIso f).trans (homIso g) := rfl

/-- An isomorphism of environments as an isomorphism in the groupoid of environments. -/
def Iso.toCatIso {M M' : MonoThetaEnv.{u}} (f : Iso M M') : CategoryTheory.Iso M M' where
  hom := f
  inv := f.symm
  hom_inv_id := Iso.ext fun x => f.e.symm_apply_apply x
  inv_hom_id := Iso.ext fun x => f.e.apply_symm_apply x

@[simp] lemma Iso.toCatIso_hom {M M' : MonoThetaEnv.{u}} (f : Iso M M') :
    homIso f.toCatIso.hom = f := rfl

@[simp] lemma Iso.toCatIso_inv {M M' : MonoThetaEnv.{u}} (f : Iso M M') :
    homIso f.toCatIso.inv = f.symm := rfl

/-- **The reduction functor** `M ↦ M_k` ([EtTh], Def. 2.13(ii)). -/
def reduceFunctor : CategoryTheory.Functor MonoThetaEnv.{u} MonoThetaEnv.{u} where
  obj M := M.reduce k
  map f := reduceIso k (homIso f)
  map_id M := Iso.ext fun x => by
    induction x using QuotientGroup.induction_on with
    | H x => rfl
  map_comp f g := Iso.ext fun x => by
    induction x using QuotientGroup.induction_on with
    | H x => rfl

@[simp] lemma reduceFunctor_obj (M : MonoThetaEnv.{u}) :
    (reduceFunctor k).obj M = M.reduce k := rfl

lemma reduceFunctor_map {M M' : MonoThetaEnv.{u}} (f : M ⟶ M') :
    homIso ((reduceFunctor k).map f) = reduceIso k (homIso f) := rfl

end MonoThetaEnv

end Iut.EtaleTheta
