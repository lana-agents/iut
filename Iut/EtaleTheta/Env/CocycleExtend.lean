import Iut.EtaleTheta.MonoTheta
import Mathlib.Tactic.Group

/-!
# Extending cocycles along `H ⊴ G` with `G/H` generated by an involution and a `ℤ`-direction

The group-theoretic step of MR15 obligation 13 ([EtTh] Prop. 2.2(ii) and l.2938–2945: the
splitting cocycle `cX` on `Π^tp_X̿` extending the mod-`l` theta cocycle of `Π^tp_Ÿ`). Here
`Π^tp_Ÿ ⊆ Π^tp_Y ⊆ Π^tp_X̿` with `[Π^tp_Y : Π^tp_Ÿ] = 2` and `Π^tp_X̿/Π^tp_Y ≅ ℤ`, and the
coefficients `μ_l` have odd exponent.

Setting: a group `G` acting on a commutative group `M` (`φ : G →* MulAut M`) with `m ^ l = 1`,
`l` odd; a normal subgroup `H`, a character `χ : G → ℤ` with `H ≤ Ker χ`, an element `e` with
`Ker χ = H ∪ H e`, and `g` with `χ g = 1`. A cocycle `c` on `H` whose conjugates by `e` and by
`g` are cohomologous to `c` (with explicit coboundaries `me`, `mg`) **extends to a cocycle on
`G`** (`exists_cocycle_extend`).

Proof: cocycles are homomorphic sections `x ↦ (c(x), x)` of `M ⋊ G ↠ G` (`isHom_iff`). The
coboundaries give `E = (me, e)`, `Γ = (mg, g)` conjugating the section on `H` correctly. The
obstructions `z₁ = s(e²)⁻¹ E²` and `z₂ = s([g,e])⁻¹ [Γ, E]` lie in `M`, commute with `s(H)`
and have order dividing `l`, and `E z₂ E⁻¹ = z₂⁻¹`; since `l = 2k+1`, replacing `E` by
`E z₁^k` and `Γ` by `z₂^k Γ` kills them (`sq_mul_pow_eq`, `adjust_comm`). Then the section
extends to `Ker χ = H ∪ H e` by `s(h e) = s(h) E` and to `G` by
`s(x) = s(x g^{-χ x}) Γ^{χ x}` (`exists_hom_extend_int`).
-/

open SemidirectProduct

noncomputable section

namespace Iut.EtaleTheta.Env

/-! ### Two identities in a group -/

section Group

variable {Q : Type*} [Group Q]

/-- If `E` commutes with `z = B⁻¹ E²` and `z^{2k+1} = 1`, then `(E z^k)² = B`. -/
theorem sq_mul_pow_eq {E B : Q} {k : ℕ} (hc : Commute E (B⁻¹ * E ^ 2))
    (hz : (B⁻¹ * E ^ 2) ^ (2 * k + 1) = 1) : (E * (B⁻¹ * E ^ 2) ^ k) ^ 2 = B := by
  set z := B⁻¹ * E ^ 2 with hzdef
  have hE : E ^ 2 = B * z := by rw [hzdef, mul_inv_cancel_left]
  rw [(hc.pow_right k).mul_pow, hE, ← pow_mul, mul_assoc, ← pow_succ', mul_comm k 2, hz,
    mul_one]

/-- If `z` commutes with `S`, `E z E⁻¹ = z⁻¹` and `z^{2k+1} = 1`, and `C · E = Γ E Γ⁻¹`
with `C = S z`, then `Γ' = z^k Γ` satisfies `Γ' E Γ'⁻¹ E⁻¹ = S`. -/
theorem adjust_comm {E Γ S z : Q} {k : ℕ} (hS : Commute z S) (hE : E * z * E⁻¹ = z⁻¹)
    (hz : z ^ (2 * k + 1) = 1) (hC : Γ * E * Γ⁻¹ * E⁻¹ = S * z) :
    z ^ k * Γ * E * (z ^ k * Γ)⁻¹ * E⁻¹ = S := by
  have hE' : E * (z ^ k)⁻¹ * E⁻¹ = z ^ k := by
    rw [← inv_pow, ← conj_pow, ← conj_inv, hE, inv_inv]
  have hΓ : Γ * E * Γ⁻¹ = S * z * E := by rw [← hC]; group
  calc z ^ k * Γ * E * (z ^ k * Γ)⁻¹ * E⁻¹
      = z ^ k * (Γ * E * Γ⁻¹) * (E⁻¹ * E) * (z ^ k)⁻¹ * E⁻¹ := by group
    _ = z ^ k * S * z * (E * (z ^ k)⁻¹ * E⁻¹) := by rw [hΓ]; group
    _ = S * (z ^ k * z * z ^ k) := by rw [hE', ((hS.pow_left k).eq)]; group
    _ = S := by rw [← pow_succ, ← pow_add, show k + 1 + k = 2 * k + 1 by ring, hz, mul_one]

/-- `a b a⁻¹ = b` means that `a` and `b` commute. -/
theorem commute_of_conj {a b : Q} (h : a * b * a⁻¹ = b) : Commute a b := by
  change a * b = b * a
  calc a * b = a * b * a⁻¹ * a := by group
    _ = b * a := by rw [h]

end Group

/-! ### The section on `H` -/

section Extend

variable {G M : Type*} [Group G] [CommGroup M] {φ : G →* MulAut M} {H : Subgroup G}
  {c : H → M}

open scoped Classical in
/-- The section `x ↦ (c(x), x)` of `M ⋊ G ↠ G` on `H` (extended by `1` off `H`). -/
def secH (c : H → M) (x : G) : M ⋊[φ] G :=
  if hx : x ∈ H then ⟨c ⟨x, hx⟩, x⟩ else 1

theorem secH_of_mem {x : G} (hx : x ∈ H) : (secH c x : M ⋊[φ] G) = ⟨c ⟨x, hx⟩, x⟩ :=
  dif_pos hx

theorem secH_right {x : G} (hx : x ∈ H) : (secH c x : M ⋊[φ] G).right = x := by
  rw [secH_of_mem hx]

theorem secH_mul (hc : IsCocycle (φ.comp H.subtype) c) {x y : G} (hx : x ∈ H) (hy : y ∈ H) :
    (secH c (x * y) : M ⋊[φ] G) = secH c x * secH c y := by
  rw [secH_of_mem (mul_mem hx hy), secH_of_mem hx, secH_of_mem hy]
  ext
  · rw [mul_left]
    exact hc ⟨x, hx⟩ ⟨y, hy⟩
  · rfl

theorem secH_one (hc : IsCocycle (φ.comp H.subtype) c) : (secH c 1 : M ⋊[φ] G) = 1 := by
  have h := secH_mul hc (one_mem H) (one_mem H)
  rw [mul_one] at h
  exact left_eq_mul.1 h

theorem secH_inv (hc : IsCocycle (φ.comp H.subtype) c) {x : G} (hx : x ∈ H) :
    (secH c x⁻¹ : M ⋊[φ] G) = (secH c x)⁻¹ :=
  eq_inv_of_mul_eq_one_left (by rw [← secH_mul hc (inv_mem hx) hx, inv_mul_cancel, secH_one hc])

/-- `Γ` conjugates the section on `H` like `γ`. -/
def Compat (c : H → M) (Γ : M ⋊[φ] G) (γ : G) : Prop :=
  ∀ x ∈ H, Γ * secH c x * Γ⁻¹ = secH c (γ * x * γ⁻¹)

theorem compat_mul (hHn : H.Normal) {Γ Δ : M ⋊[φ] G} {γ δ : G} (h1 : Compat c Γ γ)
    (h2 : Compat c Δ δ) : Compat c (Γ * Δ) (γ * δ) := fun x hx => by
  have hx' : δ * x * δ⁻¹ ∈ H := hHn.conj_mem x hx δ
  calc Γ * Δ * secH c x * (Γ * Δ)⁻¹ = Γ * (Δ * secH c x * Δ⁻¹) * Γ⁻¹ := by group
    _ = secH c (γ * δ * x * (γ * δ)⁻¹) := by
        rw [h2 x hx, h1 _ hx', show γ * (δ * x * δ⁻¹) * γ⁻¹ = γ * δ * x * (γ * δ)⁻¹ by group]

theorem compat_inv (hHn : H.Normal) {Γ : M ⋊[φ] G} {γ : G} (h : Compat c Γ γ) :
    Compat c Γ⁻¹ γ⁻¹ := fun x hx => by
  have hx' : γ⁻¹ * x * γ⁻¹⁻¹ ∈ H := hHn.conj_mem x hx γ⁻¹
  have e := h _ hx'
  rw [show γ * (γ⁻¹ * x * γ⁻¹⁻¹) * γ⁻¹ = x by group] at e
  rw [← e]
  group

theorem compat_secH (hc : IsCocycle (φ.comp H.subtype) c) {h : G} (hh : h ∈ H) :
    Compat (φ := φ) c (secH c h) h := fun x hx => by
  rw [← secH_inv hc hh, ← secH_mul hc hh hx, ← secH_mul hc (mul_mem hh hx) (inv_mem hh)]

theorem compat_pow (hHn : H.Normal) {Γ : M ⋊[φ] G} {γ : G} (h : Compat c Γ γ) (n : ℕ) :
    Compat c (Γ ^ n) (γ ^ n) := by
  induction n with
  | zero => intro x hx; simp
  | succ n ih => rw [pow_succ, pow_succ]; exact compat_mul hHn ih h

theorem commute_of_compat {z : M ⋊[φ] G} (h : Compat c z 1) {x : G} (hx : x ∈ H) :
    Commute z (secH c x) := by
  have e := h x hx
  rw [one_mul, inv_one, mul_one] at e
  exact commute_of_conj e

/-- An element of `M ⋊ G` over `1`, `M` of exponent dividing `l`, has order dividing `l`. -/
theorem pow_eq_one_of_right {l : ℕ} (hM : ∀ m : M, m ^ l = 1) {z : M ⋊[φ] G}
    (hz : z.right = 1) : z ^ l = 1 := by
  have : z = inl z.left := by ext <;> simp [hz]
  rw [this, ← map_pow, hM, map_one]

theorem right_pow (z : M ⋊[φ] G) (n : ℕ) : (z ^ n).right = z.right ^ n :=
  map_pow (rightHom : M ⋊[φ] G →* G) z n

/-- **The extension along `H ⊆ K = H ∪ H e`** (index two): `T(h) = s(h)`, `T(h e) = s(h) E`. -/
theorem exists_ext_two (hc : IsCocycle (φ.comp H.subtype) c) (hHn : H.Normal) {e : G}
    (he : e ∉ H) (he2 : e * e ∈ H) (K : Subgroup G) (hidx : ∀ y ∈ K, y ∈ H ∨ y * e⁻¹ ∈ H)
    (E : M ⋊[φ] G) (hEr : E.right = e) (hE : Compat c E e) (hE2 : E * E = secH c (e * e)) :
    ∃ T : G → M ⋊[φ] G, (∀ x ∈ K, ∀ y ∈ K, T (x * y) = T x * T y) ∧
      (∀ x ∈ K, (T x).right = x) ∧ (∀ x ∈ H, T x = secH c x) ∧
      (∀ x ∈ K, x ∉ H → T x = secH c (x * e⁻¹) * E) := by
  classical
  have hnot : ∀ {x : G}, x * e⁻¹ ∈ H → x ∉ H := fun {x} hx h =>
    he (by simpa using mul_mem (inv_mem hx) h)
  refine ⟨fun x => if x ∈ H then secH c x else secH c (x * e⁻¹) * E, ?_, ?_,
    fun x hx => if_pos hx, fun x _ hx => if_neg hx⟩
  · intro x hxK y hyK
    rcases hidx x hxK with hx | hx <;> rcases hidx y hyK with hy | hy
    · simp only [if_pos hx, if_pos hy, if_pos (mul_mem hx hy)]
      exact secH_mul hc hx hy
    · have hxy : x * y ∉ H := fun h => hnot hy (by simpa using mul_mem (inv_mem hx) h)
      simp only [if_pos hx, if_neg (hnot hy), if_neg hxy]
      rw [show x * y * e⁻¹ = x * (y * e⁻¹) by group, secH_mul hc hx hy, mul_assoc]
    · have hxy : x * y ∉ H := fun h => hnot hx (by simpa using mul_mem h (inv_mem hy))
      have hc' : e * y * e⁻¹ ∈ H := hHn.conj_mem y hy e
      simp only [if_neg (hnot hx), if_pos hy, if_neg hxy]
      rw [show x * y * e⁻¹ = x * e⁻¹ * (e * y * e⁻¹) by group, secH_mul hc hx hc', ← hE y hy]
      group
    · have hc' : e * (y * e⁻¹) * e⁻¹ ∈ H := hHn.conj_mem _ hy e
      have hxy' : x * y = x * e⁻¹ * (e * (y * e⁻¹) * e⁻¹) * (e * e) := by group
      have hxy : x * y ∈ H := by
        rw [hxy']; exact mul_mem (mul_mem hx hc') he2
      simp only [if_neg (hnot hx), if_neg (hnot hy), if_pos hxy]
      rw [hxy', secH_mul hc (mul_mem hx hc') he2, secH_mul hc hx hc', ← hE _ hy, ← hE2]
      group
  · intro x hxK
    rcases hidx x hxK with hx | hx
    · simp only [if_pos hx]; exact secH_right hx
    · simp only [if_neg (hnot hx)]
      rw [mul_right, secH_right hx, hEr, inv_mul_cancel_right]

end Extend

/-! ### The `ℤ`-direction -/

section Int

variable {G M : Type*} [Group G] [CommGroup M] {φ : G →* MulAut M}

/-- **Extension along `Ker χ ⊆ G`, `χ g = 1`**: a section `T` on `Ker χ` that is conjugated
correctly by `Γ` over `g` extends to a homomorphic section on `G`,
`S(x) = T(x g^{-χ x}) Γ^{χ x}`. -/
theorem exists_hom_extend_int (χ : G →* Multiplicative ℤ) {g : G}
    (hg : χ g = Multiplicative.ofAdd 1) (T : G → M ⋊[φ] G)
    (hT : ∀ x ∈ χ.ker, ∀ y ∈ χ.ker, T (x * y) = T x * T y)
    (hTr : ∀ x ∈ χ.ker, (T x).right = x) (Γ : M ⋊[φ] G) (hΓ : Γ.right = g)
    (hconj : ∀ x ∈ χ.ker, Γ * T x * Γ⁻¹ = T (g * x * g⁻¹)) :
    ∃ S : G →* M ⋊[φ] G, (∀ x, (S x).right = x) ∧ ∀ x ∈ χ.ker, S x = T x := by
  set a : G → ℤ := fun x => Multiplicative.toAdd (χ x) with ha
  have hgz : ∀ n : ℤ, χ (g ^ n) = Multiplicative.ofAdd n := fun n => by
    rw [map_zpow, hg, ← ofAdd_zsmul, smul_eq_mul, mul_one]
  have hmem : ∀ x : G, x * g ^ (-a x) ∈ χ.ker := fun x => by
    rw [MonoidHom.mem_ker, map_mul, hgz]
    change χ x * Multiplicative.ofAdd (-Multiplicative.toAdd (χ x)) = 1
    rw [ofAdd_neg, ofAdd_toAdd, mul_inv_cancel]
  have hnorm : ∀ (x : G) (n : ℤ), x ∈ χ.ker → g ^ n * x * g ^ (-n) ∈ χ.ker := fun x n hx => by
    rw [zpow_neg]; exact χ.normal_ker.conj_mem x hx (g ^ n)
  have hpow : ∀ (n : ℤ) (x : G), x ∈ χ.ker →
      Γ ^ n * T x * Γ ^ (-n) = T (g ^ n * x * g ^ (-n)) := by
    intro n
    induction n using Int.induction_on with
    | zero => intro x _; simp
    | succ i ih =>
      intro x hx
      calc Γ ^ ((i : ℤ) + 1) * T x * Γ ^ (-((i : ℤ) + 1))
          = Γ * (Γ ^ (i : ℤ) * T x * Γ ^ (-(i : ℤ))) * Γ⁻¹ := by group
        _ = T (g ^ ((i : ℤ) + 1) * x * g ^ (-((i : ℤ) + 1))) := by
            rw [ih x hx, hconj _ (hnorm x i hx)]
            congr 1
            group
    | pred i ih =>
      intro x hx
      have hy : g ^ (-(i : ℤ) - 1) * x * g ^ (-(-(i : ℤ) - 1)) ∈ χ.ker := hnorm x _ hx
      have h1 := hconj _ hy
      have e1 : g * (g ^ (-(i : ℤ) - 1) * x * g ^ (-(-(i : ℤ) - 1))) * g⁻¹ =
          g ^ (-(i : ℤ)) * x * g ^ (-(-(i : ℤ))) := by group
      rw [e1, ← ih x hx] at h1
      calc Γ ^ (-(i : ℤ) - 1) * T x * Γ ^ (-(-(i : ℤ) - 1))
          = Γ⁻¹ * (Γ ^ (-(i : ℤ)) * T x * Γ ^ (-(-(i : ℤ)))) * Γ := by group
        _ = Γ⁻¹ * (Γ * T (g ^ (-(i : ℤ) - 1) * x * g ^ (-(-(i : ℤ) - 1))) * Γ⁻¹) * Γ := by
            rw [h1]
        _ = T (g ^ (-(i : ℤ) - 1) * x * g ^ (-(-(i : ℤ) - 1))) := by group
  have hΓr : ∀ n : ℤ, (Γ ^ n).right = g ^ n := fun n => by
    rw [← hΓ]; exact map_zpow (rightHom : M ⋊[φ] G →* G) Γ n
  have h1 : T 1 = 1 := by
    have := hT 1 (one_mem _) 1 (one_mem _)
    rw [mul_one] at this
    exact left_eq_mul.1 this
  refine ⟨{ toFun := fun x => T (x * g ^ (-a x)) * Γ ^ a x, map_one' := ?_, map_mul' := ?_ },
    fun x => ?_, fun x hx => ?_⟩
  · simp [ha, h1]
  · intro x y
    have hax : a (x * y) = a x + a y := by simp [ha]
    change T (x * y * g ^ (-a (x * y))) * Γ ^ a (x * y) =
      T (x * g ^ (-a x)) * Γ ^ a x * (T (y * g ^ (-a y)) * Γ ^ a y)
    have e : x * y * g ^ (-a (x * y)) =
        (x * g ^ (-a x)) * (g ^ a x * (y * g ^ (-a y)) * g ^ (-a x)) := by
      rw [hax]; group
    rw [e, hT _ (hmem x) _ (hnorm _ _ (hmem y)), ← hpow _ _ (hmem y), hax, zpow_add]
    group
  · change (T (x * g ^ (-a x)) * Γ ^ a x).right = x
    rw [mul_right, hTr _ (hmem x), hΓr, zpow_neg, inv_mul_cancel_right]
  · have h0 : a x = 0 := by
      change Multiplicative.toAdd (χ x) = 0
      rw [(MonoidHom.mem_ker).1 hx]; rfl
    change T (x * g ^ (-a x)) * Γ ^ a x = T x
    rw [h0]; simp

end Int

/-! ### Dividing a character to `ℤ` -/

section DivChar

variable {P : Type*} [Group P]

/-- `χ / l` for a character `χ : P → ℤ` with values in `lℤ`. -/
def divChar (χ : P →* Multiplicative ℤ) (l : ℤ)
    (hl : ∀ x, l ∣ Multiplicative.toAdd (χ x)) : P →* Multiplicative ℤ where
  toFun x := Multiplicative.ofAdd (Multiplicative.toAdd (χ x) / l)
  map_one' := by simp
  map_mul' x y := by
    simp only [map_mul, toAdd_mul]
    rw [Int.add_ediv_of_dvd_left (hl x)]
    rfl

theorem divChar_eq_one_iff {χ : P →* Multiplicative ℤ} {l : ℤ} (hl0 : l ≠ 0)
    (hl : ∀ x, l ∣ Multiplicative.toAdd (χ x)) (x : P) : divChar χ l hl x = 1 ↔ χ x = 1 := by
  obtain ⟨n, hn⟩ := hl x
  have hχ : χ x = Multiplicative.ofAdd (l * n) := by rw [← hn, ofAdd_toAdd]
  change Multiplicative.ofAdd (Multiplicative.toAdd (χ x) / l) = 1 ↔ χ x = 1
  rw [hχ, toAdd_ofAdd, Int.mul_ediv_cancel_left _ hl0, ofAdd_eq_one, ofAdd_eq_one]
  exact ⟨fun h => by simp [h], fun h => (mul_eq_zero.1 h).resolve_left hl0⟩

theorem divChar_eq_ofAdd_one {χ : P →* Multiplicative ℤ} {l : ℤ} (hl0 : l ≠ 0)
    (hl : ∀ x, l ∣ Multiplicative.toAdd (χ x)) {x : P} (hx : χ x = Multiplicative.ofAdd l) :
    divChar χ l hl x = Multiplicative.ofAdd 1 := by
  change Multiplicative.ofAdd (Multiplicative.toAdd (χ x) / l) = _
  rw [hx, toAdd_ofAdd, Int.ediv_self hl0]

end DivChar

/-! ### The extension theorem -/

section Main

variable {G M : Type*} [Group G] [CommGroup M] {φ : G →* MulAut M}

/-- **Extension of a cocycle from `H` to `G`** (`H ⊴ G`, `Ker χ = H ∪ H e` with `e² ∈ H`,
`χ g = 1`; coefficients of odd exponent `l`). The hypotheses `hce`, `hcg` say that the conjugates
of `c` by `e` and `g` are cohomologous to `c`, with coboundaries of `me`, `mg`. -/
theorem exists_cocycle_extend {l : ℕ} (hl : Odd l) (hM : ∀ m : M, m ^ l = 1)
    (H : Subgroup G) (hHn : H.Normal) (χ : G →* Multiplicative ℤ) (hHχ : H ≤ χ.ker)
    {e g : G} (he : e ∉ H) (heχ : χ e = 1) (he2 : e * e ∈ H)
    (hidx : ∀ y ∈ χ.ker, y ∈ H ∨ y * e⁻¹ ∈ H) (hg : χ g = Multiplicative.ofAdd 1)
    (c : H → M) (hc : IsCocycle (φ.comp H.subtype) c) (me mg : M)
    (hce : ∀ (h : G) (hh : h ∈ H), c ⟨e * h * e⁻¹, hHn.conj_mem h hh e⟩ =
      me * φ e (c ⟨h, hh⟩) * (φ (e * h * e⁻¹) me)⁻¹)
    (hcg : ∀ (h : G) (hh : h ∈ H), c ⟨g * h * g⁻¹, hHn.conj_mem h hh g⟩ =
      mg * φ g (c ⟨h, hh⟩) * (φ (g * h * g⁻¹) mg)⁻¹) :
    ∃ C : G → M, IsCocycle φ C ∧ ∀ h : H, C h = c h := by
  obtain ⟨k, hk⟩ := hl
  -- the coboundaries as conjugating elements
  have hmk : ∀ (m : M) (γ : G), (∀ (h : G) (hh : h ∈ H),
      c ⟨γ * h * γ⁻¹, hHn.conj_mem h hh γ⟩ = m * φ γ (c ⟨h, hh⟩) * (φ (γ * h * γ⁻¹) m)⁻¹) →
      Compat c (⟨m, γ⟩ : M ⋊[φ] G) γ := by
    intro m γ hm x hx
    rw [secH_of_mem hx, secH_of_mem (hHn.conj_mem x hx γ)]
    ext
    · simp only [mul_left, inv_left, mul_right]
      rw [hm x hx, ← MulAut.mul_apply, ← map_mul, map_inv]
    · simp
  have hE0 := hmk me e hce
  have hG0 := hmk mg g hcg
  have heK : e ∈ χ.ker := (MonoidHom.mem_ker).2 heχ
  -- adjust `E`
  set E0 : M ⋊[φ] G := ⟨me, e⟩ with hE0def
  set z1 : M ⋊[φ] G := (secH c (e * e))⁻¹ * E0 ^ 2 with hz1
  have hz1r : z1.right = 1 := by
    rw [hz1, mul_right, inv_right, secH_right he2, right_pow]
    change (e * e)⁻¹ * e ^ 2 = 1
    group
  have hz1c : Compat c z1 1 := by
    have h := compat_mul hHn (compat_inv hHn (compat_secH hc he2)) (compat_pow hHn hE0 2)
    rwa [show (e * e)⁻¹ * e ^ 2 = 1 by group] at h
  have hEz1 : Commute E0 z1 := by
    have h1 : Commute E0 (secH c (e * e)) := by
      have h := hE0 _ he2
      rw [show e * (e * e) * e⁻¹ = e * e by group] at h
      exact commute_of_conj h
    exact (h1.inv_right).mul_right (Commute.self_pow E0 2)
  set E := E0 * z1 ^ k with hEdef
  have hEr : E.right = e := by
    rw [hEdef, mul_right, right_pow, hz1r, one_pow, mul_one]
  have hEc : Compat c E e := by
    have h := compat_mul hHn hE0 (compat_pow hHn hz1c k)
    rwa [one_pow, mul_one] at h
  have hE2 : E * E = secH c (e * e) := by
    rw [← pow_two]
    exact sq_mul_pow_eq (B := secH c (e * e)) hEz1 (by rw [← hk]; exact pow_eq_one_of_right hM hz1r)
  -- the extension to `Ker χ`
  obtain ⟨T, hT, hTr, hTH, hTe⟩ := exists_ext_two hc hHn he he2 χ.ker hidx E hEr hEc hE2
  -- adjust `Γ`
  set w := g * e * g⁻¹ * e⁻¹ with hw
  have hwH : w ∈ H := by
    have hgeg : g * e * g⁻¹ ∈ χ.ker := χ.normal_ker.conj_mem e heK g
    rcases hidx _ hgeg with h | h
    · have h' := hHn.conj_mem _ h g⁻¹
      rw [show g⁻¹ * (g * e * g⁻¹) * g⁻¹⁻¹ = e by group] at h'
      exact absurd h' he
    · exact h
  have hew : e * w * e⁻¹ ∈ H := hHn.conj_mem w hwH e
  set Γ0 : M ⋊[φ] G := ⟨mg, g⟩ with hΓ0def
  set z2 : M ⋊[φ] G := (secH c w)⁻¹ * (Γ0 * E * Γ0⁻¹ * E⁻¹) with hz2
  have hΓ0r : Γ0.right = g := rfl
  have hz2r : z2.right = 1 := by
    rw [hz2, mul_right, inv_right, secH_right hwH]
    simp only [mul_right, inv_right, hEr, hΓ0r]
    rw [hw]
    group
  have hz2c : Compat c z2 1 := by
    have h := compat_mul hHn (compat_inv hHn (compat_secH hc hwH))
      (compat_mul hHn (compat_mul hHn (compat_mul hHn hG0 hEc) (compat_inv hHn hG0))
        (compat_inv hHn hEc))
    have e1 : w⁻¹ * (g * e * g⁻¹ * e⁻¹) = 1 := by rw [hw]; group
    rwa [e1] at h
  have hz2l : z2 ^ (2 * k + 1) = 1 := by rw [← hk]; exact pow_eq_one_of_right hM hz2r
  -- `E z₂ E⁻¹ = z₂⁻¹`
  have hEz2 : E * z2 * E⁻¹ = z2⁻¹ := by
    have hz2'c : Compat c (E * z2 * E⁻¹) 1 := by
      have h := compat_mul hHn (compat_mul hHn hEc hz2c) (compat_inv hHn hEc)
      rwa [mul_one, mul_inv_cancel] at h
    have hC : Γ0 * E * Γ0⁻¹ = secH c w * z2 * E := by rw [hz2]; group
    have hF1 : Γ0 * E * Γ0⁻¹ * (Γ0 * E * Γ0⁻¹) = secH c (g * (e * e) * g⁻¹) := by
      rw [show Γ0 * E * Γ0⁻¹ * (Γ0 * E * Γ0⁻¹) = Γ0 * (E * E) * Γ0⁻¹ by group, hE2]
      exact hG0 _ he2
    have hb := (commute_of_compat hz2c hew).eq
    have hc1 := (commute_of_compat hz2c he2).eq
    have hc2 := (commute_of_compat hz2'c he2).eq
    have hF2 : Γ0 * E * Γ0⁻¹ * (Γ0 * E * Γ0⁻¹) =
        secH c (g * (e * e) * g⁻¹) * (z2 * (E * z2 * E⁻¹)) := by
      rw [hC]
      calc secH c w * z2 * E * (secH c w * z2 * E)
          = secH c w * z2 * (E * secH c w * E⁻¹) * (E * z2 * E⁻¹) * (E * E) := by group
        _ = secH c w * (z2 * secH c (e * w * e⁻¹)) * ((E * z2 * E⁻¹) * secH c (e * e)) := by
            rw [hEc w hwH, hE2]; group
        _ = secH c w * secH c (e * w * e⁻¹) * (z2 * secH c (e * e)) * (E * z2 * E⁻¹) := by
            rw [hb, hc2]; group
        _ = secH c w * secH c (e * w * e⁻¹) * secH c (e * e) * (z2 * (E * z2 * E⁻¹)) := by
            rw [hc1]; group
        _ = secH c (g * (e * e) * g⁻¹) * (z2 * (E * z2 * E⁻¹)) := by
            rw [← secH_mul hc hwH hew, ← secH_mul hc (mul_mem hwH hew) he2]
            congr 2
            rw [hw]; group
    exact eq_inv_of_mul_eq_one_right (left_eq_mul.1 (hF1.symm.trans hF2))
  set Γ := z2 ^ k * Γ0 with hΓdef
  have hΓr : Γ.right = g := by
    rw [hΓdef, mul_right, right_pow, hz2r, one_pow, one_mul]
  have hΓc : Compat c Γ g := by
    have h := compat_mul hHn (compat_pow hHn hz2c k) hG0
    rwa [one_pow, one_mul] at h
  have hΓE : Γ * E * Γ⁻¹ * E⁻¹ = secH c w :=
    adjust_comm (commute_of_compat hz2c hwH) hEz2 hz2l (by rw [hz2]; group)
  -- `Γ` conjugates `T` correctly on `Ker χ`
  have hconj : ∀ x ∈ χ.ker, Γ * T x * Γ⁻¹ = T (g * x * g⁻¹) := by
    intro x hx
    by_cases hxH : x ∈ H
    · rw [hTH x hxH, hTH _ (hHn.conj_mem x hxH g)]
      exact hΓc x hxH
    · have hx' : x * e⁻¹ ∈ H := (hidx x hx).resolve_left hxH
      have hgx : g * x * g⁻¹ ∈ χ.ker := χ.normal_ker.conj_mem x hx g
      have hgxH : g * x * g⁻¹ ∉ H := fun h => by
        have h' := hHn.conj_mem _ h g⁻¹
        rw [show g⁻¹ * (g * x * g⁻¹) * g⁻¹⁻¹ = x by group] at h'
        exact hxH h'
      rw [hTe x hx hxH, hTe _ hgx hgxH]
      have hge : g * (x * e⁻¹) * g⁻¹ ∈ H := hHn.conj_mem _ hx' g
      have e1 : g * x * g⁻¹ * e⁻¹ = g * (x * e⁻¹) * g⁻¹ * w := by rw [hw]; group
      rw [e1, secH_mul hc hge hwH, ← hΓc _ hx', ← hΓE]
      group
  obtain ⟨S, hSr, hST⟩ := exists_hom_extend_int χ hg T hT hTr Γ hΓr hconj
  obtain ⟨hδ, -⟩ := eq_sectionOf S hSr
  refine ⟨fun x => (S x).left, hδ, fun h => ?_⟩
  change (S h).left = c h
  rw [hST _ (hHχ h.2), hTH _ h.2, secH_of_mem h.2]

/-- **Extension when `H = Ker χ`** (the case `[Ker χ : H] = 1` of `exists_cocycle_extend`): if
the `g`-conjugate of a cocycle `c` on `H = Ker χ ⊴ G`, `χ g = 1`, is cohomologous to `c`,
then `c` extends to a cocycle on `G` (no condition on `M`). -/
theorem exists_cocycle_extend_ker (H : Subgroup G) (hHn : H.Normal) (χ : G →* Multiplicative ℤ)
    (hHχ : H ≤ χ.ker) (hχH : ∀ y ∈ χ.ker, y ∈ H) {g : G} (hg : χ g = Multiplicative.ofAdd 1)
    (c : H → M) (hc : IsCocycle (φ.comp H.subtype) c) (mg : M)
    (hcg : ∀ (h : G) (hh : h ∈ H), c ⟨g * h * g⁻¹, hHn.conj_mem h hh g⟩ =
      mg * φ g (c ⟨h, hh⟩) * (φ (g * h * g⁻¹) mg)⁻¹) :
    ∃ C : G → M, IsCocycle φ C ∧ ∀ h : H, C h = c h := by
  have hG0 : Compat c (⟨mg, g⟩ : M ⋊[φ] G) g := by
    intro x hx
    rw [secH_of_mem hx, secH_of_mem (hHn.conj_mem x hx g)]
    ext
    · simp only [mul_left, inv_left, mul_right]
      rw [hcg x hx, ← MulAut.mul_apply, ← map_mul, map_inv]
    · simp
  obtain ⟨S, hSr, hST⟩ := exists_hom_extend_int χ hg (secH c)
    (fun x hx y hy => secH_mul hc (hχH x hx) (hχH y hy))
    (fun x hx => secH_right (hχH x hx)) ⟨mg, g⟩ rfl
    (fun x hx => hG0 x (hχH x hx))
  obtain ⟨hδ, -⟩ := eq_sectionOf S hSr
  refine ⟨fun x => (S x).left, hδ, fun h => ?_⟩
  change (S h).left = c h
  rw [hST _ (hHχ h.2), secH_of_mem h.2]

end Main

end Iut.EtaleTheta.Env
