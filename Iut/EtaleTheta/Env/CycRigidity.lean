import Iut.EtaleTheta.Env.Prop214

/-!
# Cyclotomic rigidity of (nonabelian) mono-theta environments ([EtTh], Cor. 2.19(i))

[EtTh], Cor. 2.19(i) gives a functorial group-theoretic algorithm which reconstructs, from a
mono-theta environment `M = (Π, D, s^Θ)` alone, the cyclotome `μ_N`, the subquotient
`Π|(l·Δ_Θ)` with its two splittings over `l·Δ_Θ` (the theta and the algebraic section), and
hence, as their difference, the isomorphism of cyclotomes `(l·Δ_Θ) ⊗ ℤ/N ≅ μ_N`. Its proof
([EtTh], proof of Cor. 2.19(i)):

* since the theta and algebraic sections coincide over `Ker(Π_Y ↠ (Π_Y)^Θ)` ([EtTh],
  Prop. 1.3), `Ker(Π ↠ Π|(Π_Y)^Θ)` is the image via the theta section of
  `Ker(Π_Y ↠ (Π_Y)^Θ)`;
* the subquotients `Π|(l·Δ_Θ) ⊆ Π|(Δ_Y)^Θ ⊆ Π|(Π_Y)^Θ` are the inverse images of the
  subquotients of [EtTh], Cor. 2.18(i);
* the theta splitting comes from datum (c) of the environment, the algebraic splitting from the
  algorithm of [EtTh], Prop. 2.14(i).

This file formalizes this for the **nonabelian** environments `MonoThetaEnv` of
`MonoTheta.lean` and the model environments `modelEnv` of `Env/Model.lean`, working in `Π`
itself (all subquotients are represented by their preimages in `Π`).

## The abstract algorithm (namespace `MonoThetaEnv`)

The subquotients of [EtTh], Cor. 2.18(i) come from a tempered anabelian reconstruction which is
not available; their preimages in `Π` enter as three **input subgroups** `Lsub` (preimage of
`l·Δ_Θ`), `Ksub` (preimage of `Ker(Π_Y ↠ (Π_Y)^Θ)`) and `Dsub` (preimage of
`Δ_Y = Ker(Π_Y ↠ G_K)`). From `M` and these the algorithm constructs:

* `MonoThetaEnv.mu`: the cyclotome, the union of the centralizers of the finite-index subgroups
  ([EtTh], Prop. 2.11(ii), finite-index form);
* `MonoThetaEnv.kerTheta`: `Ker(Π ↠ Π|(Π_Y)^Θ)`, generated by the theta-section part of `Ksub`;
* `MonoThetaEnv.thetaSplit`: the theta splitting over `l·Δ_Θ`, the theta-section part of `Lsub`;
* `MonoThetaEnv.algSet`: the set of [EtTh], Prop. 2.14(i) inside `Lsub`, i.e. the `γ(β)·β⁻¹`
  with `β ∈ Dsub` and `γ ∈ D` inducing the identity modulo `Dsub`;
* `MonoThetaEnv.taut`: the algebraic splitting (modulo `kerTheta`);
* `MonoThetaEnv.IsCyc t m`: the isomorphism of cyclotomes as a relation — `t` in the algebraic
  splitting corresponds to `m ∈ μ` iff `t·m` lies in the theta splitting (modulo `kerTheta`).

`MonoThetaEnv.Iso.mem_mu_iff`, `map_kerTheta`, `mem_thetaSplit_iff`, `mem_algSet_iff`,
`map_taut`, `map_thetaSub`, `isCyc_iff`: **the algorithm is functorial** for isomorphisms of
mono-theta environments respecting the inputs.

## The model (namespace `Env`)

For `modelEnv` with inputs `rightSub L`, `rightSub Kθ`, `geomSub` (the preimages of
`L, Kθ ⊆ Π_X` and of `Δ`), under the hypotheses
`hη13` ([EtTh], Prop. 1.3: theta and algebraic sections agree on `Kθ`) and `hL`
(`L` is generated by `Kθ` and the geometric commutators in `L`; [EtTh], Prop. 2.12(i)-type):

* `modelEnv_mu`: `μ` is recovered (for `μ` finite and `Π_Y` `FISlim`);
* `modelEnv_kerTheta`: `kerTheta` is the algebraic image of `Kθ`;
* `modelEnv_thetaSplit`: the theta splitting is the theta-section image of `L`;
* `modelEnv_taut`: the algebraic splitting is the algebraic image of `L` (via
  `prop214Set_eq`, [EtTh], Prop. 2.14(i));
* `isCyc_model`: the reconstructed isomorphism of cyclotomes is `s^alg(l) ↦ η(l)⁻¹`, i.e. `-η`
  on `l·Δ_Θ`.

**`cyclotomicRigidity_env`** ([EtTh], Cor. 2.19(i)): for every mono-theta environment `M` and
every isomorphism `M ≅ modelEnv` respecting the inputs, the algorithmic isomorphism of
cyclotomes of `M` is carried to `-η`. **`cyclotomicRigidity_envAut`**: automorphisms of the model
environment respecting the inputs commute with `-η` on `l·Δ_Θ` — no `(ℤ/N)^×`-indeterminacy.
-/

namespace Iut.EtaleTheta

open SemidirectProduct

universe u

/-- The union of the centralizers of the finite-index subgroups of a group. -/
def fiCentralizers (G : Type*) [Group G] : Set G :=
  {x | ∃ V : Subgroup G, V.FiniteIndex ∧ x ∈ Subgroup.centralizer (V : Set G)}

lemma apply_mem_fiCentralizers_iff {A B : Type*} [Group A] [Group B] (e : A ≃* B) (a : A) :
    e a ∈ fiCentralizers B ↔ a ∈ fiCentralizers A :=
  ⟨fun h => by
    have h' := Envelope.exists_finiteIndex_centralizer_map e.symm (e a) h
    rw [MulEquiv.symm_apply_apply] at h'
    exact h',
    Envelope.exists_finiteIndex_centralizer_map e a⟩

namespace MonoThetaEnv

/-! ### The abstract algorithm -/

variable (M : MonoThetaEnv.{u})

/-- **The cyclotome** `μ_N ⊆ Π[μ_N]` ([EtTh], Prop. 2.11(ii), finite-index form): the union of
the centralizers of the finite-index subgroups. -/
def mu : Set M.G := fiCentralizers M.G

/-- The theta-section part of a subgroup `S`: the elements of `S` lying in a member of datum (c)
(a `μ`-conjugate of the image of the theta section). -/
def thetaPart (S : Subgroup M.G) : Set M.G :=
  ⋃ H ∈ M.thetaSubgroups, ((H ⊓ S : Subgroup M.G) : Set M.G)

lemma mem_thetaPart {S : Subgroup M.G} {x : M.G} :
    x ∈ M.thetaPart S ↔ ∃ H ∈ M.thetaSubgroups, x ∈ H ∧ x ∈ S := by
  simp only [thetaPart, Set.mem_iUnion, SetLike.mem_coe, Subgroup.mem_inf, exists_prop]

/-- `Ker(Π ↠ Π|(Π_Y)^Θ)`, constructed as the image via the theta section of
`Ker(Π_Y ↠ (Π_Y)^Θ)` (preimage `Ksub`) ([EtTh], proof of Cor. 2.19(i)). -/
def kerTheta (Ksub : Subgroup M.G) : Subgroup M.G := Subgroup.closure (M.thetaPart Ksub)

/-- **The theta splitting** over `l·Δ_Θ` (preimage `Lsub`): datum (c) of the environment. -/
def thetaSplit (Lsub : Subgroup M.G) : Set M.G := M.thetaPart Lsub

/-- **The set of [EtTh], Prop. 2.14(i)** inside `Lsub`: the `γ(β)·β⁻¹` for `β ∈ Dsub`
(geometric) and `γ ∈ D` inducing the identity modulo `Dsub`. -/
def algSet (Lsub Dsub : Subgroup M.G) : Set M.G :=
  {w | w ∈ Lsub ∧ ∃ γ ∈ M.D, (∀ z, γ z * z⁻¹ ∈ Dsub) ∧ ∃ β ∈ Dsub, w = γ β * β⁻¹}

/-- **The algebraic splitting** over `l·Δ_Θ` (modulo `kerTheta`). -/
def taut (Lsub Ksub Dsub : Subgroup M.G) : Subgroup M.G :=
  Subgroup.closure (M.algSet Lsub Dsub) ⊔ M.kerTheta Ksub

/-- The theta splitting modulo `kerTheta`, as a subgroup. -/
def thetaSub (Lsub Ksub : Subgroup M.G) : Subgroup M.G :=
  Subgroup.closure (M.thetaSplit Lsub) ⊔ M.kerTheta Ksub

/-- **The isomorphism of cyclotomes** ([EtTh], Cor. 2.19(i)) as a relation: `t` in the algebraic
splitting corresponds to `m ∈ μ` iff `t·m` lies in the theta splitting, i.e. `m` is the
difference of the two splittings at `t`. -/
def IsCyc (Lsub Ksub Dsub : Subgroup M.G) (t m : M.G) : Prop :=
  t ∈ M.taut Lsub Ksub Dsub ∧ m ∈ M.mu ∧ t * m ∈ M.thetaSub Lsub Ksub

lemma conjAut_apply {A B : Type*} [Group A] [Group B] (e : A ≃* B) (γ : MulAut A) (y : B) :
    conjAut e γ y = e (γ (e.symm y)) := rfl

/-! ### Functoriality -/

namespace Iso

variable {M} {M' : MonoThetaEnv.{u}} (f : Iso M M')

/-- The underlying homomorphism of an isomorphism of mono-theta environments. -/
abbrev hom : M.G →* M'.G := f.e.toMulEquiv.toMonoidHom

lemma apply_mem_map_iff {H : Subgroup M.G} {H' : Subgroup M'.G} (h : H.map f.hom = H')
    (x : M.G) : f.e x ∈ H' ↔ x ∈ H := by
  rw [← h]
  exact ⟨fun ⟨y, hy, e⟩ => (f.e.toMulEquiv.injective e) ▸ hy, fun hx => ⟨x, hx, rfl⟩⟩

lemma image_eq {S : Set M.G} {S' : Set M'.G} (h : ∀ x, f.e x ∈ S' ↔ x ∈ S) :
    f.hom '' S = S' := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact (h x).2 hx
  · intro hy
    refine ⟨f.e.symm y, (h _).1 ?_, f.e.apply_symm_apply y⟩
    rwa [f.e.apply_symm_apply]

/-- **The cyclotome is functorial.** -/
theorem mem_mu_iff (x : M.G) : f.e x ∈ M'.mu ↔ x ∈ M.mu :=
  apply_mem_fiCentralizers_iff f.e.toMulEquiv x

theorem mem_thetaPart_iff {S : Subgroup M.G} {S' : Subgroup M'.G} (hS : S.map f.hom = S')
    (x : M.G) : f.e x ∈ M'.thetaPart S' ↔ x ∈ M.thetaPart S := by
  rw [mem_thetaPart, mem_thetaPart, ← f.map_theta]
  constructor
  · rintro ⟨_, ⟨H, hH, rfl⟩, h1, h2⟩
    exact ⟨H, hH, (f.apply_mem_map_iff rfl x).1 h1, (f.apply_mem_map_iff hS x).1 h2⟩
  · rintro ⟨H, hH, h1, h2⟩
    exact ⟨_, ⟨H, hH, rfl⟩, (f.apply_mem_map_iff rfl x).2 h1, (f.apply_mem_map_iff hS x).2 h2⟩

/-- **`kerTheta` is functorial.** -/
theorem map_kerTheta {Ksub : Subgroup M.G} {Ksub' : Subgroup M'.G} (hK : Ksub.map f.hom = Ksub') :
    (M.kerTheta Ksub).map f.hom = M'.kerTheta Ksub' := by
  rw [kerTheta, MonoidHom.map_closure, f.image_eq (f.mem_thetaPart_iff hK), kerTheta]

/-- **The theta splitting is functorial.** -/
theorem mem_thetaSplit_iff {Lsub : Subgroup M.G} {Lsub' : Subgroup M'.G}
    (hL : Lsub.map f.hom = Lsub') (x : M.G) :
    f.e x ∈ M'.thetaSplit Lsub' ↔ x ∈ M.thetaSplit Lsub :=
  f.mem_thetaPart_iff hL x

/-- **The set of [EtTh], Prop. 2.14(i) is functorial.** -/
theorem mem_algSet_iff {Lsub Dsub : Subgroup M.G} {Lsub' Dsub' : Subgroup M'.G}
    (hL : Lsub.map f.hom = Lsub') (hD : Dsub.map f.hom = Dsub') (w : M.G) :
    f.e w ∈ M'.algSet Lsub' Dsub' ↔ w ∈ M.algSet Lsub Dsub := by
  have hconj : ∀ (γ : MulAut M.G) (y : M'.G),
      conjAut f.e.toMulEquiv γ y = f.e (γ (f.e.symm y)) := fun _ _ => rfl
  simp only [algSet, Set.mem_setOf_eq]
  rw [← f.map_D, f.apply_mem_map_iff hL]
  refine and_congr_right fun _ => ?_
  constructor
  · rintro ⟨_, ⟨γ, hγ, rfl⟩, hz, β', hβ', hw⟩
    refine ⟨γ, hγ, fun z => ?_, f.e.symm β', ?_, ?_⟩
    · rw [← f.apply_mem_map_iff hD]
      have := hz (f.e z)
      rw [hconj] at this
      simpa using this
    · rw [← f.apply_mem_map_iff hD]
      simpa using hβ'
    · have : f.e w = f.e (γ (f.e.symm β') * (f.e.symm β')⁻¹) := by
        rw [hw, hconj]
        simp
      exact (EquivLike.injective f.e) this
  · rintro ⟨γ, hγ, hz, β, hβ, rfl⟩
    refine ⟨_, ⟨γ, hγ, rfl⟩, fun z => ?_, f.e β, (f.apply_mem_map_iff hD β).2 hβ, ?_⟩
    · have := (f.apply_mem_map_iff hD _).2 (hz (f.e.symm z))
      rw [hconj]
      simpa using this
    · rw [hconj]
      simp

/-- **The algebraic splitting is functorial.** -/
theorem map_taut {Lsub Ksub Dsub : Subgroup M.G} {Lsub' Ksub' Dsub' : Subgroup M'.G}
    (hL : Lsub.map f.hom = Lsub') (hK : Ksub.map f.hom = Ksub') (hD : Dsub.map f.hom = Dsub') :
    (M.taut Lsub Ksub Dsub).map f.hom = M'.taut Lsub' Ksub' Dsub' := by
  rw [taut, Subgroup.map_sup, MonoidHom.map_closure, f.image_eq (f.mem_algSet_iff hL hD),
    f.map_kerTheta hK, taut]

/-- **The theta splitting (modulo `kerTheta`) is functorial.** -/
theorem map_thetaSub {Lsub Ksub : Subgroup M.G} {Lsub' Ksub' : Subgroup M'.G}
    (hL : Lsub.map f.hom = Lsub') (hK : Ksub.map f.hom = Ksub') :
    (M.thetaSub Lsub Ksub).map f.hom = M'.thetaSub Lsub' Ksub' := by
  rw [thetaSub, Subgroup.map_sup, MonoidHom.map_closure, f.image_eq (f.mem_thetaSplit_iff hL),
    f.map_kerTheta hK, thetaSub]

/-- **Functoriality of the isomorphism of cyclotomes** ([EtTh], Cor. 2.19(i)). -/
theorem isCyc_iff {Lsub Ksub Dsub : Subgroup M.G} {Lsub' Ksub' Dsub' : Subgroup M'.G}
    (hL : Lsub.map f.hom = Lsub') (hK : Ksub.map f.hom = Ksub') (hD : Dsub.map f.hom = Dsub')
    (t m : M.G) : M'.IsCyc Lsub' Ksub' Dsub' (f.e t) (f.e m) ↔ M.IsCyc Lsub Ksub Dsub t m := by
  unfold IsCyc
  rw [f.apply_mem_map_iff (f.map_taut hL hK hD), f.mem_mu_iff, ← map_mul,
    f.apply_mem_map_iff (f.map_thetaSub hL hK)]

end Iso

end MonoThetaEnv

/-! ### The model -/

namespace Env

open scoped commutatorElement

variable {PX G μ : Type u} [Group PX] [Group G] [CommGroup μ] (aug : PX →* G)
  (ψ : G →* MulAut μ)

/-- The preimage in `Π_Y[μ]` of a subgroup `S ⊆ Π_X`. -/
def rightSub (PY S : Subgroup PX) : Subgroup (envY aug ψ PY) :=
  S.comap ((rightHom : EnvX aug ψ →* PX).comp (envY aug ψ PY).subtype)

lemma mem_rightSub {PY S : Subgroup PX} (z : envY aug ψ PY) :
    z ∈ rightSub aug ψ PY S ↔ (z : EnvX aug ψ).right ∈ S := Iff.rfl

/-- The geometric part `Δ_Y[μ] = Ker(Π_Y[μ] ↠ G)`. -/
def geomSub (PY : Subgroup PX) : Subgroup (envY aug ψ PY) :=
  (aug.comp ((rightHom : EnvX aug ψ →* PX).comp (envY aug ψ PY).subtype)).ker

lemma mem_geomSub {PY : Subgroup PX} (z : envY aug ψ PY) :
    z ∈ geomSub aug ψ PY ↔ aug (z : EnvX aug ψ).right = 1 := Iff.rfl

/-- Conjugation by `μ` fixes the geometric elements. -/
lemma conj_inlY_of_geom {PY : Subgroup PX} (ζ : μ) (z : envY aug ψ PY)
    (hz : aug (z : EnvX aug ψ).right = 1) :
    inlY aug ψ PY ζ * z * (inlY aug ψ PY ζ)⁻¹ = z := by
  apply Subtype.ext
  refine SemidirectProduct.ext ?_ ?_
  · simp [mul_left, inv_left, hz]
  · simp

/-- `Π_Y[μ] ≅ μ ⋊ Π_Y`. -/
def envYEquiv (PY : Subgroup PX) :
    envY aug ψ PY ≃* μ ⋊[(act aug ψ).comp PY.subtype] PY where
  toFun z := ⟨(z : EnvX aug ψ).left, ⟨(z : EnvX aug ψ).right, z.2⟩⟩
  invFun y := ⟨⟨y.left, y.right⟩, y.right.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

section Sections

variable {PY PYdd : Subgroup PX} (hle : PYdd ≤ PY) {η : PYdd → μ}
  (hη : IsCocycle (actDD aug ψ PYdd) η)

/-- The theta-section image of `S ∩ Π_Ÿ`. -/
def thetaImage (S : Subgroup PX) : Subgroup (envY aug ψ PY) :=
  (S.subgroupOf PYdd).map (thetaSection aug ψ hle hη)

/-- The algebraic-section image of `S ∩ Π_Ÿ`. -/
def algImage (S : Subgroup PX) : Subgroup (envY aug ψ PY) :=
  (S.subgroupOf PYdd).map (algSection aug ψ hle)

lemma mem_thetaImage {S : Subgroup PX} {z : envY aug ψ PY} :
    z ∈ thetaImage aug ψ hle hη S ↔ ∃ l : PYdd, (l : PX) ∈ S ∧ z = thetaSection aug ψ hle hη l := by
  simp only [thetaImage, Subgroup.mem_map, Subgroup.mem_subgroupOf, eq_comm]

lemma mem_algImage {S : Subgroup PX} {z : envY aug ψ PY} :
    z ∈ algImage aug ψ hle S ↔ ∃ l : PYdd, (l : PX) ∈ S ∧ z = algSection aug ψ hle l := by
  simp only [algImage, Subgroup.mem_map, Subgroup.mem_subgroupOf, eq_comm]

lemma thetaSection_eq_algSection {l : PYdd} (h : η l = 1) :
    thetaSection aug ψ hle hη l = algSection aug ψ hle l := by
  apply Subtype.ext
  refine SemidirectProduct.ext ?_ rfl
  simp [h]

end Sections

section Model

variable [TopologicalSpace PX] [IsTopologicalGroup PX] [TopologicalSpace μ] [DiscreteTopology μ]
  (Kum : Subgroup (G → μ)) {PY PYdd : Subgroup PX} (hle : PYdd ≤ PY)
  (hψ : IsOpen ((act aug ψ).ker : Set PX)) (hKum : ∀ κ ∈ Kum, IsCocycle ψ κ)
  {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η)

/-- **The theta-section part of a geometric subgroup** in the model: the theta-section image. -/
theorem modelEnv_thetaPart (S : Subgroup PX) (hS : ∀ s ∈ S, aug s = 1) :
    (modelEnv aug ψ Kum hle hψ hKum hη).thetaPart (rightSub aug ψ PY S) =
      (thetaImage aug ψ hle hη S : Set (envY aug ψ PY)) := by
  refine Set.ext fun (z : envY aug ψ PY) => (MonoThetaEnv.mem_thetaPart _).trans ?_
  change (∃ H ∈ thetaSubgroups aug ψ hle hη, z ∈ H ∧ z ∈ rightSub aug ψ PY S) ↔
    z ∈ thetaImage aug ψ hle hη S
  refine Iff.trans ?_ (mem_thetaImage aug ψ hle hη).symm
  constructor
  · rintro ⟨H, hH, hzH, hzS⟩
    obtain ⟨ζ, rfl⟩ := (mem_thetaSubgroups_iff aug ψ hle hη H).1 hH
    obtain ⟨_, ⟨g, rfl⟩, rfl⟩ := hzH
    have hgS : (g : PX) ∈ S := by
      simpa [mem_rightSub, MulAut.conj_apply] using hzS
    refine ⟨g, hgS, ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    exact conj_inlY_of_geom aug ψ ζ _ (by simpa using hS _ hgS)
  · rintro ⟨g, hg, rfl⟩
    refine ⟨_, (mem_thetaSubgroups_iff aug ψ hle hη _).2 ⟨1, rfl⟩, ⟨_, ⟨g, rfl⟩, by simp⟩, ?_⟩
    simpa [mem_rightSub] using hg

/-- **[EtTh], proof of Cor. 2.19(i), in the model**: `kerTheta` is the algebraic image of
`Kθ = Ker(Π_Y ↠ (Π_Y)^Θ)` (theta and algebraic sections agree there, [EtTh], Prop. 1.3). -/
theorem modelEnv_kerTheta (Kθ : Subgroup PX) (hKg : ∀ k ∈ Kθ, aug k = 1)
    (hη13 : ∀ k (hk : k ∈ PYdd), k ∈ Kθ → η ⟨k, hk⟩ = 1) :
    (modelEnv aug ψ Kum hle hψ hKum hη).kerTheta (rightSub aug ψ PY Kθ) =
      algImage aug ψ hle Kθ := by
  have hP := modelEnv_thetaPart aug ψ Kum hle hψ hKum hη Kθ hKg
  apply le_antisymm
  · refine (Subgroup.closure_le _).2 fun z hz => ?_
    rw [hP] at hz
    obtain ⟨l, hl, rfl⟩ := (mem_thetaImage aug ψ hle hη).1 hz
    exact (mem_algImage aug ψ hle).2
      ⟨l, hl, thetaSection_eq_algSection aug ψ hle hη (hη13 l l.2 hl)⟩
  · intro z hz
    obtain ⟨l, hl, rfl⟩ := (mem_algImage aug ψ hle).1 hz
    apply Subgroup.subset_closure
    rw [hP]
    exact (mem_thetaImage aug ψ hle hη).2
      ⟨l, hl, (thetaSection_eq_algSection aug ψ hle hη (hη13 l l.2 hl)).symm⟩

/-- **The theta splitting in the model** is the theta-section image of `L`. -/
theorem modelEnv_thetaSplit (L : Subgroup PX) (hLg : ∀ l ∈ L, aug l = 1) :
    (modelEnv aug ψ Kum hle hψ hKum hη).thetaSplit (rightSub aug ψ PY L) =
      (thetaImage aug ψ hle hη L : Set (envY aug ψ PY)) :=
  modelEnv_thetaPart aug ψ Kum hle hψ hKum hη L hLg

/-- **The theta splitting modulo `kerTheta` in the model.** -/
theorem modelEnv_thetaSub (L Kθ : Subgroup PX) (hKL : Kθ ≤ L) (hLg : ∀ l ∈ L, aug l = 1)
    (hη13 : ∀ k (hk : k ∈ PYdd), k ∈ Kθ → η ⟨k, hk⟩ = 1) :
    (modelEnv aug ψ Kum hle hψ hKum hη).thetaSub (rightSub aug ψ PY L) (rightSub aug ψ PY Kθ) =
      thetaImage aug ψ hle hη L := by
  have h1 : Subgroup.closure ((modelEnv aug ψ Kum hle hψ hKum hη).thetaSplit
      (rightSub aug ψ PY L)) = thetaImage aug ψ hle hη L := by
    rw [modelEnv_thetaSplit aug ψ Kum hle hψ hKum hη L hLg]
    exact Subgroup.closure_eq _
  rw [MonoThetaEnv.thetaSub, h1,
    modelEnv_kerTheta aug ψ Kum hle hψ hKum hη Kθ (fun k hk => hLg k (hKL hk)) hη13]
  apply sup_eq_left.2
  intro z hz
  obtain ⟨l, hl, rfl⟩ := (mem_algImage aug ψ hle).1 hz
  exact (mem_thetaImage aug ψ hle hη).2
    ⟨l, hKL hl, (thetaSection_eq_algSection aug ψ hle hη (hη13 l l.2 hl)).symm⟩

/-- The set of [EtTh], Prop. 2.14(i) in the model, inside `rightSub L`. -/
theorem mem_modelEnv_algSet [PY.Normal] (hG : ∀ τ : G, (∀ σ, τ * σ = σ * τ) → τ = 1)
    (hsurj : ∀ σ : G, ∃ h ∈ PY, aug h = σ) (L : Subgroup PX) (w : envY aug ψ PY) :
    w ∈ (modelEnv aug ψ Kum hle hψ hKum hη).algSet (rightSub aug ψ PY L) (geomSub aug ψ PY) ↔
      w ∈ rightSub aug ψ PY L ∧ w ∈ geomCommutators aug ψ PY := by
  change (w ∈ rightSub aug ψ PY L ∧ ∃ γ ∈ DY aug ψ Kum PY hKum,
    (∀ z, γ z * z⁻¹ ∈ geomSub aug ψ PY) ∧ ∃ β ∈ geomSub aug ψ PY, w = γ β * β⁻¹) ↔ _
  rw [← prop214Set_eq aug ψ Kum hKum PY hG hsurj]
  have hγ : ∀ γ : MulAut (envY aug ψ PY), (∀ z, γ z * z⁻¹ ∈ geomSub aug ψ PY) ↔
      ∀ z : envY aug ψ PY, aug ((γ z : envY aug ψ PY) : EnvX aug ψ).right =
        aug (z : EnvX aug ψ).right := by
    intro γ
    refine forall_congr' fun z => ?_
    rw [mem_geomSub]
    simp [mul_inv_eq_one]
  simp only [prop214Set, Set.mem_setOf_eq]
  exact and_congr_right fun _ => exists_congr fun γ => and_congr_right fun _ =>
    and_congr (hγ γ) Iff.rfl

/-- **The cyclotome in the model** ([EtTh], Prop. 2.11(ii), finite-index form). -/
theorem mem_modelEnv_mu [Finite μ] (hPY : Envelope.FISlim PY) (x : envY aug ψ PY) :
    x ∈ (modelEnv aug ψ Kum hle hψ hKum hη).mu ↔ x ∈ (inlY aug ψ PY).range := by
  change x ∈ fiCentralizers (envY aug ψ PY) ↔ _
  rw [← apply_mem_fiCentralizers_iff (envYEquiv aug ψ PY)]
  change (∃ V : Subgroup (μ ⋊[(act aug ψ).comp PY.subtype] PY), V.FiniteIndex ∧
    envYEquiv aug ψ PY x ∈
      Subgroup.centralizer (V : Set (μ ⋊[(act aug ψ).comp PY.subtype] PY))) ↔ _
  refine (Envelope.mem_range_inl_iff_finiteIndex hPY _).symm.trans ⟨?_, ?_⟩
  · rintro ⟨m, hm⟩
    exact ⟨m, (envYEquiv aug ψ PY).injective hm⟩
  · rintro ⟨m, rfl⟩
    exact ⟨m, rfl⟩

/-- **[EtTh], Prop. 2.14(i) and proof of Cor. 2.19(i), in the model**: the algebraic splitting
reconstructed by the algorithm is the algebraic image of `L`. -/
theorem modelEnv_taut [PY.Normal] (hG : ∀ τ : G, (∀ σ, τ * σ = σ * τ) → τ = 1)
    (hsurj : ∀ σ : G, ∃ h ∈ PY, aug h = σ) (L Kθ : Subgroup PX) (hKL : Kθ ≤ L)
    (hLdd : L ≤ PYdd) (hLg : ∀ l ∈ L, aug l = 1)
    (hη13 : ∀ k (hk : k ∈ PYdd), k ∈ Kθ → η ⟨k, hk⟩ = 1)
    (hL : Subgroup.closure {c | c ∈ L ∧ ∃ a b, aug a = 1 ∧ b ∈ PY ∧ aug b = 1 ∧ c = ⁅a, b⁆} ⊔
      Kθ = L) :
    (modelEnv aug ψ Kum hle hψ hKum hη).taut (rightSub aug ψ PY L) (rightSub aug ψ PY Kθ)
      (geomSub aug ψ PY) = algImage aug ψ hle L := by
  have hK := modelEnv_kerTheta aug ψ Kum hle hψ hKum hη Kθ (fun k hk => hLg k (hKL hk)) hη13
  rw [MonoThetaEnv.taut, hK]
  apply le_antisymm
  · refine sup_le ?_ ?_
    · rw [Subgroup.closure_le]
      refine fun (w : envY aug ψ PY) hw => ?_
      obtain ⟨hwL, a, b, -, -, -, hw⟩ :=
        (mem_modelEnv_algSet aug ψ Kum hle hψ hKum hη hG hsurj L w).1 hw
      have hr : (w : EnvX aug ψ).right ∈ L := hwL
      refine (mem_algImage aug ψ hle).2 ⟨⟨_, hLdd hr⟩, hr, Subtype.ext ?_⟩
      simp only [coe_algSection, hw, right_inr]
    · intro z hz
      obtain ⟨l, hl, rfl⟩ := (mem_algImage aug ψ hle).1 hz
      exact (mem_algImage aug ψ hle).2 ⟨l, hKL hl, rfl⟩
  · -- the subgroup of `Π_X` of elements whose tautological image is reached
    let T : Subgroup (envY aug ψ PY) := Subgroup.closure
      ((modelEnv aug ψ Kum hle hψ hKum hη).algSet (rightSub aug ψ PY L) (geomSub aug ψ PY)) ⊔
        algImage aug ψ hle Kθ
    let T' : Subgroup PX :=
      (T.map (envY aug ψ PY).subtype).comap (inr : PX →* EnvX aug ψ)
    have hLT : L ≤ T' := by
      rw [← hL]
      refine sup_le ?_ ?_
      · rw [Subgroup.closure_le]
        rintro c ⟨hcL, a, b, ha, hb, hb1, rfl⟩
        have hcPY : ⁅a, b⁆ ∈ PY := hle (hLdd hcL)
        refine Subgroup.mem_comap.2 (Subgroup.mem_map.2 ⟨⟨inr ⁅a, b⁆, hcPY⟩, ?_, rfl⟩)
        refine Subgroup.mem_sup_left (Subgroup.subset_closure ?_)
        refine (mem_modelEnv_algSet aug ψ Kum hle hψ hKum hη hG hsurj L _).2 ⟨?_, ?_⟩
        · exact hcL
        · exact ⟨a, b, ha, hb, hb1, rfl⟩
      · intro k hk
        refine Subgroup.mem_comap.2
          (Subgroup.mem_map.2 ⟨algSection aug ψ hle ⟨k, hLdd (hKL hk)⟩, ?_, rfl⟩)
        exact Subgroup.mem_sup_right ((mem_algImage aug ψ hle).2 ⟨_, hk, rfl⟩)
    intro z hz
    obtain ⟨l, hl, rfl⟩ := (mem_algImage aug ψ hle).1 hz
    obtain ⟨y, hy, hyl⟩ := Subgroup.mem_map.1 (Subgroup.mem_comap.1 (hLT hl))
    have hly : algSection aug ψ hle l = y := Subtype.ext hyl.symm
    rw [hly]
    exact hy

/-- **The isomorphism of cyclotomes in the model** ([EtTh], Cor. 2.19(i)): the algebraic image
`s^alg(l)` of `l ∈ L` corresponds to `η(l)⁻¹ ∈ μ` — the reconstructed isomorphism
`l·Δ_Θ ⊗ ℤ/N ≅ μ_N` is `-η`, the difference of the theta and algebraic sections. -/
theorem isCyc_model [Finite μ] (hPY : Envelope.FISlim PY) [PY.Normal]
    (hG : ∀ τ : G, (∀ σ, τ * σ = σ * τ) → τ = 1) (hsurj : ∀ σ : G, ∃ h ∈ PY, aug h = σ)
    (L Kθ : Subgroup PX) (hKL : Kθ ≤ L) (hLdd : L ≤ PYdd) (hLg : ∀ l ∈ L, aug l = 1)
    (hη13 : ∀ k (hk : k ∈ PYdd), k ∈ Kθ → η ⟨k, hk⟩ = 1)
    (hL : Subgroup.closure {c | c ∈ L ∧ ∃ a b, aug a = 1 ∧ b ∈ PY ∧ aug b = 1 ∧ c = ⁅a, b⁆} ⊔
      Kθ = L)
    (t m : envY aug ψ PY) :
    (modelEnv aug ψ Kum hle hψ hKum hη).IsCyc (rightSub aug ψ PY L) (rightSub aug ψ PY Kθ)
        (geomSub aug ψ PY) t m ↔
      ∃ l : PYdd, (l : PX) ∈ L ∧ t = algSection aug ψ hle l ∧ m = inlY aug ψ PY (η l)⁻¹ := by
  rw [MonoThetaEnv.IsCyc,
    modelEnv_taut aug ψ Kum hle hψ hKum hη hG hsurj L Kθ hKL hLdd hLg hη13 hL,
    modelEnv_thetaSub aug ψ Kum hle hψ hKum hη L Kθ hKL hLg hη13]
  change t ∈ algImage aug ψ hle L ∧ m ∈ (modelEnv aug ψ Kum hle hψ hKum hη).mu ∧
    t * m ∈ thetaImage aug ψ hle hη L ↔ _
  rw [mem_algImage, mem_modelEnv_mu aug ψ Kum hle hψ hKum hη hPY, mem_thetaImage]
  constructor
  · rintro ⟨⟨l, hl, rfl⟩, ⟨m0, rfl⟩, ⟨l', hl', he⟩⟩
    have he' := congrArg (fun z : envY aug ψ PY => (z : EnvX aug ψ)) he
    simp only [Subgroup.coe_mul, coe_algSection, coe_inlY, coe_thetaSection] at he'
    have hr : (l : PX) = l' := by simpa using congrArg SemidirectProduct.right he'
    have hll : l = l' := Subtype.ext hr
    subst hll
    have hlf := congrArg SemidirectProduct.left he'
    refine ⟨l, hl, rfl, ?_⟩
    congr 1
    simpa [mul_left, hLg _ hl] using hlf
  · rintro ⟨l, hl, rfl, rfl⟩
    refine ⟨⟨l, hl, rfl⟩, ⟨_, rfl⟩, ⟨l, hl, ?_⟩⟩
    apply Subtype.ext
    refine SemidirectProduct.ext ?_ ?_ <;> simp [mul_left, hLg _ hl]

/-- **Cyclotomic rigidity** ([EtTh], Cor. 2.19(i)): for any mono-theta environment `M` and any
isomorphism `f : M ≅ modelEnv` carrying the input subgroups of `M` (the preimages of the
subquotients of [EtTh], Cor. 2.18(i)) to those of the model, the algorithmic isomorphism of
cyclotomes of `M` is carried to the natural one `s^alg(l) ↦ η(l)⁻¹` on `l·Δ_Θ`. -/
theorem cyclotomicRigidity_env [Finite μ] (hPY : Envelope.FISlim PY) [PY.Normal]
    (hG : ∀ τ : G, (∀ σ, τ * σ = σ * τ) → τ = 1) (hsurj : ∀ σ : G, ∃ h ∈ PY, aug h = σ)
    (L Kθ : Subgroup PX) (hKL : Kθ ≤ L) (hLdd : L ≤ PYdd) (hLg : ∀ l ∈ L, aug l = 1)
    (hη13 : ∀ k (hk : k ∈ PYdd), k ∈ Kθ → η ⟨k, hk⟩ = 1)
    (hL : Subgroup.closure {c | c ∈ L ∧ ∃ a b, aug a = 1 ∧ b ∈ PY ∧ aug b = 1 ∧ c = ⁅a, b⁆} ⊔
      Kθ = L)
    {M : MonoThetaEnv.{u}} (f : MonoThetaEnv.Iso M (modelEnv aug ψ Kum hle hψ hKum hη))
    {Lsub Ksub Dsub : Subgroup M.G} (hLs : Lsub.map f.hom = rightSub aug ψ PY L)
    (hKs : Ksub.map f.hom = rightSub aug ψ PY Kθ) (hDs : Dsub.map f.hom = geomSub aug ψ PY)
    (t m : M.G) :
    M.IsCyc Lsub Ksub Dsub t m ↔ ∃ l : PYdd, (l : PX) ∈ L ∧
      f.e t = algSection aug ψ hle l ∧ f.e m = inlY aug ψ PY (η l)⁻¹ := by
  rw [← f.isCyc_iff hLs hKs hDs]
  exact isCyc_model aug ψ Kum hle hψ hKum hη hPY hG hsurj L Kθ hKL hLdd hLg hη13 hL _ _

/-- **No `(ℤ/N)^×`-indeterminacy** ([EtTh], Cor. 2.19(i)): an automorphism of the model
environment respecting the input subgroups maps `s^alg(l)` to some `s^alg(l')`, `l' ∈ L`, and
then necessarily `η(l)⁻¹` to `η(l')⁻¹`. -/
theorem cyclotomicRigidity_envAut [Finite μ] (hPY : Envelope.FISlim PY) [PY.Normal]
    (hG : ∀ τ : G, (∀ σ, τ * σ = σ * τ) → τ = 1) (hsurj : ∀ σ : G, ∃ h ∈ PY, aug h = σ)
    (L Kθ : Subgroup PX) (hKL : Kθ ≤ L) (hLdd : L ≤ PYdd) (hLg : ∀ l ∈ L, aug l = 1)
    (hη13 : ∀ k (hk : k ∈ PYdd), k ∈ Kθ → η ⟨k, hk⟩ = 1)
    (hL : Subgroup.closure {c | c ∈ L ∧ ∃ a b, aug a = 1 ∧ b ∈ PY ∧ aug b = 1 ∧ c = ⁅a, b⁆} ⊔
      Kθ = L)
    (f : MonoThetaEnv.Iso (modelEnv aug ψ Kum hle hψ hKum hη)
      (modelEnv aug ψ Kum hle hψ hKum hη))
    (hLs : (rightSub aug ψ PY L).map f.hom = rightSub aug ψ PY L)
    (hKs : (rightSub aug ψ PY Kθ).map f.hom = rightSub aug ψ PY Kθ)
    (hDs : (geomSub aug ψ PY).map f.hom = geomSub aug ψ PY) (l : PYdd) (hl : (l : PX) ∈ L) :
    ∃ l' : PYdd, (l' : PX) ∈ L ∧ f.e (algSection aug ψ hle l) = algSection aug ψ hle l' ∧
      f.e (inlY aug ψ PY (η l)⁻¹) = inlY aug ψ PY (η l')⁻¹ := by
  have h := (isCyc_model aug ψ Kum hle hψ hKum hη hPY hG hsurj L Kθ hKL hLdd hLg hη13 hL
    (algSection aug ψ hle l) (inlY aug ψ PY (η l)⁻¹)).2 ⟨l, hl, rfl, rfl⟩
  exact (cyclotomicRigidity_env aug ψ Kum hle hψ hKum hη hPY hG hsurj L Kθ hKL hLdd hLg hη13 hL
    f hLs hKs hDs _ _).1 h

end Model

