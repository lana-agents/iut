import Iut.EtaleTheta.MonoTheta
import Iut.EtaleTheta.Env.Envelope
import Mathlib.Topology.Algebra.Group.Basic

/-!
# Model mono-theta environments from an abstract theta setting ([EtTh], Def. 2.13)

We fix an **abstract theta setting**, given as explicit data (no structure with `Prop` fields;
every property of the genuine objects is a named hypothesis of the theorems using it):

* a topological group `PX` (in [EtTh]: `Π^tp_X̲`) with an augmentation `aug : PX →* G`
  (`G = G_K`);
* a cyclotome `μ` (`μ_N`) with an action `ψ : G →* MulAut μ` (the cyclotomic character);
* subgroups `PYdd ≤ PY ≤ PX` (`Π^tp_Ÿ̲ ⊆ Π^tp_Y̲ ⊆ Π^tp_X̲`);
* a cocycle `η : PYdd → μ` (a cocycle of the reduction mod `N` of `η̈^Θ̲`);
* a subgroup `Kum` of functions `G → μ` consisting of cocycles (the cocycles representing the
  Kummer classes of `K^×`; for `μ = μ_N` the Kummer map `K^×/(K^×)^N ≅ H¹(G_K, μ_N)` is onto, so
  in the genuine case `Kum` is the group of all continuous cocycles).

From these data we build ([EtTh], discussion before Def. 2.13 and Def. 2.13(i),(ii)):

* the envelopes `EnvX = Π_X[μ] = μ ⋊ PX` and `envY ⊆ EnvX`, `envY ≅ Π_Y[μ]`;
* the **Kummer twists** `twist κ : (m, g) ↦ (κ(aug g)·m, g)` (the outer action of `K^×` through
  the Kummer map; trivial on the quotient `Π[μ] ↠ Π` and on the kernel `μ`), and the subgroup
  `DX ⊆ Aut(Π_X[μ])` of the `twist κ ∘ inn(x)`; its restriction `DY ⊆ Aut(Π_Y[μ])` is the
  preimage of `D_Y̲ ⊆ Out(Π_Y̲[μ_N])`, generated by `K^×` and `Gal(Y̲/X̲)`
  (`DY`, `inner_le_DY`);
* the **theta section** `s^Θ = s^alg − η : PYdd → Π_Y[μ]` and the **algebraic section**
  (`thetaSection`, `algSection`), and the `μ`-conjugacy class of the image of `s^Θ`
  (`thetaSubgroups`), which depends exactly on the cohomology class of `η`
  (`thetaSubgroups_eq_iff`);
* the **model mono-theta environment** `modelEnv` ([EtTh], Def. 2.13(ii)).

Isomorphisms of model environments ([EtTh], discussion before Def. 2.13):
* `modelEnv_eq_of_cohomologous`: cohomologous cocycles give the same environment
  ("conjugation by an element of `μ_N` corresponds precisely to modifying a cocycle by a
  coboundary");
* `kummerIso`: replacing `η` by its product with a Kummer cocycle (an `O_K^×`-multiple of the
  theta function) gives an isomorphic environment, via a Kummer twist ("corresponds to replacing
  `s^Θ` by an `O_K^×`-conjugate of `s^Θ`");
* `conjIso`: for `PYdd` normal in `PX`, the `PX`-conjugate cocycles (the "different choices of a
  cocycle in the orbit", which are `Π_X̲[μ_N]`-conjugates) give isomorphic environments.
-/

namespace Iut.EtaleTheta.Env

open SemidirectProduct

universe u

variable {PX G μ : Type u} [Group PX] [Group G] [CommGroup μ] (aug : PX →* G)
  (ψ : G →* MulAut μ)

/-- The action of `PX` on `μ` through the augmentation. -/
abbrev act : PX →* MulAut μ := ψ.comp aug

/-- `Π_X[μ] = μ ⋊ PX` ([EtTh], Def. 2.10; cf. `Envelope.fibreEquiv`). -/
abbrev EnvX : Type u := μ ⋊[act aug ψ] PX

/-- `Π_Y[μ] ⊆ Π_X[μ]`, the preimage of `PY`. -/
def envY (PY : Subgroup PX) : Subgroup (EnvX aug ψ) := PY.comap rightHom

lemma mem_envY {PY : Subgroup PX} (x : EnvX aug ψ) : x ∈ envY aug ψ PY ↔ x.right ∈ PY := Iff.rfl

instance envY_normal (PY : Subgroup PX) [PY.Normal] : (envY aug ψ PY).Normal :=
  Subgroup.Normal.comap inferInstance _

/-- `μ ⊆ Π_Y[μ]`. -/
def inlY (PY : Subgroup PX) : μ →* envY aug ψ PY :=
  (inl.codRestrict _ fun m => by simp [mem_envY])

@[simp] lemma coe_inlY (PY : Subgroup PX) (m : μ) : (inlY aug ψ PY m : EnvX aug ψ) = inl m := rfl

/-- The tautological section `s^alg : PY → Π_Y[μ]`. -/
def salg (PY : Subgroup PX) : PY →* envY aug ψ PY :=
  ((inr.comp PY.subtype).codRestrict _ fun y => by simp [mem_envY])

@[simp] lemma coe_salg (PY : Subgroup PX) (y : PY) :
    (salg aug ψ PY y : EnvX aug ψ) = inr (y : PX) :=
  rfl

/-! ### Kummer twists -/

section Twist

variable {aug ψ}

/-- The left component of a Kummer twist. -/
def twistFun (κ : G → μ) (x : EnvX aug ψ) : EnvX aug ψ := ⟨κ (aug x.right) * x.left, x.right⟩

/-- **The Kummer twist** by a cocycle `κ : G → μ`: `(m, g) ↦ (κ(aug g)·m, g)` ([EtTh], the
natural outer action `K^× → H¹(G_K, μ_N) → Out(Π[μ_N])`). -/
def twist (κ : G → μ) (hκ : IsCocycle ψ κ) : MulAut (EnvX aug ψ) where
  toFun := twistFun κ
  invFun x := ⟨(κ (aug x.right))⁻¹ * x.left, x.right⟩
  left_inv x := by simp [twistFun]
  right_inv x := by simp [twistFun]
  map_mul' x y := by
    refine SemidirectProduct.ext ?_ rfl
    simp only [twistFun, mul_left, mul_right, map_mul, hκ (aug x.right) (aug y.right),
      MonoidHom.coe_comp, Function.comp_apply]
    rw [mul_comm (κ (aug x.right)) _]
    simp only [mul_assoc, mul_left_comm, mul_comm]

@[simp] lemma twist_left (κ : G → μ) (hκ : IsCocycle ψ κ) (x : EnvX aug ψ) :
    (twist κ hκ x).left = κ (aug x.right) * x.left := rfl

@[simp] lemma twist_right (κ : G → μ) (hκ : IsCocycle ψ κ) (x : EnvX aug ψ) :
    (twist κ hκ x).right = x.right := rfl

lemma twist_apply_eq (κ : G → μ) (hκ : IsCocycle ψ κ) (x : EnvX aug ψ) :
    twist κ hκ x = inl (κ (aug x.right)) * x :=
  SemidirectProduct.ext (by simp [mul_left]) (by simp)

lemma isCocycle_mul {κ κ' : G → μ} (hκ : IsCocycle ψ κ) (hκ' : IsCocycle ψ κ') :
    IsCocycle ψ (κ * κ') := by
  intro σ τ
  simp only [Pi.mul_apply, hκ σ τ, hκ' σ τ, map_mul]
  simp only [mul_assoc, mul_left_comm, mul_comm]

lemma isCocycle_inv' {κ : G → μ} (hκ : IsCocycle ψ κ) : IsCocycle ψ κ⁻¹ := by
  intro σ τ
  simp only [Pi.inv_apply, hκ σ τ, map_inv, mul_inv]

lemma twist_mul {κ κ' : G → μ} (hκ : IsCocycle ψ κ) (hκ' : IsCocycle ψ κ') :
    twist (aug := aug) κ hκ * twist κ' hκ' = twist (κ * κ') (isCocycle_mul hκ hκ') :=
  MulEquiv.ext fun x => SemidirectProduct.ext (by simp [MulAut.mul_apply, mul_assoc]) rfl

lemma twist_one : twist (aug := aug) (ψ := ψ) (fun _ => (1 : μ)) isCocycle_one = 1 :=
  MulEquiv.ext fun x => SemidirectProduct.ext (by simp) rfl

lemma twist_inl (κ : G → μ) (hκ : IsCocycle ψ κ) (m : μ) :
    twist (aug := aug) κ hκ (inl m) = inl m := by
  have h1 : κ 1 = 1 := by
    have := hκ 1 1
    simp only [mul_one, map_one, MulAut.one_apply] at this
    exact left_eq_mul.1 this
  ext <;> simp [h1]

/-- The coboundary `σ ↦ ζ·(σ·ζ)⁻¹`. -/
def cob (ζ : μ) : G → μ := fun σ => ζ * (ψ σ ζ)⁻¹

lemma isCocycle_cob (ζ : μ) : IsCocycle ψ (cob (ψ := ψ) ζ) := by
  intro σ τ
  simp only [cob, map_mul, MulAut.mul_apply, map_inv]
  rw [mul_assoc, inv_mul_cancel_left]

/-- **Twisting by a coboundary is conjugation by an element of `μ`.** -/
lemma twist_cob (ζ : μ) :
    twist (aug := aug) (cob (ψ := ψ) ζ) (isCocycle_cob ζ) = MulAut.conj (inl ζ) := by
  refine MulEquiv.ext fun x => SemidirectProduct.ext ?_ ?_
  · simp only [twist_left, cob, MulAut.conj_apply, mul_left, inv_left, left_inl, right_inl,
      map_one, MulAut.one_apply, mul_right, one_mul, MonoidHom.coe_comp,
      Function.comp_apply, map_inv, inv_one]
    rw [mul_comm ζ, mul_assoc, mul_comm ζ]
    exact mul_comm _ _
  · simp

lemma mul_mul_inv_mul_aux (a b c d : μ) : a * b * d⁻¹ * (b⁻¹ * d * c) = a * c := by
  simp only [mul_assoc]
  rw [mul_left_comm d⁻¹ b⁻¹, mul_inv_cancel_left, inv_mul_cancel_left]

/-- Conjugation by `inr a` moves a twist by a coboundary. -/
lemma conj_inr_mul_twist (κ : G → μ) (hκ : IsCocycle ψ κ) (a : PX) :
    MulAut.conj (inr a : EnvX aug ψ) * twist κ hκ =
      twist κ hκ * twist (cob (κ (aug a))⁻¹) (isCocycle_cob _) * MulAut.conj (inr a) := by
  refine MulEquiv.ext fun z => SemidirectProduct.ext ?_ rfl
  change (inr a * ((⟨κ (aug z.right) * z.left, z.right⟩ : EnvX aug ψ)) * (inr a)⁻¹).left =
    κ (aug (a * z.right * a⁻¹)) * ((κ (aug a))⁻¹ *
      (ψ (aug (a * z.right * a⁻¹)) (κ (aug a))⁻¹)⁻¹ * (inr a * z * (inr a)⁻¹).left)
  -- the cocycle identity `κ(sσs⁻¹) = ψ(s)κ(σ)·κ(s)·(ψ(sσs⁻¹)κ(s))⁻¹`
  have key : κ (aug (a * z.right * a⁻¹)) = ψ (aug a) (κ (aug z.right)) * κ (aug a) *
      (ψ (aug (a * z.right * a⁻¹)) (κ (aug a)))⁻¹ := by
    have h1 := hκ (aug a) (aug z.right)
    have h2 := hκ (aug (a * z.right * a⁻¹)) (aug a)
    rw [← map_mul, inv_mul_cancel_right] at h2
    rw [eq_mul_inv_iff_mul_eq, ← h2, map_mul, h1, mul_comm]
  rw [key]
  simp only [mul_left, inv_left, left_inr, right_inr, map_one, one_mul, inv_one,
    mul_one, map_inv, inv_inv, MonoidHom.coe_comp, Function.comp_apply]
  rw [mul_mul_inv_mul_aux, map_mul]

lemma twist_comm {κ κ' : G → μ} (hκ : IsCocycle ψ κ) (hκ' : IsCocycle ψ κ') :
    twist (aug := aug) κ hκ * twist κ' hκ' = twist κ' hκ' * twist κ hκ := by
  rw [twist_mul, twist_mul]
  congr 1
  exact mul_comm _ _

/-- **Conjugation moves twists by a coboundary**: `inn(x) ∘ twist κ = twist κ ∘ twist(∂ζ) ∘ inn(x)`
for `ζ = κ(aug x)⁻¹` (the inner action of `G_K` on `H¹(G_K, μ_N)` is trivial). -/
lemma conj_mul_twist (κ : G → μ) (hκ : IsCocycle ψ κ) (x : EnvX aug ψ) :
    MulAut.conj x * twist κ hκ =
      twist κ hκ * twist (cob (κ (aug x.right))⁻¹) (isCocycle_cob _) * MulAut.conj x := by
  obtain ⟨ξ, a⟩ := x
  have hx : (⟨ξ, a⟩ : EnvX aug ψ) = inl ξ * inr a := by ext <;> simp
  have e := conj_inr_mul_twist (aug := aug) κ hκ a
  change MulAut.conj (⟨ξ, a⟩ : EnvX aug ψ) * _ =
    twist κ hκ * twist (cob (κ (aug a))⁻¹) (isCocycle_cob _) * MulAut.conj ⟨ξ, a⟩
  rw [hx, map_mul, ← twist_cob, mul_assoc, e]
  simp only [← mul_assoc]
  rw [twist_comm (isCocycle_cob ξ) hκ, mul_assoc (twist κ hκ) (twist (cob ξ) _),
    twist_comm (isCocycle_cob ξ) (isCocycle_cob (κ (aug a))⁻¹), ← mul_assoc]

end Twist

/-! ### The subgroups `D` -/

section D

variable (Kum : Subgroup (G → μ))

/-- The subgroup `D_X ⊆ Aut(Π_X[μ])` of the automorphisms `twist κ ∘ inn(x)`, `κ ∈ Kum`. -/
def DX (hKum : ∀ κ ∈ Kum, IsCocycle ψ κ) : Subgroup (MulAut (EnvX aug ψ)) where
  carrier := {β | ∃ (κ : G → μ) (hκ : κ ∈ Kum) (x : EnvX aug ψ),
    β = twist κ (hKum κ hκ) * MulAut.conj x}
  one_mem' := ⟨fun _ => 1, Kum.one_mem, 1, by rw [map_one, mul_one]; exact twist_one.symm⟩
  mul_mem' := by
    rintro _ _ ⟨κ, hκ, x, rfl⟩ ⟨κ', hκ', x', rfl⟩
    -- inn(x) twist κ' = twist κ' twist(∂ζ) inn(x) = twist κ' inn(inl ζ) inn(x)
    refine ⟨κ * κ', Kum.mul_mem hκ hκ', inl (κ' (aug x.right))⁻¹ * x * x', ?_⟩
    have e := conj_mul_twist (aug := aug) κ' (hKum κ' hκ') x
    rw [twist_cob] at e
    calc twist κ (hKum κ hκ) * MulAut.conj x * (twist κ' (hKum κ' hκ') * MulAut.conj x')
        = twist κ (hKum κ hκ) * (MulAut.conj x * twist κ' (hKum κ' hκ')) * MulAut.conj x' := by
          simp only [mul_assoc]
      _ = twist κ (hKum κ hκ) * twist κ' (hKum κ' hκ') *
            MulAut.conj (inl (κ' (aug x.right))⁻¹ * x * x') := by
          rw [e]; simp only [map_mul, mul_assoc]
      _ = _ := by rw [twist_mul]
  inv_mem' := by
    rintro _ ⟨κ, hκ, x, rfl⟩
    refine ⟨κ⁻¹, Kum.inv_mem hκ, inl (κ⁻¹ (aug x⁻¹.right))⁻¹ * x⁻¹, ?_⟩
    have hinv : (twist κ (hKum κ hκ))⁻¹ = twist (aug := aug) κ⁻¹ (hKum _ (Kum.inv_mem hκ)) := by
      rw [inv_eq_iff_mul_eq_one, twist_mul]
      convert twist_one (aug := aug) (ψ := ψ) using 2
      funext σ
      simp
    have e := conj_mul_twist (aug := aug) κ⁻¹ (hKum _ (Kum.inv_mem hκ)) x⁻¹
    rw [twist_cob] at e
    rw [mul_inv_rev, hinv, ← map_inv, e, map_mul, mul_assoc]

lemma mem_DX {hKum : ∀ κ ∈ Kum, IsCocycle ψ κ} (β : MulAut (EnvX aug ψ)) :
    β ∈ DX aug ψ Kum hKum ↔ ∃ (κ : G → μ) (hκ : κ ∈ Kum) (x : EnvX aug ψ),
      β = twist κ (hKum κ hκ) * MulAut.conj x := Iff.rfl

lemma conj_mem_DX (hKum : ∀ κ ∈ Kum, IsCocycle ψ κ) (x : EnvX aug ψ) :
    MulAut.conj x ∈ DX aug ψ Kum hKum :=
  ⟨fun _ => 1, Kum.one_mem, x, by rw [twist_one, one_mul]⟩

lemma twist_mem_DX (hKum : ∀ κ ∈ Kum, IsCocycle ψ κ) {κ : G → μ} (hκ : κ ∈ Kum) :
    twist κ (hKum κ hκ) ∈ DX aug ψ Kum hKum :=
  ⟨κ, hκ, 1, by rw [map_one, mul_one]⟩

/-- The restriction of `DX` to `Π_Y[μ]`: the automorphisms of `Π_Y[μ]` induced by an element of
`DX`. This is the preimage in `Aut(Π_Y̲[μ_N])` of `D_Y̲ ⊆ Out(Π_Y̲[μ_N])` ([EtTh], Def. 2.13(i)),
the subgroup generated by the image of `K^×` and `Gal(Y̲/X̲) = Π_X̲/Π_Y̲` (conjugation by `PX`). -/
def DY (PY : Subgroup PX) (hKum : ∀ κ ∈ Kum, IsCocycle ψ κ) :
    Subgroup (MulAut (envY aug ψ PY)) where
  carrier := {α | ∃ β ∈ DX aug ψ Kum hKum, ∀ z : envY aug ψ PY,
    (α z : EnvX aug ψ) = β (z : EnvX aug ψ)}
  one_mem' := ⟨1, Subgroup.one_mem _, fun _ => rfl⟩
  mul_mem' := by
    rintro α α' ⟨β, hβ, h⟩ ⟨β', hβ', h'⟩
    exact ⟨β * β', Subgroup.mul_mem _ hβ hβ', fun z => by
      rw [MulAut.mul_apply, h, h', MulAut.mul_apply]⟩
  inv_mem' := by
    rintro α ⟨β, hβ, h⟩
    refine ⟨β⁻¹, Subgroup.inv_mem _ hβ, fun z => ?_⟩
    rw [eq_comm, MulAut.inv_apply, MulEquiv.symm_apply_eq, ← h, MulAut.inv_apply,
      MulEquiv.apply_symm_apply]

lemma mem_DY {PY : Subgroup PX} {hKum : ∀ κ ∈ Kum, IsCocycle ψ κ}
    (α : MulAut (envY aug ψ PY)) :
    α ∈ DY aug ψ Kum PY hKum ↔
      ∃ β ∈ DX aug ψ Kum hKum, ∀ z : envY aug ψ PY, (α z : EnvX aug ψ) = β (z : EnvX aug ψ) :=
  Iff.rfl

/-- `DY` contains the inner automorphisms of `Π_Y[μ]`. -/
theorem inner_le_DY (PY : Subgroup PX) (hKum : ∀ κ ∈ Kum, IsCocycle ψ κ) :
    (MulAut.conj : envY aug ψ PY →* MulAut (envY aug ψ PY)).range ≤ DY aug ψ Kum PY hKum := by
  rintro _ ⟨y, rfl⟩
  exact ⟨MulAut.conj (y : EnvX aug ψ), conj_mem_DX aug ψ Kum hKum _, fun z => rfl⟩

/-- The automorphism of `Π_Y[μ]` induced by an automorphism of `Π_X[μ]` preserving it. -/
def restrictAut (PY : Subgroup PX) (β : MulAut (EnvX aug ψ))
    (hβ : ∀ x, β x ∈ envY aug ψ PY ↔ x ∈ envY aug ψ PY) : MulAut (envY aug ψ PY) where
  toFun z := ⟨β z, (hβ z).2 z.2⟩
  invFun z := ⟨β⁻¹ z, by
    rw [← hβ, MulAut.inv_apply, MulEquiv.apply_symm_apply]; exact z.2⟩
  left_inv z := Subtype.ext (by simp [MulAut.inv_apply])
  right_inv z := Subtype.ext (by simp [MulAut.inv_apply])
  map_mul' z z' := Subtype.ext (map_mul β (z : EnvX aug ψ) z')

@[simp] lemma coe_restrictAut (PY : Subgroup PX) (β : MulAut (EnvX aug ψ)) (hβ)
    (z : envY aug ψ PY) : (restrictAut aug ψ PY β hβ z : EnvX aug ψ) = β z := rfl

lemma restrictAut_mem_DY (PY : Subgroup PX) (hKum : ∀ κ ∈ Kum, IsCocycle ψ κ)
    (β : MulAut (EnvX aug ψ)) (hβ) (hβD : β ∈ DX aug ψ Kum hKum) :
    restrictAut aug ψ PY β hβ ∈ DY aug ψ Kum PY hKum :=
  ⟨β, hβD, fun _ => rfl⟩

lemma twist_mem_envY_iff (PY : Subgroup PX) (κ : G → μ) (hκ : IsCocycle ψ κ) (x : EnvX aug ψ) :
    twist κ hκ x ∈ envY aug ψ PY ↔ x ∈ envY aug ψ PY := Iff.rfl

lemma conj_mem_envY_iff (PY : Subgroup PX) [PY.Normal] (g x : EnvX aug ψ) :
    MulAut.conj g x ∈ envY aug ψ PY ↔ x ∈ envY aug ψ PY := by
  rw [MulAut.conj_apply]
  constructor
  · intro h
    have := (envY_normal aug ψ PY).conj_mem _ h g⁻¹
    simpa [mul_assoc] using this
  · intro h
    exact (envY_normal aug ψ PY).conj_mem _ h g

end D

/-! ### Theta and algebraic sections -/

section Sections

variable {PY PYdd : Subgroup PX} (hle : PYdd ≤ PY)

/-- The action of `PYdd` on `μ`. -/
abbrev actDD (PYdd : Subgroup PX) : PYdd →* MulAut μ := (act aug ψ).comp PYdd.subtype

/-- `PYdd[μ] ↪ PY[μ]`. -/
def inclDD : μ ⋊[actDD aug ψ PYdd] PYdd →* envY aug ψ PY where
  toFun x := ⟨⟨x.left, x.right⟩, hle x.right.2⟩
  map_one' := rfl
  map_mul' _ _ := rfl

@[simp] lemma coe_inclDD (x : μ ⋊[actDD aug ψ PYdd] PYdd) :
    (inclDD aug ψ hle x : EnvX aug ψ) = ⟨x.left, x.right⟩ := rfl

lemma inclDD_injective : Function.Injective (inclDD aug ψ hle) := by
  intro x y h
  have h' := congrArg (fun z : envY aug ψ PY => (z : EnvX aug ψ)) h
  simp only [coe_inclDD] at h'
  have h1 : x.left = y.left := by simpa using congrArg (fun w : EnvX aug ψ => w.left) h'
  have h2 : (x.right : PX) = y.right := by
    simpa using congrArg (fun w : EnvX aug ψ => w.right) h'
  exact SemidirectProduct.ext h1 (Subtype.ext h2)

/-- The theta cocycle `s^Θ - s^alg = -η` (written multiplicatively). -/
def thetaCocycle (η : PYdd → μ) : PYdd → μ := fun g => (η g)⁻¹

variable {aug ψ}

lemma isCocycle_thetaCocycle {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η) :
    IsCocycle (actDD aug ψ PYdd) (thetaCocycle η) := by
  intro g h
  simp only [thetaCocycle, hη g h, mul_inv, map_inv]

variable (aug ψ)

/-- **The theta section** `s^Θ = s^alg − η : PYdd → Π_Y[μ]` ([EtTh], discussion before
Def. 2.13 and Def. 2.13(i)). -/
def thetaSection {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η) :
    PYdd →* envY aug ψ PY :=
  (inclDD aug ψ hle).comp (sectionOf (thetaCocycle η) (isCocycle_thetaCocycle hη))

@[simp] lemma coe_thetaSection {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η) (g : PYdd) :
    (thetaSection aug ψ hle hη g : EnvX aug ψ) = ⟨(η g)⁻¹, g⟩ := rfl

/-- **The algebraic section** `s^alg : PYdd → Π_Y[μ]` ([EtTh], Def. 2.13(i)). -/
def algSection : PYdd →* envY aug ψ PY := (inclDD aug ψ hle).comp inr

@[simp] lemma coe_algSection (g : PYdd) : (algSection aug ψ hle g : EnvX aug ψ) = inr (g : PX) :=
  rfl

/-- **The theta section minus the algebraic section is `η⁻¹`** (the cocycle `-η`):
`s^Θ(g)·s^alg(g)⁻¹ = (η(g))⁻¹ ∈ μ`. -/
theorem thetaSection_mul_algSection_inv {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η)
    (g : PYdd) :
    thetaSection aug ψ hle hη g * (algSection aug ψ hle g)⁻¹ = inlY aug ψ PY (η g)⁻¹ := by
  apply Subtype.ext
  refine SemidirectProduct.ext ?_ ?_
  · simp [thetaSection, algSection, inclDD, thetaCocycle, inv_left]
  · simp [thetaSection, algSection, inclDD]

/-- Datum (c) of [EtTh], Def. 2.13(ii): the `μ`-conjugacy class of the image of the theta
section, as subgroups of `Π_Y[μ]`. -/
def thetaSubgroups {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η) :
    Set (Subgroup (envY aug ψ PY)) :=
  Subgroup.map (inclDD aug ψ hle) ''
    thetaClassSubgroups (thetaCocycle η) (isCocycle_thetaCocycle hη)

/-- Datum (d) of [EtTh], Def. 2.13(iii): the `μ`-conjugacy class of the image of the algebraic
section. -/
def algSubgroups : Set (Subgroup (envY aug ψ PY)) :=
  Subgroup.map (inclDD aug ψ hle) '' thetaClassSubgroups (fun _ => (1 : μ)) isCocycle_one

lemma thetaCocycle_cohomologous_iff {η η' : PYdd → μ} :
    Cohomologous (actDD aug ψ PYdd) (thetaCocycle η) (thetaCocycle η') ↔
      Cohomologous (actDD aug ψ PYdd) η η' := by
  constructor
  · rintro ⟨ζ, h⟩
    refine ⟨ζ⁻¹, fun g => ?_⟩
    have := congrArg (·⁻¹) (h g)
    simp only [thetaCocycle, inv_inv, mul_inv] at this
    rw [this, map_inv, inv_inv]
  · rintro ⟨ζ, h⟩
    refine ⟨ζ⁻¹, fun g => ?_⟩
    simp only [thetaCocycle, h g, mul_inv, map_inv, inv_inv]

/-- **Datum (c) is the cohomology class of `η`**: the `μ`-conjugacy classes of the images of
the theta sections of `η`, `η'` agree iff `η` and `η'` are cohomologous. -/
theorem thetaSubgroups_eq_iff {η η' : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η)
    (hη' : IsCocycle (actDD aug ψ PYdd) η') :
    thetaSubgroups aug ψ hle hη = thetaSubgroups aug ψ hle hη' ↔
      Cohomologous (actDD aug ψ PYdd) η η' := by
  rw [thetaSubgroups, thetaSubgroups,
    (Set.image_injective.2 (Subgroup.map_injective (inclDD_injective aug ψ hle))).eq_iff,
    thetaClassSubgroups_eq_iff, thetaCocycle_cohomologous_iff]

/-- The members of datum (c) are the `μ`-conjugates of the image of the theta section. -/
theorem mem_thetaSubgroups_iff {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η)
    (H : Subgroup (envY aug ψ PY)) :
    H ∈ thetaSubgroups aug ψ hle hη ↔ ∃ ζ : μ,
      H = (thetaSection aug ψ hle hη).range.map (MulAut.conj (inlY aug ψ PY ζ)).toMonoidHom := by
  constructor
  · rintro ⟨_, ⟨ζ, rfl⟩, rfl⟩
    refine ⟨ζ, ?_⟩
    rw [conjRange, thetaSection, MonoidHom.range_comp, Subgroup.map_map, Subgroup.map_map]
    congr 1
  · rintro ⟨ζ, rfl⟩
    refine ⟨conjRange _ (isCocycle_thetaCocycle hη) ζ, ⟨ζ, rfl⟩, ?_⟩
    rw [conjRange, thetaSection, MonoidHom.range_comp, Subgroup.map_map, Subgroup.map_map]
    congr 1

/-- `conjAut α` is conjugation by `α` in `MulAut`. -/
lemma conjAut_eq {H : Type*} [Group H] (α : H ≃* H) (β : MulAut H) :
    MonoThetaEnv.conjAut α β = α * β * α⁻¹ := by
  ext; rfl

/-- An automorphism in a subgroup `D` of `MulAut` maps `D` onto itself by conjugation. -/
lemma map_conjAut_of_mem {H : Type*} [Group H] {D : Subgroup (MulAut H)} {α : H ≃* H}
    (hα : α ∈ D) : D.map (MonoThetaEnv.conjAut α) = D := by
  ext β
  simp only [Subgroup.mem_map, conjAut_eq]
  constructor
  · rintro ⟨γ, hγ, rfl⟩
    exact D.mul_mem (D.mul_mem hα hγ) (D.inv_mem hα)
  · intro hβ
    refine ⟨α⁻¹ * β * α, D.mul_mem (D.mul_mem (D.inv_mem hα) hβ) hα, ?_⟩
    simp [mul_assoc]

/-- An automorphism permuting `μ` and mapping the image of one theta section onto the image of
another maps datum (c) onto datum (c). -/
theorem image_thetaSubgroups {η η' : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η)
    (hη' : IsCocycle (actDD aug ψ PYdd) η') (α : envY aug ψ PY ≃* envY aug ψ PY)
    (f : μ ≃ μ) (hf : ∀ ζ, α (inlY aug ψ PY ζ) = inlY aug ψ PY (f ζ))
    (hrange : (thetaSection aug ψ hle hη).range.map α.toMonoidHom =
      (thetaSection aug ψ hle hη').range) :
    Subgroup.map α.toMonoidHom '' thetaSubgroups aug ψ hle hη = thetaSubgroups aug ψ hle hη' := by
  have key : ∀ ζ, ((thetaSection aug ψ hle hη).range.map
      (MulAut.conj (inlY aug ψ PY ζ)).toMonoidHom).map α.toMonoidHom =
      (thetaSection aug ψ hle hη').range.map (MulAut.conj (inlY aug ψ PY (f ζ))).toMonoidHom := by
    intro ζ
    rw [← hrange, Subgroup.map_map, Subgroup.map_map]
    congr 1
    refine MonoidHom.ext fun z => ?_
    simp [MulAut.conj_apply, hf]
  ext H
  simp only [Set.mem_image, mem_thetaSubgroups_iff]
  constructor
  · rintro ⟨_, ⟨ζ, rfl⟩, rfl⟩
    exact ⟨f ζ, key ζ⟩
  · rintro ⟨ζ', rfl⟩
    refine ⟨_, ⟨f.symm ζ', rfl⟩, ?_⟩
    rw [key, Equiv.apply_symm_apply]

variable {aug ψ} in
lemma isCocycle_mul_kummer {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η) {κ : G → μ}
    (hκ : IsCocycle ψ κ) :
    IsCocycle (actDD aug ψ PYdd) (fun g => η g * κ (aug g)) := by
  intro g h
  simp only [Subgroup.coe_mul, map_mul, hη g h, hκ (aug g) (aug h)]
  simp only [MonoidHom.coe_comp, Function.comp_apply, Subgroup.coe_subtype]
  simp only [mul_assoc, mul_left_comm, mul_comm]

end Sections

/-! ### The model mono-theta environment -/

section ModelEnv

variable [TopologicalSpace PX] [IsTopologicalGroup PX] [TopologicalSpace μ] [DiscreteTopology μ]

open scoped Envelope

/-- `Π_X[μ]` is a topological group (product topology) if the action of `PX` on `μ` has open
kernel. -/
theorem isTopologicalGroup_envX (hψ : IsOpen ((act aug ψ).ker : Set PX)) :
    IsTopologicalGroup (EnvX aug ψ) :=
  Envelope.isTopologicalGroup hψ

variable (Kum : Subgroup (G → μ)) {PY PYdd : Subgroup PX} (hle : PYdd ≤ PY)

/-- **The model mono-theta environment** ([EtTh], Def. 2.13(ii)) of the theta setting: the
topological group `Π_Y[μ]`, the preimage `DY` of `D_Y ⊆ Out(Π_Y[μ])`, and the `μ`-conjugacy
class of the image of the theta section. -/
def modelEnv (hψ : IsOpen ((act aug ψ).ker : Set PX)) (hKum : ∀ κ ∈ Kum, IsCocycle ψ κ)
    {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η) : MonoThetaEnv.{u} where
  G := envY aug ψ PY
  group := inferInstance
  top := inferInstance
  topGroup := by
    haveI := isTopologicalGroup_envX aug ψ hψ
    exact Topology.IsInducing.topologicalGroup (envY aug ψ PY).subtype
      Topology.IsInducing.subtypeVal
  D := DY aug ψ Kum PY hKum
  inner_le := inner_le_DY aug ψ Kum PY hKum
  thetaSubgroups := thetaSubgroups aug ψ hle hη

variable (hψ : IsOpen ((act aug ψ).ker : Set PX)) (hKum : ∀ κ ∈ Kum, IsCocycle ψ κ)

@[simp] lemma modelEnv_G {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η) :
    (modelEnv aug ψ Kum hle hψ hKum hη).G = envY aug ψ PY := rfl

/-- **Cohomologous cocycles give the same model environment** ([EtTh], discussion before
Def. 2.13: conjugation by `μ_N` is modification by a coboundary). -/
theorem modelEnv_eq_of_cohomologous {η η' : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η)
    (hη' : IsCocycle (actDD aug ψ PYdd) η') (h : Cohomologous (actDD aug ψ PYdd) η η') :
    modelEnv aug ψ Kum hle hψ hKum hη = modelEnv aug ψ Kum hle hψ hKum hη' := by
  simp only [modelEnv, (thetaSubgroups_eq_iff aug ψ hle hη hη').2 h]

/-- **An automorphism in `DY` mapping datum (c) onto datum (c) is an isomorphism of model
environments.** -/
def isoOfMemDY {η η' : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η)
    (hη' : IsCocycle (actDD aug ψ PYdd) η')
    (α : envY aug ψ PY ≃ₜ* envY aug ψ PY) (hα : α.toMulEquiv ∈ DY aug ψ Kum PY hKum)
    (hθ : Subgroup.map α.toMulEquiv.toMonoidHom '' thetaSubgroups aug ψ hle hη =
      thetaSubgroups aug ψ hle hη') :
    MonoThetaEnv.Iso (modelEnv aug ψ Kum hle hψ hKum hη) (modelEnv aug ψ Kum hle hψ hKum hη') where
  e := α
  map_D := map_conjAut_of_mem hα
  map_theta := hθ

/-! #### Kummer twists: `O_K^×`-multiples of the theta class -/

variable (hKc : ∀ κ ∈ Kum, Continuous fun g : PX => κ (aug g))

omit [IsTopologicalGroup PX] in
include hKc in
lemma continuous_twist {κ : G → μ} (hκ : κ ∈ Kum) (hκc : IsCocycle ψ κ) :
    Continuous (twist (aug := aug) κ hκc) := by
  refine Envelope.continuous_mk ?_ Envelope.continuous_right
  exact (continuous_of_discreteTopology (f := fun q : μ × μ => q.1 * q.2)).comp
    (((hKc κ hκ).comp Envelope.continuous_right).prodMk Envelope.continuous_left)

/-- The Kummer twist restricted to `Π_Y[μ]`, as an automorphism of topological groups. -/
def twistY {κ : G → μ} (hκ : κ ∈ Kum) : envY aug ψ PY ≃ₜ* envY aug ψ PY where
  toMulEquiv := restrictAut aug ψ PY (twist κ (hKum κ hκ)) (twist_mem_envY_iff aug ψ PY _ _)
  continuous_toFun := ((continuous_twist aug ψ Kum hKc hκ _).comp
    continuous_subtype_val).subtype_mk _
  continuous_invFun := by
    have hinv : ∀ z : envY aug ψ PY, (((restrictAut aug ψ PY (twist κ (hKum κ hκ))
        (twist_mem_envY_iff aug ψ PY _ _)).symm z : envY aug ψ PY) : EnvX aug ψ) =
        twist κ⁻¹ (hKum _ (Kum.inv_mem hκ)) z := by
      intro z
      rfl
    refine Continuous.subtype_mk ?_ _
    have := (continuous_twist aug ψ Kum hKc (Kum.inv_mem hκ) (hKum _ (Kum.inv_mem hκ))).comp
      continuous_subtype_val (f := fun z : envY aug ψ PY => (z : EnvX aug ψ))
    convert this using 1
    funext z
    exact hinv z

omit [IsTopologicalGroup PX] in
lemma twistY_mem_DY {κ : G → μ} (hκ : κ ∈ Kum) :
    (twistY aug ψ Kum hKum hKc (PY := PY) hκ).toMulEquiv ∈ DY aug ψ Kum PY hKum :=
  restrictAut_mem_DY aug ψ Kum PY hKum _ (twist_mem_envY_iff aug ψ PY _ _)
    (twist_mem_DX aug ψ Kum hKum hκ)

/-- **Kummer twists: `O_K^×`-multiples of the theta class give isomorphic environments**
([EtTh], discussion before Def. 2.13): if `η' = η·(κ∘aug)` for a Kummer cocycle `κ ∈ Kum`, the
Kummer twist by `κ⁻¹` is an isomorphism of model mono-theta environments
`modelEnv η ≅ modelEnv η'`. -/
def kummerIso {η : PYdd → μ} (hη : IsCocycle (actDD aug ψ PYdd) η) {κ : G → μ} (hκ : κ ∈ Kum) :
    MonoThetaEnv.Iso (modelEnv aug ψ Kum hle hψ hKum hη)
      (modelEnv aug ψ Kum hle hψ hKum (isCocycle_mul_kummer hη (hKum κ hκ))) :=
  isoOfMemDY aug ψ Kum hle hψ hKum hη _ (twistY aug ψ Kum hKum hKc (Kum.inv_mem hκ))
    (twistY_mem_DY aug ψ Kum hKum hKc _) (image_thetaSubgroups aug ψ hle hη _ _ (Equiv.refl μ)
      (fun ζ => Subtype.ext (twist_inl _ _ ζ)) (by
        ext z
        simp only [Subgroup.mem_map, MonoidHom.mem_range]
        constructor
        · rintro ⟨_, ⟨g, rfl⟩, rfl⟩
          refine ⟨g, Subtype.ext (SemidirectProduct.ext ?_ rfl)⟩
          change (η g * κ (aug g))⁻¹ = κ⁻¹ (aug g) * (η g)⁻¹
          rw [Pi.inv_apply, mul_inv, mul_comm]
        · rintro ⟨g, rfl⟩
          refine ⟨_, ⟨g, rfl⟩, Subtype.ext (SemidirectProduct.ext ?_ rfl)⟩
          change κ⁻¹ (aug g) * (η g)⁻¹ = (η g * κ (aug g))⁻¹
          rw [Pi.inv_apply, mul_inv, mul_comm]))

end ModelEnv

end Iut.EtaleTheta.Env
