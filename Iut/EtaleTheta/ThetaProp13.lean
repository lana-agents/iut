import Iut.EtaleTheta.ThetaTemperedCusp
import Iut.EtaleTheta.ThetaDelta
import Iut.EtaleTheta.KummerConj

/-!
# [EtTh] Prop. 1.3 on `Δ_Θ`: the theta class restricted to `Δ_Θ` is the identity (MR14, run 13)

[EtTh] Prop. 1.3 (ET l.1137–1270): the étale theta class `η^Θ` arises from `(Π^tp_Y)^Θ`, and its
restriction to `Δ_Θ` is the natural isomorphism `Δ_Θ ≅ Ẑ(1)` (mod `N`: `Δ_Θ ⊗ ℤ/N ≅ μ_N`).
Through `I_x ≅ Δ_Θ` (ET l.2272–2274; the cusp inertia `I_x ⊆ D_x ⊆ Π_X` maps isomorphically
onto `Δ_Θ ⊆ Δ_X^Θ`) the restriction to `Δ_Θ` is the restriction to the cusp inertia, which
`ThetaTemperedCusp.lean` computes (the zeroes of `Θ̈` are the cusps, of multiplicity `1`).

* `ambientKernel_le_level`: for an étale level `L' ⊇ L_X`, the closed normal subgroup
  `⟨⟨S_X⟩⟩` generated by the inertia at the places centred on `X` lies in `Gal(Ω/L')`
  (`pi1`'s criterion `etale_iff_inertia`).
* **`inertia_fixes_level`**: under C1, every inertia element `σ ∈ I_W` fixing `L 0` (i.e. lying
  in `Π^tp_Ÿ`) fixes every level `L j` (its image in `Π^tp_Ÿ ≤ Π^tp_{Ÿ'_{N_j}}` comes from the
  level, and `⟨⟨S_X⟩⟩ ⊆ Gal(Ω/L j)`): the cusps of `Ÿ` are unramified in all levels.
* `InertiaFixesLevel`: the hypothesis that `I_W ∩ H_X` fixes `L 0` (`Ÿ'_2 → X`, i.e. the
  isogeny `[2]`, is unramified over the cusp) — **a debt** (`MR14-plan.md`, run 13; owner MR14).
* **`classAt_deltaTheta`** (generic [EtTh] Prop. 1.3 on `Δ_Θ`): given the debt
  `WeilTameAt` (G5c + G5d, `ThetaDelta.lean`) at `W`, C1, `InertiaFixesLevel (L 0)` and
  `ClassAtCusp` at the level `j`, for every `σ ∈ I_W ∩ H_X` the class `classAt η j n` at the
  image of `σ` in `Π^tp_Ÿ` is the `n`-th component of `e(σ̄)`, `σ̄ ∈ Δ_Θ` the image of `σ`.
* `classAt_cusp_surjective`: the class maps the cusp inertia of `Ÿ` onto `μ_n`.
* Concrete: **`exists_thetaClassTemp_deltaTheta`** — for the system of `exists_thetaClassTemp`,
  under `CuspInertiaWeil` for `X = E_q ∖ {O}`: there is `e : Δ_Θ ≃* Ẑ(1)` (the natural
  isomorphism of the debt) such that at every cusp place `W`, the cusp inertia maps onto `Δ_Θ`,
  and, for every base point `V ≤ W`, under C1 and `InertiaFixesLevel (L 0)`, **the theta class
  `thetaClassTemp η n` restricted to the cusp inertia `I_x ≅ Δ_Θ` is `proj_n ∘ e`** for every `n`.

The other half of Prop. 1.3 (the class comes from `(Π^tp_Y)^Θ`, i.e. vanishes on
`Ker(Π^tp_Ÿ ↠ (Π^tp_Ÿ)^Θ)`; MR15's `hη13`) is not proved here.
-/

open CategoryTheory AlgebraicGeometry Polynomial Belyi Belyi.P1 Belyi.Anabelian Pi1.Orbifold
open AffOrbicurve IsLocalRing KummerTheory KummerTheory.Curve CurvesJacobian.Kummer
open CurvesJacobian.Cusp TateCurvesTheta TateParameter WeierstrassCurve.Affine
open TemperedFundamentalGroups TemperedFundamentalGroups.Kummer

noncomputable section

universe u

namespace Iut.EtaleTheta

section Levels

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} (ht : Transcendental k t)
  [IsGalois (K₀ k t) Ω] [CharZero k]
  {LX : IntermediateField (K₀ k t) Ω} (hLX : IsOpen (LX.fixingSubgroup : Set (Ω ≃ₐ[K₀ k t] Ω)))

/-- **`⟨⟨S_X⟩⟩ ⊆ Gal(Ω/L')` for an étale level `L' ⊇ L_X`**: the inertia elements at the places
centred on `X` fix `L'` (`etale_iff_inertia`), hence so do their conjugates and the closed
subgroup they generate. -/
theorem ambientKernel_le_level (L' : IntermediateField (K₀ k t) Ω)
    (hL' : IsOpen (L'.fixingSubgroup : Set (Ω ≃ₐ[K₀ k t] Ω))) (hle : LX ≤ L')
    (het : letI := levelAlgebra ht hLX hL' hle
      Algebra.Etale (fieldData ht LX hLX).R (fieldData ht L' hL').R) :
    GaloisPi1.ambientKernel (fieldData ht LX hLX).H (fieldData ht LX hLX).S ≤
      (fieldData ht L' hL').H := by
  have hin := (etale_iff_inertia ht (fieldData_L_le ht hLX hL' hle)).1 het
  have hS : ∀ s ∈ (fieldData ht LX hLX).S, s ∈ (fieldData ht L' hL').H := by
    rintro s ⟨hsHL, W, hk, htW, hsW⟩
    have h := hin W ⟨hk, htW⟩
      ⟨hsW, by rw [GaloisData.fixingSubgroup_L]; exact hsHL⟩
    rwa [GaloisData.fixingSubgroup_L] at h
  refine Subgroup.topologicalClosure_minimal _ ?_ (Subgroup.isClosed_of_isOpen _ hL')
  rw [Subgroup.closure_le]
  rintro _ ⟨h, hh, s, hs, rfl⟩
  have hc := conj_mem_S (D := fieldData ht LX hLX) (σ := h⁻¹)
    (fun g hg => by rw [inv_inv]; exact mul_mem (mul_mem hh hg) (inv_mem hh)) hs
  simpa using hS _ hc

end Levels

section Prop13

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} {ht : Transcendental k t}
  [IsGalois (K₀ k t) Ω] [CharZero k] [IsAlgClosed Ω]
  {LX : IntermediateField (K₀ k t) Ω} {hLX : IsOpen (LX.fixingSubgroup : Set (Ω ≃ₐ[K₀ k t] Ω))}
  {O : ValuationSubring k} {V W : ValuationSubring Ω} {hV : V.comap (algebraMap k Ω) = O}
  {T : TemperedFundamentalGroups.TateObject.Data O (fieldData ht LX hLX).R}
  {L : ℕ → IntermediateField (K₀ k t) Ω}
  {hL : ∀ j, IsOpen ((L j).fixingSubgroup : Set (Ω ≃ₐ[K₀ k t] Ω))}
  [hX : ∀ j, Fact (LX ≤ L j)]
  [het : ∀ j, Algebra.Etale (fieldData ht LX hLX).R (fieldData ht (L j) (hL j)).R]

omit [IsAlgClosed Ω] in
/-- **Under C1 the cusp inertia of `Ÿ` fixes every level**: an inertia element `σ ∈ I_W` (over
`X`) fixing `L 0` fixes `L j`. Its image in `Π^tp_Ÿ ≤ Π^tp_{Ÿ'_{N_j}}` is the image of some
`γ ∈ Π^tp_{Ÿ'_{N_j}}`; in `Π_X = H_X/⟨⟨S_X⟩⟩` this says `σ ∈ H_j · ⟨⟨S_X⟩⟩ = H_j`. -/
theorem inertia_fixes_level (hC1 : LevelsDominated V hV T hL) (j : ℕ) (hVW : V ≤ W)
    (σ : inertiaGroup (fieldData ht LX hLX).R W)
    (hσ0 : ∀ x ∈ L 0, (σ : Ω ≃ₐ[(fieldData ht LX hLX).R] Ω) x = x) :
    ∀ x ∈ L j, (σ : Ω ≃ₐ[(fieldData ht LX hLX).R] Ω) x = x := by
  obtain ⟨γ, hγ⟩ := hC1 j (inertiaToTempered_mem_piYddotX V hV T hL hVW σ hσ0)
  have e1 := congrArg (tempToPi (fieldData ht LX hLX) O V hV) hγ
  rw [tempToPi_temperedPi1Map ht hLX (hL j) (hX j).out O V hV,
    tempToPi_inertiaToTempered] at e1
  obtain ⟨h, hh⟩ := QuotientGroup.mk_surjective (tempToPi (fieldData ht (L j) (hL j)) O V hV γ)
  rw [← hh] at e1
  have e2 : ((Subgroup.inclusion (fieldData_H_antitone ht hLX (hL j) (hX j).out) h :
      (fieldData ht LX hLX).H) : Pi (fieldData ht LX hLX)) =
        ((galoisToH (σ : Ω ≃ₐ[(fieldData ht LX hLX).R] Ω) : (fieldData ht LX hLX).H) :
          Pi (fieldData ht LX hLX)) := e1
  rw [QuotientGroup.eq] at e2
  have hker := ambientKernel_le_level ht hLX (L j) (hL j) (hX j).out (het j) e2
  have hmem : ((galoisToH (σ : Ω ≃ₐ[(fieldData ht LX hLX).R] Ω) : (fieldData ht LX hLX).H) :
      Ω ≃ₐ[K₀ k t] Ω) ∈ (fieldData ht (L j) (hL j)).H := by
    have := mul_mem h.2 hker
    simpa using this
  intro x hx
  exact (IntermediateField.mem_fixingSubgroup_iff _ _).1 hmem x hx

variable (ht hLX) in
/-- `I_W ∩ H_X` fixes the level `L'` (for `L' = L 0`: `Ÿ'_2 → X` is unramified over the cusp
below `W`). **Debt** (`MR14-plan.md`, run 13; owner MR14): for the theta system, `L 0` lies in
the field of the `[2]`-covering `E → E`, which is étale; this is not proved in Lean yet. A `Prop`
definition used only as a named theorem hypothesis. -/
def InertiaFixesLevel (L' : IntermediateField (K₀ k t) Ω) (W : ValuationSubring Ω) : Prop :=
  ∀ σ : inertiaGroup (fieldData ht LX hLX).R W, ∀ x ∈ L',
    (σ : Ω ≃ₐ[(fieldData ht LX hLX).R] Ω) x = x

/-- An inertia element over `X` as an element of `I_W ∩ H_X`. -/
def inertiaX (σ : inertiaGroup (fieldData ht LX hLX).R W) :
    inertiaH (fieldData ht LX hLX) W :=
  ⟨galoisToH (σ : Ω ≃ₐ[(fieldData ht LX hLX).R] Ω), (mem_inertiaGroup.1 σ.2).1⟩

omit [CharZero k] [IsAlgClosed Ω] in
/-- An element of `I_W ∩ H_X` as an inertia element over `X`. -/
theorem exists_inertiaX (τ : inertiaH (fieldData ht LX hLX) W) :
    ∃ σ : inertiaGroup (fieldData ht LX hLX).R W,
      ∀ x : Ω, (σ : Ω ≃ₐ[(fieldData ht LX hLX).R] Ω) x =
        ((τ : (fieldData ht LX hLX).H) : Ω ≃ₐ[K₀ k t] Ω) x := by
  refine ⟨⟨ofHL ((τ : (fieldData ht LX hLX).H) : Ω ≃ₐ[K₀ k t] Ω) τ.1.2, ?_⟩, fun _ => rfl⟩
  exact mem_inertiaGroup.2 ⟨fun a ha => τ.2 a ha, fun a ha => (mem_inertiaH.1 (inv_mem τ.2)) a ha⟩

variable (η : ∀ j, units (fieldData ht (L j) (hL j)))

/-- **[EtTh] Prop. 1.3 on `Δ_Θ`, at one cusp and one level** (generic): under the debt
`WeilTameAt` (G5c + G5d) for `e : Δ_Θ ≃* Ẑ(1)` at the cusp place `W`, C1, the debt
`InertiaFixesLevel (L 0)` and `ClassAtCusp` at the level `j`, for every `σ ∈ I_W` over `X`:
`σ` maps into `Δ_Θ ⊆ Δ_X^Θ`, and `classAt η j n` at the image of `σ` in `Π^tp_Ÿ` is the `n`-th
component of `e(σ)`. -/
theorem classAt_deltaTheta (hC1 : LevelsDominated V hV T hL) (j n : ℕ) [NeZero n]
    (hk : ∀ c : k, algebraMap k Ω c ∈ W) (hVW : V ≤ W)
    {e : thetaSubD (fieldData ht LX hLX) ≃* ZHatOne (F (fieldData ht LX hLX)) Ω}
    (hWT : WeilTameAt (fieldData ht LX hLX) e hk) (hL0 : InertiaFixesLevel ht hLX (L 0) W)
    (hcusp : ClassAtCusp V hV T hL η hC1 j n hk hVW)
    (σ : inertiaGroup (fieldData ht LX hLX).R W) :
    ∃ hσ : inertiaToTheta _ hk (inertiaX σ) ∈ thetaSubD (fieldData ht LX hLX),
      ContH1.evalTriv ⟨_, inertiaToTempered_mem_piYddotX V hV T hL hVW σ (hL0 σ)⟩
          (inertiaToTempered_piYddotX_smul hk hVW σ (hL0 σ) n) (classAt η hC1 j n) =
        ZHatOne.proj (⟨n, Nat.cast_ne_zero.mpr (NeZero.ne n)⟩ :
          KummerIndex (F (fieldData ht LX hLX))) (e ⟨_, hσ⟩) := by
  have hσj := inertia_fixes_level hC1 j hVW σ (hL0 σ)
  obtain ⟨π, hπW, hπ, H⟩ := hcusp
  obtain ⟨hσ, Hσ⟩ := hWT (inertiaX σ)
  refine ⟨hσ, ?_⟩
  rw [H σ (hL0 σ) hσj]
  set i : KummerIndex (F (fieldData ht (L j) (hL j))) :=
    ⟨n, Nat.cast_ne_zero.mpr (NeZero.ne n)⟩
  refine (proj_tameChar hk π ⟨_, galoisToH_inertiaLevel_mem j σ hσj⟩ i).symm.trans ?_
  have hπ0 : ((π : F (fieldData ht (L j) (hL j))) : Ω) ≠ 0 := fun h0 =>
    π.ne_zero (Subtype.ext h0)
  obtain ⟨α, hα⟩ := IsAlgClosed.exists_pow_nat_eq ((π : F (fieldData ht (L j) (hL j))) : Ω)
    (Nat.pos_of_ne_zero (NeZero.ne n))
  have hα0 : α ≠ 0 := by
    rintro rfl
    rw [zero_pow (NeZero.ne n)] at hα
    exact hπ0 hα.symm
  have h2 := val_proj_tameChar hk π ⟨_, galoisToH_inertiaLevel_mem j σ hσj⟩ i (Units.mk0 α hα0)
    (Units.ext (by simpa using hα))
  have hFF : F (fieldData ht LX hLX) ≤ F (fieldData ht (L j) (hL j)) :=
    IntermediateField.fixedField_antitone (fieldData_H_antitone ht hLX (hL j) (hX j).out)
  have hfix : ∀ τ : inertiaH (fieldData ht LX hLX) W, ∀ x ∈ F (fieldData ht (L j) (hL j)),
      ((τ : (fieldData ht LX hLX).H) : Ω ≃ₐ[K₀ k t] Ω) x = x := by
    intro τ x hx
    obtain ⟨σ', hσ'⟩ := exists_inertiaX τ
    rw [← hσ']
    refine inertia_fixes_level hC1 j hVW σ' (hL0 σ') x ?_
    rw [← fieldData_L ht (L j) (hL j)]
    exact hx
  have h1 := Hσ (F (fieldData ht (L j) (hL j))) hFF hfix _ (π : F (fieldData ht (L j) (hL j))).2
    hπ0 hπW hπ n (Nat.cast_ne_zero.mpr (NeZero.ne n)) (Units.mk0 α hα0) hα
  apply Subtype.ext
  apply Units.ext
  exact h2.trans h1

/-- **The theta class maps the cusp inertia of `Ÿ` onto `μ_n`** (from `ClassAtCusp` and the
surjectivity of the tame character, continuous-kummer-theory `evalTriv_kummer_surjective`), under
C1 and `InertiaFixesLevel (L 0)`. -/
theorem classAt_cusp_surjective (hC1 : LevelsDominated V hV T hL) (j n : ℕ) [NeZero n]
    (hk : ∀ c : k, algebraMap k Ω c ∈ W) (hVW : V ≤ W) (hL0 : InertiaFixesLevel ht hLX (L 0) W)
    (hcusp : ClassAtCusp V hV T hL η hC1 j n hk hVW) (ζ : Mu n Ω) :
    ∃ σ : inertiaGroup (fieldData ht LX hLX).R W,
      ContH1.evalTriv ⟨_, inertiaToTempered_mem_piYddotX V hV T hL hVW σ (hL0 σ)⟩
          (inertiaToTempered_piYddotX_smul hk hVW σ (hL0 σ) n) (classAt η hC1 j n) = ζ := by
  obtain ⟨π, hπW, hπ, H⟩ := hcusp
  obtain ⟨τ, hτ, hval⟩ :=
    evalTriv_kummer_surjective (D := fieldData ht (L j) (hL j)) hk π hπW hπ n ζ
  have hτX : (τ : Ω ≃ₐ[K₀ k t] Ω) ∈ (fieldData ht LX hLX).HL :=
    fieldData_H_antitone ht hLX (hL j) (hX j).out τ.2
  have hτI : τ ∈ inertiaH (fieldData ht (L j) (hL j)) W := hτ
  let σ : inertiaGroup (fieldData ht LX hLX).R W :=
    ⟨ofHL (τ : Ω ≃ₐ[K₀ k t] Ω) hτX, mem_inertiaGroup.2
      ⟨fun a ha => hτ a ha, fun a ha => (mem_inertiaH.1 (inv_mem hτI)) a ha⟩⟩
  have hσj : ∀ x ∈ L j, (σ : Ω ≃ₐ[(fieldData ht LX hLX).R] Ω) x = x := fun x hx =>
    (IntermediateField.mem_fixingSubgroup_iff _ _).1 τ.2 x hx
  refine ⟨σ, ?_⟩
  rw [H σ (hL0 σ) hσj]
  have e : galoisToH ((inertiaLevel hL j σ hσj : inertiaGroup (fieldData ht (L j) (hL j)).R W) :
      Ω ≃ₐ[(fieldData ht (L j) (hL j)).R] Ω) = τ := Subtype.ext (AlgEquiv.ext fun _ => rfl)
  have key : ∀ (g g' : (fieldData ht (L j) (hL j)).H) (_ : g = g') hg hg',
      ContH1.evalTriv g hg
          (resMu (fieldData ht (L j) (hL j)) n (kummer n (F (fieldData ht (L j) (hL j))) Ω π)) =
        ContH1.evalTriv g' hg'
          (resMu (fieldData ht (L j) (hL j)) n (kummer n (F (fieldData ht (L j) (hL j))) Ω π)) := by
    intro g g' hgg _ _
    subst hgg
    rfl
  exact (key _ _ e _ _).trans hval

end Prop13

/-! ### The concrete system -/

variable {K : Type u} [NormedField K] [CompleteSpace K] [IsUltrametricDist K] [CharZero K]
  {t : TateParameter K}

local notation "Ω" => FFClosure (curveE t.tateCurve)
local notation "τ" => coordT (xN t.tateCurve)

section Main

variable [t.tateCurve.IsElliptic] (h2 : ‖(2 : K)‖ = 1) (h12 : (12 : K) ≠ 0) {s : Kˣ}
  (hs : s ^ 2 = t.q) (O : ValuationSubring K) (hO : ∀ x : K, x ∈ O ↔ ‖x‖ ≤ 1)

set_option maxHeartbeats 2000000 in
-- destructuring `exists_thetaClassTemp_cusps` (concrete Tate-curve levels) is slow to unify
include h2 in
/-- **[EtTh] Prop. 1.3 on `Δ_Θ`** (tempered form, ET l.1137–1270 with ET l.2272–2274), under the
debt `CuspInertiaWeil` (G5c + G5d, owner PI1TOP/MR13) for `X = E_q ∖ {O}`, C1 and the debt
`InertiaFixesLevel (L 0)`: there is an isomorphism `e : Δ_Θ ≃* Ẑ(1)` (`Δ_Θ ⊆ Δ_X^Θ`) such that,
for the system of `exists_thetaClassTemp`, at every place `W ⊇ K` of `Ω` over the cusp
(`τ ∉ W`):
* the cusp inertia `I_W ∩ H_X` maps onto `Δ_Θ` (`I_x ↠ Δ_Θ`);
* for every base point `V ≤ W` over `O` (such `V` exist), under C1 and `InertiaFixesLevel`, every
  `σ ∈ I_W` maps into `Δ_Θ`, and **the étale theta class `thetaClassTemp η n` at the image of `σ`
  in `Π^tp_Ÿ` is the `n`-th component of `e(σ̄)`** for every `n ≥ 1`: the restriction of the theta
  class to `Δ_Θ` (realised by `I_x ⊆ Π^tp_Ÿ`) is the natural isomorphism `Δ_Θ ⊗ ℤ/n ≅ μ_n`;
  in particular it maps the cusp inertia onto `μ_n` (`classAt_cusp_surjective`). -/
theorem exists_thetaClassTemp_deltaTheta
    (hG5 : CuspInertiaWeil (fieldData (transcendental_tau t.tateCurve) (hemiData t.tateCurve).L
      (hemiL_open t))) :
    ∃ (e : thetaSubD (fieldData (transcendental_tau t.tateCurve) (hemiData t.tateCurve).L
        (hemiL_open t)) ≃* ZHatOne (F (fieldData (transcendental_tau t.tateCurve)
          (hemiData t.tateCurve).L (hemiL_open t))) Ω)
      (L : ℕ → IntermediateField (K₀ K τ) Ω)
      (hL : ∀ j, IsOpen ((L j).fixingSubgroup : Set (Ω ≃ₐ[K₀ K τ] Ω)))
      (_ : ∀ j, Fact ((hemiData t.tateCurve).L ≤ L j))
      (_ : ∀ j, Algebra.Etale (DX t).R (fieldData (transcendental_tau t.tateCurve) (L j) (hL j)).R)
      (η : ∀ j, units (fieldData (transcendental_tau t.tateCurve) (L j) (hL j))),
      ThetaTransitions (transcendental_tau t.tateCurve) hL η ∧
      (∀ (V : ValuationSubring Ω) (hV : V.comap (algebraMap K Ω) = O),
        ThetaClassCompatible (ht := transcendental_tau t.tateCurve)
          (LX := (hemiData t.tateCurve).L) (hLX := hemiL_open t) V hV (tateDataX O hO hs h12) η) ∧
      ∀ (W : ValuationSubring Ω) (hk : ∀ c : K, algebraMap K Ω c ∈ W), τ ∉ W →
        (∀ δ ∈ thetaSubD (fieldData (transcendental_tau t.tateCurve) (hemiData t.tateCurve).L
            (hemiL_open t)), ∃ σ, inertiaToTheta _ hk σ = δ) ∧
        (∃ V : ValuationSubring Ω, V ≤ W ∧ V.comap (algebraMap K Ω) = O) ∧
        ∀ (V : ValuationSubring Ω) (hV : V.comap (algebraMap K Ω) = O) (hVW : V ≤ W)
          (hC1 : LevelsDominated V hV (tateDataX O hO hs h12) hL)
          (hL0 : InertiaFixesLevel (transcendental_tau t.tateCurve) (hemiL_open t) (L 0) W),
          (∀ σ : inertiaGroup (DX t).R W,
            ∃ hσ : inertiaToTheta _ hk (inertiaX σ) ∈ thetaSubD (fieldData
                (transcendental_tau t.tateCurve) (hemiData t.tateCurve).L (hemiL_open t)),
              ∀ (n : ℕ) [NeZero n],
                ContH1.evalTriv ⟨_, inertiaToTempered_mem_piYddotX V hV _ hL hVW σ (hL0 σ)⟩
                    (inertiaToTempered_piYddotX_smul hk hVW σ (hL0 σ) n)
                    (thetaClassTemp η hC1 n) =
                  ZHatOne.proj (⟨n, Nat.cast_ne_zero.mpr (NeZero.ne n)⟩ :
                    KummerIndex (F (fieldData (transcendental_tau t.tateCurve)
                      (hemiData t.tateCurve).L (hemiL_open t)))) (e ⟨_, hσ⟩)) ∧
          ∀ (n : ℕ) [NeZero n] (ζ : Mu n Ω), ∃ σ : inertiaGroup (DX t).R W,
            ContH1.evalTriv ⟨_, inertiaToTempered_mem_piYddotX V hV _ hL hVW σ (hL0 σ)⟩
                (inertiaToTempered_piYddotX_smul hk hVW σ (hL0 σ) n)
                (thetaClassTemp η hC1 n) = ζ := by
  obtain ⟨e, he⟩ := hG5
  obtain ⟨L, hL, hX, het, η, htr, hcomp, hcusp⟩ := exists_thetaClassTemp_cusps h2 h12 hs O hO
