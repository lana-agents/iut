import Iut.Reconstruction.Local.UnitsColimitGalois
import Iut.Reconstruction.Local.Torsion

/-!
# The group-theoretic cyclotome `μ_{ℚ/ℤ}(G)` ([AbsTopIII], Corollary 1.10 (a), MR9 L1)

[AbsTopIII], Corollary 1.10 (i) (a) (`Topics in Absolute Anabelian Geometry III.txt`,
l.2375–2392):

> "(a) Write: `μ_{Q/Z}(G_k) := lim→_H (H^ab)_tors`; `μ_Ẑ(G_k) := Hom(Q/Z, μ_{Q/Z}(G_k))`
> — where H ranges over the open subgroups of G_k; the notation "(−)_tors" denotes the torsion
> subgroup of the abelian group in parentheses; the arrows of the direct limit are induced by
> the Verlagerung, or transfer, map […]. [Thus, the underlying module of μ_{Q/Z}(G_k),
> μ_Ẑ(G_k) is unaffected by the operation of passing from G_k to an open subgroup of G_k.]"

For a compact topological group `G` we form, inside `AbBar G = lim→_U U^ab` (the colimit along the
transfer `verAb`, `UnitsColimit.lean`):

* **`muQZ G`** `= μ_{ℚ/ℤ}(G)`, the subgroup generated by the images of the `(U^ab)_tors`; since
  filtered colimits are exact it is the torsion subgroup of `AbBar G` (`muQZ_eq_torsion`);
* `muN G n = μ_n(G)`, the `n`-torsion of `AbBar G` (`muN_le_muQZ`), a `G`-module via the
  conjugation action `barConj` (`MulDistribMulAction G (muN G n)`);
* **functoriality**: every `ψ : G ≃ₜ* G'` induces `muQZEquivOf ψ : μ_{ℚ/ℤ}(G) ≃* μ_{ℚ/ℤ}(G')` and
  `muNEquivOf ψ : μ_n(G) ≃* μ_n(G')`, equivariant along `ψ` (`muNEquivOf_smul`).

For `G = G_k = Gal(Ω/k)`, `k/ℚ_p` finite:

* `torsion_le_abUnits`: `(U^ab)_tors` lies in the image of inertia (`Torsion.torsAbEquiv`: it
  consists of the images of roots of unity under the Artin map), so `μ_{ℚ/ℤ}(G_k) ⊆ 𝒪^×_{k̄}(G_k)`
  (`muQZ_le_unitsBar`) and the transition maps of the colimit are the inclusions
  `μ(E_U) ⊆ μ(E_V)` (`unitsMap_abTrans`, from `PadicField.artin_transfer`);
* **`muQZEquiv p k Ω : μ_{ℚ/ℤ}(G_k) ≃* μ_∞(Ω)`** (`(Ωˣ)_tors`), restricting `unitsBarEquiv`, with
  `muQZEquiv_toBar` describing it on `(U^ab)_tors`;
* **`muNEquiv p k Ω n : μ_n(G_k) ≃* μ_n(Ω)`**, **`G_k`-equivariant** (`muNEquiv_smul`).

The profinite `μ_Ẑ(G) = Hom(ℚ/ℤ, μ_{ℚ/ℤ}(G))` enters through the levels `μ_n(G)` (inverse limit
convention, as for `Brauer.H2ZHatOne`); see `Cor110H2.lean`.
-/

namespace Iut.Reconstruction

open PadicField IntermediateField MonoidHom KummerTheory

set_option linter.unusedSectionVars false

noncomputable section

/-! ### The group-theoretic construction -/

section GroupTheoretic

variable (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]

/-- **`μ_{ℚ/ℤ}(G) = lim→_U (U^ab)_tors`** ([AbsTopIII], Corollary 1.10 (a)), along the transfer,
as the subgroup of `AbBar G = lim→_U U^ab` generated by the images of the `(U^ab)_tors`. -/
def muQZ : Subgroup (AbBar G) :=
  ⨆ i : OpenIdx G, (CommGroup.torsion (AbFam G i)).map (toBar G i)

/-- **`μ_{ℚ/ℤ}(G)` is the torsion of `lim→_U U^ab`.** -/
theorem muQZ_eq_torsion : muQZ G = CommGroup.torsion (AbBar G) := by
  apply le_antisymm
  · refine iSup_le fun i => ?_
    rintro _ ⟨x, hx, rfl⟩
    rw [SetLike.mem_coe, CommGroup.mem_torsion] at hx
    rw [CommGroup.mem_torsion]
    exact MonoidHom.isOfFinOrder _ hx
  · intro z hz
    obtain ⟨i, x, rfl⟩ := exists_toBar G z
    rw [CommGroup.mem_torsion] at hz
    obtain ⟨n, hn, hxn⟩ := isOfFinOrder_iff_pow_eq_one.1 hz
    rw [← map_pow, ← map_one (toBar G i)] at hxn
    obtain ⟨l, hil, hil', hl⟩ := Quotient.exact hxn
    refine Subgroup.mem_iSup_of_mem l ⟨abTrans G i l hil x, ?_, toBar_abTrans G hil x⟩
    rw [SetLike.mem_coe, CommGroup.mem_torsion]
    refine isOfFinOrder_iff_pow_eq_one.2 ⟨n, hn, ?_⟩
    rw [← map_pow]
    exact hl.trans (map_one _)

theorem mem_muQZ_iff (z : AbBar G) : z ∈ muQZ G ↔ IsOfFinOrder z := by
  rw [muQZ_eq_torsion, CommGroup.mem_torsion]

theorem toBar_mem_muQZ (i : OpenIdx G) {x : AbFam G i}
    (hx : x ∈ CommGroup.torsion (AbFam G i)) : toBar G i x ∈ muQZ G :=
  Subgroup.mem_iSup_of_mem i ⟨x, hx, rfl⟩

/-- **`μ_n(G)`**: the `n`-torsion of `lim→_U U^ab`. -/
def muN (n : ℕ) : Subgroup (AbBar G) := (powMonoidHom n : AbBar G →* AbBar G).ker

variable {G} in
theorem mem_muN {n : ℕ} {z : AbBar G} : z ∈ muN G n ↔ z ^ n = 1 := Iff.rfl

/-- `μ_n(G) ⊆ μ_{ℚ/ℤ}(G)` for `n ≠ 0`. -/
theorem muN_le_muQZ (n : ℕ) [NeZero n] : muN G n ≤ muQZ G := fun z hz => by
  rw [mem_muQZ_iff]
  exact isOfFinOrder_iff_pow_eq_one.2 ⟨n, Nat.pos_of_ne_zero (NeZero.ne n), hz⟩

theorem barConj_mem_muN {n : ℕ} (g : G) {z : AbBar G} (hz : z ∈ muN G n) :
    barConj G g z ∈ muN G n := by
  rw [mem_muN, ← map_pow, mem_muN.1 hz, map_one]

/-- **The `G`-module `μ_n(G)`**: `G` acts by the conjugation action `barConj` on
`lim→_U U^ab`. -/
instance (n : ℕ) : MulDistribMulAction G (muN G n) where
  smul g z := ⟨barConj G g z, barConj_mem_muN G g z.2⟩
  one_smul z := Subtype.ext (by
    change barConj G 1 (z : AbBar G) = z
    rw [barConj_one, MonoidHom.id_apply])
  mul_smul g h z := Subtype.ext (by
    change barConj G (g * h) (z : AbBar G) = barConj G g (barConj G h z)
    rw [barConj_mul, MonoidHom.comp_apply])
  smul_mul g z w := Subtype.ext (map_mul (barConj G g) (z : AbBar G) w)
  smul_one g := Subtype.ext (map_one (barConj G g))

theorem coe_smul_muN {n : ℕ} (g : G) (z : muN G n) :
    ((g • z : muN G n) : AbBar G) = barConj G g z := rfl

end GroupTheoretic

/-! ### Functoriality -/

section Functorial

variable {G G' : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [Group G'] [TopologicalSpace G'] [IsTopologicalGroup G'] [CompactSpace G']

theorem barMap_mem_muQZ (ψ : G ≃ₜ* G') {z : AbBar G} (hz : z ∈ muQZ G) :
    barMap ψ z ∈ muQZ G' := by
  rw [mem_muQZ_iff] at hz ⊢
  exact MonoidHom.isOfFinOrder _ hz

/-- **`μ_{ℚ/ℤ}(G)` is group-theoretic**: `ψ : G ≃ₜ* G'` maps it onto `μ_{ℚ/ℤ}(G')`. -/
theorem map_muQZ (ψ : G ≃ₜ* G') : (muQZ G).map (barMap ψ) = muQZ G' := by
  ext z
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact barMap_mem_muQZ ψ hy
  · intro hz
    exact ⟨(barEquiv ψ).symm z, barMap_mem_muQZ ψ.symm hz, (barEquiv ψ).apply_symm_apply z⟩

/-- The isomorphism `μ_{ℚ/ℤ}(G) ≃* μ_{ℚ/ℤ}(G')` induced by `ψ : G ≃ₜ* G'`. -/
def muQZEquivOf (ψ : G ≃ₜ* G') : muQZ G ≃* muQZ G' where
  toFun z := ⟨barMap ψ z, barMap_mem_muQZ ψ z.2⟩
  invFun z := ⟨barMap ψ.symm z, barMap_mem_muQZ ψ.symm z.2⟩
  left_inv z := Subtype.ext ((barEquiv ψ).symm_apply_apply (z : AbBar G))
  right_inv z := Subtype.ext ((barEquiv ψ).apply_symm_apply (z : AbBar G'))
  map_mul' z w := Subtype.ext (map_mul (barMap ψ) (z : AbBar G) w)

theorem coe_muQZEquivOf (ψ : G ≃ₜ* G') (z : muQZ G) :
    (muQZEquivOf ψ z : AbBar G') = barMap ψ z := rfl

theorem barMap_mem_muN (ψ : G ≃ₜ* G') {n : ℕ} {z : AbBar G} (hz : z ∈ muN G n) :
    barMap ψ z ∈ muN G' n := by
  rw [mem_muN, ← map_pow, mem_muN.1 hz, map_one]

/-- **`barMap` intertwines the conjugation actions**:
`ψ_*(g · z) = ψ(g) · ψ_*(z)`. -/
theorem barMap_barConj (ψ : G ≃ₜ* G') (g : G) (z : AbBar G) :
    barMap ψ (barConj G g z) = barConj G' (ψ g) (barMap ψ z) := by
  rw [barConj, barConj, ← MonoidHom.comp_apply, ← barMap_trans, ← MonoidHom.comp_apply,
    ← barMap_trans]
  congr 2
  ext x
  simp [conjCont_apply, map_mul, map_inv]

/-- The isomorphism `μ_n(G) ≃* μ_n(G')` induced by `ψ : G ≃ₜ* G'`. -/
def muNEquivOf (ψ : G ≃ₜ* G') (n : ℕ) : muN G n ≃* muN G' n where
  toFun z := ⟨barMap ψ z, barMap_mem_muN ψ z.2⟩
  invFun z := ⟨barMap ψ.symm z, barMap_mem_muN ψ.symm z.2⟩
  left_inv z := Subtype.ext ((barEquiv ψ).symm_apply_apply (z : AbBar G))
  right_inv z := Subtype.ext ((barEquiv ψ).apply_symm_apply (z : AbBar G'))
  map_mul' z w := Subtype.ext (map_mul (barMap ψ) (z : AbBar G) w)

theorem coe_muNEquivOf (ψ : G ≃ₜ* G') {n : ℕ} (z : muN G n) :
    (muNEquivOf ψ n z : AbBar G') = barMap ψ z := rfl

/-- **`μ_n(G) ≃* μ_n(G')` is equivariant along `ψ`.** -/
theorem muNEquivOf_smul (ψ : G ≃ₜ* G') {n : ℕ} (g : G) (z : muN G n) :
    muNEquivOf ψ n (g • z) = ψ g • muNEquivOf ψ n z :=
  Subtype.ext (barMap_barConj ψ g z)

end Functorial

/-! ### `G = G_k`: `μ_{ℚ/ℤ}(G_k) ≅ μ_∞(Ω)` -/

section Galois

variable {p : ℕ} [hp : Fact p.Prime]
variable {k : Type*} [Field k] [Algebra ℚ_[p] k] [FiniteDimensional ℚ_[p] k]
variable {Ω : Type*} [Field Ω] [Algebra k Ω] [Algebra ℚ_[p] Ω] [IsScalarTower ℚ_[p] k Ω]
  [IsAlgClosed Ω] [IsGalois k Ω] [Algebra.IsAlgebraic ℚ_[p] Ω]

/-- Roots of unity have norm `1`. -/
theorem nrm_eq_one_of_pow_eq_one {K : Type*} [Field K] [Algebra ℚ_[p] K]
    [Algebra.IsAlgebraic ℚ_[p] K] {x : K} {n : ℕ} (hn : n ≠ 0) (h : x ^ n = 1) :
    nrm p K x = 1 := by
  have h1 := congrArg (nrm p K) h
  rw [nrm_pow, nrm_one] at h1
  exact (pow_eq_one_iff_of_nonneg (nrm_nonneg x) hn).1 h1

include hp in
/-- **`(U^ab)_tors` lies in the image of inertia**: by `torsAbEquiv` it consists of the images of
the roots of unity of `E_U` under the Artin map. -/
theorem torsion_le_abUnits (i : OpenIdx (Ω ≃ₐ[k] Ω)) :
    CommGroup.torsion (AbFam (Ω ≃ₐ[k] Ω) i) ≤ abUnits (sg i) := by
  intro x hx
  rw [← abEquiv_mem_abUnits_iff (galEquiv i)]
  have hy : abEquiv (galEquiv i) x ∈
      CommGroup.torsion (TopologicalAbelianization (Ω ≃ₐ[fld i] Ω)) := by
    rw [CommGroup.mem_torsion] at hx ⊢
    exact MonoidHom.isOfFinOrder (abEquiv (galEquiv i)).toMonoidHom hx
  obtain ⟨ζ, hζ⟩ := (torsAbEquiv p (fld i) Ω).surjective ⟨_, hy⟩
  have h1 : ((torsAbEquiv p (fld i) Ω ζ : CommGroup.torsion _) :
      TopologicalAbelianization (Ω ≃ₐ[fld i] Ω)) = abEquiv (galEquiv i) x :=
    congrArg Subtype.val hζ
  rw [← h1]
  change ((multAbEquiv p (fld i) Ω (ζ : (fld i)ˣ) : abWeil (Ω ≃ₐ[fld i] Ω)) :
    TopologicalAbelianization (Ω ≃ₐ[fld i] Ω)) ∈ abUnits _
  rw [multAbEquiv_mem_abUnits_iff, mem_unitGroup]
  obtain ⟨n, hn, hζn⟩ := isOfFinOrder_iff_pow_eq_one.1 ((CommGroup.mem_torsion _).1 ζ.2)
  exact nrm_eq_one_of_pow_eq_one hn.ne' (by rw [← Units.val_pow_eq_pow_val, hζn, Units.val_one])

include hp in
/-- **`μ_{ℚ/ℤ}(G_k) ⊆ 𝒪^×_{k̄}(G_k)`.** -/
theorem muQZ_le_unitsBar : muQZ (Ω ≃ₐ[k] Ω) ≤ unitsBar (Ω ≃ₐ[k] Ω) :=
  iSup_le fun i => (Subgroup.map_mono (torsion_le_abUnits (p := p) i)).trans
    (le_iSup (fun j : OpenIdx (Ω ≃ₐ[k] Ω) => (abUnits (sg j)).map (toBar _ j)) i)

variable (p k Ω) in
/-- The map `μ_{ℚ/ℤ}(G_k) → Ωˣ`, the restriction of `unitsBarEquiv`. -/
def muQZHom : muQZ (Ω ≃ₐ[k] Ω) →* Ωˣ where
  toFun z := (unitsBarEquiv p k Ω ⟨z, muQZ_le_unitsBar (p := p) z.2⟩ : Ωˣ)
  map_one' := by
    have : (⟨((1 : muQZ (Ω ≃ₐ[k] Ω)) : AbBar (Ω ≃ₐ[k] Ω)),
      muQZ_le_unitsBar (p := p) (1 : muQZ (Ω ≃ₐ[k] Ω)).2⟩ : unitsBar (Ω ≃ₐ[k] Ω)) = 1 := rfl
    rw [this, map_one]
    rfl
  map_mul' z w := by
    have : (⟨((z * w : muQZ (Ω ≃ₐ[k] Ω)) : AbBar (Ω ≃ₐ[k] Ω)),
      muQZ_le_unitsBar (p := p) (z * w).2⟩ : unitsBar (Ω ≃ₐ[k] Ω)) =
        ⟨z, muQZ_le_unitsBar (p := p) z.2⟩ * ⟨w, muQZ_le_unitsBar (p := p) w.2⟩ := rfl
    rw [this, map_mul]
    rfl

theorem muQZHom_apply (z : muQZ (Ω ≃ₐ[k] Ω)) :
    muQZHom p k Ω z = (unitsBarEquiv p k Ω ⟨z, muQZ_le_unitsBar (p := p) z.2⟩ : Ωˣ) := rfl

theorem muQZHom_injective : Function.Injective (muQZHom p k Ω) := by
  intro z w h
  rw [muQZHom_apply, muQZHom_apply] at h
  have h1 := (unitsBarEquiv p k Ω).injective (Subtype.ext h)
  have h2 : (z : AbBar (Ω ≃ₐ[k] Ω)) = w :=
    congrArg (fun u : unitsBar (Ω ≃ₐ[k] Ω) => (u : AbBar (Ω ≃ₐ[k] Ω))) h1
  exact Subtype.ext h2

theorem muQZHom_mem_torsion (z : muQZ (Ω ≃ₐ[k] Ω)) : muQZHom p k Ω z ∈ CommGroup.torsion Ωˣ := by
  rw [CommGroup.mem_torsion]
  have hz := (mem_muQZ_iff _ _).1 z.2
  have hz' : IsOfFinOrder z := by
    obtain ⟨n, hn, h⟩ := isOfFinOrder_iff_pow_eq_one.1 hz
    exact isOfFinOrder_iff_pow_eq_one.2 ⟨n, hn, Subtype.ext h⟩
  exact MonoidHom.isOfFinOrder _ hz'

include hp in
/-- Torsion units of `Ω` have norm `1`. -/
theorem torsion_le_unitsΩ : CommGroup.torsion Ωˣ ≤ unitsΩ p Ω := by
  intro ζ hζ
  obtain ⟨n, hn, hζn⟩ := isOfFinOrder_iff_pow_eq_one.1 ((CommGroup.mem_torsion _).1 hζ)
  rw [mem_unitsΩ]
  exact nrm_eq_one_of_pow_eq_one hn.ne' (by rw [← Units.val_pow_eq_pow_val, hζn, Units.val_one])

theorem exists_muQZHom_eq {ζ : Ωˣ} (hζ : ζ ∈ CommGroup.torsion Ωˣ) :
    ∃ z, muQZHom p k Ω z = ζ := by
  obtain ⟨n, hn, hζn⟩ := isOfFinOrder_iff_pow_eq_one.1 ((CommGroup.mem_torsion _).1 hζ)
  set w := (unitsBarEquiv p k Ω).symm ⟨ζ, torsion_le_unitsΩ (p := p) hζ⟩
  have hw : (w : AbBar (Ω ≃ₐ[k] Ω)) ∈ muQZ (Ω ≃ₐ[k] Ω) := by
    rw [mem_muQZ_iff]
    refine isOfFinOrder_iff_pow_eq_one.2 ⟨n, hn, ?_⟩
    have : w ^ n = 1 := by
      rw [← map_pow, ← map_one (unitsBarEquiv p k Ω).symm]
      exact congrArg _ (Subtype.ext hζn)
    exact congrArg Subtype.val this
  refine ⟨⟨w, hw⟩, ?_⟩
  rw [muQZHom_apply]
  have : (⟨w, muQZ_le_unitsBar (p := p) hw⟩ : unitsBar (Ω ≃ₐ[k] Ω)) = w := rfl
  rw [this, MulEquiv.apply_symm_apply]

theorem muQZCod_bijective :
    Function.Bijective ((muQZHom p k Ω).codRestrict _ muQZHom_mem_torsion) := by
  refine ⟨fun z w h => muQZHom_injective (p := p) ?_, fun ζ => ?_⟩
  · exact congrArg (fun u : CommGroup.torsion Ωˣ => (u : Ωˣ)) h
  · obtain ⟨z, hz⟩ := exists_muQZHom_eq (p := p) (k := k) ζ.2
    exact ⟨z, Subtype.ext hz⟩

variable (p k Ω) in
/-- **`μ_{ℚ/ℤ}(G_k) ≅ μ_∞(Ω)`** ([AbsTopIII], Corollary 1.10 (a)): the group-theoretic
`lim→_U (U^ab)_tors` (colimit along the transfer) is the group of roots of unity of `Ω`. -/
def muQZEquiv : muQZ (Ω ≃ₐ[k] Ω) ≃* CommGroup.torsion Ωˣ :=
  MulEquiv.ofBijective ((muQZHom p k Ω).codRestrict _ muQZHom_mem_torsion) muQZCod_bijective

theorem coe_muQZEquiv (z : muQZ (Ω ≃ₐ[k] Ω)) :
    (muQZEquiv p k Ω z : Ωˣ) = muQZHom p k Ω z := rfl

/-- **On `(U^ab)_tors`**, `muQZEquiv` is local class field theory for `E_U`: the image of
`x ∈ (U^ab)_tors` is the root of unity `unitsMap p i x ∈ μ(E_U)` with Artin symbol `x`. -/
theorem muQZEquiv_toBar (i : OpenIdx (Ω ≃ₐ[k] Ω)) (x : AbFam (Ω ≃ₐ[k] Ω) i)
    (hx : x ∈ CommGroup.torsion (AbFam (Ω ≃ₐ[k] Ω) i)) :
    (muQZEquiv p k Ω ⟨toBar _ i x, toBar_mem_muQZ _ i hx⟩ : Ωˣ) =
      unitsMap p i ⟨x, torsion_le_abUnits (p := p) i hx⟩ :=
  congrArg Subtype.val (unitsBarEquiv_toBar (p := p) i ⟨x, torsion_le_abUnits (p := p) i hx⟩)

/-- **The transition maps are the inclusions `μ(E_U) ⊆ μ(E_V)`**: for `V ⊆ U` the transfer
`(U^ab)_tors → (V^ab)_tors` corresponds to the inclusion of roots of unity (the transfer property
of the Artin map, `PadicField.artin_transfer`). -/
theorem unitsMap_abTrans_torsion {i j : OpenIdx (Ω ≃ₐ[k] Ω)} (h : i ≤ j)
    (x : AbFam (Ω ≃ₐ[k] Ω) i) (hx : x ∈ CommGroup.torsion (AbFam (Ω ≃ₐ[k] Ω) i)) :
    unitsMap p j ⟨abTrans _ i j h x, abTrans_mem_abUnits (p := p) h
      (torsion_le_abUnits (p := p) i hx)⟩ =
      unitsMap p i ⟨x, torsion_le_abUnits (p := p) i hx⟩ :=
  unitsMap_abTrans (p := p) h ⟨x, torsion_le_abUnits (p := p) i hx⟩

/-- **`μ_{ℚ/ℤ}(G_k) ≅ μ_∞(Ω)` is `G_k`-equivariant.** -/
theorem muQZHom_barConj (σ : Ω ≃ₐ[k] Ω) (z : muQZ (Ω ≃ₐ[k] Ω)) :
    ((muQZHom p k Ω ⟨barConj _ σ z, (mem_muQZ_iff _ _).2
      (MonoidHom.isOfFinOrder _ ((mem_muQZ_iff _ _).1 z.2))⟩ : Ωˣ) : Ω) =
      σ ((muQZHom p k Ω z : Ωˣ) : Ω) := by
  rw [muQZHom_apply, muQZHom_apply]
  have h := unitsBarEquiv_barConj (p := p) σ ⟨z, muQZ_le_unitsBar (p := p) z.2⟩
  have h2 := congrArg (fun u : unitsΩ p Ω => ((u : Ωˣ) : Ω)) h
  simp only at h2
  rw [coe_unitsΩMap] at h2
  exact h2

/-! ### `μ_n(G_k) ≅ μ_n(Ω)`, equivariantly -/

variable (n : ℕ) [NeZero n]

theorem muQZHom_pow_eq_one (z : muN (Ω ≃ₐ[k] Ω) n) :
    muQZHom p k Ω ⟨z, muN_le_muQZ _ n z.2⟩ ^ n = 1 := by
  rw [← map_pow]
  have : (⟨z, muN_le_muQZ _ n z.2⟩ : muQZ (Ω ≃ₐ[k] Ω)) ^ n = 1 := Subtype.ext z.2
  rw [this, map_one]

variable (p k Ω) in
/-- The map `μ_n(G_k) → μ_n(Ω)`. -/
def muNHom : muN (Ω ≃ₐ[k] Ω) n →* Mu n Ω :=
  ((muQZHom p k Ω).comp (Subgroup.inclusion (muN_le_muQZ _ n))).codRestrict (rootsOfUnity n Ω)
    fun z => (mem_rootsOfUnity n _).2 (muQZHom_pow_eq_one n z)

theorem val_muNHom (z : muN (Ω ≃ₐ[k] Ω) n) :
    Mu.val (muNHom p k Ω n z) = muQZHom p k Ω ⟨z, muN_le_muQZ _ n z.2⟩ := rfl

theorem muNHom_bijective : Function.Bijective (muNHom p k Ω n) := by
  constructor
  · intro z w h
    have h0 := congrArg Mu.val h
    rw [val_muNHom, val_muNHom] at h0
    have h1 := muQZHom_injective h0
    exact Subtype.ext (congrArg (fun u : muQZ (Ω ≃ₐ[k] Ω) => (u : AbBar (Ω ≃ₐ[k] Ω))) h1)
  · intro ζ
    have hζ : Mu.val ζ ∈ CommGroup.torsion Ωˣ := by
      rw [CommGroup.mem_torsion]
      exact isOfFinOrder_iff_pow_eq_one.2 ⟨n, Nat.pos_of_ne_zero (NeZero.ne n), Mu.val_pow_n ζ⟩
    obtain ⟨z, hz⟩ := exists_muQZHom_eq (p := p) (k := k) hζ
    have hzn : (z : AbBar (Ω ≃ₐ[k] Ω)) ∈ muN _ n := by
      rw [mem_muN]
      have : z ^ n = 1 := muQZHom_injective (by rw [map_pow, hz, map_one, Mu.val_pow_n])
      exact congrArg Subtype.val this
    exact ⟨⟨z, hzn⟩, Mu.ext (by rw [val_muNHom]; exact hz)⟩

variable (p k Ω) in
/-- **`μ_n(G_k) ≅ μ_n(Ω)`**: the `n`-torsion of the group-theoretic `μ_{ℚ/ℤ}(G_k)` is `μ_n(Ω)`. -/
def muNEquiv : muN (Ω ≃ₐ[k] Ω) n ≃* Mu n Ω :=
  MulEquiv.ofBijective (muNHom p k Ω n) (muNHom_bijective n)

theorem val_muNEquiv (z : muN (Ω ≃ₐ[k] Ω) n) :
    Mu.val (muNEquiv p k Ω n z) = muQZHom p k Ω ⟨z, muN_le_muQZ _ n z.2⟩ := rfl

/-- **`μ_n(G_k) ≅ μ_n(Ω)` is `G_k`-equivariant.** -/
theorem muNEquiv_smul (σ : Ω ≃ₐ[k] Ω) (z : muN (Ω ≃ₐ[k] Ω) n) :
    muNEquiv p k Ω n (σ • z) = σ • muNEquiv p k Ω n z := by
  apply Mu.ext
  apply Units.ext
  rw [Mu.val_smul_coe, val_muNEquiv, val_muNEquiv]
  exact muQZHom_barConj σ ⟨z, muN_le_muQZ _ n z.2⟩

end Galois

end

end Iut.Reconstruction
