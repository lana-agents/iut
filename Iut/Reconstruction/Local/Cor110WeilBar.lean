import Iut.Reconstruction.Local.Cor110
import Iut.Reconstruction.Local.AbelianZHat

/-!
# `k̄^×(G)`: the colimit of the Weil parts along the transfer (MR9 L1, for Cor. 1.10 (a))

[Mzk9] = [AbsAnab], Proposition 1.2.1 (`Absolute Anabelian Geometry.txt`, l.503–515), in the
proof of (iv):

> "Here, we note that if `L_i` is a finite extension of `K_i`, then the inclusion
> `G_{K_i}^ab ≅ (K_i^×)^∧ → (L_i^×)^∧ ≅ G_{L_i}^ab` may be reconstructed group-theoretically by
> considering the Verlagerung, or transfer, map"

and the proof of (vii) (l.517–528) uses the module `K̄_i^×` "which is group-theoretic, by (iii)".
`UnitsColimit.lean` / `UnitsColimitGalois.lean` treat the units `𝒪^×_{k̄}(G) ⊆ lim→_U U^ab`;
here we treat the **Weil part**, the images of the `E_U^×`:

* `weilBar G ⊆ AbBar G = lim→_U U^ab`, generated by the images of `abWeil U` (the image of the
  reconstructed Weil group in `U^ab`), for any compact topological group `G`; it is
  group-theoretic (`barMap_mem_weilBar`) and stable under the `G`-action;
* for `G = G_k`: the transfer maps `abWeil U` into `abWeil V` compatibly with the inclusion
  `E_U^× ⊆ E_V^×` (`verAb_weil`, from `PadicField.artin_transfer`), hence a homomorphism
  **`weilBarHom p : weilBar G_k →* Ωˣ`**, which is **`G_k`-equivariant**
  (`weilBarHom_barConj`, from `PadicField.artin_naturality`), extends `unitsBarEquiv`
  (`weilBarHom_eq_unitsBarEquiv`), is bijective (`weilBarEquiv`), and sends the image of
  `x ∈ abWeil(G_k)` at the top level to the element `a ∈ k^×` with Artin symbol `x`
  (`weilBarHom_topBar`).
-/

namespace Iut.Reconstruction

open PadicField IntermediateField MonoidHom

set_option linter.unusedSectionVars false

noncomputable section

/-! ### The group-theoretic construction -/

section GroupTheoretic

variable {G G' : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [Group G'] [TopologicalSpace G'] [IsTopologicalGroup G']

theorem abEquiv_mem_abWeil_iff (ψ : G ≃ₜ* G') (x : TopologicalAbelianization G) :
    abEquiv ψ x ∈ abWeil G' ↔ x ∈ abWeil G := by
  rw [← map_abWeil ψ]
  exact ⟨fun ⟨y, hy, hxy⟩ => by rwa [(abEquiv ψ).injective hxy] at hy,
    fun h => Subgroup.mem_map_of_mem _ h⟩

/-- The isomorphism `abWeil G ≃* abWeil G'` induced by `ψ : G ≃ₜ* G'`. -/
def abWeilEquiv (ψ : G ≃ₜ* G') : abWeil G ≃* abWeil G' :=
  ((abEquiv ψ).subgroupMap _).trans (MulEquiv.subgroupCongr (map_abWeil ψ))

theorem coe_abWeilEquiv (ψ : G ≃ₜ* G') (u : abWeil G) :
    ((abWeilEquiv ψ u : abWeil G') : TopologicalAbelianization G') = abEquiv ψ u := rfl

/-- The image of inertia lies in the image of the Weil group. -/
theorem abUnits_le_abWeil (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] :
    abUnits G ≤ abWeil G :=
  Subgroup.map_mono fun _ h => Subgroup.subset_closure (Or.inr h)

end GroupTheoretic

section Colimit

variable (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]

/-- **`k̄^×(G)`**: the subgroup of `lim→_U U^ab` generated by the images of the `abWeil U`. -/
def weilBar : Subgroup (AbBar G) := ⨆ i : OpenIdx G, (abWeil (sg i)).map (toBar G i)

theorem toBar_mem_weilBar (i : OpenIdx G) {x : AbFam G i} (hx : x ∈ abWeil (sg i)) :
    toBar G i x ∈ weilBar G :=
  Subgroup.mem_iSup_of_mem i ⟨x, hx, rfl⟩

theorem unitsBar_le_weilBar : unitsBar G ≤ weilBar G :=
  iSup_mono fun _ => Subgroup.map_mono (abUnits_le_abWeil _)

variable {G}

variable {G' : Type*} [Group G'] [TopologicalSpace G'] [IsTopologicalGroup G'] [CompactSpace G']

/-- **`k̄^×(G)` is group-theoretic.** -/
theorem barMap_mem_weilBar (ψ : G ≃ₜ* G') {z : AbBar G} (hz : z ∈ weilBar G) :
    barMap ψ z ∈ weilBar G' := by
  refine Subgroup.iSup_induction (C := fun z => barMap ψ z ∈ weilBar G') _ hz ?_ ?_ ?_
  · rintro _ _ ⟨x, hx, rfl⟩
    rw [barMap_toBar]
    exact toBar_mem_weilBar G' _ ((abEquiv_mem_abWeil_iff _ _).2 hx)
  · rw [map_one]
    exact one_mem _
  · intro z w hz hw
    rw [map_mul]
    exact mul_mem hz hw

theorem barConj_mem_weilBar (g : G) {z : AbBar G} (hz : z ∈ weilBar G) :
    barConj G g z ∈ weilBar G :=
  barMap_mem_weilBar _ hz

variable (G) in
/-- The top index `G` itself. -/
def idxTop : OpenIdx G := OrderDual.toDual ⊤

theorem mem_sg_idxTop (g : G) : g ∈ sg (idxTop G) := Subgroup.mem_top g

variable (G) in
/-- `G ≃ₜ* G`, the latter as the top open subgroup. -/
def topCont : G ≃ₜ* sg (idxTop G) :=
  { toMulEquiv := Subgroup.topEquiv.symm
    continuous_toFun := continuous_id.subtype_mk _
    continuous_invFun := continuous_subtype_val }

theorem coe_topCont (g : G) : (topCont G g : G) = g := rfl

variable (G) in
/-- The element of `lim→_U U^ab` given by `x ∈ G^ab` at the top level. -/
def topBar (x : TopologicalAbelianization G) : AbBar G :=
  toBar G (idxTop G) (abEquiv (topCont G) x)

theorem topBar_mem_weilBar {x : TopologicalAbelianization G} (hx : x ∈ abWeil G) :
    topBar G x ∈ weilBar G :=
  toBar_mem_weilBar G _ ((abEquiv_mem_abWeil_iff _ _).2 hx)

/-- **`topBar` is group-theoretic.** -/
theorem barMap_topBar (ψ : G ≃ₜ* G') (x : TopologicalAbelianization G) :
    barMap ψ (topBar G x) = topBar G' (abEquiv ψ x) := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
  change toBar G' _ (abMk _ _) = toBar G' _ (abMk _ _)
  refine toBar_mk_eq ?_ _ _ rfl
  ext y
  simp [sg_idxMap, idxTop]

/-- **`G` acts trivially on `topBar`.** -/
theorem barConj_topBar (g : G) (x : TopologicalAbelianization G) :
    barConj G g (topBar G x) = topBar G x :=
  barConj_toBar_of_mem (mem_sg_idxTop g) _

end Colimit

/-! ### `G = G_k`: the comparison with `Ωˣ` -/

section Galois

variable {p : ℕ} [hp : Fact p.Prime]
variable {k : Type*} [Field k] [Algebra ℚ_[p] k] [FiniteDimensional ℚ_[p] k]
variable {Ω : Type*} [Field Ω] [Algebra k Ω] [Algebra ℚ_[p] Ω] [IsScalarTower ℚ_[p] k Ω]
  [IsAlgClosed Ω] [IsGalois k Ω] [Algebra.IsAlgebraic ℚ_[p] Ω]

variable (p) in
/-- **`abWeil U ≃ E_U^× → Ωˣ`** (local class field theory for `E_U`). -/
def weilMap (i : OpenIdx (Ω ≃ₐ[k] Ω)) : abWeil (sg i) →* Ωˣ :=
  (Units.map (algebraMap (fld i) Ω).toMonoidHom).comp
    ((multAbEquiv p (fld i) Ω).symm.toMonoidHom.comp (abWeilEquiv (galEquiv i)).toMonoidHom)

theorem val_weilMap (i : OpenIdx (Ω ≃ₐ[k] Ω)) (x : abWeil (sg i)) :
    ((weilMap p i x : Ωˣ) : Ω) =
      ((((multAbEquiv p (fld i) Ω).symm (abWeilEquiv (galEquiv i) x) : (fld i)ˣ) : fld i) : Ω) :=
  rfl

set_option maxHeartbeats 2000000 in
-- unifying `Gal(Ω/E_V)` with `Gal(Ω/F)` for `F = extendScalars` (definitionally equal) is slow
/-- **Compatibility of the transfer with the Weil part**: for open `V ⊆ U` the transfer
`U^ab → V^ab` maps `abWeil U` into `abWeil V`, compatibly with `E_U^× ⊆ E_V^×` (the transfer
property of the Artin map, `PadicField.artin_transfer`). -/
theorem verAb_weil {i j : OpenIdx (Ω ≃ₐ[k] Ω)} (h : i ≤ j) (u : abWeil (sg i)) :
    ∃ hu : verAb (sg_le h) (isOpen_sg j) (u : TopologicalAbelianization (sg i)) ∈ abWeil (sg j),
      weilMap p j ⟨_, hu⟩ = weilMap p i u := by
  obtain ⟨g0, hg0⟩ := QuotientGroup.mk'_surjective _ (u : TopologicalAbelianization (sg i))
  set F : IntermediateField (fld i) Ω := extendScalars (fld_mono h)
  haveI : Module.Finite k F := (inferInstance : FiniteDimensional k (fld j))
  haveI : FiniteDimensional (fld i) F := Module.Finite.of_restrictScalars_finite k (fld i) F
  set a : (fld i)ˣ := (multAbEquiv p (fld i) Ω).symm (abWeilEquiv (galEquiv i) u)
  have hg : AlgEquiv.restrictNormalHom (maxAbelian (fld i) Ω) (galEquiv i g0) =
      artin p (fld i) Ω a := by
    rw [← galAbEquiv_multAbEquiv, MulEquiv.apply_symm_apply, coe_abWeilEquiv, ← hg0]
    rfl
  have hT := artin_transfer (p := p) F a (galEquiv i g0) hg
  set e : sg i ≃* (Ω ≃ₐ[fld i] Ω) := (galEquiv i).toMulEquiv
  have hmap : ((sg j).subgroupOf (sg i)).map e.toMonoidHom = F.fixingSubgroup := by
    ext x
    simp only [Subgroup.mem_map, Subgroup.mem_subgroupOf]
    constructor
    · rintro ⟨y, hy, rfl⟩
      rw [← fixingSubgroup_fld j] at hy
      intro z
      exact hy ⟨z, z.2⟩
    · intro hx
      refine ⟨e.symm x, ?_, by simp⟩
      rw [← fixingSubgroup_fld j]
      intro z
      have := hx ⟨z, z.2⟩
      change e (e.symm x) z = z at this
      exact this
  letI := galAbCommGroup p F Ω
  have hver : ver p F (galEquiv i g0) =
      galAbEquiv p F Ω (abEquiv (galEquiv j) (verAb (sg_le h) (isOpen_sg j) (abMk _ g0))) := by
    rw [verAb_mk, ver]
    change ((AlgEquiv.restrictNormalHom (maxAbelian F Ω)).comp
      (fixingSubgroupEquiv F).toMonoidHom).transfer (e g0) = _
    rw [MonoidHom.transfer_map_equiv e hmap]
    set f : TopologicalAbelianization (sg j) →* (maxAbelian F Ω ≃ₐ[F] maxAbelian F Ω) :=
      (galAbEquiv p F Ω).toMulEquiv.toMonoidHom.comp (abEquiv (galEquiv j)).toMonoidHom
    rw [show galAbEquiv p F Ω (abEquiv (galEquiv j) ((abMkOf (sg_le h)).transfer g0)) =
      f ((abMkOf (sg_le h)).transfer g0) from rfl, ← transfer_comp_hom]
    congr 1
  set a' : Fˣ := Units.map (algebraMap (fld i) F : fld i →* F) a
  have h3 : abEquiv (galEquiv j) (verAb (sg_le h) (isOpen_sg j) (abMk _ g0)) =
      (show TopologicalAbelianization (Ω ≃ₐ[fld j] Ω) from
        Subtype.val (multAbEquiv p F Ω a')) := by
    apply (galAbEquiv p F Ω).injective
    rw [galAbEquiv_multAbEquiv, ← hver, ← hT]
  have hu : verAb (sg_le h) (isOpen_sg j) (u : TopologicalAbelianization (sg i)) ∈
      abWeil (sg j) := by
    rw [← hg0, ← abEquiv_mem_abWeil_iff (galEquiv j)]
    change abEquiv (galEquiv j) (verAb (sg_le h) (isOpen_sg j) (abMk _ g0)) ∈ _
    rw [h3]
    exact (multAbEquiv p F Ω a').2
  refine ⟨hu, ?_⟩
  have h4 : abWeilEquiv (galEquiv j) ⟨_, hu⟩ = multAbEquiv p F Ω a' := by
    apply Subtype.ext
    rw [coe_abWeilEquiv]
    change abEquiv (galEquiv j) (verAb (sg_le h) (isOpen_sg j)
      (u : TopologicalAbelianization (sg i))) = _
    rw [← hg0]
    exact h3
  apply Units.ext
  change ((((multAbEquiv p (fld j) Ω).symm (abWeilEquiv (galEquiv j) ⟨_, hu⟩) :
    (fld j)ˣ) : fld j) : Ω) = (((a : (fld i)ˣ) : fld i) : Ω)
  rw [h4]
  change ((((multAbEquiv p F Ω).symm (multAbEquiv p F Ω a') : Fˣ) : F) : Ω) = _
  rw [MulEquiv.symm_apply_apply]
  rfl

include hp in
theorem abTrans_mem_abWeil {i j : OpenIdx (Ω ≃ₐ[k] Ω)} (h : i ≤ j) {x : AbFam _ i}
    (hx : x ∈ abWeil (sg i)) : abTrans _ i j h x ∈ abWeil (sg j) :=
  (verAb_weil (p := p) h ⟨x, hx⟩).1

include hp in
theorem weilMap_abTrans {i j : OpenIdx (Ω ≃ₐ[k] Ω)} (h : i ≤ j) (x : abWeil (sg i)) :
    weilMap p j ⟨abTrans _ i j h x, abTrans_mem_abWeil (p := p) h x.2⟩ = weilMap p i x :=
  (verAb_weil (p := p) h x).2

include hp in
/-- **For `G_k`, `k̄^×(G_k)` is the union of the images of the `abWeil U`.** -/
theorem mem_weilBar_iff (z : AbBar (Ω ≃ₐ[k] Ω)) :
    z ∈ weilBar (Ω ≃ₐ[k] Ω) ↔
      ∃ i, ∃ x ∈ abWeil (sg i), z = toBar (Ω ≃ₐ[k] Ω) i x := by
  constructor
  · intro hz
    refine Subgroup.iSup_induction (C := fun z => ∃ i, ∃ x ∈ abWeil (sg i),
      z = toBar (Ω ≃ₐ[k] Ω) i x) _ hz ?_ ?_ ?_
    · rintro i _ ⟨x, hx, rfl⟩
      exact ⟨i, x, hx, rfl⟩
    · obtain ⟨i⟩ := (inferInstance : Nonempty (OpenIdx (Ω ≃ₐ[k] Ω)))
      exact ⟨i, 1, Subgroup.one_mem _, (map_one _).symm⟩
    · rintro _ _ ⟨i, x, hx, rfl⟩ ⟨j, y, hy, rfl⟩
      obtain ⟨l, hil, hjl⟩ := exists_ge_ge i j
      refine ⟨l, abTrans _ i l hil x * abTrans _ j l hjl y,
        Subgroup.mul_mem _ (abTrans_mem_abWeil (p := p) hil hx)
          (abTrans_mem_abWeil (p := p) hjl hy), ?_⟩
      rw [map_mul, toBar_abTrans, toBar_abTrans]
  · rintro ⟨i, x, hx, rfl⟩
    exact toBar_mem_weilBar _ i hx

include hp in
theorem weilMap_eq_of_toBar_eq {i j : OpenIdx (Ω ≃ₐ[k] Ω)} (x : abWeil (sg i))
    (y : abWeil (sg j)) (hxy : toBar _ i (x : AbFam _ i) = toBar _ j (y : AbFam _ j)) :
    weilMap p i x = weilMap p j y := by
  obtain ⟨l, hil, hjl, hl⟩ := Quotient.exact hxy
  rw [← weilMap_abTrans (p := p) hil x, ← weilMap_abTrans (p := p) hjl y]
  congr 1
  exact Subtype.ext hl

variable (p) in
/-- The map `k̄^×(G_k) → Ωˣ`. -/
def weilBarFun (z : weilBar (Ω ≃ₐ[k] Ω)) : Ωˣ :=
  have h := (mem_weilBar_iff (p := p) z.1).1 z.2
  weilMap p h.choose ⟨h.choose_spec.choose, h.choose_spec.choose_spec.1⟩

theorem weilBarFun_eq (z : weilBar (Ω ≃ₐ[k] Ω)) (i : OpenIdx (Ω ≃ₐ[k] Ω))
    (x : abWeil (sg i)) (hz : (z : AbBar _) = toBar _ i (x : AbFam _ i)) :
    weilBarFun p z = weilMap p i x := by
  have h := (mem_weilBar_iff (p := p) z.1).1 z.2
  exact weilMap_eq_of_toBar_eq _ _ (h.choose_spec.choose_spec.2.symm.trans hz)

variable (p) in
/-- **The homomorphism `k̄^×(G_k) → Ωˣ`.** -/
def weilBarHom : weilBar (Ω ≃ₐ[k] Ω) →* Ωˣ where
  toFun := weilBarFun p
  map_one' := by
    obtain ⟨i⟩ := (inferInstance : Nonempty (OpenIdx (Ω ≃ₐ[k] Ω)))
    rw [weilBarFun_eq 1 i 1 (by simp), map_one]
  map_mul' z w := by
    obtain ⟨i, x, hx, hz⟩ := (mem_weilBar_iff (p := p) z.1).1 z.2
    obtain ⟨j, y, hy, hw⟩ := (mem_weilBar_iff (p := p) w.1).1 w.2
    obtain ⟨l, hil, hjl⟩ := exists_ge_ge i j
    have hx' := abTrans_mem_abWeil (p := p) hil hx
    have hy' := abTrans_mem_abWeil (p := p) hjl hy
    rw [weilBarFun_eq z l ⟨_, hx'⟩ (by rw [hz]; exact (toBar_abTrans _ hil x).symm),
      weilBarFun_eq w l ⟨_, hy'⟩ (by rw [hw]; exact (toBar_abTrans _ hjl y).symm),
      weilBarFun_eq (z * w) l (⟨_, hx'⟩ * ⟨_, hy'⟩) (by
        change (z : AbBar (Ω ≃ₐ[k] Ω)) * (w : AbBar (Ω ≃ₐ[k] Ω)) = _
        rw [hz, hw, ← toBar_abTrans _ hil x, ← toBar_abTrans _ hjl y, ← map_mul]
        rfl), map_mul]

theorem weilBarHom_toBar (i : OpenIdx (Ω ≃ₐ[k] Ω)) (x : abWeil (sg i)) :
    weilBarHom p ⟨toBar _ i (x : AbFam _ i), toBar_mem_weilBar _ i x.2⟩ = weilMap p i x :=
  weilBarFun_eq _ i x rfl

theorem weilMap_injective (i : OpenIdx (Ω ≃ₐ[k] Ω)) : Function.Injective (weilMap p i) := by
  intro x y h
  apply (abWeilEquiv (galEquiv i)).injective
  apply (multAbEquiv p (fld i) Ω).symm.injective
  apply Units.ext
  apply (algebraMap (fld i) Ω).injective
  exact congrArg (fun u : Ωˣ => (u : Ω)) h

theorem weilBarHom_injective : Function.Injective (weilBarHom (k := k) (Ω := Ω) p) := by
  rw [injective_iff_map_eq_one]
  intro z hz
  obtain ⟨i, x, hx, hzx⟩ := (mem_weilBar_iff (p := p) z.1).1 z.2
  have h1 : weilMap p i ⟨x, hx⟩ = weilMap p i 1 := by
    rw [map_one, ← hz]
    exact (weilBarFun_eq z i ⟨x, hx⟩ hzx).symm
  have h2 := weilMap_injective i h1
  apply Subtype.ext
  rw [hzx]
  have : x = 1 := congrArg Subtype.val h2
  rw [this, map_one]
  rfl

theorem weilBarHom_surjective : Function.Surjective (weilBarHom (k := k) (Ω := Ω) p) := by
  intro u
  set E : IntermediateField k Ω := k⟮(u : Ω)⟯
  haveI : FiniteDimensional k E :=
    adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral (u : Ω))
  set i : OpenIdx (Ω ≃ₐ[k] Ω) := OrderDual.toDual ⟨E.fixingSubgroup, E.fixingSubgroup_isOpen⟩
  have hfi : fld i = E := InfiniteGalois.fixedField_fixingSubgroup E
  have hu : (u : Ω) ∈ fld i := by rw [hfi]; exact mem_adjoin_simple_self k _
  set a : (fld i)ˣ := Units.mk0 ⟨_, hu⟩ fun h0 => u.ne_zero (congrArg Subtype.val h0)
  set x : abWeil (sg i) := (abWeilEquiv (galEquiv i)).symm (multAbEquiv p (fld i) Ω a)
  refine ⟨_, (weilBarHom_toBar i x).trans ?_⟩
  apply Units.ext
  change ((((multAbEquiv p (fld i) Ω).symm (abWeilEquiv (galEquiv i)
    ((abWeilEquiv (galEquiv i)).symm (multAbEquiv p (fld i) Ω a))) : (fld i)ˣ) : fld i) : Ω) =
    (u : Ω)
  rw [MulEquiv.apply_symm_apply, MulEquiv.symm_apply_apply]
  rfl

variable (p k Ω) in
/-- **`k̄^×(G_k) ≃ Ωˣ`**: the Weil parts of the `U^ab`, glued along the transfer, form the
multiplicative group of `Ω` (cf. [AbsAnab], Proposition 1.2.1 (vii), proof). -/
def weilBarEquiv : weilBar (Ω ≃ₐ[k] Ω) ≃* Ωˣ :=
  MulEquiv.ofBijective (weilBarHom p) ⟨weilBarHom_injective, weilBarHom_surjective⟩

theorem weilBarEquiv_apply (z : weilBar (Ω ≃ₐ[k] Ω)) : weilBarEquiv p k Ω z = weilBarHom p z :=
  rfl

/-! ### Agreement with `unitsBarEquiv` -/

theorem weilMap_of_mem_abUnits (i : OpenIdx (Ω ≃ₐ[k] Ω)) (x : abUnits (sg i)) :
    weilMap p i ⟨x, abUnits_le_abWeil _ x.2⟩ = (unitsMap p i x : Ωˣ) := by
  have hu : (multAbEquiv p (fld i) Ω).symm (abWeilEquiv (galEquiv i)
      ⟨x, abUnits_le_abWeil _ x.2⟩) = (((unitsAbEquiv p (fld i) Ω).symm
        (abUnitsEquiv (galEquiv i) x) : unitGroup p (fld i)) : (fld i)ˣ) := by
    rw [MulEquiv.symm_apply_eq]
    apply Subtype.ext
    rw [coe_abWeilEquiv, multAbEquiv_coe_unit, MulEquiv.apply_symm_apply, coe_abUnitsEquiv]
  apply Units.ext
  rw [val_weilMap, hu]
  rfl

/-- **`weilBarHom` extends the comparison `unitsBarEquiv : 𝒪^×_{k̄}(G_k) ≃ 𝒪^×_Ω`.** -/
theorem weilBarHom_eq_unitsBarEquiv (z : unitsBar (Ω ≃ₐ[k] Ω)) :
    weilBarHom p ⟨z, unitsBar_le_weilBar (Ω ≃ₐ[k] Ω) z.2⟩ = (unitsBarEquiv p k Ω z : Ωˣ) := by
  obtain ⟨i, x, hx, hz⟩ := (mem_unitsBar_iff (p := p) z.1).1 z.2
  have h1 := weilBarFun_eq (p := p) ⟨z, unitsBar_le_weilBar (Ω ≃ₐ[k] Ω) z.2⟩ i
    ⟨x, abUnits_le_abWeil _ hx⟩ hz
  have hz' : z = ⟨toBar _ i x, (mem_unitsBar_iff (p := p) _).2 ⟨i, x, hx, rfl⟩⟩ := Subtype.ext hz
  change weilBarFun p _ = _
  rw [h1, weilMap_of_mem_abUnits i ⟨x, hx⟩, hz']
  exact congrArg (fun w : unitsΩ p Ω => (w : Ωˣ)) (unitsBarEquiv_toBar (p := p) i ⟨x, hx⟩).symm

/-! ### `G_k`-equivariance -/

section Equivariance

variable (σ : Ω ≃ₐ[k] Ω) (i : OpenIdx (Ω ≃ₐ[k] Ω))

set_option maxHeartbeats 1000000 in
-- elaborating the fixed fields of open subgroups and their Galois groups is slow
/-- **`G_k`-equivariance on generators** (`PadicField.artin_naturality`). -/
theorem weilMap_conj (x : abWeil (sg i)) :
    ((weilMap p (idxMap (conjCont σ) i)
        ⟨abFamEquiv (conjCont σ) i x, (abEquiv_mem_abWeil_iff _ _).2 x.2⟩ : Ωˣ) : Ω) =
      σ ((weilMap p i x : Ωˣ) : Ω) := by
  set j := idxMap (conjCont σ) i
  set τ := fldConj (p := p) σ i
  obtain ⟨g0, hg0⟩ := QuotientGroup.mk'_surjective _ (x : TopologicalAbelianization (sg i))
  set a : (fld i)ˣ := (multAbEquiv p (fld i) Ω).symm (abWeilEquiv (galEquiv i) x)
  have hg : AlgEquiv.restrictNormalHom (maxAbelian (fld i) Ω) (galEquiv i g0) =
      artin p (fld i) Ω a := by
    rw [← galAbEquiv_multAbEquiv, MulEquiv.apply_symm_apply, coe_abWeilEquiv, ← hg0]
    rfl
  set b : (fld j)ˣ := Units.map (τ : fld i →* fld j) a
  set x' : abWeil (sg j) := ⟨abFamEquiv (conjCont σ) i x, (abEquiv_mem_abWeil_iff _ _).2 x.2⟩
  have hx' : abWeilEquiv (galEquiv j) x' = multAbEquiv p (fld j) Ω b := by
    apply Subtype.ext
    apply (galAbEquiv p (fld j) Ω).injective
    rw [galAbEquiv_multAbEquiv, coe_abWeilEquiv]
    change galAbEquiv p (fld j) Ω (abEquiv (galEquiv j) (abFamEquiv (conjCont σ) i
      (x : TopologicalAbelianization (sg i)))) = _
    rw [← hg0]
    change galAbEquiv p (fld j) Ω (abEquiv (galEquiv j)
      (QuotientGroup.mk (sgEquiv (conjCont σ) i g0))) = _
    rw [abEquiv_mk, galAbEquiv_mk]
    ext y'
    obtain ⟨y, rfl⟩ := (maxAbelianRingEquiv τ σ.toRingEquiv (fldConj_compat σ i)).surjective y'
    have hN := artin_naturality τ σ.toRingEquiv (fldConj_compat σ i) a y
    change _ = (artin p (fld j) Ω (Units.map (τ : fld i →* fld j) a)
      (maxAbelianRingEquiv τ σ.toRingEquiv (fldConj_compat σ i) y) : Ω)
    rw [hN, ← hg]
    have hc := AlgEquiv.restrictNormal_commutes (galEquiv i g0) (maxAbelian (fld i) Ω) y
    change _ = σ (algebraMap (maxAbelian (fld i) Ω) Ω ((galEquiv i g0).restrictNormal _ y))
    rw [hc]
    have hc' := AlgEquiv.restrictNormal_commutes (galEquiv j (sgEquiv (conjCont σ) i g0))
      (maxAbelian (fld j) Ω) (maxAbelianRingEquiv τ σ.toRingEquiv (fldConj_compat σ i) y)
    change algebraMap (maxAbelian (fld j) Ω) Ω
      ((galEquiv j (sgEquiv (conjCont σ) i g0)).restrictNormal _
        (maxAbelianRingEquiv τ σ.toRingEquiv (fldConj_compat σ i) y)) = _
    rw [hc']
    change (galEquiv j (sgEquiv (conjCont σ) i g0)) (σ (y : Ω)) = σ (galEquiv i g0 (y : Ω))
    rw [galEquiv_apply, galEquiv_apply, coe_sgEquiv, conjCont_apply]
    change σ ((g0 : Ω ≃ₐ[k] Ω) (σ⁻¹ (σ (y : Ω)))) = _
    rw [show σ⁻¹ (σ (y : Ω)) = (y : Ω) from σ.symm_apply_apply _]
  change ((((multAbEquiv p (fld j) Ω).symm (abWeilEquiv (galEquiv j) x')) : (fld j)ˣ) :
    fld j) = σ ((((a : (fld i)ˣ) : fld i) : Ω))
  rw [hx', MulEquiv.symm_apply_apply]
  rfl

/-- **`weilBarHom` is `G_k`-equivariant.** -/
theorem weilBarHom_barConj (z : weilBar (Ω ≃ₐ[k] Ω)) :
    ((weilBarHom p ⟨barConj _ σ z, barConj_mem_weilBar σ z.2⟩ : Ωˣ) : Ω) =
      σ ((weilBarHom p z : Ωˣ) : Ω) := by
  obtain ⟨i, x, hx, hz⟩ := (mem_weilBar_iff (p := p) z.1).1 z.2
  have hz' : z = ⟨toBar _ i x, toBar_mem_weilBar _ i hx⟩ := Subtype.ext hz
  subst hz'
  have h1 : barConj _ σ (toBar (Ω ≃ₐ[k] Ω) i x) =
      toBar _ (idxMap (conjCont σ) i) (abFamEquiv (conjCont σ) i x) := rfl
  have e1 := weilBarHom_toBar (p := p) i ⟨x, hx⟩
  have e2 := weilBarHom_toBar (p := p) (idxMap (conjCont σ) i)
    ⟨abFamEquiv (conjCont σ) i x, (abEquiv_mem_abWeil_iff _ _).2 hx⟩
  simp only [h1]
  rw [e2, e1]
  exact weilMap_conj σ i ⟨x, hx⟩

end Equivariance

/-! ### The top level: `k^×` -/

theorem mem_fld_idxTop (c : k) : algebraMap k Ω c ∈ fld (idxTop (Ω ≃ₐ[k] Ω)) := by
  rw [fld, IntermediateField.mem_fixedField_iff]
  intro g _
  exact g.commutes c

/-- The fixed field of `G_k` contains `k`. -/
def kToFldTop : k →ₐ[ℚ_[p]] fld (idxTop (Ω ≃ₐ[k] Ω)) where
  toFun c := ⟨algebraMap k Ω c, mem_fld_idxTop c⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' _ _ := Subtype.ext (map_mul _ _ _)
  map_zero' := Subtype.ext (map_zero _)
  map_add' _ _ := Subtype.ext (map_add _ _ _)
  commutes' c := Subtype.ext (IsScalarTower.algebraMap_apply ℚ_[p] k Ω c).symm

theorem kToFldTop_bijective : Function.Bijective (kToFldTop (p := p) (k := k) (Ω := Ω)) := by
  refine ⟨fun c d h => (algebraMap k Ω).injective (congrArg Subtype.val h), fun y => ?_⟩
  have hy : (y : Ω) ∈ (⊥ : IntermediateField k Ω) := by
    have h1 : fld (idxTop (Ω ≃ₐ[k] Ω)) = ⊥ := by
      change fixedField (⊤ : Subgroup (Ω ≃ₐ[k] Ω)) = ⊥
      rw [← IntermediateField.fixingSubgroup_bot]
      exact InfiniteGalois.fixedField_fixingSubgroup ⊥
    rw [← h1]
    exact y.2
  obtain ⟨c, hc⟩ := IntermediateField.mem_bot.1 hy
  exact ⟨c, Subtype.ext hc⟩

variable (p k Ω) in
/-- `k ≃ E_{G_k}`. -/
def kFldTopEquiv : k ≃ₐ[ℚ_[p]] fld (idxTop (Ω ≃ₐ[k] Ω)) :=
  AlgEquiv.ofBijective kToFldTop kToFldTop_bijective

theorem kFldTopEquiv_compat (c : k) :
    (RingEquiv.refl Ω) (algebraMap k Ω c) =
      algebraMap (fld (idxTop (Ω ≃ₐ[k] Ω))) Ω (kFldTopEquiv p k Ω c) := rfl

set_option maxHeartbeats 1000000 in
-- elaborating the fixed fields of open subgroups and their Galois groups is slow
/-- **At the top level, `weilMap` is the inverse of the Artin map of `k`**: the image of
`x = artin(a) ∈ abWeil(G_k)` is `a`. -/
theorem weilMap_topBar (a : kˣ) :
    weilMap p (idxTop (Ω ≃ₐ[k] Ω)) ⟨abEquiv (topCont _) (multAbEquiv p k Ω a),
      (abEquiv_mem_abWeil_iff _ _).2 (multAbEquiv p k Ω a).2⟩ =
      Units.map (algebraMap k Ω).toMonoidHom a := by
  set j := idxTop (Ω ≃ₐ[k] Ω)
  set τ := kFldTopEquiv p k Ω
  set σ := RingEquiv.refl Ω
  obtain ⟨g0, hg0⟩ := QuotientGroup.mk'_surjective _
    ((multAbEquiv p k Ω a : abWeil _) : TopologicalAbelianization (Ω ≃ₐ[k] Ω))
  have hg : AlgEquiv.restrictNormalHom (maxAbelian k Ω) g0 = artin p k Ω a := by
    rw [← galAbEquiv_multAbEquiv, ← hg0]
    rfl
  set b : (fld j)ˣ := Units.map (τ : k →* fld j) a
  set x' : abWeil (sg j) := ⟨abEquiv (topCont _) (multAbEquiv p k Ω a),
    (abEquiv_mem_abWeil_iff _ _).2 (multAbEquiv p k Ω a).2⟩
  have hx' : abWeilEquiv (galEquiv j) x' = multAbEquiv p (fld j) Ω b := by
    apply Subtype.ext
    apply (galAbEquiv p (fld j) Ω).injective
    rw [galAbEquiv_multAbEquiv, coe_abWeilEquiv]
    change galAbEquiv p (fld j) Ω (abEquiv (galEquiv j) (abEquiv (topCont _)
      ((multAbEquiv p k Ω a : abWeil _) : TopologicalAbelianization (Ω ≃ₐ[k] Ω)))) = _
    rw [← hg0]
    change galAbEquiv p (fld j) Ω (abEquiv (galEquiv j)
      (QuotientGroup.mk (topCont _ g0))) = _
    rw [abEquiv_mk, galAbEquiv_mk]
    ext y'
    obtain ⟨y, rfl⟩ := (maxAbelianRingEquiv τ σ kFldTopEquiv_compat).surjective y'
    have hN := artin_naturality τ σ kFldTopEquiv_compat a y
    change _ = (artin p (fld j) Ω (Units.map (τ : k →* fld j) a)
      (maxAbelianRingEquiv τ σ kFldTopEquiv_compat y) : Ω)
    rw [hN, ← hg]
    have hc := AlgEquiv.restrictNormal_commutes g0 (maxAbelian k Ω) y
    change _ = σ (algebraMap (maxAbelian k Ω) Ω (g0.restrictNormal _ y))
    rw [hc]
    have hc' := AlgEquiv.restrictNormal_commutes (galEquiv j (topCont _ g0))
      (maxAbelian (fld j) Ω) (maxAbelianRingEquiv τ σ kFldTopEquiv_compat y)
    change algebraMap (maxAbelian (fld j) Ω) Ω
      ((galEquiv j (topCont _ g0)).restrictNormal _
        (maxAbelianRingEquiv τ σ kFldTopEquiv_compat y)) = _
    rw [hc']
    rfl
  apply Units.ext
  change ((((multAbEquiv p (fld j) Ω).symm (abWeilEquiv (galEquiv j) x')) : (fld j)ˣ) :
    fld j) = algebraMap k Ω (a : k)
  rw [hx', MulEquiv.symm_apply_apply]
  rfl

set_option maxHeartbeats 1000000 in
-- elaborating the fixed fields of open subgroups and their Galois groups is slow
/-- **`weilBarHom` on `topBar`**: the image of `x = artin(a)`, `a ∈ k^×`, at the top level is
`a`. -/
theorem weilBarHom_topBar (a : kˣ) :
    weilBarHom p ⟨topBar _ (multAbEquiv p k Ω a),
      topBar_mem_weilBar (G := Ω ≃ₐ[k] Ω) (multAbEquiv p k Ω a).2⟩ =
      Units.map (algebraMap k Ω).toMonoidHom a := by
  exact (weilBarHom_toBar (p := p) (idxTop (Ω ≃ₐ[k] Ω)) ⟨abEquiv (topCont _)
    (multAbEquiv p k Ω a), (abEquiv_mem_abWeil_iff _ _).2 (multAbEquiv p k Ω a).2⟩).trans
    (weilMap_topBar (p := p) a)

end Galois

end

end Iut.Reconstruction
