import Iut.Reconstruction.Transfer
import Iut.Reconstruction.Local.LogShellMono
import Mathlib.Algebra.Colimit.DirectLimit
import Mathlib.Topology.Algebra.OpenSubgroup

/-!
# `𝒪^×_{k̄}(G)` from `G` alone: the colimit along the transfer (roadmap MR11)

[AbsTopIII], Proposition 5.8 (i):

> "Let `G_k` be the absolute Galois group of an MLF `k`. Then there exists a functorial [i.e.,
> relative to `TG⊢`] 'group-theoretic' algorithm for constructing the images of the embeddings
> `O▷_k ↪ G_k^ab`, `k^× ↪ G_k^ab` of local class field theory […]. Here, the asserted
> 'functoriality' is contravariant and induced by the Verlagerung, or transfer, map on
> abelianizations."

and (ii) constructs from `G` the `G`-module `O^×_{k̄}(G)` (the `𝒪^×` of the algebraic closure)
and `k∼(G) = (O^×_{k̄}(G))^pf`. Here, for a compact topological group `G` (no further
hypothesis), we form

* `AbBar G = lim→_{U} U^ab`, the direct limit of the topological abelianizations of the open
  subgroups `U ⊆ G` along the transfer `Ver : U^ab → V^ab` (`V ⊆ U`), which is a directed system
  by `verAb_self` and the transitivity `verAb_verAb` (`Iut/Reconstruction/Transfer.lean`);
* `unitsBar G ⊆ AbBar G`, generated by the images of the reconstructed `𝒪^×(U) = abUnits U`
  (the image of the reconstructed inertia in `U^ab`);
* `barMap ψ : AbBar G ≃* AbBar G'` for every isomorphism of topological groups
  `ψ : G ≃ₜ* G'` (**functoriality**, `barMap_trans`, `barMap_refl`; it maps `unitsBar` onto
  `unitsBar`, `map_unitsBar`), hence the **`G`-action** `barConj g = barMap (conj g)`
  (`barConj_mul`, `barConj_one`);
* `barConj_toBar_of_mem`: an element of `U` acts trivially on the image of `U^ab`, i.e. the image
  of `U^ab` lies in the `U`-invariants (`(O^×_{k̄})^{G_E} ⊇ 𝒪^×_E`).

The comparison with the field model `𝒪^×_{k̄}` for `G = Gal(Ω/k)` uses the transfer property of
the Artin map (`PadicField.artin_transfer`), see `UnitsColimitGalois.lean`.
-/

namespace Iut.Reconstruction

open MonoidHom

set_option linter.unusedSectionVars false

noncomputable section

section Colimit

variable (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]

instance finiteIndex_openSubgroup (U : OpenSubgroup G) : (U : Subgroup G).FiniteIndex :=
  Subgroup.finiteIndex_of_finite_quotient

/-- The index set: open subgroups, ordered by reverse inclusion. -/
abbrev OpenIdx : Type _ := (OpenSubgroup G)ᵒᵈ

variable {G} in
/-- The subgroup of an index. -/
abbrev sg (i : OpenIdx G) : Subgroup G := ((OrderDual.ofDual i : OpenSubgroup G) : Subgroup G)

variable {G} in
theorem isOpen_sg (i : OpenIdx G) : IsOpen (sg i : Set G) := (OrderDual.ofDual i).isOpen

variable {G} in
theorem sg_le {i j : OpenIdx G} (h : i ≤ j) : sg j ≤ sg i := h

/-- The family `U ↦ U^ab`. -/
abbrev AbFam (i : OpenIdx G) : Type _ := TopologicalAbelianization (sg i)

/-- The transition maps: the transfer. -/
def abTrans (i j : OpenIdx G) (h : i ≤ j) : AbFam G i →* AbFam G j :=
  verAb (sg_le h) (isOpen_sg j)

instance directedSystem_abTrans : DirectedSystem (AbFam G) (fun i j h => abTrans G i j h) where
  map_self _ x := verAb_self _ x
  map_map _ _ _ _ _ x := verAb_verAb _ _ _ _ x

/-- **`lim→_U U^ab` along the transfer.** -/
abbrev AbBar : Type _ := DirectLimit (AbFam G) (abTrans G)

/-- The canonical map `U^ab → AbBar G`. -/
def toBar (i : OpenIdx G) : AbFam G i →* AbBar G where
  toFun x := ⟦⟨i, x⟩⟧
  map_one' := (DirectLimit.one_def i).symm
  map_mul' x y := (DirectLimit.mul_def i x y).symm

theorem toBar_abTrans {i j : OpenIdx G} (h : i ≤ j) (x : AbFam G i) :
    toBar G j (abTrans G i j h x) = toBar G i x :=
  (DirectLimit.eq_of_le (f := abTrans G) ⟨i, x⟩ j h).symm

theorem exists_toBar (z : AbBar G) : ∃ i x, z = toBar G i x := DirectLimit.exists_eq_mk _ z

/-- **`𝒪^×_{k̄}(G)`**: the subgroup generated by the images of the reconstructed
`𝒪^×(U) = abUnits U`. -/
def unitsBar : Subgroup (AbBar G) := ⨆ i : OpenIdx G, (abUnits (sg i)).map (toBar G i)

variable {G} in
/-- Equal subgroups give the same element of the colimit. -/
theorem toBar_mk_eq {i j : OpenIdx G} (hij : sg i = sg j) (g : sg i) (g' : sg j)
    (hg : (g : G) = g') : toBar G i (abMk _ g) = toBar G j (abMk _ g') := by
  have h : i ≤ j := hij.symm.le
  rw [← toBar_abTrans G h]
  congr 1
  exact verAb_of_ge _ hij.le (isOpen_sg j) g |>.trans (by congr 1; exact Subtype.ext hg)

end Colimit

/-! ### Functoriality -/

section Functorial

variable {G G' G'' : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [Group G'] [TopologicalSpace G'] [IsTopologicalGroup G'] [CompactSpace G']
  [Group G''] [TopologicalSpace G''] [IsTopologicalGroup G''] [CompactSpace G'']

/-- The image `ψ(U)` of an open subgroup. -/
def idxMap (ψ : G ≃ₜ* G') (i : OpenIdx G) : OpenIdx G' :=
  OrderDual.toDual ⟨(sg i).comap ψ.symm.toMulEquiv.toMonoidHom,
    (isOpen_sg i).preimage ψ.symm.continuous⟩

theorem sg_idxMap (ψ : G ≃ₜ* G') (i : OpenIdx G) :
    sg (idxMap ψ i) = (sg i).comap ψ.symm.toMulEquiv.toMonoidHom := rfl

theorem idxMap_mono (ψ : G ≃ₜ* G') {i j : OpenIdx G} (h : i ≤ j) : idxMap ψ i ≤ idxMap ψ j :=
  fun _ hx => sg_le h hx

/-- `U ≃ₜ* ψ(U)`. -/
def sgEquiv (ψ : G ≃ₜ* G') (i : OpenIdx G) : sg i ≃ₜ* sg (idxMap ψ i) :=
  (comapContEquiv ψ.symm (sg i)).symm

theorem coe_sgEquiv (ψ : G ≃ₜ* G') (i : OpenIdx G) (u : sg i) :
    ((sgEquiv ψ i u : sg (idxMap ψ i)) : G') = ψ u := rfl

/-- `U^ab ≃ ψ(U)^ab`. -/
def abFamEquiv (ψ : G ≃ₜ* G') (i : OpenIdx G) : AbFam G i ≃* AbFam G' (idxMap ψ i) :=
  abEquiv (sgEquiv ψ i)

theorem abFamEquiv_mk (ψ : G ≃ₜ* G') (i : OpenIdx G) (u : sg i) :
    abFamEquiv ψ i (abMk _ u) = abMk _ (sgEquiv ψ i u) := rfl

/-- **Naturality of the transfer under isomorphisms.** -/
theorem abFamEquiv_abTrans (ψ : G ≃ₜ* G') {i j : OpenIdx G} (h : i ≤ j) (x : AbFam G i) :
    abFamEquiv ψ j (abTrans G i j h x) =
      abTrans G' _ _ (idxMap_mono ψ h) (abFamEquiv ψ i x) := by
  obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective _ x
  change abFamEquiv ψ j (verAb _ _ (abMk _ u)) = verAb _ _ (abFamEquiv ψ i (abMk _ u))
  rw [verAb_mk, abFamEquiv_mk, verAb_mk]
  set e : sg i ≃* sg (idxMap ψ i) := (sgEquiv ψ i).toMulEquiv
  have hmap : ((sg j).subgroupOf (sg i)).map e.toMonoidHom =
      (sg (idxMap ψ j)).subgroupOf (sg (idxMap ψ i)) := by
    ext x
    simp only [Subgroup.mem_map, Subgroup.mem_subgroupOf]
    constructor
    · rintro ⟨y, hy, rfl⟩
      change ψ.symm (ψ y) ∈ sg j
      simpa using hy
    · intro hx
      refine ⟨e.symm x, ?_, by simp⟩
      exact hx
  change abFamEquiv ψ j ((abMkOf (sg_le h)).transfer u) =
    (abMkOf (sg_le (idxMap_mono ψ h))).transfer (e u)
  rw [MonoidHom.transfer_map_equiv e hmap, ← MulEquiv.coe_toMonoidHom, ← transfer_comp_hom]
  congr 1

/-- **The map `AbBar G → AbBar G'` induced by `ψ : G ≃ₜ* G'`.** -/
def barMap (ψ : G ≃ₜ* G') : AbBar G →* AbBar G' where
  toFun := DirectLimit.lift (abTrans G)
    (fun i x => toBar G' (idxMap ψ i) (abFamEquiv ψ i x)) fun i j h x => by
      rw [abFamEquiv_abTrans, toBar_abTrans]
  map_one' := DirectLimit.lift_one (g := fun i => (toBar G' (idxMap ψ i)).comp
    (abFamEquiv ψ i).toMonoidHom) _
  map_mul' x y := DirectLimit.lift_mul (g := fun i => (toBar G' (idxMap ψ i)).comp
    (abFamEquiv ψ i).toMonoidHom) _ x y

theorem barMap_toBar (ψ : G ≃ₜ* G') (i : OpenIdx G) (x : AbFam G i) :
    barMap ψ (toBar G i x) = toBar G' (idxMap ψ i) (abFamEquiv ψ i x) := rfl

theorem barMap_toBar_mk (ψ : G ≃ₜ* G') (i : OpenIdx G) (u : sg i) :
    barMap ψ (toBar G i (abMk _ u)) = toBar G' (idxMap ψ i) (abMk _ (sgEquiv ψ i u)) := rfl

/-- Two homomorphisms out of `AbBar G` agreeing on the generators `toBar i (mk u)` agree. -/
theorem AbBar.hom_ext {M : Type*} [Monoid M] {φ φ' : AbBar G →* M}
    (h : ∀ i (u : sg i), φ (toBar G i (abMk _ u)) = φ' (toBar G i (abMk _ u))) : φ = φ' := by
  ext z
  obtain ⟨i, x, rfl⟩ := exists_toBar G z
  obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective _ x
  exact h i u

theorem barMap_trans (ψ : G ≃ₜ* G') (χ : G' ≃ₜ* G'') :
    barMap (ψ.trans χ) = (barMap χ).comp (barMap ψ) := by
  refine AbBar.hom_ext fun i u => ?_
  rw [MonoidHom.comp_apply, barMap_toBar_mk, barMap_toBar_mk, barMap_toBar_mk]
  exact toBar_mk_eq (by ext x; rfl) _ _ rfl

theorem barMap_refl : barMap (ContinuousMulEquiv.refl G) = MonoidHom.id (AbBar G) := by
  refine AbBar.hom_ext fun i u => ?_
  rw [barMap_toBar_mk, MonoidHom.id_apply]
  exact toBar_mk_eq (by ext x; rfl) _ _ rfl

/-- `barMap ψ` as an isomorphism. -/
def barEquiv (ψ : G ≃ₜ* G') : AbBar G ≃* AbBar G' where
  toFun := barMap ψ
  invFun := barMap ψ.symm
  left_inv z := by
    rw [← MonoidHom.comp_apply, ← barMap_trans]
    have : ψ.trans ψ.symm = ContinuousMulEquiv.refl G := by ext; simp
    rw [this, barMap_refl, MonoidHom.id_apply]
  right_inv z := by
    rw [← MonoidHom.comp_apply, ← barMap_trans]
    have : ψ.symm.trans ψ = ContinuousMulEquiv.refl G' := by ext; simp
    rw [this, barMap_refl, MonoidHom.id_apply]
  map_mul' := (barMap ψ).map_mul

theorem map_toBar_abUnits (ψ : G ≃ₜ* G') (i : OpenIdx G) :
    ((abUnits (sg i)).map (toBar G i)).map (barMap ψ) =
      (abUnits (sg (idxMap ψ i))).map (toBar G' (idxMap ψ i)) := by
  rw [Subgroup.map_map]
  have : (barMap ψ).comp (toBar G i) =
      (toBar G' (idxMap ψ i)).comp (abFamEquiv ψ i).toMonoidHom := rfl
  rw [this, ← Subgroup.map_map]
  congr 1
  exact map_abUnits (sgEquiv ψ i)

theorem map_unitsBar_le (ψ : G ≃ₜ* G') : (unitsBar G).map (barMap ψ) ≤ unitsBar G' := by
  rw [unitsBar, Subgroup.map_iSup, iSup_le_iff]
  intro i
  rw [map_toBar_abUnits]
  exact le_iSup (fun j : OpenIdx G' => (abUnits (sg j)).map (toBar G' j)) (idxMap ψ i)

/-- **`ψ` maps `𝒪^×_{k̄}(G)` onto `𝒪^×_{k̄}(G')`** (the construction is group-theoretic). -/
theorem map_unitsBar (ψ : G ≃ₜ* G') : (unitsBar G).map (barMap ψ) = unitsBar G' := by
  refine le_antisymm (map_unitsBar_le ψ) ?_
  intro z hz
  refine ⟨barMap ψ.symm z, map_unitsBar_le ψ.symm ⟨z, hz, rfl⟩, ?_⟩
  change (barEquiv ψ) ((barEquiv ψ).symm z) = z
  exact MulEquiv.apply_symm_apply _ z

/-! ### The `G`-action -/

/-- Conjugation by `g` as a topological automorphism. -/
def conjCont (g : G) : G ≃ₜ* G :=
  { toMulEquiv := MulAut.conj g
    continuous_toFun := (continuous_const.mul continuous_id).mul continuous_const
    continuous_invFun := (continuous_const.mul continuous_id).mul continuous_const }

theorem conjCont_apply (g x : G) : conjCont g x = g * x * g⁻¹ := rfl

variable (G) in
/-- **The action of `G` on `AbBar G`** (and on `𝒪^×_{k̄}(G)`). -/
def barConj (g : G) : AbBar G →* AbBar G := barMap (conjCont g)

theorem barConj_mul (g h : G) : barConj G (g * h) = (barConj G g).comp (barConj G h) := by
  rw [barConj, barConj, barConj, ← barMap_trans]
  congr 1
  ext x
  simp [conjCont_apply, mul_assoc]

theorem barConj_one : barConj G 1 = MonoidHom.id (AbBar G) := by
  rw [barConj, ← barMap_refl]
  congr 1
  ext x
  simp [conjCont_apply]

theorem map_barConj_unitsBar (g : G) : (unitsBar G).map (barConj G g) = unitsBar G :=
  map_unitsBar _

theorem idxMap_conj_of_mem {i : OpenIdx G} {h : G} (hh : h ∈ sg i) :
    sg (idxMap (conjCont h) i) = sg i := by
  ext x
  have hs : (conjCont h).symm x = h⁻¹ * x * h := by
    rw [ContinuousMulEquiv.symm_apply_eq]
    simp [conjCont_apply, mul_assoc]
  rw [sg_idxMap, Subgroup.mem_comap]
  change (conjCont h).symm x ∈ sg i ↔ x ∈ sg i
  rw [hs]
  constructor
  · intro hx
    have := (sg i).mul_mem ((sg i).mul_mem hh hx) ((sg i).inv_mem hh)
    simpa [mul_assoc] using this
  · intro hx
    exact (sg i).mul_mem ((sg i).mul_mem ((sg i).inv_mem hh) hx) hh

/-- **An element of `U` acts trivially on the image of `U^ab`**: the image of `U^ab` (in
particular of `𝒪^×(U)`) lies in the `U`-invariants of `AbBar G`. -/
theorem barConj_toBar_of_mem {i : OpenIdx G} {h : G} (hh : h ∈ sg i) (x : AbFam G i) :
    barConj G h (toBar G i x) = toBar G i x := by
  obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective _ x
  change barMap _ (toBar G i (abMk _ u)) = _
  rw [barMap_toBar_mk]
  have hu : (h * u * h⁻¹ : G) ∈ sg i :=
    (sg i).mul_mem ((sg i).mul_mem hh u.2) ((sg i).inv_mem hh)
  rw [toBar_mk_eq (idxMap_conj_of_mem hh) _ ⟨h * u * h⁻¹, hu⟩ rfl]
  congr 1
  have : (⟨h * u * h⁻¹, hu⟩ : sg i) = ⟨h, hh⟩ * u * (⟨h, hh⟩ : sg i)⁻¹ := rfl
  rw [this, map_mul, map_mul, map_inv, mul_comm, ← mul_assoc, inv_mul_cancel, one_mul]

end Functorial

end

end Iut.Reconstruction
