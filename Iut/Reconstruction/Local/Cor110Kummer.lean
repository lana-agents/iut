import Iut.Reconstruction.Local.AbelianZHat
import Iut.Reconstruction.Local.UnitIndex
import LocalClassFieldTheory.Reciprocity.ProfiniteCompletion

/-!
# `H¹(G_k, Ẑ(1)) ≅ G_k^ab ↠ Ẑ` and the Kummer image ([AbsTopIII], Corollary 1.10 (b), (d))

[AbsTopIII], Corollary 1.10 (i) (b) (`Topics in Absolute Anabelian Geometry III.txt`,
l.2401–2406):

> "(b) By applying the isomorphism of (a) [and the cup-product in group cohomology], one
> constructs the surjection `H¹(G_k, μ_Ẑ(G_k)) ∼→ G_k^ab ↠ G^unr ∼→ Ẑ` determined by the
> Frobenius element in the maximal unramified quotient `G^unr` of `G_k` via the
> "group-theoretic" algorithm described in the proof of [Mzk9], Proposition 1.2.1, (ii), (iv)."

and Corollary 1.10 (ii) (d) (l.2434–2442):

> "(d) One constructs the image of the Kummer map `k^× → H¹(G_k, μ_Ẑ(Π_X)) → H¹(Π_X, μ_Ẑ(Π_X))`
> as the inverse image of the subgroup generated by the Frobenius element via the surjection
> `H¹(G_k, μ_Ẑ(Π_X)) ∼→ H¹(G_k, μ_Ẑ(G_k)) ∼→ G_k^ab ↠ Ẑ` of (b) [cf. also the isomorphism of
> (c)]."

Here we prove the field-theoretic content of (b) and (d) for a finite extension `k/ℚ_p`, with
coefficients `Ẑ(1) = lim_n μ_n(Ω)` (`KummerTheory.ZHatOne`; the comparison with the
group-theoretic cyclotome `μ_Ẑ(G_k)` is `muNEquiv` of `Cor110.lean`, levelwise):

* **`h1AbEquiv p k Ω : H¹(G_k, Ẑ(1)) ≃* G_k^ab`**: Kummer theory
  (`KummerTheory.kummerZHatEquivProfiniteCompletion`, `H¹(G_k, Ẑ(1)) ≅ (k^×)^∧`) followed
  by local class field theory (`PadicField.artinCompletionEquiv`, `(k^×)^∧ ≅ Gal(k^ab/k)`) and
  `Gal(k^ab/k) ≅ G_k^ab`; it sends the Kummer class of `a ∈ k^×` to the image of `a` under the
  Artin map (`h1AbEquiv_kummerZHat`);
* **`frobAb p k Ω : G_k^ab ↠ Ẑ`**, the `Ẑ`-component of `G_k^ab ≅ 𝒪_k^× × Ẑ`; it factors through
  the unramified quotient `G_k ↠ G^unr ≅ Ẑ` (`frobAb_mk`), sends Frobenius lifts to `1`
  (`frobAb_of_isFrobLift`), is surjective, and is **group-theoretic**: for every isomorphism of
  topological groups `ψ : G_k ≃ₜ* G_{k'}`, `frobAb ∘ ψ^ab = frobAb` (`frobAb_abEquiv`);
* (d) **`range_kummerZHat`**: the image of the Kummer map `k^× → H¹(G_k, Ẑ(1))` is the inverse
  image of the subgroup `ℤ = ⟨Frob⟩ ⊆ Ẑ` under `H¹(G_k, Ẑ(1)) ≅ G_k^ab ↠ Ẑ`; the Kummer map is
  injective (`kummerZHat_injective`).
-/

namespace Iut.Reconstruction

open PadicField IntermediateField KummerTheory Brauer CategoryTheory ProfiniteGrp

set_option linter.unusedSectionVars false

noncomputable section

universe u

variable {p : ℕ} [hp : Fact p.Prime]
variable {k : Type u} [Field k] [Algebra ℚ_[p] k] [FiniteDimensional ℚ_[p] k]
variable {Ω : Type u} [Field Ω] [Algebra k Ω] [Algebra ℚ_[p] Ω] [IsScalarTower ℚ_[p] k Ω]
  [IsAlgClosed Ω] [IsGalois k Ω] [Algebra.IsAlgebraic ℚ_[p] Ω]

variable (p k) in
include p in
theorem charZero_padic : CharZero k :=
  charZero_of_injective_algebraMap (algebraMap ℚ_[p] k).injective

variable (p k) in
include p in
/-- `k^×/(k^×)^n` is finite for every `n ≥ 1`. -/
theorem finiteKummerQuotients_padic : FiniteKummerQuotients k :=
  haveI := charZero_padic p k
  ⟨fun n hn => finiteIndex_powRange_of_isDiscreteValuationRing (𝒪 p k) k n
    (Nat.cast_ne_zero.2 hn)⟩

/-! ### (b): `H¹(G_k, Ẑ(1)) ≅ G_k^ab` -/

variable (p k Ω) in
/-- **`H¹(G_k, Ẑ(1)) ≃* G_k^ab`** (Kummer theory and local class field theory). -/
def h1AbEquiv :
    ContH1 (Ω ≃ₐ[k] Ω) (ZHatOne k Ω) ≃* TopologicalAbelianization (Ω ≃ₐ[k] Ω) :=
  haveI := charZero_padic p k
  haveI := finiteKummerQuotients_padic p k
  (kummerZHatEquivProfiniteCompletion k Ω).trans
    ((artinCompletionEquiv p k Ω).toMulEquiv.trans (galAbEquiv p k Ω).symm.toMulEquiv)

/-- The profinite completion of the Kummer class of `a` is the image of `a`. -/
theorem kummerZHatEquivProfiniteCompletion_kummerZHat (a : kˣ) :
    haveI := charZero_padic p k
    haveI := finiteKummerQuotients_padic p k
    kummerZHatEquivProfiniteCompletion k Ω (kummerZHat k Ω a) =
      ProfiniteCompletion.etaFn (GrpCat.of kˣ) a := by
  haveI := charZero_padic p k
  haveI := finiteKummerQuotients_padic p k
  change kummerCompletionEquivProfiniteCompletion k (kummerZHatEquiv k Ω (kummerZHat k Ω a)) = _
  rw [kummerZHatEquiv_kummerZHat]
  rfl

/-- **The Kummer class of `a ∈ k^×` corresponds to the Artin symbol of `a`.** -/
theorem h1AbEquiv_kummerZHat (a : kˣ) :
    h1AbEquiv p k Ω (kummerZHat k Ω a) = multAbEquiv p k Ω a := by
  haveI := charZero_padic p k
  haveI := finiteKummerQuotients_padic p k
  apply (galAbEquiv p k Ω).injective
  rw [galAbEquiv_multAbEquiv]
  change galAbEquiv p k Ω ((galAbEquiv p k Ω).symm (artinCompletionEquiv p k Ω
    (kummerZHatEquivProfiniteCompletion k Ω (kummerZHat k Ω a)))) = _
  rw [ContinuousMulEquiv.apply_symm_apply, kummerZHatEquivProfiniteCompletion_kummerZHat (p := p),
    artinCompletionEquiv_eta]

variable (p) in
include p in
/-- **The Kummer map `k^× → H¹(G_k, Ẑ(1))` is injective.** -/
theorem kummerZHat_injective : Function.Injective (kummerZHat k Ω) := by
  intro a b h
  have h1 := congrArg (h1AbEquiv p k Ω) h
  rw [h1AbEquiv_kummerZHat, h1AbEquiv_kummerZHat] at h1
  exact (multAbEquiv p k Ω).injective (Subtype.ext h1)

/-! ### (b): the Frobenius surjection `G_k^ab ↠ Ẑ` -/

variable (p k) in
/-- A uniformiser of `k`, as a unit. -/
def unif : kˣ := Units.mk0 (uniformizer p k) (uniformizer_spec (p := p) (K := k)).ne_zero

theorem v_unif : v p ((unif p k : kˣ) : k) = 1 := uniformizer_spec

variable (p k Ω) in
/-- **The Frobenius surjection `G_k^ab ↠ Ẑ`**: the `Ẑ`-component of `G_k^ab ≅ 𝒪_k^× × Ẑ`
(it does not depend on the uniformiser, `frobAb_mk`). -/
def frobAb : TopologicalAbelianization (Ω ≃ₐ[k] Ω) →* Multiplicative ZHat :=
  (MonoidHom.snd _ _).comp (abZHatEquiv p k Ω (v_unif (p := p) (k := k))).toMonoidHom

theorem frobAb_apply (x : TopologicalAbelianization (Ω ≃ₐ[k] Ω)) :
    frobAb p k Ω x = (abZHatEquiv p k Ω (v_unif (p := p) (k := k)) x).2 := rfl

/-- **`frobAb` factors through `G_k ↠ G^unr ≅ Ẑ`.** -/
theorem frobAb_mk (σ : Ω ≃ₐ[k] Ω) :
    frobAb p k Ω (QuotientGroup.mk σ) = unrZHat p k Ω (QuotientGroup.mk σ) :=
  abZHatEquiv_snd_mk _ σ

/-- **Frobenius lifts are sent to `1`.** -/
theorem frobAb_of_isFrobLift {φ : Ω ≃ₐ[k] Ω} (hφ : IsFrobLift (Ω ≃ₐ[k] Ω) φ) :
    frobAb p k Ω (QuotientGroup.mk φ) = Multiplicative.ofAdd (intToZHat 1) :=
  abZHatEquiv_snd_of_isFrobLift _ hφ

theorem frobAb_surjective : Function.Surjective (frobAb p k Ω) := fun a =>
  ⟨(abZHatEquiv p k Ω (v_unif (p := p) (k := k))).symm (1, a), by
    rw [frobAb_apply, ContinuousMulEquiv.apply_symm_apply]⟩

/-- On `k^×`, `frobAb` is the valuation. -/
theorem frobAb_multAbEquiv (a : kˣ) :
    frobAb p k Ω (multAbEquiv p k Ω a) = Multiplicative.ofAdd (intToZHat (v p (a : k))) := by
  rw [frobAb_apply, abZHatEquiv_multAbEquiv]

/-- The kernel of `frobAb` is the image of inertia. -/
theorem frobAb_eq_one_iff (x : TopologicalAbelianization (Ω ≃ₐ[k] Ω)) :
    frobAb p k Ω x = 1 ↔ x ∈ abUnits (Ω ≃ₐ[k] Ω) :=
  abZHatEquiv_snd_eq_one_iff _ x

section Functorial

variable {p' : ℕ} [Fact p'.Prime]
variable {k' : Type u} [Field k'] [Algebra ℚ_[p'] k'] [FiniteDimensional ℚ_[p'] k']
variable {Ω' : Type u} [Field Ω'] [Algebra k' Ω'] [Algebra ℚ_[p'] Ω'] [IsScalarTower ℚ_[p'] k' Ω']
  [IsAlgClosed Ω'] [IsGalois k' Ω'] [Algebra.IsAlgebraic ℚ_[p'] Ω']

/-- **The Frobenius surjection is group-theoretic**: for every isomorphism of topological groups
`ψ : G_k ≃ₜ* G_{k'}`, `frobAb ∘ ψ^ab = frobAb`. -/
theorem frobAb_abEquiv (ψ : (Ω ≃ₐ[k] Ω) ≃ₜ* (Ω' ≃ₐ[k'] Ω'))
    (x : TopologicalAbelianization (Ω ≃ₐ[k] Ω)) :
    frobAb p' k' Ω' (abEquiv ψ x) = frobAb p k Ω x := by
  obtain ⟨σ, rfl⟩ := QuotientGroup.mk_surjective x
  change frobAb p' k' Ω' (QuotientGroup.mk (ψ σ)) = _
  rw [frobAb_mk, frobAb_mk, ← unrEquiv_mk, galEquiv_unrZHat (p := p) (p' := p')]

end Functorial

variable (p k Ω) in
/-- **The surjection `H¹(G_k, Ẑ(1)) ≅ G_k^ab ↠ Ẑ`** of [AbsTopIII], Corollary 1.10 (b). -/
def h1Frob : ContH1 (Ω ≃ₐ[k] Ω) (ZHatOne k Ω) →* Multiplicative ZHat :=
  (frobAb p k Ω).comp (h1AbEquiv p k Ω).toMonoidHom

theorem h1Frob_apply (c : ContH1 (Ω ≃ₐ[k] Ω) (ZHatOne k Ω)) :
    h1Frob p k Ω c = frobAb p k Ω (h1AbEquiv p k Ω c) := rfl

theorem h1Frob_surjective : Function.Surjective (h1Frob p k Ω) :=
  (frobAb_surjective (p := p) (k := k) (Ω := Ω)).comp (h1AbEquiv p k Ω).surjective

/-- On Kummer classes, `h1Frob` is the valuation. -/
theorem h1Frob_kummerZHat (a : kˣ) :
    h1Frob p k Ω (kummerZHat k Ω a) = Multiplicative.ofAdd (intToZHat (v p (a : k))) := by
  rw [h1Frob_apply, h1AbEquiv_kummerZHat, frobAb_multAbEquiv]

/-! ### (d): the Kummer image is the inverse image of `ℤ = ⟨Frob⟩` -/

/-- An element of `G_k^ab` with `Ẑ`-component in `ℤ` is the image of an element of `k^×`. -/
theorem exists_multAbEquiv_eq {x : TopologicalAbelianization (Ω ≃ₐ[k] Ω)} {m : ℤ}
    (hx : frobAb p k Ω x = Multiplicative.ofAdd (intToZHat m)) :
    ∃ a : kˣ, (multAbEquiv p k Ω a : TopologicalAbelianization (Ω ≃ₐ[k] Ω)) = x := by
  set e := abZHatEquiv p k Ω (v_unif (p := p) (k := k))
  set u : unitGroup p k := (e x).1
  refine ⟨(u : kˣ) * unif p k ^ m, e.injective ?_⟩
  rw [map_mul, map_zpow, Subgroup.coe_mul, Subgroup.coe_zpow, map_mul, map_zpow,
    multAbEquiv_coe_unit, abZHatEquiv_unitsAbEquiv, abZHatEquiv_multAbEquiv_uniformizer]
  refine Prod.ext ?_ ?_
  · simp [u]
  · change (1 : Multiplicative ZHat) * (Multiplicative.ofAdd (intToZHat 1)) ^ m = (e x).2
    rw [one_mul, ← ofAdd_intToZHat_eq_zpow, ← hx]
    rfl

/-- **[AbsTopIII], Corollary 1.10 (d)**: the image of the Kummer map `k^× → H¹(G_k, Ẑ(1))` is the
inverse image of the subgroup `ℤ = ⟨1⟩ ⊆ Ẑ` generated by the Frobenius under the surjection
`H¹(G_k, Ẑ(1)) ≅ G_k^ab ↠ Ẑ` of (b). -/
theorem range_kummerZHat :
    (kummerZHat k Ω).range =
      (Subgroup.zpowers (Multiplicative.ofAdd (intToZHat 1))).comap (h1Frob p k Ω) := by
  ext c
  rw [Subgroup.mem_comap, Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨v p (a : k), by rw [h1Frob_kummerZHat, ← ofAdd_intToZHat_eq_zpow]⟩
  · rintro ⟨m, hm⟩
    rw [← ofAdd_intToZHat_eq_zpow, h1Frob_apply] at hm
    obtain ⟨a, ha⟩ := exists_multAbEquiv_eq hm.symm
    exact ⟨a, (h1AbEquiv p k Ω).injective ((h1AbEquiv_kummerZHat a).trans ha)⟩

end

end Iut.Reconstruction
