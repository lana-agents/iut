import Iut.Reconstruction.Thm19.CycloIso
import Iut.Reconstruction.Thm19.ArithBridgeGk

/-!
# Functoriality of [AbsTopIII] Thm 1.9 (b) for isomorphisms of cuspidal extensions

[AbsTopIII] Thm 1.9 (`Topics in Absolute Anabelian Geometry III.txt` l.2109–2199) is functorial
in isomorphisms of the input extensions `1 → Δ_X → Π_X → G_k → 1`. `Thm19/CycloIso.lean` builds
the cyclotome `Ẑ(1) ≃ Ẑ(1)'` and `H¹(Π_U, Ẑ(1)) ≃ H¹(Π_{U'}, Ẑ(1)')` (step (b): `μ_Ẑ(Π_U) = M_X`)
from an isomorphism `Φ : Π_U ≃ Π_{U'}` of Galois models lying over `G_k ≃ G_{k'}` and preserving
the kernels of the fillings `Π_U ↠ Π_X`. Here both hypotheses are discharged for every isomorphism
of the cuspidal extensions `arithmeticExt` of curves-jacobian (for instance the one of
`arithmeticExtIso'`, which only asks for `Π_U ≃ Π_{U'}` over `G_K ≃ G_{K'}`: [AbsTopI] Lemma 4.5
(v)):

* `CuspW D`: the places `W ⊇ k` of `Ω` with `t ∉ W` (over the points at infinity of the chart);
  `cuspUnionG D`: the union of the images in `Π_U` of their inertia groups `I_W ∩ H`;
* **`piUToPiX_eq_one_iff`**: for `H = H_L`, `ker(Π_U ↠ Π_X)` is the closed subgroup generated by
  `cuspUnionG D` (the inertia at points of `U` is already killed in `Π_U`);
* `isCuspPlace_comap_iff`: under `σc : K(X̄)^alg ≃ K(X̄_Ω)^alg` a place `W` is a cusp place of
  `arithmeticExt` iff `W ⊇ K` and `τ ∉ W` (`U = chartOne τ`);
* `mem_cuspUnionG_iff`: `cuspUnionG` is the union of the preimages under `piBridge` of the
  cuspidal subgroups of `arithmeticExt`;
* **`bridgeIso Φ`**: `Π_U ≃ Π_{U'}` in the Galois models for an isomorphism `Φ` of
  `arithmeticExt`, **`bridgeIso_fill`** (it preserves the fillings), `gkIso Φ`, `bridgeIso_gk`
  (over `G_K ≃ G_{K'}`);
* **`cycloIso Φ : Ẑ(1) ≃ₜ* Ẑ(1)'`**, **`cycloIso_smul`** and **`h1CycloIso Φ`** (genus `≥ 1`).
-/

open CategoryTheory AlgebraicGeometry Pi1 Pi1.Orbifold KummerTheory KummerTheory.Curve
  AffOrbicurve CurvesJacobian CurvesJacobian.Kummer CurvesJacobian.Cusp
  CurvesJacobian.LocAn.DeltaXEquiv Belyi Belyi.Anabelian

universe u

noncomputable section

namespace Iut.Reconstruction.Thm19

set_option linter.unusedSectionVars false

/-! ### Closed subgroups generated by corresponding sets -/

section Generic

variable {P P' : Type*} [Group P] [Group P'] [TopologicalSpace P] [TopologicalSpace P']
  [IsTopologicalGroup P] [IsTopologicalGroup P']

lemma le_comap_closure_of_image_subset (e : P ≃ₜ* P') {A : Set P} {A' : Set P'}
    (h : ∀ x ∈ A, e x ∈ A') :
    (Subgroup.closure A).topologicalClosure ≤
      ((Subgroup.closure A').topologicalClosure).comap e.toMulEquiv.toMonoidHom := by
  refine Subgroup.topologicalClosure_minimal _ ?_
    ((Subgroup.isClosed_topologicalClosure _).preimage e.continuous)
  rw [Subgroup.closure_le]
  intro x hx
  exact Subgroup.le_topologicalClosure _ (Subgroup.subset_closure (h x hx))

/-- **An isomorphism matching generating sets matches the closed subgroups they generate.** -/
lemma mem_closure_iff_of_image (e : P ≃ₜ* P') {A : Set P} {A' : Set P'}
    (h : ∀ x, x ∈ A ↔ e x ∈ A') (x : P) :
    e x ∈ (Subgroup.closure A').topologicalClosure ↔ x ∈ (Subgroup.closure A).topologicalClosure :=
  ⟨fun hx ↦ by
    have := le_comap_closure_of_image_subset e.symm (A := A') (A' := A) (fun y hy ↦ by
      rw [h, ContinuousMulEquiv.apply_symm_apply]; exact hy) hx
    rw [Subgroup.mem_comap] at this
    convert this using 1
    exact (e.symm_apply_apply x).symm,
   fun hx ↦ le_comap_closure_of_image_subset e (fun y hy ↦ (h y).1 hy) hx⟩

end Generic

/-! ### `ker(Π_U ↠ Π_X)` in the Galois model -/

section Fill

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
  (D : GaloisData k t) [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω]

/-- The places `W ⊇ k` of `Ω` with `t ∉ W`: the places over the points of `X` outside the chart
`U` (the cusps). -/
def CuspW : Set (ValuationSubring Ω) := {W | (∀ c : k, algebraMap k Ω c ∈ W) ∧ t ∉ W}

/-- The union of the images in `Π_U` of the inertia groups `I_W ∩ H`, `W ∈ CuspW`. -/
def cuspUnionG : Set (Pi D) :=
  {x | ∃ W ∈ CuspW (k := k) (t := t), ∃ σ ∈ inertiaH D W, x = (σ : Pi D)}

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotient `Π_X` are found slowly
lemma piUToPiX_eq_one_of_mem_cuspUnionG {x : Pi D} (hx : x ∈ cuspUnionG D) :
    piUToPiX D x = 1 := by
  obtain ⟨W, hW, σ, hσ, rfl⟩ := hx
  rw [piUToPiX_mk]
  refine (QuotientGroup.eq_one_iff _).2 (Subgroup.mem_subgroupOf.2 ?_)
  exact Subgroup.le_topologicalClosure _ (Subgroup.subset_closure
    ⟨1, D.H.one_mem, σ, ⟨σ.2, W, hW.1, hσ⟩, by simp⟩)

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotient `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` of `H` are slow for unification
/-- **`ker(Π_U ↠ Π_X)` is generated by the cuspidal inertia** (for `H = H_L`, i.e. no orbifold
points): the closed subgroup of `Π_U` generated by the images of the `I_W ∩ H`, `W ∈ CuspW`. -/
theorem piUToPiX_eq_one_iff (hH : D.H ≤ D.HL) (x : Pi D) :
    piUToPiX D x = 1 ↔ x ∈ (Subgroup.closure (cuspUnionG D)).topologicalClosure := by
  set N := (Subgroup.closure (cuspUnionG D)).topologicalClosure
  constructor
  · intro hx
    obtain ⟨σ, rfl⟩ := QuotientGroup.mk_surjective x
    rw [piUToPiX_mk, QuotientGroup.eq_one_iff] at hx
    have hσ := Subgroup.mem_subgroupOf.1 hx
    -- the subgroup of `Gal(Ω/K₀)` of the `σ ∈ H` with image in `N`
    let N' : Subgroup (Ω ≃ₐ[K₀ k t] Ω) :=
      (N.comap (QuotientGroup.mk' (GaloisPi1.kernel D.H D.S))).map D.H.subtype
    have hN' : IsClosed (N' : Set (Ω ≃ₐ[K₀ k t] Ω)) := by
      have h1 : IsClosed ((N.comap (QuotientGroup.mk' (GaloisPi1.kernel D.H D.S))) : Set D.H) :=
        (Subgroup.isClosed_topologicalClosure _).preimage QuotientGroup.continuous_mk
      exact (D.isClosed_H.isClosedEmbedding_subtypeVal).isClosedMap _ h1
    have hle : GaloisPi1.ambientKernel D.H (SAll D) ≤ N' := by
      refine Subgroup.topologicalClosure_minimal _ ?_ hN'
      rw [Subgroup.closure_le]
      rintro _ ⟨g, hg, s, hs, rfl⟩
      have hs' := conj_mem_SAll D hg hs
      obtain ⟨hsH, W, hkW, hsW⟩ := hs'
      refine ⟨⟨_, hsH⟩, ?_, rfl⟩
      change ((⟨_, hsH⟩ : D.H) : Pi D) ∈ N
      by_cases htW : t ∈ W
      · have h1 : ((⟨_, hsH⟩ : D.H) : Pi D) = 1 := (QuotientGroup.eq_one_iff _).2
          (Subgroup.mem_subgroupOf.2 (Subgroup.le_topologicalClosure _ (Subgroup.subset_closure
            ⟨1, D.H.one_mem, _, ⟨hH hsH, W, hkW, htW, hsW⟩, by simp⟩)))
        rw [h1]
        exact N.one_mem
      · exact Subgroup.le_topologicalClosure _ (Subgroup.subset_closure
          ⟨W, ⟨hkW, htW⟩, ⟨_, hsH⟩, hsW, rfl⟩)
    obtain ⟨σ', hσ', he⟩ := hle hσ
    have : σ' = σ := Subtype.ext he
    subst this
    exact hσ'
  · intro hx
    have hcl : IsClosed (((piUToPiX D).ker : Subgroup (Pi D)) : Set (Pi D)) :=
      isClosed_singleton.preimage (continuous_piUToPiX D)
    have hle : N ≤ (piUToPiX D).ker := by
      refine Subgroup.topologicalClosure_minimal _ ?_ hcl
      rw [Subgroup.closure_le]
      intro y hy
      exact piUToPiX_eq_one_of_mem_cuspUnionG D hy
    exact hle hx

end Fill

/-! ### Cusp places under the bridge -/

section Bridge

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {C : HypCurve K}
  [hc : Fact (C.U : Set C.Xbar)ᶜ.Nonempty]

attribute [local instance] isIntegral_Xbar nonempty_U algFF

variable {τ : C.Xbar.functionField} (hτ : Transcendental K τ)
  [IsGalois (K₀ K (coordT τ)) (FFClosure C.Xbar)] (hU : C.U = chartOne K C.Xbar τ)

lemma σc_symm_secEmb (a : Γ(C.Xbar, C.U)) :
    (σc (Ω := Ω) (C := C)).symm (secEmb Ω C (isAffineOpen_U C hc.out) a) =
      algebraMap C.Xbar.functionField (FFClosure C.Xbar) (C.Xbar.germToFunctionField C.U a) := by
  rw [RingEquiv.symm_apply_eq, σc_algebraMap, algebraMap_algFF, ffEmb_germ]

lemma σc_symm_algebraMap_K (c : K) :
    (σc (Ω := Ω) (C := C)).symm (algebraMap Ω (FFClosure (geomCurve Ω C)) (algebraMap K Ω c)) =
      algebraMap K (FFClosure C.Xbar) c := by
  rw [RingEquiv.symm_apply_eq,
    IsScalarTower.algebraMap_apply K C.Xbar.functionField (FFClosure C.Xbar), σc_algebraMap,
    algebraMap_algFF, ffEmb_algebraMap]

/-- **Integral elements land in a valuation subring**: if `f : A → L` takes values in `W` and
`z` is integral over `A`, then `g z ∈ W` for any `g` extending `f`. -/
lemma mem_of_isIntegral_map {A S L : Type*} [CommRing A] [CommRing S] [Algebra A S] [Field L]
    (W : ValuationSubring L) (f : A →+* L) (hf : ∀ a, f a ∈ W) (g : S →+* L)
    (hg : ∀ a, g (algebraMap A S a) = f a) {z : S} (hz : IsIntegral A z) : g z ∈ W := by
  let φ : A →+* W := f.codRestrict W.toSubring hf
  have hx : IsIntegral W (g z) := by
    obtain ⟨p, hp, hpz⟩ := hz
    refine ⟨p.map φ, hp.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    have : (algebraMap W L).comp φ = g.comp (algebraMap A S) := RingHom.ext fun a ↦ (hg a).symm
    rw [this, ← Polynomial.hom_eval₂, hpz, map_zero]
  obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.1 hx
  rw [← hy]
  exact y.2

lemma range_germ_congr {X : Scheme.{u}} [IsIntegral X] {U V : X.Opens} (h : U = V)
    [Nonempty U] [Nonempty V] :
    Set.range (X.germToFunctionField U) = Set.range (X.germToFunctionField V) := by
  subst h
  rfl

include hτ hU in
lemma mem_range_germ_iff (z : C.Xbar.functionField) :
    z ∈ Set.range (C.Xbar.germToFunctionField C.U) ↔ IsIntegral (Algebra.adjoin K {τ}) z := by
  haveI : Nonempty (chartOne K C.Xbar τ) := hU ▸ inferInstance
  rw [range_germ_congr hU]
  exact mem_range_germ_chartOne_iff hτ z

include hτ hU in
/-- **Cusp places in the Galois model**: `σc(W)` is a cusp place of `arithmeticExt` iff `W ⊇ K`
and the coordinate `τ` (`U = chartOne τ`) is not in `W`. -/
theorem isCuspPlace_comap_iff (W : ValuationSubring (FFClosure C.Xbar)) :
    IsCuspPlace Ω C hc.out (W.comap ((σc (Ω := Ω) (C := C)).symm :
        FFClosure (geomCurve Ω C) →+* FFClosure C.Xbar)) ↔
      W ∈ CuspW (k := K) (t := coordT τ) := by
  have hτU : ∃ a : Γ(C.Xbar, C.U), C.Xbar.germToFunctionField C.U a = τ :=
    (mem_range_germ_iff hτ hU τ).2 (isIntegral_algebraMap (R := Algebra.adjoin K {τ})
      (A := C.Xbar.functionField) (x := ⟨τ, Algebra.subset_adjoin rfl⟩))
  obtain ⟨a₀, ha₀⟩ := hτU
  constructor
  · rintro ⟨hΩ, hU'⟩
    have hK : ∀ c : K, algebraMap K (FFClosure C.Xbar) c ∈ W := fun c ↦ by
      have := hΩ (algebraMap K Ω c)
      rwa [ValuationSubring.mem_comap, RingHom.coe_coe, σc_symm_algebraMap_K] at this
    refine ⟨hK, fun htW ↦ hU' fun a ↦ ?_⟩
    rw [ValuationSubring.mem_comap, RingHom.coe_coe, σc_symm_secEmb]
    -- `germ a` is integral over `K[τ]`, and `K[τ] ⊆ W`
    have hint : IsIntegral (Algebra.adjoin K {τ}) (C.Xbar.germToFunctionField C.U a) :=
      (mem_range_germ_iff hτ hU _).1 ⟨a, rfl⟩
    refine mem_of_isIntegral_map W ((algebraMap C.Xbar.functionField (FFClosure C.Xbar)).comp
      (Algebra.adjoin K {τ}).val.toRingHom) (fun y ↦ ?_)
      (algebraMap C.Xbar.functionField (FFClosure C.Xbar)) (fun _ ↦ rfl) hint
    obtain ⟨y, hy⟩ := y
    induction hy using Algebra.adjoin_induction with
    | mem x hx =>
      obtain rfl := Set.mem_singleton_iff.1 hx
      exact htW
    | algebraMap c =>
      change algebraMap C.Xbar.functionField (FFClosure C.Xbar)
        (algebraMap K C.Xbar.functionField c) ∈ W
      rw [← IsScalarTower.algebraMap_apply]
      exact hK c
    | add x y _ _ hx hy =>
      change algebraMap C.Xbar.functionField (FFClosure C.Xbar) (x + y) ∈ W
      rw [map_add]
      exact W.add_mem _ _ hx hy
    | mul x y _ _ hx hy =>
      change algebraMap C.Xbar.functionField (FFClosure C.Xbar) (x * y) ∈ W
      rw [map_mul]
      exact W.mul_mem _ _ hx hy
  · rintro ⟨hK, htW⟩
    refine ⟨fun c ↦ ?_, fun h ↦ htW ?_⟩
    · rw [ValuationSubring.mem_comap, RingHom.coe_coe]
      have hc' := mem_algebraicClosure_iff.1 (σc_symm_algebraMap_mem_kbar (Ω := Ω) (C := C) c)
      exact mem_of_isIntegral_map W (algebraMap K (FFClosure C.Xbar)) hK (RingHom.id _)
        (fun _ ↦ rfl) hc'.isIntegral
    · have := h a₀
      rwa [ValuationSubring.mem_comap, RingHom.coe_coe, σc_symm_secEmb, ha₀] at this

include hU in
/-- **`cuspUnionG` through the bridge**: an element of `Π_U` (Galois model) lies in the image of a
cuspidal inertia group `I_W ∩ H` iff its image under `piBridge` lies in a cuspidal subgroup of
`arithmeticExt`. -/
theorem mem_cuspUnionG_iff (x : Pi (curveGaloisData K hτ)) :
    x ∈ cuspUnionG (curveGaloisData K hτ) ↔
      ∃ I ∈ (arithmeticExt Ω C hc.out).cusps, piBridge (Ω := Ω) hτ hU x ∈ I := by
  constructor
  · rintro ⟨W, hW, σ, hσ, rfl⟩
    refine ⟨_, (mem_cusps_iff_piBridge hτ hU _).2
      ⟨W, (isCuspPlace_comap_iff hτ hU W).2 hW, rfl⟩, ⟨_, ⟨σ, hσ, rfl⟩, rfl⟩⟩
  · rintro ⟨I, hI, hx⟩
    obtain ⟨W, hW, rfl⟩ := (mem_cusps_iff_piBridge hτ hU I).1 hI
    obtain ⟨y, ⟨σ, hσ, rfl⟩, hy⟩ := hx
    have hyx : (σ : Pi (curveGaloisData K hτ)) = x := (piBridge (Ω := Ω) hτ hU).injective hy
    exact ⟨W, (isCuspPlace_comap_iff hτ hU W).1 hW, σ, hσ, hyx.symm⟩

end Bridge

/-! ### Isomorphisms of `arithmeticExt` in the Galois models -/

section Iso

variable {K : Type u} [Field K] [NumberField K] {Ω : Type u} [Field Ω] [Algebra K Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [CharZero Ω] {C : HypCurve K}
  [hc : Fact (C.U : Set C.Xbar)ᶜ.Nonempty]
  {K' : Type u} [Field K'] [NumberField K'] {Ω' : Type u} [Field Ω'] [Algebra K' Ω']
  [IsAlgClosed Ω'] [Algebra.IsAlgebraic K' Ω'] [CharZero Ω'] {C' : HypCurve K'}
  [hc' : Fact (C'.U : Set C'.Xbar)ᶜ.Nonempty]

attribute [local instance] isIntegral_Xbar nonempty_U

variable {τ : C.Xbar.functionField} (hτ : Transcendental K τ)
  [IsGalois (K₀ K (coordT τ)) (FFClosure C.Xbar)] (hU : C.U = chartOne K C.Xbar τ)
  {τ' : C'.Xbar.functionField} (hτ' : Transcendental K' τ')
  [IsGalois (K₀ K' (coordT τ')) (FFClosure C'.Xbar)] (hU' : C'.U = chartOne K' C'.Xbar τ')
  (Φ : (arithmeticExt Ω C hc.out).Iso (arithmeticExt Ω' C' hc'.out))

/-- **An isomorphism of `arithmeticExt` in the Galois models**: `Π_U ≃ₜ* Π_{U'}` through
`piBridge`. -/
def bridgeIso : Pi (curveGaloisData K hτ) ≃ₜ* Pi (curveGaloisData K' hτ') :=
  (piBridge (Ω := Ω) hτ hU).trans (Φ.pi.trans (piBridge (Ω := Ω') hτ' hU').symm)

lemma piBridge_bridgeIso (x : Pi (curveGaloisData K hτ)) :
    piBridge (Ω := Ω') hτ' hU' (bridgeIso hτ hU hτ' hU' Φ x) =
      Φ.pi (piBridge (Ω := Ω) hτ hU x) := by
  simp [bridgeIso]

lemma exists_cusp_mem_iff (y : (arithmeticExt Ω C hc.out).Pi) :
    (∃ I ∈ (arithmeticExt Ω C hc.out).cusps, y ∈ I) ↔
      ∃ I ∈ (arithmeticExt Ω' C' hc'.out).cusps, Φ.pi y ∈ I := by
  constructor
  · rintro ⟨I, hI, hy⟩
    exact ⟨_, (Φ.cusps_map I).1 hI, ⟨y, hy, rfl⟩⟩
  · rintro ⟨I, hI, hy⟩
    refine ⟨_, (Φ.symm.cusps_map I).1 hI, ⟨Φ.pi y, hy, ?_⟩⟩
    exact Φ.pi.symm_apply_apply y

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotient `Π_X` are found slowly
/-- **`bridgeIso` preserves the fillings `Π_U ↠ Π_X`** (it matches the cuspidal inertia groups,
`cusps_map`, which generate the kernels, `piUToPiX_eq_one_iff`). -/
theorem bridgeIso_fill (x : Pi (curveGaloisData K hτ)) :
    piUToPiX (curveGaloisData K' hτ') (bridgeIso hτ hU hτ' hU' Φ x) = 1 ↔
      piUToPiX (curveGaloisData K hτ) x = 1 := by
  rw [piUToPiX_eq_one_iff _ le_rfl, piUToPiX_eq_one_iff _ le_rfl]
  refine mem_closure_iff_of_image _ (fun y ↦ ?_) x
  rw [mem_cuspUnionG_iff (Ω := Ω) hτ hU, mem_cuspUnionG_iff (Ω := Ω') hτ' hU',
    piBridge_bridgeIso]
  exact exists_cusp_mem_iff Φ _

/-- **`G_K ≃* G_{K'}`** in the Galois models (`Gal(k̄/K)`), through `gkBridge`. -/
def gkIso : Gk K (FFClosure C.Xbar) ≃* Gk K' (FFClosure C'.Xbar) :=
  (gkBridge (Ω := Ω) hτ hU).trans (Φ.g.toMulEquiv.trans (gkBridge (Ω := Ω') hτ' hU').symm)

/-- **`bridgeIso` lies over `gkIso`.** -/
theorem bridgeIso_gk (x : Pi (curveGaloisData K hτ)) :
    piToGk (curveGaloisData K' hτ') (bridgeIso hτ hU hτ' hU' Φ x) =
      gkIso hτ hU hτ' hU' Φ (piToGk (curveGaloisData K hτ) x) := by
  apply (gkBridge (Ω := Ω') hτ' hU').injective
  have h : ∀ g, gkBridge (Ω := Ω') hτ' hU' (gkIso hτ hU hτ' hU' Φ g) =
      Φ.g (gkBridge (Ω := Ω) hτ hU g) := fun g ↦ (gkBridge (Ω := Ω') hτ' hU').apply_symm_apply _
  rw [gkBridge_piToGk, piBridge_bridgeIso, h, gkBridge_piToGk]
  exact Φ.pr_comm _

variable [Fact (0 < (CurvesJacobian.curveGenus K C.Xbar).toNat)]
  [Fact (0 < (CurvesJacobian.curveGenus K' C'.Xbar).toNat)]

/-- **[AbsTopIII] Thm 1.9 (b) over an isomorphism of cuspidal extensions**: the cyclotome
`Ẑ(1) ≃ₜ* Ẑ(1)'` (through `μ_Ẑ(Π_U) = M_X`, `cycloCongr`) induced by an isomorphism of the
`arithmeticExt` of two affine hyperbolic curves over number fields, with compactifications of
genus `≥ 1`. -/
def cycloIso :
    ZHatOne (F (curveGaloisData K hτ)) (FFClosure C.Xbar) ≃ₜ*
      ZHatOne (F (curveGaloisData K' hτ')) (FFClosure C'.Xbar) :=
  cycloCongr (bridgeIso hτ hU hτ' hU' Φ) (bridgeIso_fill hτ hU hτ' hU' Φ)
    (gkIso hτ hU hτ' hU' Φ) (bridgeIso_gk hτ hU hτ' hU' Φ)

set_option synthInstance.maxHeartbeats 400000 in
-- the action of `Π_U` on `Ẑ(1)` is found slowly
/-- **`cycloIso` is equivariant along `bridgeIso`.** -/
theorem cycloIso_smul (g : Pi (curveGaloisData K hτ))
    (z : ZHatOne (F (curveGaloisData K hτ)) (FFClosure C.Xbar)) :
    cycloIso hτ hU hτ' hU' Φ (g • z) = bridgeIso hτ hU hτ' hU' Φ g • cycloIso hτ hU hτ' hU' Φ z :=
  cycloCongr_smul _ _ _ _ g z

/-- **`H¹(Π_U, Ẑ(1)) ≃* H¹(Π_{U'}, Ẑ(1)')`** induced by an isomorphism of `arithmeticExt`
(the Kummer side of [AbsTopIII] Thm 1.9 (b)–(d) is functorial in the input extension). -/
def h1CycloIso :
    ContH1 (Pi (curveGaloisData K hτ)) (ZHatOne (F (curveGaloisData K hτ)) (FFClosure C.Xbar)) ≃*
      ContH1 (Pi (curveGaloisData K' hτ'))
        (ZHatOne (F (curveGaloisData K' hτ')) (FFClosure C'.Xbar)) :=
  h1CycloCongr (bridgeIso hτ hU hτ' hU' Φ) (bridgeIso_fill hτ hU hτ' hU' Φ)
    (gkIso hτ hU hτ' hU' Φ) (bridgeIso_gk hτ hU hτ' hU' Φ)

end Iso

end Iut.Reconstruction.Thm19
