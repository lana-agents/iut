import Iut.Reconstruction.Thm19.CuspSync
import CurvesJacobian.LocAn.DeltaXEquiv

/-!
# Functoriality of [AbsTopIII] Thm 1.9 (b): the cyclotome `μ_Ẑ(Π_U) = M_X` over an isomorphism

[AbsTopIII] Thm 1.9 (`Topics in Absolute Anabelian Geometry III.txt` l.2109–2199) is a functorial
group-theoretic algorithm; in step (b) (l.2144–2152) the cyclotome is `μ_Ẑ(Π_U) = M_X =
Hom(H²(Δ_X, Ẑ), Ẑ)` (Prop 1.4 (ii), l.1771–1802), where `Δ_X` is the quotient of `Δ_U` by the
cuspidal inertia groups. Its functoriality is that an isomorphism `Φ : Π_U ≃ Π_{U'}` lying over
`G_k ≃ G_{k'}` and preserving the cusps induces `Π_X ≃ Π_{X'}`, `Δ_X ≃ Δ_{X'}`, hence a
`Φ`-equivariant `M_X ≃ M_{X'}`, and then (through the natural `Π_U`-equivariant `M_X ≅ Ẑ(1)`
of [Mzk19] Prop 1.2 (ii), curves-jacobian `natIsoHatK`) a `Φ`-equivariant `Ẑ(1) ≃ Ẑ(1)'` and
`H¹(Π_U, Ẑ(1)) ≃ H¹(Π_{U'}, Ẑ(1)')`. Here:

* generic group theory: `h2Triv e : H²(G', ℤ/n) → H²(G, ℤ/n)` along `e : G → G'`,
  `mxModMap e : M_X/n(G) → M_X/n(G')` (`φ ↦ φ ∘ e^*`), `mxHatMap`, **`mxHatCongr`**
  (`M_X(G) ≃ M_X(G')` for `G ≃ₜ* G'`, reindexing the Kummer indices), and the equivariance
  `mxHatCongr_precompMXHat` (`e ∘ θ = θ' ∘ e` ⇒ `M_X(e) ∘ θ^* = θ'^* ∘ M_X(e)`);
* `descendCongr`: an isomorphism of compact groups descends to quotients by corresponding kernels
  (Hausdorff targets);
* in the Galois model: **`piXCongr`** (`Π_X ≃ₜ* Π_{X'}` from `Φ : Π_U ≃ₜ* Π_{U'}` preserving
  `ker(Π_U ↠ Π_X)`), `piXToGk_piXCongr` (over `ψ : G_k ≃* G_{k'}`), **`deltaXCongr`**
  (`Δ_X ≃ₜ* Δ_{X'}`), `deltaXEquivBar_thetaBar` (the conjugation action `θ̄_h` of curves-jacobian
  on `Δ_X = π₁ᵉᵗ(X_{k̄})` is conjugation by the image of `h` in `Π_X`), `deltaBarCongr`;
* **`mxCongr : M_X ≃ₜ* M_{X'}`** and **`mxCongr_smul`** (`Φ`-equivariance);
* **`cycloCongr : Ẑ(1) ≃ₜ* Ẑ(1)'`**, **`cycloCongr_smul`** (`χ(g • z) = Φ(g) • χ(z)`) and
  **`h1CycloCongr : H¹(Π_U, Ẑ(1)) ≃* H¹(Π_{U'}, Ẑ(1)')`**, `h1CycloCongr_mk`.

The hypothesis on the cusps is `ker(Π_U ↠ Π_X) ↦ ker(Π_{U'} ↠ Π_{X'})`; it says that `Φ` preserves
the closed normal subgroup generated by the cuspidal inertia groups, which every isomorphism of
cuspidal extensions does ([AbsTopI] Lemma 4.5 (v), `arithmeticExtIso'`).
-/

universe u

open CategoryTheory AlgebraicGeometry Pi1 Pi1.Orbifold Pi1.Profinite Pi1.SurfaceGroup
  KummerTheory KummerTheory.Curve AffOrbicurve CurvesJacobian CurvesJacobian.TopClass
  CurvesJacobian.Kummer CurvesJacobian.ChernClass CurvesJacobian.Cusp
  CurvesJacobian.LocAn.DeltaXEquiv Belyi

noncomputable section

namespace Iut.Reconstruction.Thm19

/-! ### `M_X/n` and `M_X` along homomorphisms of groups -/

section Generic

variable {G G' G'' : Type*} [Group G] [TopologicalSpace G] [Group G'] [TopologicalSpace G']
  [Group G''] [TopologicalSpace G''] {n : ℕ}

/-- **`e^* : H²(G', ℤ/n) → H²(G, ℤ/n)`** along a continuous homomorphism `e : G → G'` (trivial
actions). -/
def h2Triv (e : G →* G') (he : Continuous e) : H2lc G' (TrivZ G' n) →* H2lc G (TrivZ G n) :=
  letI : MulDistribMulAction G (TrivZ G' n) := trivialAction G _
  H2lc.comap e he fun _ _ ↦ rfl

lemma h2Triv_comp (e₁ : G →* G') (he₁ : Continuous e₁) (e₂ : G' →* G'') (he₂ : Continuous e₂)
    (c : H2lc G'' (TrivZ G'' n)) :
    h2Triv (n := n) (e₂.comp e₁) (he₂.comp he₁) c = h2Triv e₁ he₁ (h2Triv e₂ he₂ c) := by
  induction c using QuotientGroup.induction_on with
  | H f => rfl

lemma h2Triv_congr {e e' : G →* G'} (he : Continuous e) (he' : Continuous e') (h : ∀ g, e g = e' g)
    (c : H2lc G' (TrivZ G' n)) : h2Triv e he c = h2Triv e' he' c := by
  obtain rfl : e = e' := MonoidHom.ext h
  rfl

lemma h2Triv_id (c : H2lc G (TrivZ G n)) : h2Triv (MonoidHom.id G) continuous_id c = c := by
  induction c using QuotientGroup.induction_on with
  | H f => rfl

lemma h2Triv_h2Map (e : G →* G') (he : Continuous e) {N : ℕ} (h : n ∣ N)
    (v : H2lc G' (TrivZ G' N)) :
    h2Map (redDvd G h) (fun _ _ ↦ rfl) (h2Triv e he v) =
      h2Triv e he (h2Map (redDvd G' h) (fun _ _ ↦ rfl) v) := by
  induction v using QuotientGroup.induction_on with
  | H f => rfl

/-- **`M_X/n(G) → M_X/n(G')`, `φ ↦ φ ∘ e^*`** along `e : G → G'`. -/
def mxModMap (e : G →* G') (he : Continuous e) : MXmod G n →* MXmod G' n where
  toFun φ := (MXmod.toHom G' n).symm ((MXmod.toHom G n φ).comp (h2Triv e he))
  map_one' := rfl
  map_mul' _ _ := rfl

lemma evAt_mxModMap (e : G →* G') (he : Continuous e) (u : H2lc G' (TrivZ G' n))
    (φ : MXmod G n) : evAt u (mxModMap e he φ) = evAt (h2Triv e he u) φ := rfl

lemma mxModMap_comp (e₁ : G →* G') (he₁ : Continuous e₁) (e₂ : G' →* G'') (he₂ : Continuous e₂)
    (φ : MXmod G n) :
    mxModMap (e₂.comp e₁) (he₂.comp he₁) φ = mxModMap e₂ he₂ (mxModMap e₁ he₁ φ) := by
  apply (MXmod.toHom G'' n).injective
  refine MonoidHom.ext fun u ↦ ?_
  change MXmod.toHom G n φ (h2Triv _ _ u) = MXmod.toHom G n φ (h2Triv e₁ he₁ (h2Triv e₂ he₂ u))
  rw [h2Triv_comp]

lemma mxModMap_congr {e e' : G →* G'} (he : Continuous e) (he' : Continuous e')
    (h : ∀ g, e g = e' g) (φ : MXmod G n) : mxModMap e he φ = mxModMap e' he' φ := by
  obtain rfl : e = e' := MonoidHom.ext h
  rfl

lemma mxModMap_id (φ : MXmod G n) : mxModMap (MonoidHom.id G) continuous_id φ = φ := by
  apply (MXmod.toHom G n).injective
  refine MonoidHom.ext fun u ↦ ?_
  change MXmod.toHom G n φ (h2Triv _ _ u) = MXmod.toHom G n φ u
  rw [h2Triv_id]

/-- `precompMX θ` is `mxModMap θ`. -/
lemma precompMX_eq_mxModMap (θ : G ≃ₜ* G) (φ : MXmod G n) :
    precompMX θ φ = mxModMap θ.toMulEquiv.toMonoidHom θ.continuous φ := rfl

/-- `mxModMap` preserves the reductions `M_X/N → M_X/n`. -/
lemma isMXCompat_mxModMap (e : G →* G') (he : Continuous e) {n N : ℕ} (h : n ∣ N)
    {φ : MXmod G N} {ψ : MXmod G n} (hc : IsMXCompat G h φ ψ) :
    IsMXCompat G' h (mxModMap e he φ) (mxModMap e he ψ) := fun v ↦ by
  rw [evAt_mxModMap, evAt_mxModMap, ← h2Triv_h2Map]
  exact hc _

variable (K K' : Type*) [Field K] [Field K'] [CharZero K] [CharZero K']

/-- **`M_X(G) → M_X(G')`** along `e : G → G'`, levelwise `mxModMap`, the Kummer indices of `K`
reindexed by those of `K'` (characteristic `0`: all `n ≥ 1`). -/
def mxHatMap (e : G →* G') (he : Continuous e) : MXHat G K →* MXHat G' K' where
  toFun φ := ⟨fun i ↦ mxModMap e he ((φ : ∀ i : KummerIndex K, MXmod G i.n)
      ⟨i.n, Nat.cast_ne_zero.2 i.n_ne_zero⟩),
    fun _ _ h ↦ isMXCompat_mxModMap e he h (φ.2 _ _ h)⟩
  map_one' := Subtype.ext (funext fun _ ↦ map_one (mxModMap e he))
  map_mul' _ _ := Subtype.ext (funext fun _ ↦ map_mul (mxModMap e he) _ _)

omit [CharZero K'] in
@[simp] lemma proj_mxHatMap (e : G →* G') (he : Continuous e) (φ : MXHat G K)
    (i : KummerIndex K') :
    MXHat.proj i (mxHatMap K K' e he φ) =
      mxModMap e he (MXHat.proj ⟨i.n, Nat.cast_ne_zero.2 i.n_ne_zero⟩ φ) := rfl

omit [CharZero K'] in
lemma continuous_mxHatMap (e : G →* G') (he : Continuous e) : Continuous (mxHatMap K K' e he) :=
  Continuous.subtype_mk (continuous_pi fun _ ↦ continuous_of_discreteTopology.comp
    ((continuous_apply _).comp continuous_subtype_val)) _

/-- **`M_X(G) ≃ₜ* M_X(G')`** for `e : G ≃ₜ* G'` ([Mzk19] l.302–305: `M_X` depends only on the
topological group `Δ_X`). -/
def mxHatCongr (e : G ≃ₜ* G') : MXHat G K ≃ₜ* MXHat G' K' where
  toFun := mxHatMap K K' e.toMulEquiv.toMonoidHom e.continuous
  invFun := mxHatMap K' K e.symm.toMulEquiv.toMonoidHom e.symm.continuous
  left_inv φ := Subtype.ext (funext fun i ↦ by
    change mxModMap _ _ (mxModMap _ _ _) = _
    rw [← mxModMap_comp, mxModMap_congr (e' := MonoidHom.id G) _ continuous_id
      (fun g ↦ e.symm_apply_apply g), mxModMap_id])
  right_inv φ := Subtype.ext (funext fun i ↦ by
    change mxModMap _ _ (mxModMap _ _ _) = _
    rw [← mxModMap_comp, mxModMap_congr (e' := MonoidHom.id G') _ continuous_id
      (fun g ↦ e.apply_symm_apply g), mxModMap_id])
  map_mul' := map_mul (mxHatMap K K' e.toMulEquiv.toMonoidHom e.continuous)
  continuous_toFun := continuous_mxHatMap K K' _ _
  continuous_invFun := continuous_mxHatMap K' K _ _

@[simp] lemma proj_mxHatCongr (e : G ≃ₜ* G') (φ : MXHat G K) (i : KummerIndex K') :
    MXHat.proj i (mxHatCongr K K' e φ) =
      mxModMap e.toMulEquiv.toMonoidHom e.continuous
        (MXHat.proj ⟨i.n, Nat.cast_ne_zero.2 i.n_ne_zero⟩ φ) := rfl

/-- **Equivariance of `mxHatCongr`**: if `e ∘ θ = θ' ∘ e`, then `M_X(e) ∘ θ^* = θ'^* ∘ M_X(e)`
(`precompMXHat`, the action of automorphisms of `Δ_X` on `M_X`). -/
lemma mxHatCongr_precompMXHat (e : G ≃ₜ* G') (θ : G ≃ₜ* G) (θ' : G' ≃ₜ* G')
    (h : ∀ g, e (θ g) = θ' (e g)) (φ : MXHat G K) :
    mxHatCongr K K' e (precompMXHat K θ φ) = precompMXHat K' θ' (mxHatCongr K K' e φ) :=
  Subtype.ext (funext fun i ↦ by
    change mxModMap _ _ (mxModMap _ _ _) = mxModMap _ _ (mxModMap _ _ _)
    rw [← mxModMap_comp, ← mxModMap_comp]
    exact mxModMap_congr _ _ h _)

end Generic

/-! ### Descending isomorphisms to quotients -/

section Descend

variable {P P' Q Q' : Type*} [Group P] [Group P'] [Group Q] [Group Q'] [TopologicalSpace P]
  [TopologicalSpace P'] [TopologicalSpace Q] [TopologicalSpace Q'] [CompactSpace P]
  [CompactSpace P'] [T2Space Q] [T2Space Q'] (ρ : P →* Q) (ρ' : P' →* Q')
  (hρ : Continuous ρ) (hρ' : Continuous ρ') (hρs : Function.Surjective ρ)
  (hρs' : Function.Surjective ρ') (Φ : P ≃ₜ* P')
  (hker : ∀ x, ρ' (Φ x) = 1 ↔ ρ x = 1)

omit [TopologicalSpace Q] [TopologicalSpace Q'] [CompactSpace P] [CompactSpace P'] [T2Space Q]
  [T2Space Q'] in
include hker in
lemma descend_eq_of_eq {a b : P} (h : ρ a = ρ b) : ρ' (Φ a) = ρ' (Φ b) := by
  have h1 : ρ (a * b⁻¹) = 1 := by rw [map_mul, map_inv, h, mul_inv_cancel]
  have h2 := (hker _).2 h1
  rw [map_mul, map_inv, map_mul, map_inv, mul_inv_eq_one] at h2
  exact h2

omit [TopologicalSpace Q] [TopologicalSpace Q'] [CompactSpace P] [CompactSpace P'] [T2Space Q]
  [T2Space Q'] in
include hker in
lemma descend_eq_of_eq' {a b : P'} (h : ρ' a = ρ' b) : ρ (Φ.symm a) = ρ (Φ.symm b) := by
  refine descend_eq_of_eq ρ' ρ Φ.symm (fun x ↦ ?_) h
  rw [← hker, ContinuousMulEquiv.apply_symm_apply]

/-- **An isomorphism of compact groups descends to quotients by corresponding kernels**: `Q ≃ₜ* Q'`
with `ρ' ∘ Φ = e ∘ ρ`. -/
def descendCongr : Q ≃ₜ* Q' where
  toFun q := ρ' (Φ (Function.surjInv hρs q))
  invFun q := ρ (Φ.symm (Function.surjInv hρs' q))
  left_inv q := by
    have h1 : ρ' (Φ (Function.surjInv hρs q)) =
        ρ' (Function.surjInv hρs' (ρ' (Φ (Function.surjInv hρs q)))) :=
      (Function.surjInv_eq hρs' _).symm
    have h2 := descend_eq_of_eq' ρ ρ' Φ hker h1
    simp only [ContinuousMulEquiv.symm_apply_apply] at h2
    change ρ (Φ.symm (Function.surjInv hρs' (ρ' (Φ (Function.surjInv hρs q))))) = q
    rw [← h2, Function.surjInv_eq hρs q]
  right_inv q := by
    have h1 : ρ (Φ.symm (Function.surjInv hρs' q)) =
        ρ (Function.surjInv hρs (ρ (Φ.symm (Function.surjInv hρs' q)))) :=
      (Function.surjInv_eq hρs _).symm
    have h2 := descend_eq_of_eq ρ ρ' Φ hker h1
    simp only [ContinuousMulEquiv.apply_symm_apply] at h2
    change ρ' (Φ (Function.surjInv hρs (ρ (Φ.symm (Function.surjInv hρs' q))))) = q
    rw [← h2, Function.surjInv_eq hρs' q]
  map_mul' a b := by
    rw [← map_mul, ← map_mul]
    refine descend_eq_of_eq ρ ρ' Φ hker ?_
    rw [map_mul, Function.surjInv_eq hρs, Function.surjInv_eq hρs, Function.surjInv_eq hρs]
  continuous_toFun := by
    refine (Topology.IsQuotientMap.of_surjective_continuous hρs hρ).continuous_iff.2 ?_
    have : (fun q ↦ ρ' (Φ (Function.surjInv hρs q))) ∘ ρ = ρ' ∘ Φ := funext fun x ↦
      descend_eq_of_eq ρ ρ' Φ hker (Function.surjInv_eq hρs (ρ x))
    rw [this]
    exact hρ'.comp Φ.continuous
  continuous_invFun := by
    refine (Topology.IsQuotientMap.of_surjective_continuous hρs' hρ').continuous_iff.2 ?_
    have : (fun q ↦ ρ (Φ.symm (Function.surjInv hρs' q))) ∘ ρ' = ρ ∘ Φ.symm := funext fun x ↦
      descend_eq_of_eq' ρ ρ' Φ hker (Function.surjInv_eq hρs' (ρ' x))
    rw [this]
    exact hρ.comp Φ.symm.continuous

lemma descendCongr_apply (x : P) :
    descendCongr ρ ρ' hρ hρ' hρs hρs' Φ hker (ρ x) = ρ' (Φ x) :=
  descend_eq_of_eq ρ ρ' Φ hker (Function.surjInv_eq hρs (ρ x))

end Descend

/-! ### `Π_X ≃ Π_{X'}` and `Δ_X ≃ Δ_{X'}` in the Galois model -/

/-- Shortcut instance: `Group` structures on the quotient `Π_X` are found slowly. -/
local instance mulOneClass_piX {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
    (D : GaloisData k t) [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω] :
    MulOneClass (PiX D) :=
  @Monoid.toMulOneClass _ (@DivInvMonoid.toMonoid _ (@Group.toDivInvMonoid _ (group_piX D)))

/-- Shortcut instance. -/
local instance one_piX {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
    (D : GaloisData k t) [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω] : One (PiX D) :=
  (mulOneClass_piX D).toOne

/-- Shortcut instance. -/
local instance mul_piX {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
    (D : GaloisData k t) [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω] : Mul (PiX D) :=
  (mulOneClass_piX D).toMul

/-- Shortcut instance. -/
local instance divisionMonoid_piX {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
    (D : GaloisData k t) [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω] :
    DivisionMonoid (PiX D) :=
  (group_piX D).toDivisionMonoid

/-- Shortcut instance. -/
local instance inv_piX {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω}
    (D : GaloisData k t) [CharZero k] [IsGalois (K₀ k t) Ω] [IsAlgClosed Ω] : Inv (PiX D) :=
  (group_piX D).toInv

section PiX

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] {t : Ω} {D : GaloisData k t}
  {k' Ω' : Type u} [Field k'] [Field Ω'] [Algebra k' Ω'] {t' : Ω'} {D' : GaloisData k' t'}
  [IsGalois (K₀ k t) Ω] [IsGalois (K₀ k' t') Ω'] [CharZero k] [IsAlgClosed Ω] [CharZero k']
  [IsAlgClosed Ω']

lemma piUToPiX_surjective (D : GaloisData k t) : Function.Surjective (piUToPiX D) := by
  intro y
  induction y using QuotientGroup.induction_on with
  | H h => exact ⟨h, rfl⟩

instance compactSpace_pi (D : GaloisData k t) : CompactSpace (Pi D) := Quotient.compactSpace

variable (Φ : Pi D ≃ₜ* Pi D') (hfill : ∀ x, piUToPiX D' (Φ x) = 1 ↔ piUToPiX D x = 1)

/-- **`Π_X ≃ₜ* Π_{X'}`** from an isomorphism `Φ : Π_U ≃ₜ* Π_{U'}` preserving the kernels of the
fillings `Π_U ↠ Π_X` (the closed normal subgroups generated by the cuspidal inertia groups). -/
def piXCongr : PiX D ≃ₜ* PiX D' :=
  descendCongr (piUToPiX D) (piUToPiX D') (continuous_piUToPiX D) (continuous_piUToPiX D')
    (piUToPiX_surjective D) (piUToPiX_surjective D') Φ hfill

lemma piXCongr_piUToPiX (x : Pi D) : piXCongr Φ hfill (piUToPiX D x) = piUToPiX D' (Φ x) :=
  descendCongr_apply _ _ _ _ _ _ _ _ x

variable (ψ : Gk k Ω ≃* Gk k' Ω') (hψ : ∀ x, piToGk D' (Φ x) = ψ (piToGk D x))

include hψ in
lemma piXToGk_piXCongr (y : PiX D) : piXToGk D' (piXCongr Φ hfill y) = ψ (piXToGk D y) := by
  obtain ⟨x, rfl⟩ := piUToPiX_surjective D y
  rw [piXCongr_piUToPiX, piXToGk_piUToPiX, piXToGk_piUToPiX, hψ]

include hψ in
lemma mem_deltaX_piXCongr_iff (y : PiX D) : piXCongr Φ hfill y ∈ DeltaX D' ↔ y ∈ DeltaX D := by
  change piXToGk D' _ = 1 ↔ piXToGk D y = 1
  rw [piXToGk_piXCongr Φ hfill ψ hψ, MulEquiv.map_eq_one_iff]

/-- **`Δ_X ≃ₜ* Δ_{X'}`**: the restriction of `piXCongr` to the geometric subgroups. -/
def deltaXCongr : DeltaX D ≃ₜ* DeltaX D' where
  toFun δ := ⟨piXCongr Φ hfill (δ : PiX D), (mem_deltaX_piXCongr_iff Φ hfill ψ hψ _).2 δ.2⟩
  invFun δ := ⟨(piXCongr Φ hfill).symm (δ : PiX D'), (mem_deltaX_piXCongr_iff Φ hfill ψ hψ _).1 (by
    rw [ContinuousMulEquiv.apply_symm_apply]; exact δ.2)⟩
  left_inv δ := Subtype.ext ((piXCongr Φ hfill).symm_apply_apply (δ : PiX D))
  right_inv δ := Subtype.ext ((piXCongr Φ hfill).apply_symm_apply (δ : PiX D'))
  map_mul' a b := Subtype.ext (map_mul (piXCongr Φ hfill) (a : PiX D) b)
  continuous_toFun := ((piXCongr Φ hfill).continuous.comp continuous_subtype_val).subtype_mk _
  continuous_invFun := ((piXCongr Φ hfill).symm.continuous.comp continuous_subtype_val).subtype_mk _

@[simp] lemma coe_deltaXCongr (δ : DeltaX D) :
    (deltaXCongr Φ hfill ψ hψ δ : PiX D') = piXCongr Φ hfill (δ : PiX D) := rfl

end PiX

/-! ### The conjugation action on `Δ_X = π₁ᵉᵗ(X_{k̄})` is conjugation in `Π_X` -/

section Curve

variable {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}} [X.Over (Spec (.of k))]
  [IsCurveOver k X] [IsIntegral X] {τ : X.functionField} {hτ : Transcendental k τ}
  [IsGalois (K₀ k (coordT τ)) (FFClosure X)]

/-- **`θ̄_h` is conjugation by `h` in `Π_X`**: under `Δ_X ≃ DeltaX D₀ ⊆ Π_X` (`deltaXEquivBar`),
curves-jacobian's conjugation action `thetaBar h` of `h ∈ H` on `Δ_X = π₁ᵉᵗ(X_{k̄})` is conjugation
by the image of `h` in `Π_X`. -/
lemma deltaXEquivBar_thetaBar (h : (curveGaloisData k hτ).H) (γ : DeltaBarX k hτ) :
    (deltaXEquivBar hτ (thetaBar hτ h γ) : PiX (curveGaloisData k hτ)) =
      (QuotientGroup.mk h : PiX (curveGaloisData k hτ)) *
        (deltaXEquivBar hτ γ : PiX (curveGaloisData k hτ)) *
          (QuotientGroup.mk h : PiX (curveGaloisData k hτ))⁻¹ := by
  obtain ⟨a, rfl⟩ := rhoBar_surjective (hτ := hτ) γ
  rw [thetaBar_rhoBar, deltaXEquivBar_rhoBar, deltaXEquivBar_rhoBar, coe_bcToDeltaX,
    coe_bcToDeltaX, ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul]
  refine congrArg QuotientGroup.mk (Subtype.ext ?_)
  exact resK₀_conjK (h : FFClosure X ≃ₐ[K₀ k (coordT τ)] FFClosure X) a

end Curve

/-! ### `M_X ≃ M_{X'}`, `Ẑ(1) ≃ Ẑ(1)'` and `H¹(Π_U, Ẑ(1)) ≃ H¹(Π_{U'}, Ẑ(1)')` -/

section Congr

variable {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}} [X.Over (Spec (.of k))]
  [IsCurveOver k X] [IsIntegral X] {τ : X.functionField} {hτ : Transcendental k τ}
  [IsGalois (K₀ k (coordT τ)) (FFClosure X)]
  {k' : Type u} [Field k'] [CharZero k'] {X' : Scheme.{u}} [X'.Over (Spec (.of k'))]
  [IsCurveOver k' X'] [IsIntegral X'] {τ' : X'.functionField} {hτ' : Transcendental k' τ'}
  [IsGalois (K₀ k' (coordT τ')) (FFClosure X')]
  (Φ : Pi (curveGaloisData k hτ) ≃ₜ* Pi (curveGaloisData k' hτ'))
  (hfill : ∀ x, piUToPiX (curveGaloisData k' hτ') (Φ x) = 1 ↔
    piUToPiX (curveGaloisData k hτ) x = 1)
  (ψ : Gk k (FFClosure X) ≃* Gk k' (FFClosure X'))
  (hψ : ∀ x, piToGk (curveGaloisData k' hτ') (Φ x) = ψ (piToGk (curveGaloisData k hτ) x))

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
/-- **`Δ_X ≃ₜ* Δ_{X'}`** for `Δ_X = π₁ᵉᵗ(X_{k̄})` (curves-jacobian's `DeltaBarX`, on which
`M_X` is defined), via `DeltaBarX ≃ DeltaX D₀` (`deltaXEquivBar`). -/
def deltaBarCongr : DeltaBarX k hτ ≃ₜ* DeltaBarX k' hτ' :=
  ((deltaXEquivBar hτ).trans (deltaXCongr Φ hfill ψ hψ)).trans (deltaXEquivBar hτ').symm

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
lemma deltaXEquivBar_deltaBarCongr (γ : DeltaBarX k hτ) :
    deltaXEquivBar hτ' (deltaBarCongr Φ hfill ψ hψ γ) =
      deltaXCongr Φ hfill ψ hψ (deltaXEquivBar hτ γ) := by
  simp [deltaBarCongr]

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
/-- **`deltaBarCongr` intertwines the conjugation actions**: if `Φ(h) = h'` in `Π_{U'}`, then
`Δ_X ≃ Δ_{X'}` carries `θ̄_h` to `θ̄_{h'}`. -/
lemma deltaBarCongr_thetaBar (h : (curveGaloisData k hτ).H) (h' : (curveGaloisData k' hτ').H)
    (hh : Φ (h : Pi (curveGaloisData k hτ)) = (h' : Pi (curveGaloisData k' hτ')))
    (γ : DeltaBarX k hτ) :
    deltaBarCongr Φ hfill ψ hψ (thetaBar hτ h γ) =
      thetaBar hτ' h' (deltaBarCongr Φ hfill ψ hψ γ) := by
  apply (deltaXEquivBar hτ').injective
  apply Subtype.ext
  rw [deltaXEquivBar_thetaBar, deltaXEquivBar_deltaBarCongr, deltaXEquivBar_deltaBarCongr,
    coe_deltaXCongr, coe_deltaXCongr, deltaXEquivBar_thetaBar, map_mul, map_mul, map_inv]
  have e : piXCongr Φ hfill (QuotientGroup.mk h : PiX (curveGaloisData k hτ)) =
      (QuotientGroup.mk h' : PiX (curveGaloisData k' hτ')) :=
    (piXCongr_piUToPiX Φ hfill (h : Pi (curveGaloisData k hτ))).trans (by rw [hh]; rfl)
  rw [e]

variable (K K' : Type u) [Field K] [Field K'] [CharZero K] [CharZero K']

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
/-- **`M_X ≃ₜ* M_{X'}`** (`M_X = Hom(H²(Δ_X, Ẑ), Ẑ)`, [AbsTopIII] Prop 1.4 (ii)), induced by
`Φ`. -/
def mxCongr : MX hτ K ≃ₜ* MX hτ' K' :=
  (MX.equiv hτ K).trans ((mxHatCongr K K' (deltaBarCongr Φ hfill ψ hψ)).trans
    (MX.equiv hτ' K').symm)

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
/-- `mxCongr` is equivariant for `h ∈ H` and any lift `h'` of `Φ(h)`. -/
lemma mxCongr_smul (h : (curveGaloisData k hτ).H) (h' : (curveGaloisData k' hτ').H)
    (hh : Φ (h : Pi (curveGaloisData k hτ)) = (h' : Pi (curveGaloisData k' hτ')))
    (φ : MX hτ K) :
    mxCongr Φ hfill ψ hψ K K' (h • φ) = h' • mxCongr Φ hfill ψ hψ K K' φ := by
  rw [MX.smul_def, MX.smul_def]
  exact mxHatCongr_precompMXHat K K' _ _ _ (deltaBarCongr_thetaBar Φ hfill ψ hψ h h' hh) _

variable [Fact (0 < (curveGenus k X).toNat)] [Fact (0 < (curveGenus k' X').toNat)]

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
/-- **`mxCongr` is `Φ`-equivariant**: `M_X(Φ)(g • φ) = Φ(g) • M_X(Φ)(φ)` for `g ∈ Π_U`. -/
theorem mxCongr_pi_smul (g : Pi (curveGaloisData k hτ)) (φ : MX hτ K) :
    mxCongr Φ hfill ψ hψ K K' (g • φ) = Φ g • mxCongr Φ hfill ψ hψ K K' φ := by
  induction g using QuotientGroup.induction_on with
  | H h =>
    obtain ⟨h', hh'⟩ := QuotientGroup.mk_surjective (Φ (h : Pi (curveGaloisData k hτ)))
    rw [← hh', pi_smul_mx, pi_smul_mx]
    exact mxCongr_smul Φ hfill ψ hψ K K' h h' hh'.symm φ

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
/-- **The cyclotome over `Φ`**: `Ẑ(1) ≃ₜ* Ẑ(1)'`, the isomorphism `M_X ≃ M_{X'}` read through
the natural `M_X ≅ Ẑ(1)` ([Mzk19] Prop 1.2 (ii), `natIsoHatK`). -/
def cycloCongr :
    ZHatOne (F (curveGaloisData k hτ)) (FFClosure X) ≃ₜ*
      ZHatOne (F (curveGaloisData k' hτ')) (FFClosure X') :=
  (natIsoHatK hτ _ Fact.out).symm.trans
    ((mxCongr Φ hfill ψ hψ _ _).trans (natIsoHatK hτ' _ Fact.out))

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
/-- **`cycloCongr` is `Φ`-equivariant**: `χ(g • z) = Φ(g) • χ(z)`. -/
theorem cycloCongr_smul (g : Pi (curveGaloisData k hτ))
    (z : ZHatOne (F (curveGaloisData k hτ)) (FFClosure X)) :
    cycloCongr Φ hfill ψ hψ (g • z) = Φ g • cycloCongr Φ hfill ψ hψ z := by
  simp only [cycloCongr, ContinuousMulEquiv.trans_apply]
  rw [← natIsoHatK_pi_smul, ← mxCongr_pi_smul]
  congr 2
  apply (natIsoHatK hτ _ Fact.out).injective
  rw [natIsoHatK_pi_smul, ContinuousMulEquiv.apply_symm_apply,
    ContinuousMulEquiv.apply_symm_apply]

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
lemma cycloCongr_symm_smul (g : Pi (curveGaloisData k hτ))
    (z : ZHatOne (F (curveGaloisData k' hτ')) (FFClosure X')) :
    (cycloCongr Φ hfill ψ hψ).symm (Φ g • z) = g • (cycloCongr Φ hfill ψ hψ).symm z := by
  apply (cycloCongr Φ hfill ψ hψ).injective
  rw [cycloCongr_smul, ContinuousMulEquiv.apply_symm_apply, ContinuousMulEquiv.apply_symm_apply]

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
/-- **`H¹(Π_U, Ẑ(1)) ≃* H¹(Π_{U'}, Ẑ(1)')`** induced by `Φ` and the cyclotome `cycloCongr`
([AbsTopIII] Thm 1.9 (b), (c): the Kummer side `H¹(Π_U, μ_Ẑ(Π_U))` is functorial in `Π_U`). -/
def h1CycloCongr :
    ContH1 (Pi (curveGaloisData k hτ)) (ZHatOne (F (curveGaloisData k hτ)) (FFClosure X)) ≃*
      ContH1 (Pi (curveGaloisData k' hτ'))
        (ZHatOne (F (curveGaloisData k' hτ')) (FFClosure X')) where
  toFun := ContH1.map Φ.symm.toMulEquiv.toMonoidHom Φ.symm.continuous
    (cycloCongr Φ hfill ψ hψ).toMulEquiv.toMonoidHom (cycloCongr Φ hfill ψ hψ).continuous
    fun g m ↦ by
      change cycloCongr Φ hfill ψ hψ (Φ.symm g • m) = g • cycloCongr Φ hfill ψ hψ m
      rw [cycloCongr_smul, ContinuousMulEquiv.apply_symm_apply]
  invFun := ContH1.map Φ.toMulEquiv.toMonoidHom Φ.continuous
    (cycloCongr Φ hfill ψ hψ).symm.toMulEquiv.toMonoidHom (cycloCongr Φ hfill ψ hψ).symm.continuous
    fun g m ↦ cycloCongr_symm_smul Φ hfill ψ hψ g m
  left_inv x := by
    induction x using ContH1.induction_on with
    | h c =>
      simp only [ContH1.map_mk]
      congr 1
      apply Subtype.ext
      funext g
      simp only [ContH1.cocyclesMap_apply]
      exact ((cycloCongr Φ hfill ψ hψ).symm_apply_apply _).trans (congrArg _ (Φ.symm_apply_apply g))
  right_inv x := by
    induction x using ContH1.induction_on with
    | h c =>
      simp only [ContH1.map_mk]
      congr 1
      apply Subtype.ext
      funext g
      simp only [ContH1.cocyclesMap_apply]
      exact ((cycloCongr Φ hfill ψ hψ).apply_symm_apply _).trans (congrArg _ (Φ.apply_symm_apply g))
  map_mul' := map_mul _

set_option synthInstance.maxHeartbeats 400000 in
-- instances on the quotients `Π_U`, `Π_X` are found slowly
set_option maxHeartbeats 1600000 in
-- the quotients `Π_U`, `Π_X` and the modules `M_X`, `Ẑ(1)` are slow for unification
lemma h1CycloCongr_mk
    (c : ContH1.cocycles (Pi (curveGaloisData k hτ))
      (ZHatOne (F (curveGaloisData k hτ)) (FFClosure X)))
    (g : Pi (curveGaloisData k' hτ')) :
    ∃ c' : ContH1.cocycles (Pi (curveGaloisData k' hτ'))
        (ZHatOne (F (curveGaloisData k' hτ')) (FFClosure X')),
      h1CycloCongr Φ hfill ψ hψ (ContH1.mk c) = ContH1.mk c' ∧
        (c' : _ → _) g = cycloCongr Φ hfill ψ hψ ((c : _ → _) (Φ.symm g)) :=
  ⟨_, rfl, rfl⟩

end Congr

