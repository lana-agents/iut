import Iut.Reconstruction.Cusp.SurfacePi1
import CurvesJacobian.Kummer.CuspCentralCurve

/-!
# The model `F̂ ↠ Π̂_{g,0}` is the geometric `Δ_{U_x} ↠ Δ_X`

`SurfaceH2.lean` proves [AbsTopIII] Prop 1.4 (ii) for the model `F̂ = F̂(a₁, b₁, …, a_g, b_g)`,
`Π̂_{g,0} = F̂ / cl⟨⟨∏ᵢ ⁅aᵢ, bᵢ⁆⟩⟩` (`SurfGrp g`), with cusp inertia generated by the relation. Here
this model is identified with the geometric fundamental groups:

* `freeSurfEquiv g : F(a, b) ≃* Π_{g,1}` (`pi1`'s `Π_{g,1}` is free on `a, b`; `rel ↦ c⁻¹`,
  `freeSurfEquiv_rel`) and its completion **`fhatEquiv g : F̂ ≃ₜ* Π̂_{g,1}`**;
* `map_relSub`: `relSub g ↦ cuspKernel g` (the kernel of filling the cusp), `map_relInertia`:
  `cl⟨rel⟩ ↦ I = cl⟨c⟩`, `map_cuspCentralKer`: `cl⁅relSub, F̂⁆ ↦ ccnKernel g`;
* `surfPi1Equiv_surfMap`: `surfPi1Equiv ∘ surfMap = fillHat ∘ fhatEquiv` (with `SurfacePi1.lean`);
* **`exists_fhat_equiv`**: for a proper smooth curve `X` of genus `g` over an algebraically closed
  field `k` of characteristic `0` and `U = X ∖ {x}`, there are `Θ : π₁ᵉᵗ(U) ≃ₜ* F̂` and
  `Θ₀ : π₁ᵉᵗ(X) ≃ₜ* SurfGrp g` with `Θ₀ ∘ π₁(U ⊆ X) = surfMap ∘ Θ`, carrying the cuspidal
  inertia group `I_x` onto `cl⟨rel⟩`, `ker(π₁(U) ↠ π₁(X))` onto `relSub g` and
  `cl⁅ker, π₁(U)⁆` onto `cuspCentralKer (surfMap g)` (from `curves-jacobian`'s
  `CurvesJacobian.CuspCentral.exists_cuspCentral_equiv`, MR5 S1d).

So `CuspCentral (surfMap g)` is the maximal cuspidally central quotient `Δ^{c-cn}_{U_x}` of the
curve, and the results of `SurfaceH2.lean`, `CuspCentral.lean`, `CuspTransgression.lean` and
`SurfaceIndex.lean` apply to it.
-/

open CategoryTheory AlgebraicGeometry ProfiniteGrp ProfiniteGrp.ProfiniteCompletion Pi1
  Pi1.SurfaceGen Pi1.SurfaceGroup Pi1.Profinite CurvesJacobian.CuspCentral

namespace Iut.Reconstruction.SurfaceH2

section Group

variable {G H : Type*} [Group G] [TopologicalSpace G] [Group H] [TopologicalSpace H]
  [IsTopologicalGroup G] [IsTopologicalGroup H]

/-- A topological isomorphism maps closures of subgroups to closures. -/
lemma map_topologicalClosure_equiv (e : G ≃ₜ* H) (S : Subgroup G) :
    S.topologicalClosure.map e.toMulEquiv.toMonoidHom =
      (S.map e.toMulEquiv.toMonoidHom).topologicalClosure := by
  apply SetLike.coe_injective
  rw [Subgroup.coe_map, Subgroup.topologicalClosure_coe, Subgroup.topologicalClosure_coe,
    Subgroup.coe_map]
  exact e.toHomeomorph.image_closure _

end Group

lemma normalClosure_singleton_inv {G : Type*} [Group G] (x : G) :
    Subgroup.normalClosure ({x⁻¹} : Set G) = Subgroup.normalClosure {x} := by
  refine le_antisymm (Subgroup.normalClosure_le_normal ?_)
    (Subgroup.normalClosure_le_normal ?_) <;> rw [Set.singleton_subset_iff]
  · exact inv_mem (Subgroup.subset_normalClosure rfl)
  · simpa using inv_mem (Subgroup.subset_normalClosure (Set.mem_singleton x⁻¹) :
      x⁻¹ ∈ Subgroup.normalClosure ({x⁻¹} : Set G))

variable (g : ℕ)

/-- `F(a₁, b₁, …, a_g, b_g) ≃* Π_{g,1}` (`pi1`'s `freeEquiv`, relabelled). -/
noncomputable def freeSurfEquiv : FreeGroup (Gen g) ≃* SurfaceGroup g 1 :=
  (FreeGroup.freeGroupCongr (genEquiv g).symm).trans (freeEquiv (g := g) (r := 0)).symm

lemma freeSurfEquiv_of (x : SurfaceGen g 0) :
    freeSurfEquiv g (FreeGroup.of (genEquiv g x)) = PresentedGroup.of (embGen x) := by
  rw [freeSurfEquiv, MulEquiv.trans_apply, MulEquiv.symm_apply_eq]
  cases x with
  | a i =>
    rw [show (PresentedGroup.of (embGen (SurfaceGen.a i)) : SurfaceGroup g 1) = genA i from rfl,
      freeEquiv_genA]
    simp [genEquiv]
  | b i =>
    rw [show (PresentedGroup.of (embGen (SurfaceGen.b i)) : SurfaceGroup g 1) = genB i from rfl,
      freeEquiv_genB]
    simp [genEquiv]
  | c j => exact j.elim0

lemma freeSurfEquiv_inl (i : Fin g) :
    freeSurfEquiv g (FreeGroup.of (Sum.inl i)) = genA i :=
  freeSurfEquiv_of g (.a i)

lemma freeSurfEquiv_inr (i : Fin g) :
    freeSurfEquiv g (FreeGroup.of (Sum.inr i)) = genB i :=
  freeSurfEquiv_of g (.b i)

/-- The relation goes to the inverse of the cuspidal generator. -/
lemma freeSurfEquiv_rel : freeSurfEquiv g (rel g) = (cusp 0)⁻¹ := by
  rw [← commProd_genA_genB_one]
  simp [rel, commProd, map_list_prod, List.map_ofFn, Function.comp_def, commutatorElement_def,
    freeSurfEquiv_inl, freeSurfEquiv_inr]

/-- **The model `F̂` is `Π̂_{g,1}`.** -/
noncomputable def fhatEquiv : Fhat g ≃ₜ* ProfiniteSurfaceGroup g 1 :=
  completionCongr (freeSurfEquiv g)

lemma fhatEquiv_eta (w : FreeGroup (Gen g)) :
    fhatEquiv g (eta g w) = etaFn (GrpCat.of (SurfaceGroup g 1)) (freeSurfEquiv g w) := by
  rw [fhatEquiv, completionCongr_apply]
  exact completionMap_eta _ w

lemma fhatEquiv_eta_rel : fhatEquiv g (eta g (rel g)) = (cuspHat g)⁻¹ := by
  rw [fhatEquiv_eta, freeSurfEquiv_rel]
  exact map_inv (ProfiniteGrp.ProfiniteCompletion.eta (GrpCat.of (SurfaceGroup g 1))).hom _

/-- `relSub g` (the kernel of `F̂ ↠ Π̂_{g,0}`) is the kernel `cuspKernel g` of filling the cusp. -/
lemma map_relSub : (relSub g).map (fhatEquiv g).toMulEquiv.toMonoidHom = cuspKernel g := by
  rw [relSub, map_topologicalClosure_equiv, Subgroup.map_normalClosure _
    (fhatEquiv g).toMulEquiv.toMonoidHom (fhatEquiv g).surjective, Set.image_singleton]
  change (Subgroup.normalClosure {fhatEquiv g (eta g (rel g))}).topologicalClosure = _
  rw [fhatEquiv_eta_rel, normalClosure_singleton_inv]
  rfl

/-- The closed subgroup generated by the relation is the cuspidal inertia group `I = cl⟨c⟩`. -/
lemma map_relInertia :
    (Subgroup.zpowers (eta g (rel g))).topologicalClosure.map
      (fhatEquiv g).toMulEquiv.toMonoidHom = inertia (g := g) (r := 1) 0 := by
  rw [map_topologicalClosure_equiv, MonoidHom.map_zpowers]
  change (Subgroup.zpowers (fhatEquiv g (eta g (rel g)))).topologicalClosure = _
  rw [fhatEquiv_eta_rel, Subgroup.zpowers_inv]
  rfl

/-- `cl⁅relSub, F̂⁆` is `ccnKernel g`: `CuspCentral (surfMap g) ≅ Δ^{c-cn}`. -/
lemma map_cuspCentralKer :
    (cuspCentralKer (surfMap g)).map (fhatEquiv g).toMulEquiv.toMonoidHom = ccnKernel g := by
  rw [cuspCentralKer, map_topologicalClosure_equiv, Subgroup.map_commutator, ker_surfMap,
    map_relSub, Subgroup.map_top_of_surjective (fhatEquiv g).toMulEquiv.toMonoidHom
      (fhatEquiv g).surjective]
  rfl

/-- **`F̂ ↠ Π̂_{g,0}` is `Π̂_{g,1} ↠ Π̂_{g,0}`**: `surfPi1Equiv ∘ surfMap = fillHat ∘ fhatEquiv`. -/
lemma surfPi1Equiv_surfMap (f : Fhat g) :
    surfPi1Equiv g (surfMap g f) = fillHat g (fhatEquiv g f) := by
  have h := hom_ext (φ := (surfPi1Equiv g).toMulEquiv.toMonoidHom.comp (surfMap g))
    (ψ := (fillHat g).comp (fhatEquiv g).toMulEquiv.toMonoidHom)
    ((surfPi1Equiv g).continuous.comp (continuous_surfMap g))
    ((continuous_fillHat g).comp (fhatEquiv g).continuous) (fun x => by
      obtain ⟨y, rfl⟩ := (genEquiv g).surjective x
      change surfPi1Equiv g (surfMap g (eta g (FreeGroup.of (genEquiv g y)))) =
        fillHat g (fhatEquiv g (eta g (FreeGroup.of (genEquiv g y))))
      rw [surfPi1Equiv_surfMap_eta_of, fhatEquiv_eta, freeSurfEquiv_of, fillHat_eta]
      cases y with
      | a i => exact congrArg _ (fillHom_genA i).symm
      | b i => exact congrArg _ (fillHom_genB i).symm
      | c j => exact j.elim0)
  exact DFunLike.congr_fun h f

section Geom

universe u

open Belyi AlgebraicGeometry.FiniteEtale AffOrbicurve Pi1.Orbifold PreGaloisCategory
  CurvesJacobian CurvesJacobian.Cusp

variable {k Ω : Type u} [Field k] [IsAlgClosed k] [CharZero k]
  [Field Ω] [Algebra k Ω] [IsSepClosed Ω] {t : Ω} [IsGalois (K₀ k t) Ω] (D : GaloisData k t)
  {X : Scheme.{u}} [X.Over (Spec (.of k))] [IsCurveOver k X] [IsIntegral X]
  (eL : X.functionField ≃+* D.L) (hH : D.H ≤ D.HL)
  (hk : ∀ c : k, ((eL (algebraMap k X.functionField c) : D.L) : Ω) = algebraMap k Ω c)
  {τ : X.functionField} (hτ : ((eL τ : D.L) : Ω) = t)
  [Nonempty (⊤ : X.Opens)]

include hk hτ in
/-- **The model is the geometric `Δ_{U_x} ↠ Δ_X`** ([AbsTopIII] Prop 1.4 (ii) setting): for a
proper smooth curve `X` of genus `g` over an algebraically closed field of characteristic `0`
and `U = X ∖ {x}` (`W₀` a place over `x`), `π₁ᵉᵗ(U) ≃ₜ* F̂` and `π₁ᵉᵗ(X) ≃ₜ* SurfGrp g`,
compatible with `π₁(U) ↠ π₁(X)` and `surfMap`, carrying `I_x` onto `cl⟨rel⟩`, the kernel onto
`relSub g` and `cl⁅ker, π₁(U)⁆` onto `cuspCentralKer (surfMap g)`. -/
theorem exists_fhat_equiv (U : X.Opens) [Nonempty U] {x : X}
    (hUx : (U : Set X)ᶜ = {x}) {W₀ : ValuationSubring Ω}
    (hW₀ : IsCentredOn D X eL ⊤ W₀)
    (hW₀U : ¬ IsCentredOn D X eL U W₀) :
    ∃ (Θ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U) ≃ₜ* Fhat (curveGenus k X).toNat)
      (Θ₀ : π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL ⊤) ≃ₜ* SurfGrp (curveGenus k X).toNat),
      (CurvesJacobian.Cusp.cuspInertia D X eL hH U W₀).map Θ.toMulEquiv.toMonoidHom =
        (Subgroup.zpowers (eta _ (rel (curveGenus k X).toNat))).topologicalClosure ∧
      (∀ γ, Θ₀ (fundamentalGroupMap (X.homOfLE le_top)
        (specPoint_genericL_homOfLE D X eL le_top) γ) = surfMap _ (Θ γ)) ∧
      (fundamentalGroupMap (X.homOfLE (le_top : U ≤ ⊤))
        (specPoint_genericL_homOfLE D X eL le_top)).toMonoidHom.ker.map
          Θ.toMulEquiv.toMonoidHom = relSub (curveGenus k X).toNat ∧
      (⁅(fundamentalGroupMap (X.homOfLE (le_top : U ≤ ⊤))
        (specPoint_genericL_homOfLE D X eL le_top)).toMonoidHom.ker, ⊤⁆ :
          Subgroup π₁ᵉᵗ(specPoint D.L Ω ≫ genericL D X eL U)).topologicalClosure.map
            Θ.toMulEquiv.toMonoidHom = cuspCentralKer (surfMap (curveGenus k X).toNat) := by
  set g := (curveGenus k X).toNat
  obtain ⟨Θ, Θ₀, hI, hfill, hker, hccn⟩ :=
    exists_cuspCentral_equiv D eL hH hk hτ U hUx hW₀ hW₀U
  have hmap : ∀ S : Subgroup (Fhat g), ∀ T, S.map (fhatEquiv g).toMulEquiv.toMonoidHom = T →
      T.map (fhatEquiv g).symm.toMulEquiv.toMonoidHom = S := by
    rintro S T rfl
    rw [Subgroup.map_map]
    convert Subgroup.map_id S
    ext y
    exact (fhatEquiv g).symm_apply_apply y
  refine ⟨Θ.trans (fhatEquiv g).symm, Θ₀.trans (surfPi1Equiv g).symm, ?_, fun γ => ?_, ?_, ?_⟩
  · rw [← hmap _ _ (map_relInertia g), ← hI, Subgroup.map_map]
    rfl
  · rw [ContinuousMulEquiv.trans_apply, ContinuousMulEquiv.trans_apply, hfill,
      ContinuousMulEquiv.symm_apply_eq, surfPi1Equiv_surfMap,
      ContinuousMulEquiv.apply_symm_apply]
  · rw [← hmap _ _ (map_relSub g), ← hker, Subgroup.map_map]
    rfl
  · rw [← hmap _ _ (map_cuspCentralKer g), ← hccn, Subgroup.map_map]
    rfl

end Geom

end Iut.Reconstruction.SurfaceH2
