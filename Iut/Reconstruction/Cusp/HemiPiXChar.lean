import CurvesJacobian.Cusp.HemiInvolutionGen
import CurvesJacobian.Cusp.MulNSubgroup

/-!
# `Π_X ⊆ Π_C` is group-theoretic, via the `ℓ`-torsion (MR9, IUT I Def. 3.1 (c), (d))

Let `E` be an elliptic curve over a number field `K` with all of `E[N]` rational over `K`
(`TorsionCardN E N`), `N > 1` odd, `X = E ∖ {O}`, `C = [X / ±1]` the hemi-elliptic orbicurve
(curves-jacobian's `Π_C = etalePi1 …`, `Π_X ↪ Π_C` = `hemiPiXEmb`, `Δ_C = ker hemiPrC`). The
index-`2` subgroup `Π_X` is *not* determined by `Δ_X = Π_X ∩ Δ_C` alone (the quadratic twists of
`X → C` have the same geometric part, cf. [AbsTopII] Cor. 3.3 (ii), `hemi_semiElliptic_iff'`). In
IUT, `X_K` is distinguished by the `ℓ`-torsion condition of IUT I, Def. 3.1 (c), (d)
(`Inter-universal Teichmuller Theory I.txt` l.3979–4000: `K` is cut out by `G_F → GL₂(𝔽_ℓ)`, and
the type `(1, ℓ-tors)` of [EtTh], Def. 2.1, `The Etale Theta Function … .txt` l.2382–2392). This
file proves the corresponding group-theoretic characterisation:

* **`range_hemiPiXEmb_eq_hemiCentN`**: `Π_X` is the subgroup `hemiCentN` of the `γ ∈ Π_C` acting
  trivially by conjugation on `Δ_X / Δ_X^N [Δ_X, Δ_X]` (`mulNClosure`). `⊆`: `[Π_X, Π_X]` lies in
  the `[N]`-subgroup `Π_U` and `Π_U ∩ Δ_X = Δ_X^N [Δ_X, Δ_X]` (curves-jacobian
  `commutator_mem_mulNPiU`, `mulNPiU_inf_Delta`). `⊉ Π_C`: otherwise `Δ_C / Δ_X^N [Δ_X, Δ_X]` is
  abelian and topologically generated by involutions (`hemi_hgen`), so `a² ∈ Δ_X^N [Δ_X, Δ_X]`
  for all `a ∈ Δ_X`, hence (`N` odd) `Δ_X ⊆ Π_U`, contradicting `Δ_X · Π_U = Π_X`,
  `[Π_X : Π_U] = N² ≠ 1`;
* **`map_DeltaX_hemi`**: a continuous automorphism of `Π_C` preserving `Δ_C` preserves `Δ_X`
  (`hemi_semiElliptic_iff'`);
* **`mem_range_hemiPiXEmb_iff_aut`**: hence it maps `Π_X` onto itself.
-/

open CategoryTheory AlgebraicGeometry Belyi Belyi.Anabelian Pi1 Pi1.Orbifold AffOrbicurve
  CurvesJacobian CurvesJacobian.Cusp

universe u

noncomputable section

namespace Iut.Reconstruction.HemiPiXChar

section Hemi

variable {K : Type u} [Field K] [NumberField K] (E : WeierstrassCurve K) [E.IsElliptic]
  (Ω' : Type u) [Field Ω'] [Algebra K Ω'] [IsAlgClosed Ω'] [Algebra.IsAlgebraic K Ω']
  [CharZero Ω']

/-- `Π_C` of the hemi-elliptic orbicurve. -/
abbrev HemiPiC : Type u := etalePi1 (hemiData E).R (hemiData E).A (FFClosure (curveE E))

/-- `Δ_C = ker (Π_C → G_K)`. -/
abbrev hemiDeltaC : Subgroup (HemiPiC E) := (hemiPrC E Ω').toMonoidHom.ker

/-- `Π_X ⊆ Π_C`. -/
abbrev hemiPiX : Subgroup (HemiPiC E) := (hemiPiXEmb E Ω').toMonoidHom.range

/-- `Δ_X = Π_X ∩ Δ_C`. -/
abbrev hemiDeltaX : Subgroup (HemiPiC E) := hemiPiX E Ω' ⊓ hemiDeltaC E Ω'

instance hemiPiX_normal : (hemiPiX E Ω').Normal := (hemi_arith_orbiEmb E Ω').2.1

instance hemiDeltaX_normal : (hemiDeltaX E Ω').Normal := Subgroup.normal_inf_normal _ _

/-- **The `γ ∈ Π_C` acting trivially on `Δ_X / Δ_X^N [Δ_X, Δ_X]`** by conjugation. -/
def hemiCentN (N : ℕ) : Subgroup (HemiPiC E) where
  carrier := {γ | ∀ δ ∈ hemiDeltaX E Ω', γ * δ * γ⁻¹ * δ⁻¹ ∈ mulNClosure (hemiDeltaX E Ω') N}
  one_mem' δ _ := by
    rw [one_mul, inv_one, mul_one, mul_inv_cancel]
    exact one_mem _
  mul_mem' {γ₁ γ₂} h₁ h₂ δ hδ := by
    have e : γ₁ * γ₂ * δ * (γ₁ * γ₂)⁻¹ * δ⁻¹ =
        γ₁ * (γ₂ * δ * γ₂⁻¹ * δ⁻¹) * γ₁⁻¹ * (γ₁ * δ * γ₁⁻¹ * δ⁻¹) := by group
    rw [e]
    exact mul_mem ((mulNClosure_normal _ N).conj_mem _ (h₂ δ hδ) γ₁) (h₁ δ hδ)
  inv_mem' {γ} h δ hδ := by
    have e : γ⁻¹ * δ * γ⁻¹⁻¹ * δ⁻¹ = γ⁻¹ * (γ * δ * γ⁻¹ * δ⁻¹)⁻¹ * γ⁻¹⁻¹ := by group
    rw [e]
    exact (mulNClosure_normal _ N).conj_mem _ (inv_mem (h δ hδ)) γ⁻¹

lemma mem_hemiCentN_iff (N : ℕ) (γ : HemiPiC E) :
    γ ∈ hemiCentN E Ω' N ↔
      ∀ δ ∈ hemiDeltaX E Ω', γ * δ * γ⁻¹ * δ⁻¹ ∈ mulNClosure (hemiDeltaX E Ω') N :=
  Iff.rfl

/-- `Δ_X` is the image of `Δ = ker (Π_X → G_K)`. -/
lemma hemiDeltaX_eq_map :
    hemiDeltaX E Ω' = (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).Delta.map
      (hemiPiXEmb E Ω').toMonoidHom :=
  hemi_range_inf_ker E Ω'

/-- `Π_X ⊴ Π_C`-image of `Δ^N [Δ, Δ]` lies in `Δ_X^N [Δ_X, Δ_X]`. -/
lemma map_mulNClosure_le (N : ℕ) {d : (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).Pi}
    (hd : d ∈ mulNClosure (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).Delta N) :
    hemiPiXEmb E Ω' d ∈ mulNClosure (hemiDeltaX E Ω') N := by
  have hle : mulNClosure (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).Delta N ≤
      (mulNClosure (hemiDeltaX E Ω') N).comap (hemiPiXEmb E Ω').toMonoidHom := by
    refine mulNClosure_le ((isClosed_mulNClosure _ N).preimage (hemiPiXEmb E Ω').continuous)
      (fun e he => ?_) (fun e he f hf => ?_)
    · rw [Subgroup.mem_comap, map_pow]
      refine pow_mem_mulNClosure N ?_
      rw [hemiDeltaX_eq_map]
      exact ⟨e, he, rfl⟩
    · rw [Subgroup.mem_comap, map_mul, map_mul, map_mul, map_inv, map_inv]
      refine commutator_mem_mulNClosure N ?_ ?_
      · rw [hemiDeltaX_eq_map]; exact ⟨e, he, rfl⟩
      · rw [hemiDeltaX_eq_map]; exact ⟨f, hf, rfl⟩
  exact hle hd

variable {E} {N : ℕ} [NeZero N] (hcard : TorsionCardN E N)

include hcard in
/-- **`Π_X` acts trivially on `Δ_X / Δ_X^N [Δ_X, Δ_X]`** (`Π_X / Π_U ≅ E[N]` is abelian and
`Π_U ∩ Δ = Δ^N [Δ, Δ]`). -/
theorem hemiPiX_le_hemiCentN : hemiPiX E Ω' ≤ hemiCentN E Ω' N := by
  rintro _ ⟨g, rfl⟩ δ hδ
  rw [hemiDeltaX_eq_map] at hδ
  obtain ⟨d, hd, rfl⟩ := hδ
  have hc : g * d * g⁻¹ * d⁻¹ ∈ mulNClosure
      (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).Delta N := by
    rw [← mulNPiU_inf_Delta Ω' hcard]
    refine ⟨commutator_mem_mulNPiU Ω' hcard g d, ?_⟩
    exact mul_mem ((Delta_normal₂ _).conj_mem d hd g) (Subgroup.inv_mem _ hd)
  have h := map_mulNClosure_le E Ω' N hc
  simp only [map_mul, map_inv] at h
  exact h

include hcard in
/-- `Δ_X^N [Δ_X, Δ_X]` lies in the image of `Π_U ∩ Δ`. -/
lemma mulNClosure_hemiDeltaX_le :
    mulNClosure (hemiDeltaX E Ω') N ≤
      (mulNPiU Ω' E N ⊓ (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).Delta).map
        (hemiPiXEmb E Ω').toMonoidHom := by
  have hcl : IsClosed (((mulNPiU Ω' E N ⊓
      (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).Delta).map
        (hemiPiXEmb E Ω').toMonoidHom : Subgroup (HemiPiC E)) : Set (HemiPiC E)) := by
    rw [Subgroup.coe_map]
    refine IsCompact.isClosed (IsCompact.image ?_ (hemiPiXEmb E Ω').continuous)
    exact (IsClosed.inter (isClosed_mulNPiU Ω' E N) (isClosed_Delta₂ _)).isCompact
  refine mulNClosure_le hcl (fun δ hδ => ?_) (fun δ hδ ε hε => ?_)
  · rw [hemiDeltaX_eq_map] at hδ
    obtain ⟨d, hd, rfl⟩ := hδ
    exact ⟨d ^ N, ⟨pow_mem_mulNPiU Ω' hcard d, pow_mem hd N⟩, map_pow _ d N⟩
  · rw [hemiDeltaX_eq_map] at hδ hε
    obtain ⟨d, hd, rfl⟩ := hδ
    obtain ⟨e, he, rfl⟩ := hε
    refine ⟨d * e * d⁻¹ * e⁻¹, ⟨commutator_mem_mulNPiU Ω' hcard d e,
      mul_mem (mul_mem (mul_mem hd he) (Subgroup.inv_mem _ hd)) (Subgroup.inv_mem _ he)⟩, ?_⟩
    simp only [MonoidHom.map_mul, MonoidHom.map_inv]

include hcard in
/-- `Δ_X ⊄ Δ_X^N [Δ_X, Δ_X]` (`Δ · Π_U = Π` and `[Π : Π_U] = N² ≠ 1`). -/
lemma exists_not_mem_mulNClosure (hN : N ≠ 1) :
    ∃ a ∈ hemiDeltaX E Ω', a ∉ mulNClosure (hemiDeltaX E Ω') N := by
  have hex : ∃ d ∈ (arithmeticExt Ω' (hypCurveX E) (compl_XE_nonempty E)).Delta,
      d ∉ mulNPiU Ω' E N := by
    by_contra h
    push Not at h
    have htop := Delta_sup_mulNPiU Ω' E N
    rw [sup_eq_right.2 h] at htop
    have hi := mulNPiU_index Ω' hcard
    rw [htop, Subgroup.index_top] at hi
    exact hN (Nat.pow_eq_one.1 hi.symm |>.resolve_right (by norm_num))
  obtain ⟨d, hd, hdU⟩ := hex
  refine ⟨hemiPiXEmb E Ω' d, by rw [hemiDeltaX_eq_map]; exact ⟨d, hd, rfl⟩, fun ha => hdU ?_⟩
  obtain ⟨e, he, hed⟩ := mulNClosure_hemiDeltaX_le Ω' hcard ha
  rw [← (hemi_arith_orbiEmb E Ω').1.injective hed]
  exact he.1

omit [NeZero N] in
/-- If all of `Π_C` acts trivially on `Δ_X / Δ_X^N [Δ_X, Δ_X]`, all commutators of `Δ_C` lie in
`Δ_X^N [Δ_X, Δ_X]`. -/
lemma commutator_mem_of_hemiCentN_eq_top (htop : hemiCentN E Ω' N = ⊤) {x y : HemiPiC E}
    (hx : x ∈ hemiDeltaC E Ω') (hy : y ∈ hemiDeltaC E Ω') :
    x * y * x⁻¹ * y⁻¹ ∈ mulNClosure (hemiDeltaX E Ω') N := by
  have hcent : ∀ γ, ∀ δ ∈ hemiDeltaX E Ω',
      γ * δ * γ⁻¹ * δ⁻¹ ∈ mulNClosure (hemiDeltaX E Ω') N := fun γ => by
    have : γ ∈ hemiCentN E Ω' N := by rw [htop]; exact Subgroup.mem_top γ
    exact this
  by_cases hxX : x ∈ hemiPiX E Ω'
  · have h := hcent y x ⟨hxX, hx⟩
    have e : x * y * x⁻¹ * y⁻¹ = (y * x * y⁻¹ * x⁻¹)⁻¹ := by group
    rw [e]
    exact inv_mem h
  by_cases hyX : y ∈ hemiPiX E Ω'
  · exact hcent x y ⟨hyX, hy⟩
  have hb : x⁻¹ * y ∈ hemiPiX E Ω' :=
    (Subgroup.mul_mem_iff_of_index_two (hemi_arith_orbiEmb E Ω').2.2.1).2
      ⟨fun h => absurd (inv_inv x ▸ Subgroup.inv_mem _ h) hxX, fun h => absurd h hyX⟩
  have hbΔ : x⁻¹ * y ∈ hemiDeltaX E Ω' := ⟨hb, mul_mem (Subgroup.inv_mem _ hx) hy⟩
  have e : x * y * x⁻¹ * y⁻¹ =
      x * (x * (x⁻¹ * y) * x⁻¹ * (x⁻¹ * y)⁻¹) * x⁻¹ := by group
  rw [e]
  exact (mulNClosure_normal _ N).conj_mem _ (hcent x _ hbΔ) x

/-- The elements of `Δ_C` whose square lies in `Δ_X^N [Δ_X, Δ_X]`, a subgroup when all
commutators of `Δ_C` lie there. -/
def sqSubgroup (N : ℕ) (htop : hemiCentN E Ω' N = ⊤) : Subgroup (HemiPiC E) where
  carrier := {z | z ∈ hemiDeltaC E Ω' ∧ z ^ 2 ∈ mulNClosure (hemiDeltaX E Ω') N}
  one_mem' := ⟨one_mem _, by rw [one_pow]; exact one_mem _⟩
  mul_mem' {x y} hx hy := by
    refine ⟨mul_mem hx.1 hy.1, ?_⟩
    have e : (x * y) ^ 2 = x * (y * x * y⁻¹ * x⁻¹) * x⁻¹ * (x ^ 2 * y ^ 2) := by
      rw [sq, sq, sq]; group
    rw [e]
    exact mul_mem ((mulNClosure_normal _ N).conj_mem _
      (commutator_mem_of_hemiCentN_eq_top Ω' htop hy.1 hx.1) x) (mul_mem hx.2 hy.2)
  inv_mem' {x} hx := ⟨inv_mem hx.1, by rw [inv_pow]; exact inv_mem hx.2⟩

include hcard in
/-- **`Π_C` does not act trivially on `Δ_X / Δ_X^N [Δ_X, Δ_X]`** (`N > 1` odd). -/
theorem hemiCentN_ne_top (hN : N ≠ 1) (hodd : Odd N) : hemiCentN E Ω' N ≠ ⊤ := by
  intro htop
  have hcl : IsClosed (sqSubgroup Ω' N htop : Set (HemiPiC E)) :=
    IsClosed.inter (isClosed_singleton.preimage (hemiPrC E Ω').continuous)
      ((isClosed_mulNClosure _ N).preimage (continuous_pow 2))
  have hgen : hemiDeltaC E Ω' ≤ sqSubgroup Ω' N htop := by
    refine (hemi_hgen E Ω').trans (Subgroup.topologicalClosure_minimal _ ?_ hcl)
    rw [Subgroup.closure_le]
    rintro τ ⟨hτ, hτ2, -⟩
    exact ⟨hτ, by rw [hτ2]; exact one_mem _⟩
  obtain ⟨a, ha, haN⟩ := exists_not_mem_mulNClosure Ω' hcard hN
  have h2 : a ^ 2 ∈ mulNClosure (hemiDeltaX E Ω') N := (hgen ha.2).2
  have hN' : a ^ N ∈ mulNClosure (hemiDeltaX E Ω') N := pow_mem_mulNClosure N ha
  obtain ⟨m, rfl⟩ := hodd
  have e : a = ((a ^ 2) ^ m)⁻¹ * a ^ (2 * m + 1) := by group
  rw [e] at haN
  exact haN (mul_mem (inv_mem (pow_mem h2 m)) hN')

include hcard in
/-- **`Π_X` is group-theoretic in `Π_C`** (IUT I, Def. 3.1 (c), (d); `N > 1` odd, `E[N]` rational):
`Π_X` is the subgroup of the `γ ∈ Π_C` acting trivially by conjugation on
`Δ_X / Δ_X^N [Δ_X, Δ_X]`. -/
theorem range_hemiPiXEmb_eq_hemiCentN (hN : N ≠ 1) (hodd : Odd N) :
    hemiPiX E Ω' = hemiCentN E Ω' N := by
  have hle := hemiPiX_le_hemiCentN Ω' hcard
  have hdvd : (hemiCentN E Ω' N).index ∣ 2 :=
    (hemi_arith_orbiEmb E Ω').2.2.1 ▸ Subgroup.index_dvd_of_le hle
  rcases (Nat.dvd_prime Nat.prime_two).1 hdvd with h1 | h2
  · exact absurd (Subgroup.index_eq_one.1 h1) (hemiCentN_ne_top Ω' hcard hN hodd)
  · refine le_antisymm hle (Subgroup.relIndex_eq_one.1 ?_)
    have h := Subgroup.relIndex_mul_index hle
    rw [h2, (hemi_arith_orbiEmb E Ω').2.2.1] at h
    omega

/-- **A `Δ_C`-preserving continuous automorphism of `Π_C` preserves `Δ_X`** (`α(Π_X)` is open of
index `2` with torsion-free geometric part, [AbsTopII] Cor. 3.3 (ii), `hemi_semiElliptic_iff'`). -/
theorem map_DeltaX_hemi (α : HemiPiC E ≃ₜ* HemiPiC E)
    (hα : ∀ x, α x ∈ hemiDeltaC E Ω' ↔ x ∈ hemiDeltaC E Ω') {x : HemiPiC E}
    (hx : x ∈ hemiDeltaX E Ω') : α x ∈ hemiDeltaX E Ω' := by
  let J := (hemiPiX E Ω').map (α.toMulEquiv : HemiPiC E →* HemiPiC E)
  have hJo : IsOpen (J : Set (HemiPiC E)) := by
    rw [Subgroup.coe_map]
    exact α.toHomeomorph.isOpenMap _ (isOpen_hemi_range E Ω')
  have hJi : J.index = 2 := by
    change ((hemiPiX E Ω').map (α.toMulEquiv : HemiPiC E →* HemiPiC E)).index = 2
    rw [Subgroup.index_map_equiv]
    exact (hemi_arith_orbiEmb E Ω').2.2.1
  have hJΔ : J ⊓ hemiDeltaC E Ω' =
      (hemiDeltaX E Ω').map (α.toMulEquiv : HemiPiC E →* HemiPiC E) := by
    ext y
    constructor
    · rintro ⟨⟨z, hz, rfl⟩, hy⟩
      exact ⟨z, ⟨hz, (hα z).1 hy⟩, rfl⟩
    · rintro ⟨z, ⟨hz, hzΔ⟩, rfl⟩
      exact ⟨⟨z, hz, rfl⟩, (hα z).2 hzΔ⟩
  have htf : IsTorsionFreeSubgroup (J ⊓ hemiDeltaC E Ω') := by
    rw [hJΔ]
    exact isTorsionFreeSubgroup_map₂ _ α.injective (isTorsionFreeSubgroup_hemi_range_inf E Ω')
  have heq := (hemi_semiElliptic_iff' E Ω' J hJo hJi).1 htf
  have hmem : α x ∈ J ⊓ hemiDeltaC E Ω' := by
    rw [hJΔ]
    exact ⟨x, hx, rfl⟩
  rw [heq] at hmem
  exact hmem

include hcard in
/-- **A `Δ_C`-preserving continuous automorphism of `Π_C` maps `Π_X` into itself** (IUT I,
Def. 3.1 (c), (d); `N > 1` odd, `E[N]` rational): it preserves `Δ_X` (`map_DeltaX_hemi`), hence
`Δ_X^N [Δ_X, Δ_X]` and the subgroup `hemiCentN = Π_X`. -/
theorem mem_hemiPiX_of_aut (hN : N ≠ 1) (hodd : Odd N) (α : HemiPiC E ≃ₜ* HemiPiC E)
    (hα : ∀ x, α x ∈ hemiDeltaC E Ω' ↔ x ∈ hemiDeltaC E Ω') {x : HemiPiC E}
    (hx : x ∈ hemiPiX E Ω') : α x ∈ hemiPiX E Ω' := by
  have hα' : ∀ y, α.symm y ∈ hemiDeltaC E Ω' ↔ y ∈ hemiDeltaC E Ω' := fun y => by
    rw [← hα, ContinuousMulEquiv.apply_symm_apply]
  have hmapΔ : (hemiDeltaX E Ω').map α.toMulEquiv.toMonoidHom = hemiDeltaX E Ω' := by
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact map_DeltaX_hemi Ω' α hα hz
    · intro hy
      exact ⟨α.symm y, map_DeltaX_hemi Ω' α.symm hα' hy, α.apply_symm_apply y⟩
  have hmapM : (mulNClosure (hemiDeltaX E Ω') N).map α.toMulEquiv.toMonoidHom =
      mulNClosure (hemiDeltaX E Ω') N := by
    rw [map_mulNClosure, hmapΔ]
  rw [range_hemiPiXEmb_eq_hemiCentN Ω' hcard hN hodd] at hx ⊢
  intro δ hδ
  have hδ' : α.symm δ ∈ hemiDeltaX E Ω' := by
    rw [← hmapΔ] at hδ
    obtain ⟨z, hz, rfl⟩ := hδ
    change α.symm (α z) ∈ _
    rwa [ContinuousMulEquiv.symm_apply_apply]
  have h := hx _ hδ'
  have hm : α (x * α.symm δ * x⁻¹ * (α.symm δ)⁻¹) ∈ mulNClosure (hemiDeltaX E Ω') N := by
    rw [← hmapM]
    exact ⟨_, h, rfl⟩
  simpa only [map_mul, map_inv, ContinuousMulEquiv.apply_symm_apply] using hm

include hcard in
/-- **`α(Π_X) = Π_X`** for a continuous automorphism `α` of `Π_C` preserving `Δ_C`. -/
theorem mem_hemiPiX_iff_aut (hN : N ≠ 1) (hodd : Odd N) (α : HemiPiC E ≃ₜ* HemiPiC E)
    (hα : ∀ x, α x ∈ hemiDeltaC E Ω' ↔ x ∈ hemiDeltaC E Ω') (x : HemiPiC E) :
    α x ∈ hemiPiX E Ω' ↔ x ∈ hemiPiX E Ω' := by
  have hα' : ∀ y, α.symm y ∈ hemiDeltaC E Ω' ↔ y ∈ hemiDeltaC E Ω' := fun y => by
    rw [← hα, ContinuousMulEquiv.apply_symm_apply]
  refine ⟨fun h => ?_, mem_hemiPiX_of_aut Ω' hcard hN hodd α hα⟩
  have := mem_hemiPiX_of_aut Ω' hcard hN hodd α.symm hα' h
  rwa [ContinuousMulEquiv.symm_apply_apply] at this

end Hemi

end Iut.Reconstruction.HemiPiXChar
