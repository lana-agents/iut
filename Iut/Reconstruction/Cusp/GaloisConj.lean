import Pi1.Orbicurve.GaloisPi1

/-!
# Transport of Galois-theoretic fundamental groups along field isomorphisms (MR8)

For fields `Ω₁ ⊇ P₁`, `Ω₂ ⊇ P₂` and a ring isomorphism `φ : Ω₁ ≃+* Ω₂` mapping the image of
`P₁` onto that of `P₂`:

* `galConj φ hφ : Gal(Ω₁ / P₁) ≃ₜ* Gal(Ω₂ / P₂)`, `σ ↦ φ σ φ⁻¹` (continuous for the Krull
  topologies, `continuous_galConjMul`: preimages of fixing subgroups of finite-dimensional
  intermediate fields contain fixing subgroups of the fields generated by the `φ⁻¹`-images of
  bases);
* `galConj_mem_inertia_iff`: `galConj` maps the inertia group of a valuation subring `W` onto that
  of `φ(W)`;
* `pi1Congr`: the groups `GaloisPi1.pi1 H S = H ⧸ ⟨⟨S⟩⟩` of the `pi1` project are transported along
  any isomorphism of topological Galois groups matching `H` and `S` (`map_ambientKernel`: the
  closed normal subgroups generated by `S` correspond).
-/

noncomputable section

namespace Iut.Reconstruction.HemiGenuine

universe u

open scoped Classical in
lemma valuation_lt_one_iff_mem' {K : Type*} [Field K] (W : ValuationSubring K) (z : K) :
    W.valuation z < 1 ↔ z ∈ W ∧ (z = 0 ∨ z⁻¹ ∉ W) := by
  by_cases hz : z = 0
  · subst hz; simp
  have hpos : 0 < W.valuation z := (Valuation.pos_iff _).mpr hz
  rw [← W.valuation_le_one_iff, ← W.valuation_le_one_iff, map_inv₀, inv_le_one₀ hpos]
  simp only [hz, false_or, not_le]
  exact ⟨fun h => ⟨h.le, h⟩, fun h => h.2⟩

/-! ### Conjugating Galois groups along a field isomorphism -/

section GalConj

variable {P₁ P₂ Ω₁ Ω₂ : Type u} [Field P₁] [Field P₂] [Field Ω₁] [Field Ω₂] [Algebra P₁ Ω₁]
  [Algebra P₂ Ω₂] (φ : Ω₁ ≃+* Ω₂)
  (hφ : ∀ x : Ω₁, x ∈ (algebraMap P₁ Ω₁).range ↔ φ x ∈ (algebraMap P₂ Ω₂).range)

include hφ in
lemma symm_mem_range {y : Ω₂} (hy : y ∈ (algebraMap P₂ Ω₂).range) :
    φ.symm y ∈ (algebraMap P₁ Ω₁).range :=
  (hφ _).2 (by rwa [RingEquiv.apply_symm_apply])

/-- `σ ↦ φ σ φ⁻¹` on one automorphism. -/
def galConjFun (σ : Ω₁ ≃ₐ[P₁] Ω₁) : Ω₂ ≃ₐ[P₂] Ω₂ :=
  AlgEquiv.ofRingEquiv (f := (φ.symm.trans σ.toRingEquiv).trans φ) fun c => by
    obtain ⟨c', hc'⟩ := symm_mem_range φ hφ ⟨c, rfl⟩
    change φ (σ (φ.symm (algebraMap P₂ Ω₂ c))) = _
    rw [← hc', AlgEquiv.commutes, hc', RingEquiv.apply_symm_apply]

lemma galConjFun_apply (σ : Ω₁ ≃ₐ[P₁] Ω₁) (y : Ω₂) :
    galConjFun φ hφ σ y = φ (σ (φ.symm y)) := rfl

include hφ in
lemma hφ_symm (y : Ω₂) : y ∈ (algebraMap P₂ Ω₂).range ↔ φ.symm y ∈ (algebraMap P₁ Ω₁).range := by
  rw [hφ, RingEquiv.apply_symm_apply]

/-- **Conjugation by `φ`**: `Gal(Ω₁ / P₁) ≃* Gal(Ω₂ / P₂)`, `σ ↦ φ σ φ⁻¹`. -/
def galConjMul : (Ω₁ ≃ₐ[P₁] Ω₁) ≃* (Ω₂ ≃ₐ[P₂] Ω₂) where
  toFun := galConjFun φ hφ
  invFun := galConjFun φ.symm (hφ_symm φ hφ)
  left_inv σ := AlgEquiv.ext fun x => by
    simp only [galConjFun_apply, RingEquiv.symm_symm, RingEquiv.symm_apply_apply]
  right_inv τ := AlgEquiv.ext fun x => by
    simp only [galConjFun_apply, RingEquiv.symm_symm, RingEquiv.apply_symm_apply]
  map_mul' σ τ := AlgEquiv.ext fun x => by
    simp only [galConjFun_apply, AlgEquiv.mul_apply, RingEquiv.symm_apply_apply]

lemma galConjMul_apply (σ : Ω₁ ≃ₐ[P₁] Ω₁) (y : Ω₂) :
    galConjMul φ hφ σ y = φ (σ (φ.symm y)) := rfl

/-- An automorphism fixing a basis of a finite-dimensional intermediate field fixes it. -/
lemma mem_fixingSubgroup_of_basis {E : IntermediateField P₂ Ω₂} {n : ℕ}
    (b : Module.Basis (Fin n) P₂ E) {τ : Ω₂ ≃ₐ[P₂] Ω₂} (hτ : ∀ i, τ (b i : Ω₂) = b i) :
    τ ∈ E.fixingSubgroup := by
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro e he
  have h' : e = ∑ i, b.repr ⟨e, he⟩ i • (b i : Ω₂) := by
    have := congrArg E.val (b.sum_repr ⟨e, he⟩)
    rw [map_sum] at this
    simpa [map_smul] using this.symm
  rw [h', map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_smul, hτ]

variable [Algebra.IsAlgebraic P₁ Ω₁]

include hφ in
lemma continuous_galConjMul : Continuous (galConjMul φ hφ) := by
  refine continuous_of_continuousAt_one (galConjMul φ hφ) ?_
  rw [ContinuousAt, map_one]
  intro U hU
  obtain ⟨E, hE, hEU⟩ := (krullTopology_mem_nhds_one_iff P₂ Ω₂ U).1 hU
  rw [Filter.mem_map]
  let b := Module.finBasis P₂ E
  let s : Set Ω₁ := Set.range fun i => φ.symm (b i : Ω₂)
  haveI : Finite s := Set.finite_range _ |>.to_subtype
  haveI : FiniteDimensional P₁ (IntermediateField.adjoin P₁ s) :=
    IntermediateField.finiteDimensional_adjoin fun x _ =>
      (Algebra.IsAlgebraic.isAlgebraic (R := P₁) x).isIntegral
  refine (krullTopology_mem_nhds_one_iff P₁ Ω₁ _).2
    ⟨IntermediateField.adjoin P₁ s, inferInstance, fun σ hσ => hEU ?_⟩
  rw [SetLike.mem_coe] at hσ ⊢
  refine mem_fixingSubgroup_of_basis b fun i => ?_
  have h := (IntermediateField.mem_fixingSubgroup_iff _ σ).1 hσ (φ.symm (b i : Ω₂))
    (IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩)
  change φ (σ (φ.symm (b i : Ω₂))) = _
  rw [h, RingEquiv.apply_symm_apply]

variable [Algebra.IsAlgebraic P₂ Ω₂]

/-- **Conjugation by `φ`** as an isomorphism of topological groups (Krull topologies). -/
def galConj : (Ω₁ ≃ₐ[P₁] Ω₁) ≃ₜ* (Ω₂ ≃ₐ[P₂] Ω₂) where
  toMulEquiv := galConjMul φ hφ
  continuous_toFun := continuous_galConjMul φ hφ
  continuous_invFun := continuous_galConjMul φ.symm (hφ_symm φ hφ)

lemma galConj_apply (σ : Ω₁ ≃ₐ[P₁] Ω₁) (y : Ω₂) : galConj φ hφ σ y = φ (σ (φ.symm y)) := rfl

lemma galConj_apply' (σ : Ω₁ ≃ₐ[P₁] Ω₁) (x : Ω₁) : galConj φ hφ σ (φ x) = φ (σ x) := by
  rw [galConj_apply, RingEquiv.symm_apply_apply]

/-- `φ` maps the inertia group of `W` onto that of `φ(W)`. -/
lemma galConj_mem_inertia_iff (σ : Ω₁ ≃ₐ[P₁] Ω₁) (W : ValuationSubring Ω₁) :
    galConj φ hφ σ ∈ GaloisPi1.inertia (W.comap φ.symm.toRingHom) ↔
      σ ∈ GaloisPi1.inertia W := by
  simp only [GaloisPi1.inertia, Set.mem_setOf_eq]
  have key : ∀ a : Ω₁, (W.comap φ.symm.toRingHom).valuation (φ a) < 1 ↔ W.valuation a < 1 := by
    intro a
    rw [valuation_lt_one_iff_mem',
      valuation_lt_one_iff_mem']
    simp only [ValuationSubring.mem_comap, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      RingEquiv.symm_apply_apply, map_inv₀, map_eq_zero_iff _ φ.injective]
  constructor
  · intro h a ha
    have := h (φ a) (by simpa [ValuationSubring.mem_comap] using ha)
    rw [galConj_apply', ← map_sub, key] at this
    exact this
  · intro h b hb
    obtain ⟨a, rfl⟩ := φ.surjective b
    have ha : a ∈ W := by simpa [ValuationSubring.mem_comap] using hb
    rw [galConj_apply', ← map_sub, key]
    exact h a ha

end GalConj

/-! ### Transport of the Galois-theoretic fundamental groups -/

section Pi1Congr

variable {P₁ P₂ Ω₁ Ω₂ : Type u} [Field P₁] [Field P₂] [Field Ω₁] [Field Ω₂] [Algebra P₁ Ω₁]
  [Algebra P₂ Ω₂] [IsGalois P₁ Ω₁] [IsGalois P₂ Ω₂]
  (e : (Ω₁ ≃ₐ[P₁] Ω₁) ≃ₜ* (Ω₂ ≃ₐ[P₂] Ω₂))
  {H₁ : Subgroup (Ω₁ ≃ₐ[P₁] Ω₁)} {S₁ : Set (Ω₁ ≃ₐ[P₁] Ω₁)}
  (hH₁ : IsClosed (H₁ : Set (Ω₁ ≃ₐ[P₁] Ω₁)))
  {H₂ : Subgroup (Ω₂ ≃ₐ[P₂] Ω₂)} {S₂ : Set (Ω₂ ≃ₐ[P₂] Ω₂)}
  (hH₂ : IsClosed (H₂ : Set (Ω₂ ≃ₐ[P₂] Ω₂)))
  (hH : ∀ σ, σ ∈ H₁ ↔ e σ ∈ H₂) (hS : ∀ σ, σ ∈ S₁ ↔ e σ ∈ S₂)

omit [IsGalois P₁ Ω₁] [IsGalois P₂ Ω₂] in
include hH hS in
lemma map_ambientKernel :
    (GaloisPi1.ambientKernel H₁ S₁).map (e : (Ω₁ ≃ₐ[P₁] Ω₁) →* (Ω₂ ≃ₐ[P₂] Ω₂)) =
      GaloisPi1.ambientKernel H₂ S₂ := by
  have hconj : (Subgroup.closure (GaloisPi1.conjSet H₁ S₁)).map
      (e : (Ω₁ ≃ₐ[P₁] Ω₁) →* (Ω₂ ≃ₐ[P₂] Ω₂)) = Subgroup.closure (GaloisPi1.conjSet H₂ S₂) := by
    rw [MonoidHom.map_closure]
    congr 1
    ext y
    obtain ⟨x, rfl⟩ := e.surjective y
    simp only [Set.mem_image, GaloisPi1.conjSet, Set.mem_setOf_eq]
    constructor
    · rintro ⟨z, ⟨h, hh, s, hs, rfl⟩, hz⟩
      refine ⟨e h, (hH h).1 hh, e s, (hS s).1 hs, ?_⟩
      rw [← hz]
      simp [map_mul, map_inv]
    · rintro ⟨h, hh, s, hs, hx⟩
      obtain ⟨h', rfl⟩ := e.surjective h
      obtain ⟨s', rfl⟩ := e.surjective s
      refine ⟨h' * s' * h'⁻¹, ⟨h', (hH h').2 hh, s', (hS s').2 hs, rfl⟩, ?_⟩
      rw [hx]
      simp [map_mul, map_inv]
  unfold GaloisPi1.ambientKernel
  rw [← hconj]
  apply SetLike.coe_injective
  rw [Subgroup.coe_map, Subgroup.topologicalClosure_coe, Subgroup.topologicalClosure_coe,
    Subgroup.coe_map]
  exact (e.toHomeomorph.image_closure _)

omit [IsGalois P₁ Ω₁] [IsGalois P₂ Ω₂] in
include hH hS in
lemma mem_ambientKernel_iff (σ : Ω₁ ≃ₐ[P₁] Ω₁) :
    σ ∈ GaloisPi1.ambientKernel H₁ S₁ ↔ e σ ∈ GaloisPi1.ambientKernel H₂ S₂ := by
  rw [← map_ambientKernel e hH hS]
  exact (Subgroup.mem_map_iff_mem (f := (e : (Ω₁ ≃ₐ[P₁] Ω₁) →* (Ω₂ ≃ₐ[P₂] Ω₂)))
    e.injective).symm

/-- `e` restricted to `H₁ ≃ₜ* H₂`. -/
def restrictH : H₁ ≃ₜ* H₂ where
  toFun x := ⟨e (x : Ω₁ ≃ₐ[P₁] Ω₁), (hH x.1).1 x.2⟩
  invFun y := ⟨e.symm y, (hH _).2 (by rw [ContinuousMulEquiv.apply_symm_apply]; exact y.2)⟩
  left_inv x := Subtype.ext (e.symm_apply_apply x.1)
  right_inv y := Subtype.ext (e.apply_symm_apply y)
  map_mul' x y := Subtype.ext (map_mul e x.1 y.1)
  continuous_toFun := (e.continuous.comp continuous_subtype_val).subtype_mk _
  continuous_invFun := (e.symm.continuous.comp continuous_subtype_val).subtype_mk _

omit [IsGalois P₁ Ω₁] [IsGalois P₂ Ω₂] in
include hS in
lemma map_kernel : (GaloisPi1.kernel H₁ S₁).map ((restrictH e hH).toMulEquiv : H₁ →* H₂) =
    GaloisPi1.kernel H₂ S₂ := by
  ext y
  obtain ⟨x, rfl⟩ := (restrictH e hH).surjective y
  constructor
  · rintro ⟨x', hx', h⟩
    obtain rfl : x' = x := (restrictH e hH).injective h
    exact (mem_ambientKernel_iff e hH hS x'.1).1 hx'
  · intro h
    exact ⟨x, (mem_ambientKernel_iff e hH hS x.1).2 h, rfl⟩

/-- **Transport of `H ⧸ ⟨⟨S⟩⟩` along an isomorphism of Galois groups** matching `H` and `S`. -/
def pi1Congr : GaloisPi1.pi1 H₁ S₁ hH₁ ≃ₜ* GaloisPi1.pi1 H₂ S₂ hH₂ where
  toMulEquiv := QuotientGroup.congr _ _ (restrictH e hH).toMulEquiv (map_kernel e hH hS)
  continuous_toFun := by
    change Continuous (QuotientGroup.congr (GaloisPi1.kernel H₁ S₁) (GaloisPi1.kernel H₂ S₂)
      (restrictH e hH).toMulEquiv (map_kernel e hH hS))
    rw [(QuotientGroup.isQuotientMap_mk (GaloisPi1.kernel H₁ S₁)).continuous_iff]
    exact QuotientGroup.continuous_mk.comp (restrictH e hH).continuous
  continuous_invFun := by
    change Continuous (QuotientGroup.congr (GaloisPi1.kernel H₁ S₁) (GaloisPi1.kernel H₂ S₂)
      (restrictH e hH).toMulEquiv (map_kernel e hH hS)).symm
    rw [QuotientGroup.congr_symm,
      (QuotientGroup.isQuotientMap_mk (GaloisPi1.kernel H₂ S₂)).continuous_iff]
    exact QuotientGroup.continuous_mk.comp (restrictH e hH).symm.continuous

lemma pi1Congr_mk (x : H₁) :
    pi1Congr e hH₁ hH₂ hH hS (QuotientGroup.mk x : H₁ ⧸ GaloisPi1.kernel H₁ S₁) =
      (QuotientGroup.mk (restrictH e hH x) : H₂ ⧸ GaloisPi1.kernel H₂ S₂) := rfl

end Pi1Congr

end Iut.Reconstruction.HemiGenuine
