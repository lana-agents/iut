/-! ### Twisted products `A ×_c Q` -/

section Twisted

variable {A Q : Type*} [CommGroup A] [Group Q]

/-- The multiplicative `2`-cocycle identity for the trivial action. -/
def IsTrivCocycle (c : Q × Q → A) : Prop :=
  ∀ x y z : Q, c (x * y, z) * c (x, y) = c (y, z) * c (x, y * z)

variable {c : Q × Q → A}

lemma IsTrivCocycle.one_left (hc : IsTrivCocycle c) (z : Q) : c (1, z) = c (1, 1) := by
  have h := hc 1 1 z
  simp only [one_mul] at h
  exact (mul_left_cancel h).symm

lemma IsTrivCocycle.one_right (hc : IsTrivCocycle c) (x : Q) : c (x, 1) = c (1, 1) := by
  have h := hc x 1 1
  simp only [mul_one] at h
  rw [hc.one_left] at h
  exact mul_right_cancel h

lemma IsTrivCocycle.inv_comm (hc : IsTrivCocycle c) (u : Q) : c (u⁻¹, u) = c (u, u⁻¹) := by
  have h := hc u u⁻¹ u
  rw [mul_inv_cancel, inv_mul_cancel, hc.one_left u, hc.one_right u, mul_comm (c (u⁻¹, u))] at h
  exact (mul_left_cancel h).symm

variable (c) in
/-- The twisted product `A ×_c Q`: `(a, u) (b, v) = (a b c(u, v), u v)`. -/
@[nolint unusedArguments]
def Twisted (_hc : IsTrivCocycle c) : Type _ := A × Q

namespace Twisted

variable (hc : IsTrivCocycle c)

instance : Mul (Twisted c hc) := ⟨fun p q => ((p : A × Q).1 * (q : A × Q).1 *
  c ((p : A × Q).2, (q : A × Q).2), (p : A × Q).2 * (q : A × Q).2)⟩

instance : One (Twisted c hc) := ⟨(((c (1, 1))⁻¹ : A), (1 : Q))⟩

instance : Inv (Twisted c hc) := ⟨fun p => ((p : A × Q).1⁻¹ * (c ((p : A × Q).2⁻¹,
  (p : A × Q).2))⁻¹ * (c (1, 1))⁻¹, (p : A × Q).2⁻¹)⟩

/-- The underlying pair. -/
def toProd : Twisted c hc → A × Q := id

/-- The element with given underlying pair. -/
def ofProd : A × Q → Twisted c hc := id

@[simp] lemma toProd_ofProd (p : A × Q) : toProd hc (ofProd hc p) = p := rfl

lemma mul_def (p q : Twisted c hc) : toProd hc (p * q) =
    ((toProd hc p).1 * (toProd hc q).1 * c ((toProd hc p).2, (toProd hc q).2),
      (toProd hc p).2 * (toProd hc q).2) := rfl

instance : Group (Twisted c hc) :=
  Group.ofLeftAxioms
    (fun p q r => by
      change ((_ : A), (_ : Q)) = ((_ : A), (_ : Q))
      refine Prod.ext ?_ (mul_assoc _ _ _)
      have h := hc (toProd hc p).2 (toProd hc q).2 (toProd hc r).2
      change (toProd hc p).1 * (toProd hc q).1 * c ((toProd hc p).2, (toProd hc q).2) *
          (toProd hc r).1 * c ((toProd hc p).2 * (toProd hc q).2, (toProd hc r).2) =
        (toProd hc p).1 * ((toProd hc q).1 * (toProd hc r).1 *
          c ((toProd hc q).2, (toProd hc r).2)) *
          c ((toProd hc p).2, (toProd hc q).2 * (toProd hc r).2)
      calc _ = (toProd hc p).1 * (toProd hc q).1 * (toProd hc r).1 *
            (c ((toProd hc p).2 * (toProd hc q).2, (toProd hc r).2) *
              c ((toProd hc p).2, (toProd hc q).2)) := by mul_abel
        _ = _ := by rw [h]; mul_abel)
    (fun p => by
      change ((_ : A), (_ : Q)) = toProd hc p
      refine Prod.ext ?_ (one_mul _)
      change (c (1, 1))⁻¹ * (toProd hc p).1 * c (1, (toProd hc p).2) = (toProd hc p).1
      rw [hc.one_left (toProd hc p).2]
      mul_abel)
    (fun p => by
      change ((_ : A), (_ : Q)) = (((c (1, 1))⁻¹ : A), (1 : Q))
      refine Prod.ext ?_ (inv_mul_cancel _)
      change (toProd hc p).1⁻¹ * (c ((toProd hc p).2⁻¹, (toProd hc p).2))⁻¹ * (c (1, 1))⁻¹ *
          (toProd hc p).1 * c ((toProd hc p).2⁻¹, (toProd hc p).2) = (c (1, 1))⁻¹
      mul_abel)

/-- The projection `A ×_c Q → Q`. -/
def snd : Twisted c hc →* Q where
  toFun p := (toProd hc p).2
  map_one' := rfl
  map_mul' _ _ := rfl

@[simp] lemma snd_apply (p : Twisted c hc) : snd hc p = (toProd hc p).2 := rfl

lemma fst_mul (p q : Twisted c hc) : (toProd hc (p * q)).1 =
    (toProd hc p).1 * (toProd hc q).1 * c ((toProd hc p).2, (toProd hc q).2) := rfl

/-- Elements over `1 ∈ Q` are central. -/
lemma mem_center (p : Twisted c hc) (hp : (toProd hc p).2 = 1) : p ∈ Subgroup.center _ := by
  rw [Subgroup.mem_center_iff]
  intro q
  change ((_ : A), (_ : Q)) = ((_ : A), (_ : Q))
  refine Prod.ext ?_ ?_
  · change (toProd hc q).1 * (toProd hc p).1 * c ((toProd hc q).2, (toProd hc p).2) =
      (toProd hc p).1 * (toProd hc q).1 * c ((toProd hc p).2, (toProd hc q).2)
    rw [hp, hc.one_right (toProd hc q).2, hc.one_left (toProd hc q).2]
    mul_abel
  · change (toProd hc q).2 * (toProd hc p).2 = (toProd hc p).2 * (toProd hc q).2
    rw [hp, one_mul, mul_one]

section Topology

variable [TopologicalSpace A] [TopologicalSpace Q]

instance : TopologicalSpace (Twisted c hc) := inferInstanceAs (TopologicalSpace (A × Q))

lemma continuous_toProd : Continuous (toProd hc) := continuous_id

lemma continuous_ofProd : Continuous (ofProd hc) := continuous_id

variable [IsTopologicalGroup A] [IsTopologicalGroup Q]

lemma isTopologicalGroup (hcont : Continuous c) : IsTopologicalGroup (Twisted c hc) where
  continuous_mul := by
    change Continuous fun p : (A × Q) × (A × Q) =>
      (p.1.1 * p.2.1 * c (p.1.2, p.2.2), p.1.2 * p.2.2)
    fun_prop
  continuous_inv := by
    change Continuous fun p : A × Q => (p.1⁻¹ * (c (p.2⁻¹, p.2))⁻¹ * (c (1, 1))⁻¹, p.2⁻¹)
    fun_prop

instance [CompactSpace A] [CompactSpace Q] : CompactSpace (Twisted c hc) :=
  inferInstanceAs (CompactSpace (A × Q))

instance [TotallyDisconnectedSpace A] [TotallyDisconnectedSpace Q] :
    TotallyDisconnectedSpace (Twisted c hc) :=
  inferInstanceAs (TotallyDisconnectedSpace (A × Q))

instance [T2Space A] [T2Space Q] : T2Space (Twisted c hc) := inferInstanceAs (T2Space (A × Q))

end Topology

end Twisted

end Twisted

/-! ### The profinite free group and the closed surface group `Π̂_{g,0}` -/

variable (g : ℕ)

/-- The generators `a_i = inl i`, `b_i = inr i`. -/
abbrev Gen : Type := Fin g ⊕ Fin g

/-- The profinite completion `F̂` of the free group on `a₁, b₁, …, a_g, b_g` (`≃ Δ_{U_x}`). -/
noncomputable abbrev Fhat : ProfiniteGrp.{0} :=
  ProfiniteGrp.ProfiniteCompletion.completion (GrpCat.of (FreeGroup (Gen g)))

/-- `F → F̂`. -/
noncomputable def eta : FreeGroup (Gen g) →* Fhat g :=
  (ProfiniteGrp.ProfiniteCompletion.eta (GrpCat.of (FreeGroup (Gen g)))).hom

/-- The surface relation `∏ᵢ ⁅aᵢ, bᵢ⁆`. -/
def rel : FreeGroup (Gen g) :=
  (List.ofFn fun i : Fin g => ⁅FreeGroup.of (Sum.inl i : Gen g), FreeGroup.of (Sum.inr i)⁆).prod

/-- The closed normal subgroup of `F̂` generated by the relation. -/
noncomputable def relSub : Subgroup (Fhat g) :=
  (Subgroup.normalClosure {eta g (rel g)}).topologicalClosure

instance : (relSub g).Normal := Subgroup.is_normal_topologicalClosure _

instance : IsClosed (relSub g : Set (Fhat g)) := Subgroup.isClosed_topologicalClosure _

/-- **The profinite closed surface group** `Π̂_{g,0} = F̂ / ⟨⟨∏ᵢ ⁅aᵢ, bᵢ⁆⟩⟩`. -/
abbrev SurfGrp : Type := Fhat g ⧸ relSub g

/-- `F̂ ↠ Π̂_{g,0}` (filling the cusp). -/
noncomputable def surfMap : Fhat g →* SurfGrp g := QuotientGroup.mk' _

lemma continuous_surfMap : Continuous (surfMap g) := QuotientGroup.continuous_mk

lemma surfMap_surjective : Function.Surjective (surfMap g) := QuotientGroup.mk'_surjective _

lemma ker_surfMap : (surfMap g).ker = relSub g := QuotientGroup.ker_mk' _

/-! #### The universal property of `F̂` -/

section Lift

variable {g} {P : Type} [Group P] [TopologicalSpace P] [IsTopologicalGroup P] [CompactSpace P]
  [TotallyDisconnectedSpace P]

/-- The continuous homomorphism `F̂ → P` extending `f : F → P`, for a profinite group `P`. -/
noncomputable def liftF (f : FreeGroup (Gen g) →* P) : Fhat g →ₜ* P :=
  (ProfiniteGrp.ProfiniteCompletion.lift (P := ProfiniteGrp.of P) (GrpCat.ofHom f)).hom

lemma liftF_eta (f : FreeGroup (Gen g) →* P) (x : FreeGroup (Gen g)) :
    liftF f (eta g x) = f x := by
  have h := ProfiniteGrp.ProfiniteCompletion.lift_eta (P := ProfiniteGrp.of P) (GrpCat.ofHom f)
  exact ConcreteCategory.congr_hom h x

/-- Two continuous homomorphisms `F̂ → P` to a Hausdorff group agreeing on the generators agree. -/
lemma hom_ext {P : Type*} [Group P] [TopologicalSpace P] [T2Space P] {φ ψ : Fhat g →* P}
    (hφ : Continuous φ) (hψ : Continuous ψ)
    (h : ∀ x : Gen g, φ (eta g (FreeGroup.of x)) = ψ (eta g (FreeGroup.of x))) : φ = ψ := by
  have h' : φ.comp (eta g) = ψ.comp (eta g) := FreeGroup.ext_hom _ _ h
  ext y
  exact congrFun ((ProfiniteGrp.ProfiniteCompletion.denseRange _).equalizer hφ hψ
    (funext fun x => DFunLike.congr_fun h' x)) y

end Lift

/-- A closed normal subgroup containing the relation contains `relSub`. -/
lemma relSub_le {N : Subgroup (Fhat g)} [N.Normal] (hN : IsClosed (N : Set (Fhat g)))
    (hr : eta g (rel g) ∈ N) : relSub g ≤ N :=
  Subgroup.topologicalClosure_minimal _
    (Subgroup.normalClosure_le_normal (Set.singleton_subset_iff.mpr hr)) hN

/-- A homomorphism to a commutative group kills the relation. -/
lemma map_rel_eq_one {B : Type*} [CommGroup B] (ψ : FreeGroup (Gen g) →* B) : ψ (rel g) = 1 := by
  rw [rel, map_list_prod, List.map_ofFn]
  refine List.prod_eq_one fun x hx => ?_
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hx
  simp [commutatorElement_def]

/-! ### The cuspidally central extension of `Π̂_{g,0}` -/

/-- The kernel `I` of `Δ^{c-cn} → Π̂_{g,0}` (the cusp inertia of the maximal cuspidally central
quotient of `Δ_{U_x}`). -/
noncomputable abbrev Inertia : Subgroup (CuspCentral (surfMap g)) :=
  cuspInertia (surfMap g) (continuous_surfMap g)

/-- The class `r̄ ∈ I` of the relation `∏ᵢ ⁅aᵢ, bᵢ⁆` (the cusp loop). -/
lemma inertia_eq_map : Inertia g = (relSub g).map (QuotientGroup.mk' _) := by
  rw [Inertia, cuspInertia_eq_map, ker_surfMap]

lemma mk_mem_inertia {f : Fhat g} (hf : f ∈ relSub g) :
    (QuotientGroup.mk f : CuspCentral (surfMap g)) ∈ Inertia g := by
  rw [inertia_eq_map]
  exact ⟨f, hf, rfl⟩

lemma eta_rel_mem : eta g (rel g) ∈ relSub g :=
  Subgroup.le_topologicalClosure _ (Subgroup.subset_normalClosure rfl)

/-- The class `r̄ ∈ I` of the relation `∏ᵢ ⁅aᵢ, bᵢ⁆` (the cusp loop). -/
noncomputable def relBar : Inertia g :=
  ⟨QuotientGroup.mk (eta g (rel g)), mk_mem_inertia g (eta_rel_mem g)⟩

/-- **`I` is topologically generated by `r̄`**: every closed subgroup of `Δ^{c-cn}` containing
`r̄` contains `I` (subgroups of the central `I` are normal). -/
theorem cuspInertia_le {L : Subgroup (CuspCentral (surfMap g))}
    (hL : IsClosed (L : Set (CuspCentral (surfMap g)))) (hLI : L ≤ Inertia g)
    (hr : (relBar g : CuspCentral (surfMap g)) ∈ L) : Inertia g ≤ L := by
  have hLn : L.Normal := ⟨fun l hl e => by
    have := cuspInertia_central (surfMap g) (continuous_surfMap g) l (hLI hl) e
    rw [this, mul_inv_cancel_right]
    exact hl⟩
  let N := L.comap (QuotientGroup.mk' (cuspCentralKer (surfMap g)))
  have hN : IsClosed (N : Set (Fhat g)) := hL.preimage QuotientGroup.continuous_mk
  have hle : relSub g ≤ N := relSub_le g hN hr
  rw [inertia_eq_map]
  rintro _ ⟨f, hf, rfl⟩
  exact hle hf

/-- `I` is the closure of the powers of `r̄`. -/
theorem dense_zpowers_relBar : Dense (Subgroup.zpowers (relBar g) : Set (Inertia g)) := by
  let L : Subgroup (CuspCentral (surfMap g)) :=
    ((Subgroup.zpowers (relBar g)).topologicalClosure).map (Inertia g).subtype
  have hI : IsClosed ((Inertia g : Subgroup _) : Set (CuspCentral (surfMap g))) :=
    isClosed_cuspInertia _ _
  have hc : IsClosed ((Subgroup.zpowers (relBar g)).topologicalClosure : Set (Inertia g)) :=
    Subgroup.isClosed_topologicalClosure _
  have hL : IsClosed (L : Set (CuspCentral (surfMap g))) := by
    rw [Subgroup.coe_map]
    exact (hI.isClosedEmbedding_subtypeVal).isClosedMap _ hc
  have hle := cuspInertia_le g hL (by
    rintro _ ⟨x, -, rfl⟩
    exact x.2) ⟨relBar g, Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers _), rfl⟩
  rw [dense_iff_closure_eq, ← Subgroup.topologicalClosure_coe, Set.eq_univ_iff_forall]
  intro i
  obtain ⟨x, hx, hxi⟩ := hle i.2
  rwa [Subtype.ext hxi] at hx

/-- A continuous homomorphism from `F̂` to a `T1` group sending `relSub` into the center kills
`cl⁅relSub, F̂⁆`, i.e. factors through `Δ^{c-cn}`. -/
lemma cuspCentralKer_le_of_center {P : Type*} [Group P] [TopologicalSpace P] [T1Space P]
    (ρ : Fhat g →* P) (hρ : Continuous ρ) (h : ∀ f ∈ relSub g, ρ f ∈ Subgroup.center P) :
    cuspCentralKer (surfMap g) ≤ ρ.ker := by
  refine Subgroup.topologicalClosure_minimal _ ?_ (isClosed_ker ρ hρ)
  rw [Subgroup.commutator_le]
  intro a ha b _
  rw [ker_surfMap] at ha
  have hc := Subgroup.mem_center_iff.mp (h a ha) (ρ b)
  rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_def, ← hc,
    mul_inv_cancel_right, mul_inv_cancel]

/-! ### The transgression is bijective -/

section Transgression

variable (A : Type) [CommGroup A] [TopologicalSpace A] [DiscreteTopology A] [IsTopologicalGroup A]

/-- `d₂ : Hom_cont(I, A) → H²(Δ^{c-cn}/I, A)` is **injective**: a homomorphism `Δ^{c-cn} → A`
kills `∏ᵢ ⁅aᵢ, bᵢ⁆`, hence `I`. -/
theorem cuspTg_injective : Function.Injective (cuspTg (surfMap g) (continuous_surfMap g) A) := by
  rw [injective_iff_map_eq_one]
  intro φ hφ
  obtain ⟨χ, hχ⟩ := (cuspTg_eq_one_iff _ _ A φ).mp hφ
  have hmul : ∀ a b, χ (a * b) = χ a * χ b := fun a b => by
    rw [χ.2.2 a b, TrivCoeff.smul_eq, mul_comm]
  let χh : CuspCentral (surfMap g) →* TrivCoeff A :=
    { toFun := χ
      map_one' := mul_left_cancel (a := χ 1) (by rw [← hmul, mul_one, mul_one])
      map_mul' := hmul }
  have hL : IsClosed ((χh.ker ⊓ Inertia g : Subgroup _) : Set (CuspCentral (surfMap g))) :=
    (isClosed_ker χh χ.2.1).inter (isClosed_cuspInertia _ _)
  have hr : (relBar g : CuspCentral (surfMap g)) ∈ χh.ker ⊓ Inertia g := by
    refine ⟨?_, (relBar g).2⟩
    change χh ((QuotientGroup.mk' _).comp (eta g) (rel g)) = 1
    rw [← MonoidHom.comp_apply]
    exact map_rel_eq_one g _
  have hle := cuspInertia_le g hL inf_le_right hr
  ext i
  rw [← hχ i]
  exact (hle i.2).1

variable [Finite A]

/-- **Inflation `H²(Δ^{c-cn}/I, A) → H²(Δ^{c-cn}, A)` is zero** for finite `A`: a `2`-cocycle `c`
becomes a coboundary on `Δ^{c-cn}`, since the free generators lift to the twisted product
`A ×_c (Δ^{c-cn}/I)` and the lift factors through `Δ^{c-cn}` (the kernel of `F̂ ↠ Π̂_{g,0}` maps
into the central `A × {1}`). -/
theorem inf₂_eq_one (z : ContH2 (CuspCentral (surfMap g) ⧸ Inertia g)
    (fixedPts (Inertia g) (TrivCoeff A))) : inf₂ (Inertia g) (TrivCoeff A) z = 1 := by
  induction z using ContH2.induction_on with | h c => ?_
  haveI : IsClosed ((Inertia g : Subgroup _) : Set (CuspCentral (surfMap g))) :=
    isClosed_cuspInertia _ _
  haveI : TotallyDisconnectedSpace (CuspCentral (surfMap g) ⧸ Inertia g) :=
    QuotientGroup.totallyDisconnectedSpace_of_isClosed _ (isClosed_cuspInertia _ _)
  set Qt := CuspCentral (surfMap g) ⧸ Inertia g
  let q : CuspCentral (surfMap g) →* Qt := QuotientGroup.mk' _
  let mk : Fhat g →* CuspCentral (surfMap g) := QuotientGroup.mk' _
  have hq : Continuous q := QuotientGroup.continuous_mk
  have hmk : Continuous mk := QuotientGroup.continuous_mk
  let cA : Qt × Qt → A := fun p => ((c p : fixedPts (Inertia g) (TrivCoeff A)) : TrivCoeff A)
  have hsmul : ∀ (u : Qt) (a : fixedPts (Inertia g) (TrivCoeff A)), u • a = a := by
    intro u a
    obtain ⟨e, rfl⟩ := QuotientGroup.mk_surjective u
    exact Subtype.ext rfl
  have hcA : IsTrivCocycle cA := fun x y w => by
    have h := ContH2.isMulCocycle₂ c x y w
    rw [hsmul] at h
    exact congrArg Subtype.val h
  have hcont : Continuous cA :=
    ((ContH2.isLocallyConstant c).comp (fun a => (a : TrivCoeff A))).continuous
  letI := Twisted.isTopologicalGroup hcA hcont
  let T := Twisted cA hcA
  let f0 : FreeGroup (Gen g) →* T :=
    FreeGroup.lift fun x => Twisted.ofProd hcA (1, q (mk (eta g (FreeGroup.of x))))
  let s := liftF f0
  have hs2 : (Twisted.snd hcA).comp s.toMonoidHom = q.comp mk := by
    refine hom_ext (continuous_snd.comp ((Twisted.continuous_toProd hcA).comp s.continuous))
      (hq.comp hmk) fun x => ?_
    change (Twisted.toProd hcA (liftF f0 (eta g (FreeGroup.of x)))).2 = _
    rw [liftF_eta, FreeGroup.lift_apply_of]
    rfl
  have hs2' : ∀ f, (Twisted.toProd hcA (s f)).2 = q (mk f) := fun f =>
    DFunLike.congr_fun hs2 f
  have hcent : ∀ f ∈ relSub g, s f ∈ Subgroup.center T := by
    intro f hf
    refine Twisted.mem_center hcA _ ?_
    rw [hs2']
    exact (QuotientGroup.eq_one_iff _).mpr (mk_mem_inertia g hf)
  have hker := cuspCentralKer_le_of_center g s.toMonoidHom s.continuous hcent
  let t : CuspCentral (surfMap g) →* T := QuotientGroup.lift _ s.toMonoidHom hker
  have ht : Continuous t := (QuotientGroup.isQuotientMap_mk _).continuous_iff.mpr s.continuous
  have ht2 : ∀ e, (Twisted.toProd hcA (t e)).2 = q e := by
    intro e
    obtain ⟨f, rfl⟩ := QuotientGroup.mk_surjective e
    exact hs2' f
  let x : CuspCentral (surfMap g) → TrivCoeff A := fun e => ((Twisted.toProd hcA (t e)).1)⁻¹
  have hx : IsLocallyConstant x :=
    (IsLocallyConstant.iff_continuous x).mpr
      (continuous_inv.comp (continuous_fst.comp ((Twisted.continuous_toProd hcA).comp ht)))
  rw [inf₂, ContH2.map_mk, ContH2.mk_eq_one_iff]
  refine ⟨x, hx, funext fun p => ?_⟩
  obtain ⟨e₁, e₂⟩ := p
  have h12 := Twisted.fst_mul hcA (t e₁) (t e₂)
  rw [← map_mul, ht2, ht2] at h12
  change ((Twisted.toProd hcA (t e₂)).1)⁻¹ / ((Twisted.toProd hcA (t (e₁ * e₂))).1)⁻¹ *
    ((Twisted.toProd hcA (t e₁)).1)⁻¹ = cA (q e₁, q e₂)
  rw [h12]
  mul_abel

/-- `d₂` is **surjective** for finite `A`. -/
theorem cuspTg_surjective :
    Function.Surjective (cuspTg (surfMap g) (continuous_surfMap g) A) := fun z =>
  exists_cuspTg_eq_of_inf₂_eq_one _ _ A (inf₂_eq_one g A z)

/-- **`Hom_cont(I, A) ≅ H²(Δ^{c-cn}/I, A)`** via the transgression, for finite discrete `A`. -/
noncomputable def cuspTgEquiv : ContinuousMonoidHom (Inertia g) (TrivCoeff A) ≃*
    ContH2 (CuspCentral (surfMap g) ⧸ Inertia g) (fixedPts (Inertia g) (TrivCoeff A)) :=
  MulEquiv.ofBijective _ ⟨cuspTg_injective g A, cuspTg_surjective g A⟩

@[simp] lemma cuspTgEquiv_apply (φ : ContinuousMonoidHom (Inertia g) (TrivCoeff A)) :
    cuspTgEquiv g A φ = cuspTg (surfMap g) (continuous_surfMap g) A φ := rfl

end Transgression

/-! ### The Heisenberg group modulo `n` -/

/-- The Heisenberg group over `ℤ/n`: `(a, b, c) (a', b', c') = (a + a', b + b', c + c' + a b')`. -/
@[ext]
structure Heis (n : ℕ) where
  /-- first coordinate -/
  a : ZMod n
  /-- second coordinate -/
  b : ZMod n
  /-- central coordinate -/
  c : ZMod n

namespace Heis

variable {n : ℕ}

instance : Mul (Heis n) := ⟨fun p q => ⟨p.a + q.a, p.b + q.b, p.c + q.c + p.a * q.b⟩⟩

instance : One (Heis n) := ⟨⟨0, 0, 0⟩⟩

instance : Inv (Heis n) := ⟨fun p => ⟨-p.a, -p.b, -p.c + p.a * p.b⟩⟩

instance : Group (Heis n) :=
  Group.ofLeftAxioms
    (fun p q r => Heis.ext (add_assoc p.a q.a r.a) (add_assoc p.b q.b r.b) (by
      change p.c + q.c + p.a * q.b + r.c + (p.a + q.a) * r.b =
        p.c + (q.c + r.c + q.a * r.b) + p.a * (q.b + r.b)
      ring))
    (fun p => Heis.ext (zero_add p.a) (zero_add p.b) (by
      change 0 + p.c + 0 * p.b = p.c
      ring))
    (fun p => Heis.ext (neg_add_cancel p.a) (neg_add_cancel p.b) (by
      change -p.c + p.a * p.b + p.c + -p.a * p.b = 0
      ring))

@[simp] lemma mul_a (p q : Heis n) : (p * q).a = p.a + q.a := rfl
@[simp] lemma mul_b (p q : Heis n) : (p * q).b = p.b + q.b := rfl
@[simp] lemma mul_c (p q : Heis n) : (p * q).c = p.c + q.c + p.a * q.b := rfl
@[simp] lemma one_a : (1 : Heis n).a = 0 := rfl
@[simp] lemma one_b : (1 : Heis n).b = 0 := rfl
@[simp] lemma one_c : (1 : Heis n).c = 0 := rfl
@[simp] lemma inv_a (p : Heis n) : p⁻¹.a = -p.a := rfl
@[simp] lemma inv_b (p : Heis n) : p⁻¹.b = -p.b := rfl
@[simp] lemma inv_c (p : Heis n) : p⁻¹.c = -p.c + p.a * p.b := rfl

/-- The central element `(0, 0, t)`. -/
def zc (t : ZMod n) : Heis n := ⟨0, 0, t⟩

@[simp] lemma zc_c (t : ZMod n) : (zc t).c = t := rfl

lemma zc_mul (s t : ZMod n) : zc s * zc t = zc (s + t) :=
  Heis.ext (add_zero 0) (add_zero 0) (by simp [zc])

lemma zc_zero : zc (0 : ZMod n) = 1 := rfl

/-- `X = (1, 0, 0)`. -/
def X : Heis n := ⟨1, 0, 0⟩

/-- `Y = (0, 1, 0)`. -/
def Y : Heis n := ⟨0, 1, 0⟩

lemma commutator_X_Y : ⁅(X : Heis n), Y⁆ = zc (1 : ZMod n) :=
  Heis.ext (by simp [commutatorElement_def, X, Y, zc]) (by simp [commutatorElement_def, X, Y, zc])
    (by simp [commutatorElement_def, X, Y, zc])

/-- The central subgroup `{(0, 0, t)}`. -/
def centralSub : Subgroup (Heis n) where
  carrier := {p | p.a = 0 ∧ p.b = 0}
  mul_mem' := fun ⟨h1, h2⟩ ⟨h3, h4⟩ => ⟨by simp [h1, h3], by simp [h2, h4]⟩
  one_mem' := ⟨rfl, rfl⟩
  inv_mem' := fun ⟨h1, h2⟩ => ⟨by simp [h1], by simp [h2]⟩

lemma centralSub_le_center : (centralSub : Subgroup (Heis n)) ≤ Subgroup.center (Heis n) := by
  rintro p ⟨h1, h2⟩
  refine Subgroup.mem_center_iff.mpr fun q => Heis.ext ?_ ?_ ?_
  · simp [h1, add_comm]
  · simp [h2, add_comm]
  · simp only [mul_c, h1, h2, mul_zero, zero_mul, add_zero]
    ring

instance : (centralSub : Subgroup (Heis n)).Normal :=
  ⟨fun p hp q => by
    rw [Subgroup.mem_center_iff.mp (centralSub_le_center hp) q, mul_inv_cancel_right]
    exact hp⟩

instance : TopologicalSpace (Heis n) := ⊥

instance : DiscreteTopology (Heis n) := ⟨rfl⟩

instance [NeZero n] : Finite (Heis n) :=
  Finite.of_injective (fun p : Heis n => (p.a, p.b, p.c)) fun p q h => by
    simp only [Prod.mk.injEq] at h
    exact Heis.ext h.1 h.2.1 h.2.2

end Heis

/-! ### `Hom_cont(I, ℤ/n) ≅ ℤ/n` and `H²(Π̂_{g,0}, ℤ/n) ≅ ℤ/n` for `g ≥ 1` -/

/-- `ℤ/n` (multiplicatively) with the trivial action. -/
abbrev Zn (n : ℕ) : Type := TrivCoeff (Multiplicative (ZMod n))

instance (n : ℕ) [NeZero n] : Finite (Multiplicative (ZMod n)) := inferInstanceAs (Finite (ZMod n))

variable {g}

/-- `a_{i₀} ↦ X`, `b_{i₀} ↦ Y`, all other generators `↦ 1`. -/
def heisGen (n : ℕ) (i₀ : Fin g) : Gen g → Heis n :=
  Sum.elim (fun i => if i = i₀ then Heis.X else 1) (fun i => if i = i₀ then Heis.Y else 1)

lemma prod_ofFn_zc {n : ℕ} : ∀ {m : ℕ} (t : Fin m → ZMod n),
    (List.ofFn fun i => Heis.zc (t i)).prod = Heis.zc (∑ i, t i)
  | 0, t => by simp [Heis.zc_zero]
  | m + 1, t => by
    rw [List.ofFn_succ, List.prod_cons, prod_ofFn_zc, Fin.sum_univ_succ, Heis.zc_mul]

lemma lift_heisGen_rel (n : ℕ) (i₀ : Fin g) :
    FreeGroup.lift (heisGen n i₀) (rel g) = Heis.zc 1 := by
  rw [rel, map_list_prod, List.map_ofFn]
  have : ((FreeGroup.lift (heisGen n i₀)) ∘ fun i : Fin g =>
      ⁅FreeGroup.of (Sum.inl i : Gen g), FreeGroup.of (Sum.inr i)⁆) =
        fun i => Heis.zc (if i = i₀ then 1 else 0) := by
    funext i
    simp only [Function.comp_apply, map_commutatorElement, FreeGroup.lift_apply_of, heisGen,
      Sum.elim_inl, Sum.elim_inr]
    split_ifs
    · exact Heis.commutator_X_Y
    · simp [Heis.zc_zero]
  rw [this, prod_ofFn_zc, Finset.sum_ite_eq' Finset.univ i₀]
  simp

variable (n : ℕ) [NeZero n] (i₀ : Fin g)

/-- `F̂ → Heis(ℤ/n)`. -/
noncomputable def heisF : Fhat g →ₜ* Heis n := liftF (FreeGroup.lift (heisGen n i₀))

lemma heisF_mem {f : Fhat g} (hf : f ∈ relSub g) : heisF n i₀ f ∈ Heis.centralSub := by
  have hcl : IsClosed ((Heis.centralSub.comap (heisF n i₀).toMonoidHom : Subgroup (Fhat g)) :
      Set (Fhat g)) := by
    rw [Subgroup.coe_comap]
    exact (isClosed_discrete _).preimage (heisF n i₀).continuous
  refine relSub_le g hcl ?_ hf
  change heisF n i₀ (eta g (rel g)) ∈ Heis.centralSub
  rw [heisF, liftF_eta, lift_heisGen_rel]
  exact ⟨rfl, rfl⟩

/-- `Δ^{c-cn} → Heis(ℤ/n)`. -/
noncomputable def heisE : CuspCentral (surfMap g) →* Heis n :=
  QuotientGroup.lift _ (heisF n i₀).toMonoidHom (cuspCentralKer_le_of_center g _
    (heisF n i₀).continuous fun _ hf => Heis.centralSub_le_center (heisF_mem n i₀ hf))

lemma continuous_heisE : Continuous (heisE n i₀) :=
  (QuotientGroup.isQuotientMap_mk _).continuous_iff.mpr (heisF n i₀).continuous

lemma heisE_mem (i : Inertia g) : heisE n i₀ i ∈ Heis.centralSub := by
  obtain ⟨f, hf, hfi⟩ : (i : CuspCentral (surfMap g)) ∈ (relSub g).map (QuotientGroup.mk' _) := by
    rw [← inertia_eq_map]
    exact i.2
  rw [← hfi]
  exact heisF_mem n i₀ hf

/-- **The character `I → ℤ/n` with `r̄ ↦ 1`** (through the Heisenberg group). -/
noncomputable def charN : ContinuousMonoidHom (Inertia g) (Zn n) where
  toFun i := Multiplicative.ofAdd (heisE n i₀ i).c
  map_one' := by
    change Multiplicative.ofAdd (heisE n i₀ 1).c = 1
    rw [map_one]
    rfl
  map_mul' i j := by
    change Multiplicative.ofAdd (heisE n i₀ ((i : CuspCentral (surfMap g)) * j)).c = _
    rw [map_mul, Heis.mul_c, (heisE_mem n i₀ i).1, zero_mul, add_zero, ofAdd_add]
    rfl
  continuous_toFun :=
    (continuous_of_discreteTopology (f := fun p : Heis n => (Multiplicative.ofAdd p.c : Zn n))).comp
      ((continuous_heisE n i₀).comp continuous_subtype_val)

lemma charN_relBar : charN n i₀ (relBar g) = Multiplicative.ofAdd (1 : ZMod n) := by
  change Multiplicative.ofAdd (heisF n i₀ (eta g (rel g))).c = _
  rw [heisF, liftF_eta, lift_heisGen_rel]
  rfl

variable {n} in
variable (A : Type) [CommGroup A] [TopologicalSpace A] [DiscreteTopology A] [IsTopologicalGroup A]
  in
/-- Evaluation at `r̄`. -/
noncomputable def evalRel : ContinuousMonoidHom (Inertia g) (TrivCoeff A) →* TrivCoeff A where
  toFun φ := φ (relBar g)
  map_one' := rfl
  map_mul' _ _ := rfl

variable (A : Type) [CommGroup A] [TopologicalSpace A] [DiscreteTopology A] [IsTopologicalGroup A]
  in
/-- A continuous homomorphism on `I` is determined by its value at `r̄`. -/
theorem evalRel_injective : Function.Injective (evalRel (g := g) A) := by
  rw [injective_iff_map_eq_one]
  intro φ hφ
  have hcl : IsClosed (φ.toMonoidHom.ker : Set (Inertia g)) := isClosed_ker _ φ.continuous
  have hsub : ((Subgroup.zpowers (relBar g) : Subgroup (Inertia g)) : Set (Inertia g)) ⊆
      φ.toMonoidHom.ker := Subgroup.zpowers_le.mpr hφ
  have h := closure_minimal hsub hcl
  rw [(dense_zpowers_relBar g).closure_eq] at h
  ext i
  exact h (Set.mem_univ i)

lemma evalRel_charN_pow (k : ℕ) :
    evalRel (Multiplicative (ZMod n)) (charN n i₀ ^ k) = Multiplicative.ofAdd (k : ZMod n) := by
  rw [map_pow]
  change (charN n i₀ (relBar g)) ^ k = _
  rw [charN_relBar]
  change (Multiplicative.ofAdd (1 : ZMod n) : Multiplicative (ZMod n)) ^ k =
    Multiplicative.ofAdd (k : ZMod n)
  rw [← ofAdd_nsmul, nsmul_eq_mul, mul_one]

include i₀ in
theorem evalRel_surjective :
    Function.Surjective (evalRel (g := g) (Multiplicative (ZMod n))) := fun a =>
  ⟨charN n i₀ ^ (Multiplicative.toAdd a).val, by
    rw [evalRel_charN_pow, ZMod.natCast_zmod_val]
    rfl⟩

/-- **`Hom_cont(I, ℤ/n) ≅ ℤ/n`**, `φ ↦ φ(r̄)` (`g ≥ 1`). -/
noncomputable def inertiaHomEquiv : ContinuousMonoidHom (Inertia g) (Zn n) ≃* Zn n :=
  MulEquiv.ofBijective (evalRel (Multiplicative (ZMod n)))
    ⟨evalRel_injective _, evalRel_surjective n i₀⟩

/-- **`H²(Δ^{c-cn}/I, ℤ/n) ≅ ℤ/n`**: the inverse of the transgression followed by evaluation at
`r̄`. -/
noncomputable def h2CuspEquiv :
    ContH2 (CuspCentral (surfMap g) ⧸ Inertia g) (fixedPts (Inertia g) (Zn n)) ≃* Zn n :=
  (cuspTgEquiv g (Multiplicative (ZMod n))).symm.trans (inertiaHomEquiv n i₀)

lemma h2CuspEquiv_cuspTg (φ : ContinuousMonoidHom (Inertia g) (Zn n)) :
    h2CuspEquiv n i₀ (cuspTg (surfMap g) (continuous_surfMap g) (Multiplicative (ZMod n)) φ) =
      φ (relBar g) := by
  rw [h2CuspEquiv, MulEquiv.trans_apply, ← cuspTgEquiv_apply, MulEquiv.symm_apply_apply]
  rfl

/-! ### Naturality in `n` and `H²(Π̂_{g,0}, ℤ/n)` -/

variable {n} in
/-- The reduction `ℤ/m → ℤ/n` for `n ∣ m`. -/
def redZn {m : ℕ} (h : n ∣ m) : ContinuousMonoidHom (Zn m) (Zn n) where
  toMonoidHom := AddMonoidHom.toMultiplicative (ZMod.castHom h (ZMod n)).toAddMonoidHom
  continuous_toFun := continuous_of_discreteTopology

variable {n} in
lemma redZn_ofAdd {m : ℕ} (h : n ∣ m) (x : ZMod m) :
    redZn h (Multiplicative.ofAdd x : Zn m) = Multiplicative.ofAdd (ZMod.castHom h (ZMod n) x) :=
  rfl

/-- **Naturality of `H²(Δ^{c-cn}/I, ℤ/n) ≅ ℤ/n` in `n`.** -/
lemma h2CuspEquiv_map {m : ℕ} [NeZero m] (h : n ∣ m)
    (z : ContH2 (CuspCentral (surfMap g) ⧸ Inertia g) (fixedPts (Inertia g) (Zn m))) :
    h2CuspEquiv n i₀ (ContH2.map (MonoidHom.id _) continuous_id
      (fixedPtsMap ((redZn h : Zn m →* Zn n)) (fun _ _ => rfl)) (fixedPtsMap_smul _ _) z) =
      redZn h (h2CuspEquiv m i₀ z) := by
  obtain ⟨φ, rfl⟩ := cuspTg_surjective g (Multiplicative (ZMod m)) z
  rw [← cuspTg_comp, h2CuspEquiv_cuspTg, h2CuspEquiv_cuspTg]
  rfl

variable (A : Type) [CommGroup A] [TopologicalSpace A] [DiscreteTopology A] [IsTopologicalGroup A]
  in
/-- `A^I = A` for the trivial action. -/
def fixedPtsEquiv : TrivCoeff A ≃* fixedPts (Inertia g) (TrivCoeff A) where
  toFun a := ⟨a, fun _ _ => rfl⟩
  invFun a := a
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

variable (g) in
/-- `Π̂_{g,0} ≃ₜ* Δ^{c-cn}/I`. -/
noncomputable def quotEquiv : SurfGrp g ≃ₜ* (CuspCentral (surfMap g) ⧸ Inertia g) :=
  (cuspQuotEquiv (surfMap g) (continuous_surfMap g) (surfMap_surjective g)).symm

variable (A : Type) [CommGroup A] [TopologicalSpace A] [DiscreteTopology A] [IsTopologicalGroup A]
  in
variable (g) in
/-- `H²(Π̂_{g,0}, A) ≅ H²(Δ^{c-cn}/I, A^I)`. -/
noncomputable def toCusp :
    ContH2 (SurfGrp g) (TrivCoeff A) ≃* ContH2 (CuspCentral (surfMap g) ⧸ Inertia g)
      (fixedPts (Inertia g) (TrivCoeff A)) :=
  h2Congr (quotEquiv g) (fixedPtsEquiv A) fun x a => by
    obtain ⟨e, he⟩ := QuotientGroup.mk_surjective (quotEquiv g x)
    rw [← he]
    exact Subtype.ext rfl

/-- **`H²(Π̂_{g,0}, ℤ/n) ≅ ℤ/n`** for `g ≥ 1` (`i₀ : Fin g`), via the transgression of the
cuspidally central extension and evaluation at the cusp loop `r̄`. -/
noncomputable def h2SurfEquiv : ContH2 (SurfGrp g) (Zn n) ≃* Zn n :=
  (toCusp g (Multiplicative (ZMod n))).trans (h2CuspEquiv n i₀)

variable (g) in
variable {n} in
/-- `H²(Π̂_{g,0}, ℤ/m) → H²(Π̂_{g,0}, ℤ/n)` for `n ∣ m`. -/
noncomputable def h2Red {m : ℕ} (h : n ∣ m) :
    ContH2 (SurfGrp g) (Zn m) →* ContH2 (SurfGrp g) (Zn n) :=
  ContH2.map (MonoidHom.id _) continuous_id (redZn h : Zn m →* Zn n) fun _ _ => rfl

variable {n} in
lemma toCusp_h2Red {m : ℕ} (h : n ∣ m) (z : ContH2 (SurfGrp g) (Zn m)) :
    toCusp g (Multiplicative (ZMod n)) (h2Red g h z) =
      ContH2.map (MonoidHom.id _) continuous_id
        (fixedPtsMap ((redZn h : Zn m →* Zn n)) (fun _ _ => rfl)) (fixedPtsMap_smul _ _)
        (toCusp g (Multiplicative (ZMod m)) z) := by
  induction z using ContH2.induction_on with
  | h c => rfl

lemma h2SurfEquiv_h2Red {m : ℕ} [NeZero m] (h : n ∣ m) (z : ContH2 (SurfGrp g) (Zn m)) :
    h2SurfEquiv n i₀ (h2Red g h z) = redZn h (h2SurfEquiv m i₀ z) := by
  rw [h2SurfEquiv, MulEquiv.trans_apply, toCusp_h2Red, h2CuspEquiv_map]
  rfl

/-! ### `H²(Π̂_{g,0}, Ẑ) = lim_n H²(Π̂_{g,0}, ℤ/n) ≅ Ẑ` -/

variable (g) in
/-- **`H²(Π̂_{g,0}, Ẑ) = lim_n H²(Π̂_{g,0}, ℤ/n)`** (the inverse-limit convention of
[AbsTopIII]). -/
noncomputable def H2ZHatSurf : Subgroup (∀ n : ℕ+, ContH2 (SurfGrp g) (Zn n)) :=
  limSub (A := fun n : ℕ+ => ContH2 (SurfGrp g) (Zn n)) fun h => h2Red g h

/-- `lim_n ℤ/n = Ẑ`. -/
def zhatLimEquiv :
    limSub (A := fun n : ℕ+ => Zn n) (fun h => (redZn h : Zn _ →* Zn _)) ≃*
      Multiplicative ZHat where
  toFun x := Multiplicative.ofAdd ⟨fun n => Multiplicative.toAdd (x.1 n : Multiplicative (ZMod n)),
    fun n m h => congrArg Multiplicative.toAdd (x.2 n m h)⟩
  invFun a := ⟨fun n =>
      (Multiplicative.ofAdd (((Multiplicative.toAdd a : ZHat) : ∀ n : ℕ+, ZMod n) n) : Zn n),
    fun n m h => congrArg Multiplicative.ofAdd ((Multiplicative.toAdd a).2 n m h)⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

/-- **`H²(Π̂_{g,0}, Ẑ) ≅ Ẑ`** for `g ≥ 1`. -/
noncomputable def h2ZHatSurfEquiv : H2ZHatSurf g ≃* Multiplicative ZHat :=
  (limSubEquiv (A := fun n : ℕ+ => ContH2 (SurfGrp g) (Zn n)) (B := fun n : ℕ+ => Zn n)
    (fun n => h2SurfEquiv n i₀)
    (fun n _ h x => (h2SurfEquiv_h2Red n i₀ h x).symm)).trans zhatLimEquiv

/-! ### Proposition 1.4(i) for the model: `I ≅ Ẑ` -/

instance : IsClosed (cuspCentralKer (surfMap g) : Set (Fhat g)) :=
  Subgroup.isClosed_topologicalClosure _

instance : CompactSpace (Inertia g) :=
  isCompact_iff_compactSpace.mp (isClosed_cuspInertia _ _).isCompact

lemma charN_zhatPow (a : Multiplicative ZHat) (n : ℕ+) :
    charN n i₀ (zhatPow (relBar g) a) =
      (Multiplicative.ofAdd (((Multiplicative.toAdd a : ZHat) : ∀ n : ℕ+, ZMod n) n) : Zn n) := by
  have h := denseRange_ofAdd_intToZHat.equalizer
    ((charN n i₀).continuous.comp (zhatPow (relBar g)).continuous)
    (continuous_of_discreteTopology.comp ((continuous_ZHat_apply n).comp continuous_toAdd))
    (funext fun k => by
      change charN n i₀ (zhatPow (relBar g) (Multiplicative.ofAdd (intToZHat k))) =
        (Multiplicative.ofAdd (((intToZHat k : ZHat) : ∀ n : ℕ+, ZMod n) n) : Zn n)
      rw [zhatPow_intToZHat, map_zpow, charN_relBar, intToZHat_apply]
      change (Multiplicative.ofAdd (1 : ZMod n) : Multiplicative (ZMod n)) ^ k =
        Multiplicative.ofAdd (k : ZMod n)
      rw [← ofAdd_zsmul, zsmul_eq_mul, mul_one])
  exact congrFun h a

include i₀ in
lemma zhatPow_relBar_injective : Function.Injective (zhatPow (relBar g)) := by
  rw [injective_iff_map_eq_one]
  intro a ha
  refine Multiplicative.toAdd.injective (ZHat.ext fun n => ?_)
  have h := charN_zhatPow i₀ a n
  rw [ha, map_one] at h
  exact (congrArg Multiplicative.toAdd h).symm

include i₀ in
/-- **Proposition 1.4(i) for the model**: `Ẑ ≃ₜ* I`, `1 ↦ r̄` (`g ≥ 1`). -/
noncomputable def inertiaEquiv : Multiplicative ZHat ≃ₜ* Inertia g :=
  let e := MulEquiv.ofBijective (zhatPow (relBar g)).toMonoidHom
    ⟨zhatPow_relBar_injective i₀, zhatPow_surjective _ (dense_zpowers_relBar g)⟩
  { e with
    continuous_toFun := (zhatPow (relBar g)).continuous
    continuous_invFun :=
      ((zhatPow (relBar g)).continuous.homeoOfEquivCompactToT2 (f := e.toEquiv)).symm.continuous }

lemma inertiaEquiv_one : inertiaEquiv i₀ (Multiplicative.ofAdd (intToZHat 1)) = relBar g :=
  zhatPow_one _

/-! ### Proposition 1.4(ii): the synchronization `M_X ≅ I` -/

variable (g) in
/-- **`M_X = Hom((H²(Δ_X, ℤ/n))_n, (ℤ/n)_n)`**, compatible families of homomorphisms
`H²(Π̂_{g,0}, ℤ/n) → ℤ/n` (the levelwise form of `Hom(H²(Δ_X, Ẑ), Ẑ)`). -/
def MX : Subgroup (∀ n : ℕ+, ContH2 (SurfGrp g) (Zn n) →* Zn n) where
  carrier := {f | ∀ (n m : ℕ+) (h : (n : ℕ) ∣ m) (z : ContH2 (SurfGrp g) (Zn m)),
    f n (h2Red g h z) = redZn h (f m z)}
  mul_mem' hf hf' n m h z := by simp [hf n m h z, hf' n m h z]
  one_mem' n m h z := by simp
  inv_mem' hf n m h z := by simp [hf n m h z]

variable (g) in
/-- The pairing `I × H²(Π̂_{g,0}, ℤ/n) → ℤ/n`, `(i, z) ↦ (d₂⁻¹ z)(i)`. -/
noncomputable def pair (n : ℕ+) (i : Inertia g) : ContH2 (SurfGrp g) (Zn n) →* Zn n where
  toFun z := (cuspTgEquiv g (Multiplicative (ZMod n))).symm (toCusp g _ z) i
  map_one' := by rw [map_one, map_one]; rfl
  map_mul' z w := by rw [map_mul, map_mul]; rfl

lemma pair_mul (n : ℕ+) (i j : Inertia g) : pair g n (i * j) = pair g n i * pair g n j := by
  ext z
  exact map_mul ((cuspTgEquiv g (Multiplicative (ZMod n))).symm (toCusp g _ z)) i j

lemma pair_h2Red (n m : ℕ+) (h : (n : ℕ) ∣ m) (i : Inertia g) (z : ContH2 (SurfGrp g) (Zn m)) :
    pair g n i (h2Red g h z) = redZn h (pair g m i z) := by
  obtain ⟨φ, hφ⟩ := cuspTg_surjective g (Multiplicative (ZMod m)) (toCusp g _ z)
  change (cuspTgEquiv g _).symm (toCusp g _ (h2Red g h z)) i =
    redZn h ((cuspTgEquiv g _).symm (toCusp g _ z) i)
  rw [toCusp_h2Red, ← hφ, ← cuspTg_comp, ← cuspTgEquiv_apply, ← cuspTgEquiv_apply,
    MulEquiv.symm_apply_apply, MulEquiv.symm_apply_apply]
  rfl

variable (g) in
/-- `I → M_X`, `i ↦ ((z ↦ (d₂⁻¹ z)(i)))_n`. -/
noncomputable def syncMap : Inertia g →* MX g where
  toFun i := ⟨fun n => pair g n i, fun n m h z => pair_h2Red n m h i z⟩
  map_one' := Subtype.ext (funext fun n => by
    ext z
    exact map_one ((cuspTgEquiv g (Multiplicative (ZMod n))).symm (toCusp g _ z)))
  map_mul' i j := Subtype.ext (funext fun n => pair_mul n i j)

/-- The generator `d₂(charN n) ∈ H²(Π̂_{g,0}, ℤ/n)`. -/
noncomputable def gen (n : ℕ+) : ContH2 (SurfGrp g) (Zn n) :=
  (toCusp g _).symm (cuspTg (surfMap g) (continuous_surfMap g) _ (charN n i₀))

lemma pair_gen (n : ℕ+) (i : Inertia g) : pair g n i (gen i₀ n) = charN n i₀ i := by
  change (cuspTgEquiv g _).symm (toCusp g _ ((toCusp g _).symm _)) i = _
  rw [MulEquiv.apply_symm_apply, ← cuspTgEquiv_apply, MulEquiv.symm_apply_apply]

lemma h2SurfEquiv_gen (n : ℕ+) :
    h2SurfEquiv n i₀ (gen i₀ n) = Multiplicative.ofAdd (1 : ZMod n) := by
  rw [h2SurfEquiv, MulEquiv.trans_apply, gen, MulEquiv.apply_symm_apply, h2CuspEquiv_cuspTg,
    charN_relBar]

lemma redZn_comp_charN (n m : ℕ+) (h : (n : ℕ) ∣ m) :
    (redZn h).comp (charN m i₀) = charN n i₀ :=
  evalRel_injective (Multiplicative (ZMod n)) (by
    change redZn h (charN m i₀ (relBar g)) = charN n i₀ (relBar g)
    rw [charN_relBar, charN_relBar, redZn_ofAdd, map_one])

lemma h2Red_gen (n m : ℕ+) (h : (n : ℕ) ∣ m) : h2Red g h (gen i₀ m) = gen i₀ n := by
  apply (toCusp g (Multiplicative (ZMod n))).injective
  rw [toCusp_h2Red, gen, gen, MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply,
    ← cuspTg_comp, redZn_comp_charN]

lemma eq_gen_pow (n : ℕ+) (z : ContH2 (SurfGrp g) (Zn n)) :
    z = gen i₀ n ^ (Multiplicative.toAdd (h2SurfEquiv n i₀ z : Multiplicative (ZMod n))).val := by
  apply (h2SurfEquiv n i₀).injective
  rw [map_pow, h2SurfEquiv_gen]
  change (h2SurfEquiv n i₀ z : Multiplicative (ZMod n)) =
    (Multiplicative.ofAdd (1 : ZMod n) : Multiplicative (ZMod n)) ^
      (Multiplicative.toAdd (h2SurfEquiv n i₀ z : Multiplicative (ZMod n))).val
  rw [← ofAdd_nsmul, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
  rfl

/-- **Proposition 1.4(ii), the synchronization of cyclotomes**: `I ≃* M_X` (`g ≥ 1`),
`i ↦ (z ↦ (d₂⁻¹ z)(i))`, i.e. the isomorphism `M_X ≅ I_x` determined by the transgression of
`1 ∈ Hom(I_x, I_x)`. -/
noncomputable def syncEquiv (i₀ : Fin g) : Inertia g ≃* MX g :=
  MulEquiv.ofBijective (syncMap g) ⟨by
    rw [injective_iff_map_eq_one]
    intro i hi
    obtain ⟨a, rfl⟩ := zhatPow_surjective _ (dense_zpowers_relBar g) i
    have ha : a = 1 := by
      refine Multiplicative.toAdd.injective (ZHat.ext fun n => ?_)
      have h := congrArg (fun f : MX g => f.1 n (gen i₀ n)) hi
      simp only [syncMap, MonoidHom.coe_mk, OneHom.coe_mk, pair_gen, charN_zhatPow] at h
      exact congrArg Multiplicative.toAdd h
    rw [ha, map_one], by
    intro f
    let a : ZHat := ⟨fun n => Multiplicative.toAdd (f.1 n (gen i₀ n) : Multiplicative (ZMod n)),
      fun n m h => by
        have := f.2 n m h (gen i₀ m)
        rw [h2Red_gen] at this
        exact (congrArg Multiplicative.toAdd this).symm⟩
    refine ⟨zhatPow (relBar g) (Multiplicative.ofAdd a), Subtype.ext (funext fun n => ?_)⟩
    ext z
    change pair g n _ z = f.1 n z
    rw [eq_gen_pow i₀ n z, map_pow, map_pow, pair_gen, charN_zhatPow]
    rfl⟩

lemma syncEquiv_apply (i : Inertia g) (n : ℕ+) (z : ContH2 (SurfGrp g) (Zn n)) :
    (syncEquiv i₀ i).1 n z = (cuspTgEquiv g (Multiplicative (ZMod n))).symm (toCusp g _ z) i :=
  rfl

/-! ### The finite-level classes `cuspClass N` -/

/-- `N_n = Ker(charN n) ⊆ I` (open, `I/N_n ≅ ℤ/n`). -/
noncomputable abbrev kerN (n : ℕ+) : Subgroup (Inertia g) := (charN n i₀).toMonoidHom.ker

lemma isOpen_kerN (n : ℕ+) : IsOpen (kerN i₀ n : Set (Inertia g)) := by
  have : (kerN i₀ n : Set (Inertia g)) = charN n i₀ ⁻¹' {1} := by ext; simp
  rw [this]
  exact (isOpen_discrete _).preimage (charN n i₀).continuous

/-- `I/N_n → ℤ/n` induced by `charN n`. -/
noncomputable def kerNHom (n : ℕ+) :
    ContinuousMonoidHom (TrivCoeff (cuspInertiaQuot (surfMap g) (continuous_surfMap g) (kerN i₀ n)))
      (Zn n) :=
  haveI := discreteTopology_cuspInertiaQuot (surfMap g) (continuous_surfMap g) _ (isOpen_kerN i₀ n)
  { toMonoidHom := QuotientGroup.lift (kerN i₀ n) (charN n i₀).toMonoidHom le_rfl
    continuous_toFun := continuous_of_discreteTopology }

/-- **The generator of `H²(Π̂_{g,0}, ℤ/n)` is the class `cuspClass N_n` of the cuspidally central
extension modulo `N_n`** (pushed along `I/N_n ≅ ℤ/n`): the isomorphism `M_X ≅ I_x` of
`syncEquiv` is the limit over `n` of the classes `cuspClass N_n`. -/
theorem map_cuspClass_kerN (n : ℕ+) :
    haveI := discreteTopology_cuspInertiaQuot (surfMap g) (continuous_surfMap g) _
      (isOpen_kerN i₀ n)
    ContH2.map (MonoidHom.id _) continuous_id
      (fixedPtsMap ((kerNHom i₀ n : TrivCoeff (cuspInertiaQuot (surfMap g) (continuous_surfMap g)
        (kerN i₀ n)) →* Zn n)) (fun _ _ => rfl)) (fixedPtsMap_smul _ _)
      (cuspClass (surfMap g) (continuous_surfMap g) (kerN i₀ n) (isOpen_kerN i₀ n)) =
      toCusp g _ (gen i₀ n) := by
  haveI := discreteTopology_cuspInertiaQuot (surfMap g) (continuous_surfMap g) _ (isOpen_kerN i₀ n)
  rw [gen, MulEquiv.apply_symm_apply, cuspClass, ← cuspTg_comp]
  congr 1

end Iut.Reconstruction.SurfaceH2
