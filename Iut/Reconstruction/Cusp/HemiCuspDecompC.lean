import Iut.Reconstruction.Cusp.HemiCuspDecomp
import CurvesJacobian.Cusp.CuspConj

/-!
# Decomposition groups of the points of `C ∖ U_X` in `Π_C` ([AbsTopII] Cor. 3.3 (iii) (c), MR8)

[AbsTopII] Corollary 3.3 (iii) (c) (`Topics in Absolute Anabelian Geometry II.txt` l.4510–4513):
"The decomposition groups of the closed points of `X` lying in the complement of `U_X` may be
obtained as the images via `Π_{U_X} ↠ Π` of the cuspidal decomposition groups of `Π_{U_X}`".
`HemiCuspDecomp.lean` proves this on the open subgroup `π⁻¹(Π_V)`; here we treat all of `Π_C`,
in the Galois form `Π = H ⧸ ⟨⟨S⟩⟩` of pi1's orbifold fundamental groups (`GaloisPi1.pi1`), where
both `Π_{U_X}` and `Π_C` are quotients of the same group `Gal(Ω / K(x))` (`Ω` an algebraic
closure of `K(E)`, `hemiHEquivN`) and `π = hemiFillN` is induced by the identity.

* `galProj H S`: `H ↠ H ⧸ ⟨⟨S⟩⟩`; `galDecomp H S W`: **the decomposition group of the place `W`
  of `Ω`** in `H ⧸ ⟨⟨S⟩⟩`, the image of the stabiliser `{σ ∈ H | σ(W) = W}` (cj's `decompGal`);
  `galInertia H S W`: the image of the inertia elements of `W` (pi1's `GaloisPi1.inertia`, the
  elements acting trivially on the residue field). For a place `W ⊇ K` centred on the coarse
  space of the orbicurve, `galDecomp` is a decomposition group of the closed point under `W`; for
  `W` over a cusp, `galInertia` is a cuspidal inertia group and `galDecomp` a cuspidal
  decomposition group;
* `galInertia_le_galDecomp`, **`galDecomp_le_commensurator`**: the decomposition group of a place
  normalises (hence commensurates) its inertia group;
* **`map_hemiFillN_galDecomp`**, `map_hemiFillN_galInertia`: `π : Π_{U_X} ↠ Π_C` maps the
  decomposition (inertia) group of `W` in `Π_{U_X}` onto that of `W` in `Π_C`;
* **`hemi_cor33iii_c_le`**: hence, for every place `W` (in particular over a point of
  `C ∖ U_X = [(E[N] ∖ {O}) / ±1]`), the decomposition group of `W` in `Π_C` is contained in the
  image under `π` of the commensurator in `Π_{U_X}` of the inertia group `I_W`, and it is the image
  of the decomposition group of `W` in `Π_{U_X}`.

Not covered here: the reverse inclusion `Comm_{Π_{U_X}}(I_W) ⊆ D_W` for `W` over a cusp of the
orbicurve `U_X` ([AbsTopI] Lemma 4.5 (vi) for `U_X`; curves-jacobian has it for hyperbolic curves,
`commensurator_arithInertia`, used over `π⁻¹(Π_V)` in `HemiCuspDecomp.lean`).
-/

open CategoryTheory AlgebraicGeometry CurvesJacobian CurvesJacobian.Cusp Belyi Belyi.Anabelian
  Pi1.Orbifold AffOrbicurve Topology

noncomputable section

namespace Iut.Reconstruction.HemiCusp

universe u

/-! ### Decomposition and inertia groups of places in Galois-form fundamental groups -/

section Galois

variable {P Ω : Type u} [Field P] [Field Ω] [Algebra P Ω] [IsGalois P Ω]
  (H : Subgroup (Ω ≃ₐ[P] Ω)) (S : Set (Ω ≃ₐ[P] Ω)) (hH : IsClosed (H : Set (Ω ≃ₐ[P] Ω)))

/-- The projection `H ↠ H ⧸ ⟨⟨S⟩⟩ = GaloisPi1.pi1 H S`. -/
def galProj : H →* GaloisPi1.pi1 H S hH :=
  QuotientGroup.mk' (GaloisPi1.kernel H S)

lemma galProj_surjective : Function.Surjective (galProj H S hH) :=
  QuotientGroup.mk'_surjective _

/-- **The decomposition group of a place `W` of `Ω` in `H ⧸ ⟨⟨S⟩⟩`**: the image of the stabiliser
`{σ ∈ H | σ(W) = W}`. -/
def galDecomp (W : ValuationSubring Ω) : Subgroup (GaloisPi1.pi1 H S hH) :=
  ((decompGal P W).subgroupOf H).map (galProj H S hH)

/-- **The inertia group of a place `W` of `Ω` in `H ⧸ ⟨⟨S⟩⟩`**: the image of the subgroup
generated by the inertia elements of `W` in `H`. -/
def galInertia (W : ValuationSubring Ω) : Subgroup (GaloisPi1.pi1 H S hH) :=
  (Subgroup.closure (Subtype.val ⁻¹' GaloisPi1.inertia W : Set H)).map (galProj H S hH)

variable {H S hH}

omit [IsGalois P Ω] in
/-- An inertia element of `W` stabilises `W`. -/
lemma mem_decompGal_of_mem_inertia {W : ValuationSubring Ω} {σ : Ω ≃ₐ[P] Ω}
    (hσ : σ ∈ GaloisPi1.inertia W) : σ ∈ decompGal P W :=
  mem_decompGal_iff_comap.2 (comap_eq_of_mem_inertia hσ)

/-- The inertia group of a place lies in its decomposition group. -/
lemma galInertia_le_galDecomp (W : ValuationSubring Ω) :
    galInertia H S hH W ≤ galDecomp H S hH W := by
  refine Subgroup.map_mono ?_
  rw [Subgroup.closure_le]
  intro σ hσ
  exact mem_decompGal_of_mem_inertia hσ

omit [IsGalois P Ω] in
/-- Conjugation by an element of the stabiliser of `W` preserves the inertia elements of `W`. -/
lemma conj_mem_inertia_of_mem_decompGal {W : ValuationSubring Ω} {ρ σ : Ω ≃ₐ[P] Ω}
    (hρ : ρ ∈ decompGal P W) (hσ : σ ∈ GaloisPi1.inertia W) :
    ρ * σ * ρ⁻¹ ∈ GaloisPi1.inertia W := by
  have h := GaloisPi1.conj_mem_inertia hσ ρ
  rwa [comap_symm_eq_of_mem_decompGal hρ] at h

/-- **The decomposition group of `W` normalises the inertia group of `W`.** -/
theorem galInertia_map_conj {W : ValuationSubring Ω} {ρ : H}
    (hρ : (ρ : Ω ≃ₐ[P] Ω) ∈ decompGal P W) :
    (galInertia H S hH W).map (MulAut.conj (galProj H S hH ρ)).toMonoidHom =
      galInertia H S hH W := by
  -- conjugation by `ρ` maps the generators of `I_W` in `H` onto themselves
  have hgen : (Subgroup.closure (Subtype.val ⁻¹' GaloisPi1.inertia W : Set H)).map
      (MulAut.conj ρ).toMonoidHom =
        Subgroup.closure (Subtype.val ⁻¹' GaloisPi1.inertia W : Set H) := by
    rw [MonoidHom.map_closure]
    congr 1
    ext σ
    simp only [Set.mem_image, Set.mem_preimage, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    constructor
    · rintro ⟨τ, hτ, rfl⟩
      exact conj_mem_inertia_of_mem_decompGal hρ hτ
    · intro hσ
      refine ⟨ρ⁻¹ * σ * ρ, ?_, by group⟩
      have h := conj_mem_inertia_of_mem_decompGal (inv_mem hρ) hσ
      simpa using h
  have hcomm : (MulAut.conj (galProj H S hH ρ)).toMonoidHom.comp (galProj H S hH) =
      (galProj H S hH).comp (MulAut.conj ρ).toMonoidHom := by
    ext σ
    simp [map_mul, map_inv]
  rw [galInertia, Subgroup.map_map, hcomm, ← Subgroup.map_map, hgen]

/-- **The decomposition group of a place commensurates its inertia group.** -/
theorem galDecomp_le_commensurator (W : ValuationSubring Ω) :
    galDecomp H S hH W ≤ Subgroup.Commensurable.commensurator (galInertia H S hH W) := by
  rintro _ ⟨ρ, hρ, rfl⟩
  rw [Subgroup.Commensurable.commensurator_mem_iff, conjAct_smul_eq_map,
    galInertia_map_conj (Subgroup.mem_subgroupOf.1 hρ)]

end Galois

/-! ### The filling `Π_{U_X} ↠ Π_C` on decomposition and inertia groups -/

section Hemi

set_option backward.isDefEq.respectTransparency false

variable {K : Type u} [Field K] [NumberField K] (E : WeierstrassCurve K) [E.IsElliptic]
  (N : ℕ) [NeZero N]

/-- The decomposition group of a place `W` of `Ω = K(E)^alg` in `Π_{U_X}`. -/
abbrev hemiDecompUX (W : ValuationSubring (FFClosure (curveE E))) : Subgroup (hemiPiUX E N) :=
  galDecomp (hemiDataN E N).H (hemiDataN E N).S (hemiDataN E N).isClosed_H W

/-- The inertia group of a place `W` of `Ω = K(E)^alg` in `Π_{U_X}`. -/
abbrev hemiInertiaUX (W : ValuationSubring (FFClosure (curveE E))) : Subgroup (hemiPiUX E N) :=
  galInertia (hemiDataN E N).H (hemiDataN E N).S (hemiDataN E N).isClosed_H W

/-- **The decomposition group of a place `W` of `Ω = K(E)^alg` in `Π_C`** (for `W` over a closed
point of `C`: a decomposition group of that point). -/
abbrev hemiDecompC (W : ValuationSubring (FFClosure (curveE E))) : Subgroup (hemiPiC E) :=
  galDecomp (hemiData E).H (hemiData E).S (hemiData E).isClosed_H W

/-- The inertia group of a place `W` of `Ω = K(E)^alg` in `Π_C`. -/
abbrev hemiInertiaC (W : ValuationSubring (FFClosure (curveE E))) : Subgroup (hemiPiC E) :=
  galInertia (hemiData E).H (hemiData E).S (hemiData E).isClosed_H W

/-- `π ∘ galProj = galProj ∘ (H_τ ≅ H_x)`. -/
lemma hemiFillHom_comp_galProj :
    (hemiFillHom E N).comp (galProj (hemiDataN E N).H (hemiDataN E N).S
      (hemiDataN E N).isClosed_H) =
      (galProj (hemiData E).H (hemiData E).S (hemiData E).isClosed_H).comp (hemiHHomN E N) :=
  MonoidHom.ext fun h => hemiFillN_mk E N h

/-- `H_τ ≅ H_x` preserves the stabiliser of `W`. -/
lemma map_hemiHHomN_decompGal (W : ValuationSubring (FFClosure (curveE E))) :
    ((decompGal _ W).subgroupOf (hemiDataN E N).H).map (hemiHHomN E N) =
      (decompGal _ W).subgroupOf (hemiData E).H := by
  ext y
  simp only [Subgroup.mem_map, Subgroup.mem_subgroupOf, mem_decompGal]
  constructor
  · rintro ⟨h, hh, rfl⟩ x
    rw [hemiHHomN_apply]
    exact hh x
  · intro hy
    refine ⟨(hemiHEquivN E N).symm y, fun x => ?_, (hemiHEquivN E N).apply_symm_apply y⟩
    rw [hemiHEquivN_symm_apply]
    exact hy x

/-- `H_τ ≅ H_x` preserves the inertia elements of `W`. -/
lemma map_hemiHHomN_inertia (W : ValuationSubring (FFClosure (curveE E))) :
    (Subgroup.closure (Subtype.val ⁻¹' GaloisPi1.inertia W : Set (hemiDataN E N).H)).map
        (hemiHHomN E N) =
      Subgroup.closure (Subtype.val ⁻¹' GaloisPi1.inertia W : Set (hemiData E).H) := by
  rw [MonoidHom.map_closure]
  congr 1
  ext y
  simp only [Set.mem_image, Set.mem_preimage, GaloisPi1.inertia, Set.mem_setOf_eq]
  constructor
  · rintro ⟨h, hh, rfl⟩ a ha
    rw [hemiHHomN_apply]
    exact hh a ha
  · intro hy
    refine ⟨(hemiHEquivN E N).symm y, fun a ha => ?_, (hemiHEquivN E N).apply_symm_apply y⟩
    rw [hemiHEquivN_symm_apply]
    exact hy a ha

/-- **`π : Π_{U_X} ↠ Π_C` maps the decomposition group of `W` in `Π_{U_X}` onto the decomposition
group of `W` in `Π_C`.** -/
theorem map_hemiFillN_galDecomp (W : ValuationSubring (FFClosure (curveE E))) :
    (hemiDecompUX E N W).map (hemiFillHom E N) = hemiDecompC E W :=
  -- (explicit `calc`: `rw` on these subgroup goals times out)
  calc (hemiDecompUX E N W).map (hemiFillHom E N)
      = ((decompGal _ W).subgroupOf (hemiDataN E N).H).map ((hemiFillHom E N).comp
          (galProj (hemiDataN E N).H (hemiDataN E N).S (hemiDataN E N).isClosed_H)) :=
        Subgroup.map_map _ _ _
    _ = ((decompGal _ W).subgroupOf (hemiDataN E N).H).map
          ((galProj (hemiData E).H (hemiData E).S (hemiData E).isClosed_H).comp
            (hemiHHomN E N)) :=
        congrArg (fun f => Subgroup.map f ((decompGal _ W).subgroupOf (hemiDataN E N).H))
          (hemiFillHom_comp_galProj E N)
    _ = (((decompGal _ W).subgroupOf (hemiDataN E N).H).map (hemiHHomN E N)).map
          (galProj (hemiData E).H (hemiData E).S (hemiData E).isClosed_H) :=
        (Subgroup.map_map _ _ _).symm
    _ = hemiDecompC E W :=
        congrArg (Subgroup.map (galProj (hemiData E).H (hemiData E).S (hemiData E).isClosed_H))
          (map_hemiHHomN_decompGal E N W)

/-- **`π : Π_{U_X} ↠ Π_C` maps the inertia group of `W` in `Π_{U_X}` onto the inertia group of
`W` in `Π_C`.** -/
theorem map_hemiFillN_galInertia (W : ValuationSubring (FFClosure (curveE E))) :
    (hemiInertiaUX E N W).map (hemiFillHom E N) = hemiInertiaC E W :=
  calc (hemiInertiaUX E N W).map (hemiFillHom E N)
      = (Subgroup.closure (Subtype.val ⁻¹' GaloisPi1.inertia W : Set (hemiDataN E N).H)).map
          ((hemiFillHom E N).comp
            (galProj (hemiDataN E N).H (hemiDataN E N).S (hemiDataN E N).isClosed_H)) :=
        Subgroup.map_map _ _ _
    _ = (Subgroup.closure (Subtype.val ⁻¹' GaloisPi1.inertia W : Set (hemiDataN E N).H)).map
          ((galProj (hemiData E).H (hemiData E).S (hemiData E).isClosed_H).comp
            (hemiHHomN E N)) :=
        congrArg (fun f => Subgroup.map f
          (Subgroup.closure (Subtype.val ⁻¹' GaloisPi1.inertia W : Set (hemiDataN E N).H)))
          (hemiFillHom_comp_galProj E N)
    _ = ((Subgroup.closure (Subtype.val ⁻¹' GaloisPi1.inertia W : Set (hemiDataN E N).H)).map
          (hemiHHomN E N)).map (galProj (hemiData E).H (hemiData E).S (hemiData E).isClosed_H) :=
        (Subgroup.map_map _ _ _).symm
    _ = hemiInertiaC E W :=
        congrArg (Subgroup.map (galProj (hemiData E).H (hemiData E).S (hemiData E).isClosed_H))
          (map_hemiHHomN_inertia E N W)

/-- **[AbsTopII] Cor. 3.3 (iii) (c) in `Π_C`, the inclusion `⊆`**: for every place `W` of
`Ω = K(E)^alg` (in particular over a closed point of `C ∖ U_X = [(E[N] ∖ {O}) / ±1]`), the
decomposition group of `W` in `Π_C` is the image under `π : Π_{U_X} ↠ Π_C` of the decomposition
group of `W` in `Π_{U_X}`, which commensurates the inertia group `I_W` of `W` in `Π_{U_X}`; so it
lies in the image of the commensurator `Comm_{Π_{U_X}}(I_W)`. -/
theorem hemi_cor33iii_c_le (W : ValuationSubring (FFClosure (curveE E))) :
    (hemiDecompUX E N W).map (hemiFillHom E N) = hemiDecompC E W ∧
      hemiDecompC E W ≤
        (Subgroup.Commensurable.commensurator (hemiInertiaUX E N W)).map (hemiFillHom E N) :=
  ⟨map_hemiFillN_galDecomp E N W, (map_hemiFillN_galDecomp E N W).symm.le.trans
    (Subgroup.map_mono (galDecomp_le_commensurator W))⟩

end Hemi

end Iut.Reconstruction.HemiCusp
