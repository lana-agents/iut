import Iut.Anabelian.Tempered
import Iut.Cor312.ThetaData.TwoTorsion

/-!
# Base change of the genuine étale fundamental groups (MR22 T3)

The genuine fundamental groups of iut are `GaloisPi1.pi1 H S = H ⧸ ⟨⟨S⟩⟩` (closed normal subgroup
generated by the inertia generators `S`) for closed subgroups `H` of `Aut(Ω / P)`. The base change
`K ⊂ K_v` of IUT I, Definition 3.1 (e) (`X̲_v = X̲_K ×_K K_v`) relates groups over *different*
fields `Ω`, `Ω'`: restriction of automorphisms along an embedding `Ω → Ω'` is a continuous
homomorphism `Aut(Ω' / P') → Aut(Ω / P)`.

* `GaloisPi1Map.pi1MapOfHom`: a continuous homomorphism `r : Aut(Ω' / P') → Aut(Ω / P)` with
  `r(H') ⊆ H` and `r(S') ⊆ ⟨⟨S⟩⟩` induces a continuous homomorphism
  `π₁(H', S') → π₁(H, S)` (`continuous_pi1MapOfHom`, `pi1MapOfHom_mk`).
* For a field embedding `f : k → L`, an elliptic curve `E / k` and `E' = E ×_k L`:
  the embedding of function fields `fnFieldMap : k(E) → L(E')` (`x ↦ x`, `y ↦ y`), an extension
  `ιΩ : Ω(E) → Ω(E')` to the algebraic closures, and in characteristic `0` the continuous
  restriction homomorphism `resGal : Gal(Ω(E') / L(x)) → Gal(Ω(E) / k(x))`,
  `σ ↦ ιΩ⁻¹ ∘ σ ∘ ιΩ`.
-/

noncomputable section

universe u

namespace Iut

namespace Multiradial

namespace Theater

namespace GaloisPi1Map

open GaloisPi1

variable {P Ω P' Ω' : Type u} [Field P] [Field Ω] [Algebra P Ω] [Field P'] [Field Ω']
  [Algebra P' Ω']
  {H : Subgroup (Ω ≃ₐ[P] Ω)} {S : Set (Ω ≃ₐ[P] Ω)} {H' : Subgroup (Ω' ≃ₐ[P'] Ω')}
  {S' : Set (Ω' ≃ₐ[P'] Ω')}

/-- `r` restricted to `H' → H`. -/
def resHom (r : (Ω' ≃ₐ[P'] Ω') →* (Ω ≃ₐ[P] Ω)) (hH : ∀ x ∈ H', r x ∈ H) : H' →* H :=
  (r.comp H'.subtype).codRestrict H fun x => hH x.1 x.2

lemma kernel_le_comap (r : (Ω' ≃ₐ[P'] Ω') →* (Ω ≃ₐ[P] Ω)) (hr : Continuous r)
    (hH : ∀ x ∈ H', r x ∈ H) (hS : ∀ s ∈ S', r s ∈ ambientKernel H S) :
    kernel H' S' ≤ (kernel H S).comap (resHom r hH) := by
  intro x hx
  rw [kernel, Subgroup.mem_subgroupOf] at hx
  rw [Subgroup.mem_comap, kernel, Subgroup.mem_subgroupOf]
  change r x.1 ∈ ambientKernel H S
  have hcl : IsClosed (((ambientKernel H S).comap r : Subgroup _) : Set (Ω' ≃ₐ[P'] Ω')) :=
    (isClosed_ambientKernel H S).preimage hr
  refine Subgroup.topologicalClosure_minimal _ ?_ hcl hx
  rw [Subgroup.closure_le]
  rintro _ ⟨h, hh, s, hs, rfl⟩
  change r (h * s * h⁻¹) ∈ ambientKernel H S
  rw [map_mul, map_mul, map_inv]
  exact conj_mem_ambientKernel H S (hH h hh) (hS s hs)

open Topology in
/-- A homomorphism `r : Aut(Ω' / P') → Aut(Ω / P)` intertwined with a field embedding
`ι : Ω → Ω'` (`ι ∘ r σ = σ ∘ ι`) is continuous for the Krull topologies, when `Ω' / P'` is
algebraic. -/
lemma continuous_of_comm [Algebra.IsAlgebraic P' Ω'] (ι : Ω →+* Ω')
    (r : (Ω' ≃ₐ[P'] Ω') →* (Ω ≃ₐ[P] Ω)) (hr : ∀ σ a, ι (r σ a) = σ (ι a)) : Continuous r := by
  refine continuous_of_continuousAt_one _ ?_
  intro s hs
  rw [map_one, krullTopology_mem_nhds_one_iff] at hs
  obtain ⟨S, hSfin, hSs⟩ := hs
  rw [Filter.mem_map, krullTopology_mem_nhds_one_iff]
  haveI : Module.Free P S := Module.Free.of_divisionRing _ _
  let b := Module.finBasis P S
  refine ⟨IntermediateField.adjoin P' (Set.range fun i => ι (b i)),
    IntermediateField.finiteDimensional_adjoin fun x _ =>
      (Algebra.IsAlgebraic.isAlgebraic (R := P') x).isIntegral, fun σ hσ => hSs ?_⟩
  have hfixb : ∀ i, r σ (b i) = b i := fun i => ι.injective (by
    rw [hr]
    exact (IntermediateField.mem_fixingSubgroup_iff _ σ).mp hσ _
      (IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩))
  rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff]
  intro x hx
  have hlin : ((r σ).toLinearMap ∘ₗ S.val.toLinearMap : S →ₗ[P] Ω) = S.val.toLinearMap :=
    b.ext fun i => hfixb i
  exact LinearMap.congr_fun hlin ⟨x, hx⟩

variable [IsGalois P Ω] [IsGalois P' Ω']

/-- **`π₁(H', S') → π₁(H, S)` along `r`**. -/
def pi1MapOfHom (hH₁ : IsClosed (H : Set (Ω ≃ₐ[P] Ω))) (hH₁' : IsClosed (H' : Set (Ω' ≃ₐ[P'] Ω')))
    (r : (Ω' ≃ₐ[P'] Ω') →* (Ω ≃ₐ[P] Ω)) (hr : Continuous r) (hH : ∀ x ∈ H', r x ∈ H)
    (hS : ∀ s ∈ S', r s ∈ ambientKernel H S) : pi1 H' S' hH₁' →* pi1 H S hH₁ :=
  QuotientGroup.map _ _ (resHom r hH) (kernel_le_comap r hr hH hS)

lemma pi1MapOfHom_mk (hH₁ : IsClosed (H : Set (Ω ≃ₐ[P] Ω)))
    (hH₁' : IsClosed (H' : Set (Ω' ≃ₐ[P'] Ω'))) (r : (Ω' ≃ₐ[P'] Ω') →* (Ω ≃ₐ[P] Ω))
    (hr : Continuous r) (hH : ∀ x ∈ H', r x ∈ H) (hS : ∀ s ∈ S', r s ∈ ambientKernel H S)
    (x : H') : pi1MapOfHom hH₁ hH₁' r hr hH hS (QuotientGroup.mk x) =
      QuotientGroup.mk (resHom r hH x) := rfl

lemma continuous_pi1MapOfHom (hH₁ : IsClosed (H : Set (Ω ≃ₐ[P] Ω)))
    (hH₁' : IsClosed (H' : Set (Ω' ≃ₐ[P'] Ω'))) (r : (Ω' ≃ₐ[P'] Ω') →* (Ω ≃ₐ[P] Ω))
    (hr : Continuous r) (hH : ∀ x ∈ H', r x ∈ H) (hS : ∀ s ∈ S', r s ∈ ambientKernel H S) :
    Continuous (pi1MapOfHom hH₁ hH₁' r hr hH hS) := by
  change Continuous (QuotientGroup.map _ _ (resHom r hH) (kernel_le_comap r hr hH hS))
  rw [(QuotientGroup.isQuotientMap_mk _).continuous_iff]
  exact QuotientGroup.continuous_mk.comp
    ((hr.comp continuous_subtype_val).subtype_mk _)

end GaloisPi1Map

namespace GenuineBaseChange

open WeierstrassCurve Polynomial Anabelian Anabelian.Genuine

variable {k L : Type u} [Field k] [Field L] (f : k →+* L) (E : WeierstrassCurve k)

/-! ### (a) The embedding of function fields `k(E) → L(E_L)` -/

/-- The map of coordinate rings `k[E] → L[E_L]`, followed by `L[E_L] → L(E_L)`. -/
def coordToFn : E.toAffine.CoordinateRing →+* (E.map f).toAffine.FunctionField :=
  (algebraMap (E.map f).toAffine.CoordinateRing (E.map f).toAffine.FunctionField).comp
    (Affine.CoordinateRing.map E.toAffine f)

lemma coordToFn_injective : Function.Injective (coordToFn f E) := by
  have h1 : Function.Injective (Affine.CoordinateRing.map E.toAffine f) :=
    Affine.CoordinateRing.map_injective f.injective
  have h2 : Function.Injective (algebraMap (E.map f).toAffine.CoordinateRing
      (E.map f).toAffine.FunctionField) :=
    IsFractionRing.injective _ _
  rw [coordToFn, RingHom.coe_comp]
  exact h2.comp h1

/-- **The embedding of function fields** `k(E) → L(E_L)` induced by `f` (`x ↦ x`, `y ↦ y`). -/
def fnFieldMap : E.toAffine.FunctionField →+* (E.map f).toAffine.FunctionField :=
  IsFractionRing.lift (coordToFn_injective f E)

lemma fnFieldMap_algebraMap (a : E.toAffine.CoordinateRing) :
    fnFieldMap f E (algebraMap _ E.toAffine.FunctionField a) = coordToFn f E a :=
  IsFractionRing.lift_algebraMap _ a

open scoped Classical in
lemma fnFieldMap_xF : fnFieldMap f E (xF E) = xF (E.map f) := by
  rw [xF, fnFieldMap_algebraMap, coordToFn, RingHom.comp_apply,
    Affine.CoordinateRing.map_mk]
  simp [xF]

open scoped Classical in
lemma fnFieldMap_yF : fnFieldMap f E (yF E) = yF (E.map f) := by
  rw [yF, fnFieldMap_algebraMap, coordToFn, RingHom.comp_apply,
    Affine.CoordinateRing.map_mk]
  simp [yF]

lemma fnFieldMap_algebraMap_base (c : k) :
    fnFieldMap f E (algebraMap k E.toAffine.FunctionField c) =
      algebraMap L (E.map f).toAffine.FunctionField (f c) := by
  rw [IsScalarTower.algebraMap_apply k E.toAffine.CoordinateRing E.toAffine.FunctionField,
    fnFieldMap_algebraMap, coordToFn, RingHom.comp_apply,
    IsScalarTower.algebraMap_apply L (E.map f).toAffine.CoordinateRing
      (E.map f).toAffine.FunctionField]
  congr 1
  change Affine.CoordinateRing.map E.toAffine f (Affine.CoordinateRing.mk _ (C (C c))) =
    Affine.CoordinateRing.mk _ (C (C (f c)))
  rw [Affine.CoordinateRing.map_mk]
  simp

/-! ### (b) The embedding of algebraic closures `Ω(E) → Ω(E_L)` -/

section Extend

variable {K₁ Ω₁ K₂ Ω₂ : Type*} [Field K₁] [Field Ω₁] [Field K₂] [Field Ω₂] [Algebra K₁ Ω₁]
  [Algebra.IsAlgebraic K₁ Ω₁] [Algebra K₂ Ω₂] [IsAlgClosed Ω₂]

/-- An extension `Ω₁ → Ω₂` of a field embedding `φ : K₁ → K₂` along algebraic `Ω₁ / K₁`, with
`Ω₂ ⊇ K₂` algebraically closed. -/
def extendAlg (φ : K₁ →+* K₂) : Ω₁ →+* Ω₂ :=
  letI : Algebra K₁ Ω₂ := ((algebraMap K₂ Ω₂).comp φ).toAlgebra
  (IsAlgClosed.lift (R := K₁) (S := Ω₁) (M := Ω₂)).toRingHom

lemma extendAlg_algebraMap (φ : K₁ →+* K₂) (a : K₁) :
    extendAlg (Ω₁ := Ω₁) (Ω₂ := Ω₂) φ (algebraMap K₁ Ω₁ a) = algebraMap K₂ Ω₂ (φ a) :=
  letI : Algebra K₁ Ω₂ := ((algebraMap K₂ Ω₂).comp φ).toAlgebra
  (IsAlgClosed.lift (R := K₁) (S := Ω₁) (M := Ω₂)).commutes a

end Extend

open scoped Classical in
/-- **An embedding `ιΩ : Ω(E) → Ω(E_L)` of algebraic closures** extending `k(E) → L(E_L)`. -/
def ιΩ : Ω E →+* Ω (E.map f) :=
  extendAlg (K₁ := E.toAffine.FunctionField) (K₂ := (E.map f).toAffine.FunctionField)
    (fnFieldMap f E)

open scoped Classical in
lemma ιΩ_algebraMap (a : E.toAffine.FunctionField) :
    ιΩ f E (algebraMap E.toAffine.FunctionField (Ω E) a) =
      algebraMap (E.map f).toAffine.FunctionField (Ω (E.map f)) (fnFieldMap f E a) :=
  extendAlg_algebraMap (fnFieldMap f E) a

lemma ιΩ_injective : Function.Injective (ιΩ f E) := (ιΩ f E).injective

open scoped Classical in
lemma ιΩ_xG : ιΩ f E (xG E) = xG (E.map f) := by
  rw [xG, ιΩ_algebraMap, fnFieldMap_xF, xG]

open scoped Classical in
lemma ιΩ_yG : ιΩ f E (yG E) = yG (E.map f) := by
  rw [yG, ιΩ_algebraMap, fnFieldMap_yF, yG]

open scoped Classical in
lemma ιΩ_algebraMap_base (c : k) :
    ιΩ f E (algebraMap k (Ω E) c) = algebraMap L (Ω (E.map f)) (f c) := by
  rw [IsScalarTower.algebraMap_apply k E.toAffine.FunctionField (Ω E), ιΩ_algebraMap,
    fnFieldMap_algebraMap_base, ← IsScalarTower.algebraMap_apply]

/-! ### (c) Restriction of automorphisms `Gal(Ω(E_L) / L(x)) → Gal(Ω(E) / k(x))` -/

open scoped Classical in
/-- Automorphisms over `L(x)` fix the image of `k(x)`. -/
lemma fix_ιΩ_xLine (σ : Gal (E.map f)) {a : Ω E} (ha : a ∈ xLine E) :
    σ (ιΩ f E a) = ιΩ f E a := by
  let Fx : IntermediateField k (Ω E) :=
    (RingHom.eqLocusField ((σ : Ω (E.map f) →+* Ω (E.map f)).comp (ιΩ f E))
      (ιΩ f E)).toIntermediateField (fun c => by
        change σ (ιΩ f E (algebraMap k (Ω E) c)) = ιΩ f E (algebraMap k (Ω E) c)
        rw [ιΩ_algebraMap_base]
        exact σ.commutes' ⟨_, (baseField (E.map f)).algebraMap_mem (f c)⟩)
  have hle : xLine E ≤ Fx := by
    rw [xLine, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
    change σ (ιΩ f E (xG E)) = ιΩ f E (xG E)
    rw [ιΩ_xG]
    exact σ.commutes' ⟨_, xG_mem_baseField (E.map f)⟩
  exact hle ha

open scoped Classical in
/-- The image of `Ω(E)` in `Ω(E_L)` is stable under `Gal(Ω(E_L) / L(x))`. -/
lemma exists_ιΩ_eq (σ : Gal (E.map f)) (a : Ω E) : ∃ b : Ω E, ιΩ f E b = σ (ιΩ f E a) := by
  let F := xLine E
  let p : F[X] := minpoly F a
  have hp0 : p ≠ 0 := minpoly.ne_zero (Algebra.IsIntegral.isIntegral (R := F) a)
  set p' : (Ω E)[X] := p.map (algebraMap F (Ω E)) with hp'def
  have hp'0 : p' ≠ 0 := Polynomial.map_ne_zero hp0
  have hroots : p'.roots.map (ιΩ f E) = (p'.map (ιΩ f E)).roots :=
    roots_map_of_injective_of_card_eq_natDegree (ιΩ_injective f E)
      IsAlgClosed.card_roots_eq_natDegree
  have hq0 : p'.map (ιΩ f E) ≠ 0 := Polynomial.map_ne_zero hp'0
  have hev : (p'.map (ιΩ f E)).eval (σ (ιΩ f E a)) = 0 := by
    have h1 : (p'.map (ιΩ f E)).eval (ιΩ f E a) = 0 := by
      rw [eval_map, eval₂_at_apply, hp'def, eval_map, ← aeval_def, minpoly.aeval, map_zero]
    have hfix : (p'.map (ιΩ f E)).map (σ : Ω (E.map f) →+* Ω (E.map f)) =
        p'.map (ιΩ f E) := by
      have hc : ((σ : Ω (E.map f) →+* Ω (E.map f)).comp (ιΩ f E)).comp (algebraMap F (Ω E)) =
          (ιΩ f E).comp (algebraMap F (Ω E)) :=
        RingHom.ext fun (c : xLine E) => fix_ιΩ_xLine f E σ c.2
      rw [hp'def, Polynomial.map_map, Polynomial.map_map, Polynomial.map_map, hc]
    rw [← hfix, eval_map]
    have h2 := eval₂_at_apply (p := p'.map (ιΩ f E)) (σ : Ω (E.map f) →+* Ω (E.map f))
      (ιΩ f E a)
    rw [h1, map_zero] at h2
    exact h2
  have hmem : σ (ιΩ f E a) ∈ (p'.map (ιΩ f E)).roots := (mem_roots hq0).mpr hev
  rw [← hroots, Multiset.mem_map] at hmem
  obtain ⟨b, -, hb⟩ := hmem
  exact ⟨b, hb⟩

open scoped Classical in
/-- The function underlying `resGal σ = ιΩ⁻¹ ∘ σ ∘ ιΩ`. -/
def resFun (σ : Gal (E.map f)) (a : Ω E) : Ω E := (exists_ιΩ_eq f E σ a).choose

open scoped Classical in
lemma ιΩ_resFun (σ : Gal (E.map f)) (a : Ω E) : ιΩ f E (resFun f E σ a) = σ (ιΩ f E a) :=
  (exists_ιΩ_eq f E σ a).choose_spec

open scoped Classical in
lemma resFun_eq_iff (σ : Gal (E.map f)) (a b : Ω E) :
    resFun f E σ a = b ↔ σ (ιΩ f E a) = ιΩ f E b := by
  rw [← ιΩ_resFun]
  exact (ιΩ_injective f E).eq_iff.symm

open scoped Classical in
lemma resFun_mul (σ τ : Gal (E.map f)) (a : Ω E) :
    resFun f E (σ * τ) a = resFun f E σ (resFun f E τ a) := by
  rw [resFun_eq_iff, ιΩ_resFun, ιΩ_resFun, AlgEquiv.mul_apply]

open scoped Classical in
lemma resFun_one (a : Ω E) : resFun f E 1 a = a := by
  rw [resFun_eq_iff, AlgEquiv.one_apply]

open scoped Classical in
lemma mem_xLine_of_mem_baseField [CharZero k] {a : Ω E} (ha : a ∈ baseField E) :
    a ∈ xLine E := by
  change a ∈ perfectClosure (xLine E) (Ω E) at ha
  rw [mem_perfectClosure_iff_pow_mem 1] at ha
  obtain ⟨n, b, hb⟩ := ha
  rw [one_pow, pow_one] at hb
  rw [← hb]
  exact b.2

open scoped Classical in
/-- **Restriction** `σ ↦ ιΩ⁻¹ ∘ σ ∘ ιΩ`, an automorphism of `Ω(E)` over `k(x)`. -/
def resGalEquiv [CharZero k] (σ : Gal (E.map f)) : Gal E where
  toFun := resFun f E σ
  invFun := resFun f E σ⁻¹
  left_inv a := by rw [← resFun_mul, inv_mul_cancel, resFun_one]
  right_inv a := by rw [← resFun_mul, mul_inv_cancel, resFun_one]
  map_mul' a b := by
    rw [resFun_eq_iff, map_mul, map_mul, map_mul, ιΩ_resFun, ιΩ_resFun]
  map_add' a b := by
    rw [resFun_eq_iff, map_add, map_add, map_add, ιΩ_resFun, ιΩ_resFun]
  commutes' c := by
    rw [resFun_eq_iff]
    exact fix_ιΩ_xLine f E σ (mem_xLine_of_mem_baseField E c.2)

open scoped Classical in
lemma ιΩ_resGalEquiv [CharZero k] (σ : Gal (E.map f)) (a : Ω E) :
    ιΩ f E (resGalEquiv f E σ a) = σ (ιΩ f E a) := ιΩ_resFun f E σ a

open scoped Classical in
/-- **The restriction homomorphism** `Gal(Ω(E_L) / L(x)) → Gal(Ω(E) / k(x))`,
`σ ↦ ιΩ⁻¹ ∘ σ ∘ ιΩ`. -/
def resGal [CharZero k] : Gal (E.map f) →* Gal E where
  toFun := resGalEquiv f E
  map_one' := AlgEquiv.ext fun a => resFun_one f E a
  map_mul' σ τ := AlgEquiv.ext fun a => resFun_mul f E σ τ a

open scoped Classical in
lemma ιΩ_resGal [CharZero k] (σ : Gal (E.map f)) (a : Ω E) :
    ιΩ f E (resGal f E σ a) = σ (ιΩ f E a) := ιΩ_resFun f E σ a

open scoped Classical in
open Topology in
/-- The restriction homomorphism is continuous for the Krull topologies. -/
lemma continuous_resGal [CharZero k] : Continuous (resGal f E) :=
  GaloisPi1Map.continuous_of_comm (ιΩ f E) (resGal f E) (ιΩ_resGal f E)

/-! ### Points along `ιΩ` -/

section PtMap

variable {R F K : Type*} [Field R] [Field F] [Field K] (W : WeierstrassCurve R) (a : R →+* F)
  (b : R →+* K) (ι : F →+* K) (h : ∀ c, ι (a c) = b c)

open scoped Classical in
/-- The map of points `(W ×_a F)(F) → (W ×_b K)(K)` induced by `ι : F → K` with `ι ∘ a = b`. -/
def ptMapOver : (W.map a).toAffine.Point →+ (W.map b).toAffine.Point :=
  letI := a.toAlgebra
  letI := b.toAlgebra
  Affine.Point.map (W' := W) (S := R) (F := F) (K := K) { ι with commutes' := h }

open scoped Classical in
lemma ptMapOver_injective : Function.Injective (ptMapOver W a b ι h) :=
  letI := a.toAlgebra
  letI := b.toAlgebra
  Affine.Point.map_injective (W' := W) (S := R) (F := F) (K := K) { ι with commutes' := h }

end PtMap


open scoped Classical in
/-- **The map of points `E(Ω(E)) → E_L(Ω(E_L))` along `ιΩ`.** -/
def ιPt : Pt E →+ Pt (E.map f) :=
  ptMapOver E (algebraMap k (Ω E)) ((algebraMap L (Ω (E.map f))).comp f) (ιΩ f E)
    (ιΩ_algebraMap_base f E)

open scoped Classical in
lemma ιPt_injective : Function.Injective (ιPt f E) :=
  ptMapOver_injective E (algebraMap k (Ω E)) ((algebraMap L (Ω (E.map f))).comp f) (ιΩ f E)
    (ιΩ_algebraMap_base f E)

open scoped Classical in
lemma ιPt_act [CharZero k] (σ : Gal (E.map f)) (P : Pt E) :
    ιPt f E (act E (resGal f E σ) P) = act (E.map f) σ (ιPt f E P) := by
  rcases P with _ | ⟨x, y, h⟩
  · rfl
  · change Affine.Point.some _ _ _ = Affine.Point.some _ _ _
    congr 1
    · exact ιΩ_resGal f E σ x
    · exact ιΩ_resGal f E σ y

variable [E.IsElliptic]

open scoped Classical in
lemma ιPt_genericPoint : ιPt f E (genericPoint E) = genericPoint (E.map f) := by
  change Affine.Point.some _ _ _ = Affine.Point.some _ _ _
  congr 1
  · exact ιΩ_xG f E
  · exact ιΩ_yG f E

open scoped Classical in
omit [E.IsElliptic] in
lemma ιPt_base (T : E.toAffine.Point) :
    ιPt f E (base E T) = base (E.map f) (pointMap E f T) := by
  rcases T with _ | ⟨x, y, h⟩
  · rfl
  · change Affine.Point.some _ _ _ = Affine.Point.some _ _ _
    congr 1
    · exact ιΩ_algebraMap_base f E x
    · exact ιΩ_algebraMap_base f E y

/-! ### (d) The groups `Aut(Ω / F_X)` -/

open scoped Classical in
/-- If all `n`-torsion of `E` is `k`-rational (`|E(k)[n]| = n²`), every `n`-torsion point of
`E_L` over `Ω(E_L)` comes from `E(k)[n]`. -/
lemma exists_base_of_torsion [CharZero L] {n : ℕ} (hn : n ≠ 0)
    (hcard : Nat.card (AddSubgroup.torsionBy E.toAffine.Point (n : ℤ)) = n ^ 2)
    {D : Pt (E.map f)} (hD : n • D = 0) :
    ∃ t : E.toAffine.Point, base (E.map f) (pointMap E f t) = D := by
  let φ : E.toAffine.Point →+ Pt (E.map f) := (base (E.map f)).comp (pointMap E f)
  have hφ : Function.Injective φ :=
    (pointMap_injective _ _).comp (pointMap_injective E f)
  have htgt : Nat.card (AddSubgroup.torsionBy (Pt (E.map f)) (n : ℤ)) = n ^ 2 :=
    card_torsionBy_eq_sq' ((E.map f)⁄(Ω (E.map f))) n hn
  haveI : Finite (AddSubgroup.torsionBy (Pt (E.map f)) (n : ℤ)) :=
    Nat.finite_of_card_ne_zero (by rw [htgt]; positivity)
  let g : AddSubgroup.torsionBy E.toAffine.Point (n : ℤ) →
      AddSubgroup.torsionBy (Pt (E.map f)) (n : ℤ) := fun t => ⟨φ t.1, by
    have := t.2
    rw [AddSubgroup.torsionBy.nsmul_iff] at this ⊢
    rw [← map_nsmul, this, map_zero]⟩
  have hg : Function.Injective g := fun s t hst =>
    Subtype.ext (hφ (congrArg Subtype.val hst))
  have hDt : D ∈ AddSubgroup.torsionBy (Pt (E.map f)) (n : ℤ) :=
    AddSubgroup.torsionBy.nsmul_iff.mpr hD
  obtain ⟨t, ht⟩ := (hg.bijective_of_nat_card_le (htgt.trans hcard.symm).le).2 ⟨D, hDt⟩
  exact ⟨t.1, congrArg Subtype.val ht⟩

open scoped Classical in
lemma nsmul_Qpt [CharZero k] {ℓ : ℕ} (hℓ : ℓ ≠ 0) : ℓ • Qpt E ℓ = genericPoint E := by
  have hc := compatible_divSys_of_charZero E
  have h := hc.2 ℓ 1 (Nat.pos_of_ne_zero hℓ) one_pos
  rw [mul_one, hc.1] at h
  rw [Qpt, effLevel, if_neg hℓ]
  exact h

open scoped Classical in
/-- **Key step**: if `σ(Q'_ℓ) − Q'_ℓ ∈ M_L` then `(res σ)(Q_ℓ) − Q_ℓ ∈ M` (all `ℓ`-torsion of
`E` being `k`-rational: `ιΩ(Q_ℓ) − Q'_ℓ` is `ℓ`-torsion, hence `k`-rational and fixed by `σ`). -/
lemma resGal_sub_mem_Mbar [CharZero k] [CharZero L] {ℓ : ℕ} (hℓ : ℓ ≠ 0)
    (hcard : Nat.card (AddSubgroup.torsionBy E.toAffine.Point (ℓ : ℤ)) = ℓ ^ 2)
    {M : AddSubgroup E.toAffine.Point} {σ : Gal (E.map f)}
    (hσ : act (E.map f) σ (Qpt (E.map f) ℓ) - Qpt (E.map f) ℓ ∈
      Mbar (E.map f) ℓ (M.map (pointMap E f))) :
    act E (resGal f E σ) (Qpt E ℓ) - Qpt E ℓ ∈ Mbar E ℓ M := by
  have he : effLevel ℓ = ℓ := if_neg hℓ
  set D : Pt (E.map f) := ιPt f E (Qpt E ℓ) - Qpt (E.map f) ℓ with hDdef
  have hD : ℓ • D = 0 := by
    rw [hDdef, nsmul_sub, ← map_nsmul, nsmul_Qpt E hℓ, nsmul_Qpt (E.map f) hℓ,
      ιPt_genericPoint, sub_self]
  obtain ⟨t₀, ht₀⟩ := exists_base_of_torsion f E hℓ hcard hD
  have hactD : act (E.map f) σ D = D := by rw [← ht₀]; exact act_base _ σ _
  obtain ⟨t', ⟨ht'M, ht'tor⟩, ht'⟩ := hσ
  obtain ⟨t, htM, rfl⟩ := AddSubgroup.mem_map.mp ht'M
  have hQD : ιPt f E (Qpt E ℓ) = Qpt (E.map f) ℓ + D := by rw [hDdef]; abel
  have key : ιPt f E (act E (resGal f E σ) (Qpt E ℓ) - Qpt E ℓ) = ιPt f E (base E t) := by
    rw [map_sub, ιPt_act, hQD, map_add, hactD, ιPt_base, ht']
    abel
  rw [ιPt_injective f E key]
  refine ⟨t, ⟨htM, ?_⟩, rfl⟩
  have ht2 : pointMap E f t ∈ AddSubgroup.torsionBy (E.map f).toAffine.Point (ℓ : ℤ) := by
    have h := ht'tor
    rw [he] at h
    exact h
  change t ∈ AddSubgroup.torsionBy E.toAffine.Point ((effLevel ℓ : ℕ) : ℤ)
  rw [he, AddSubgroup.torsionBy.nsmul_iff]
  rw [AddSubgroup.torsionBy.nsmul_iff, ← map_nsmul] at ht2
  exact pointMap_injective E f (ht2.trans (map_zero _).symm)

open scoped Classical in
/-- Restriction maps `Aut(Ω(E_L) / F_{X_L})` into `Aut(Ω(E) / F_X)` (no `±`-flag). -/
lemma resGal_mem_Hgp [CharZero k] [CharZero L] {ℓ : ℕ} (hℓ : ℓ ≠ 0)
    (hcard : Nat.card (AddSubgroup.torsionBy E.toAffine.Point (ℓ : ℤ)) = ℓ ^ 2)
    {M : AddSubgroup E.toAffine.Point} {pm : Bool} (hpm : pm = false) {σ : Gal (E.map f)}
    (hσ : σ ∈ Hgp (E.map f) ℓ (M.map (pointMap E f)) pm) :
    resGal f E σ ∈ Hgp E ℓ M pm := by
  obtain ⟨ε, hε, h⟩ := hσ
  have hε1 : ε = 1 := by
    rcases hε with h1 | ⟨h1, -⟩
    · exact h1
    · rw [hpm] at h1; exact absurd h1 Bool.false_ne_true
  subst hε1
  rw [one_smul] at h
  refine ⟨1, Or.inl rfl, ?_⟩
  rw [one_smul]
  exact resGal_sub_mem_Mbar f E hℓ hcard h

/-! ### (e) Inertia -/

lemma valuation_lt_one_iff_inv {K : Type*} [Field K] (A : ValuationSubring K) (x : K) :
    A.valuation x < 1 ↔ x = 0 ∨ x⁻¹ ∉ A := by
  rcases eq_or_ne x 0 with rfl | hx
  · simp
  · have hpos : 0 < A.valuation x := zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hx)
    rw [← A.valuation_le_one_iff, map_inv₀, inv_le_one₀ hpos]
    simp [hx]

open scoped Classical in
/-- Restriction maps inertia generators over `X_L` to inertia generators over `X`: the
pullback `ιΩ⁻¹(W')` of a valuation subring `W' ⊇ L[x]` contains `k[x]`. -/
lemma resGal_mem_Sgen [CharZero k] [CharZero L] {ℓ : ℕ} (hℓ : ℓ ≠ 0)
    (hcard : Nat.card (AddSubgroup.torsionBy E.toAffine.Point (ℓ : ℤ)) = ℓ ^ 2)
    {M : AddSubgroup E.toAffine.Point} {σ : Gal (E.map f)}
    (hσ : σ ∈ Sgen (E.map f) ℓ (M.map (pointMap E f))) :
    resGal f E σ ∈ Sgen E ℓ M := by
  obtain ⟨hσ, W', hk, hx, hin⟩ := hσ
  refine ⟨resGal_sub_mem_Mbar f E hℓ hcard hσ, W'.comap (ιΩ f E), fun c => ?_, ?_, ?_⟩
  · rw [ValuationSubring.mem_comap, ιΩ_algebraMap_base]; exact hk (f c)
  · rw [ValuationSubring.mem_comap, ιΩ_xG]; exact hx
  · intro a ha
    have h1 := hin (ιΩ f E a) ha
    rw [valuation_lt_one_iff_inv] at h1 ⊢
    rw [← ιΩ_resGal f E σ a, ← map_sub] at h1
    rcases h1 with h1 | h1
    · exact Or.inl ((map_eq_zero _).mp h1)
    · right
      rw [ValuationSubring.mem_comap, map_inv₀]
      exact h1

open scoped Classical in
lemma resGal_mem_ambientKernel [CharZero k] [CharZero L] {ℓ : ℕ} (hℓ : ℓ ≠ 0)
    (hcard : Nat.card (AddSubgroup.torsionBy E.toAffine.Point (ℓ : ℤ)) = ℓ ^ 2)
    {M : AddSubgroup E.toAffine.Point} {pm : Bool} {σ : Gal (E.map f)}
    (hσ : σ ∈ SgenC (E.map f) ℓ (M.map (pointMap E f))) :
    resGal f E σ ∈ GaloisPi1.ambientKernel (Hgp E ℓ M pm) (SgenC E ℓ M) := by
  rw [SgenC_of_charZero] at hσ ⊢
  refine Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ?_)
  exact ⟨1, (Hgp E ℓ M pm).one_mem, _, resGal_mem_Sgen f E hℓ hcard hσ, by simp⟩

/-! ### Type `(1, ℓ-tors)` -/

lemma level_ne_zero {X : Orbicurve k} {ℓ : ℕ} (hX : X.IsTypeOneEllTors ℓ) : X.level ≠ 0 := by
  rw [hX.2.1]; exact hX.1.ne_zero

open scoped Classical in
lemma card_torsion {X : Orbicurve k} {ℓ : ℕ} (hX : X.IsTypeOneEllTors ℓ) :
    Nat.card (AddSubgroup.torsionBy X.E.toAffine.Point (X.level : ℤ)) = X.level ^ 2 :=
  calc _ = Nat.card X.torsion := rfl
    _ = ℓ ^ 2 := hX.2.2.2.2.2
    _ = X.level ^ 2 := by rw [hX.2.1]

end GenuineBaseChange

/-! ### (f) The base-change homomorphism of genuine fundamental groups -/

open GenuineBaseChange Anabelian Anabelian.Genuine in
open scoped Classical in
/-- **Base change of the genuine étale fundamental group** `π₁(X_L) → π₁(X)`, for a field
embedding `f : k → L` of characteristic-`0` fields and a model orbicurve `X` of type
`(1, ℓ-tors)` over `k` (no `±`-flag, all `ℓ`-torsion `k`-rational): induced by the restriction
`Gal(Ω(E_L) / L(x)) → Gal(Ω(E) / k(x))` along an embedding `Ω(E) → Ω(E_L)` extending
`k(E) → L(E_L)`. For `K ⊂ K_v` this is the homomorphism `Π_{X̲_v} → Π_{X̲_K}` of the base change
`X̲_v = X̲_K ×_K K_v` (IUT I, Definition 3.1 (e)), whose restriction functor on finite étale
coverings gives the morphisms of IUT I, Example 4.3 (ii) and Example 6.3. -/
def genuinePi1BaseChange {k L : Type u} [Field k] [Field L] [CharZero k] [CharZero L]
    (f : k →+* L) (X : Orbicurve k) {ℓ : ℕ} (hX : X.IsTypeOneEllTors ℓ) :
    (X.baseChange f).genuinePi1 →* X.genuinePi1 :=
  GaloisPi1Map.pi1MapOfHom (isClosed_Hgp X.E X.level X.M X.pm)
    (isClosed_Hgp (X.E.map f) X.level (X.M.map (pointMap X.E f)) X.pm) (resGal f X.E)
    (continuous_resGal f X.E)
    (fun _ hσ => resGal_mem_Hgp f X.E (level_ne_zero hX) (card_torsion hX) hX.2.2.1 hσ)
    (fun _ hσ => resGal_mem_ambientKernel f X.E (level_ne_zero hX) (card_torsion hX) hσ)

end Theater

